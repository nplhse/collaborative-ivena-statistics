includes:
    - phpstan-baseline.neon
    - phpstan-baseline-wall-clock.neon

rules:
    - App\Tests\PHPStan\Rules\NoWallClockInstantiationRule
    - App\Tests\PHPStan\Rules\NoWallClockFunctionCallRule

parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - config/reference.php
        - tests/PHPStan/Unit/Rules/data/*

    # Reading the wall clock is only forbidden in application code (ADR 021).
    ignoreErrors:
        -
            identifier: wallClock.dateTime
            paths:
                - bin/*
                - config/*
                - tests/*
            reportUnmatched: false
        -
            identifier: wallClock.function
            paths:
                - bin/*
                - config/*
                - tests/*
            reportUnmatched: false
    doctrine:
        objectManagerLoader: tests/object-manager.php
        allowNullablePropertyForRequiredField: true
    symfony:
        consoleApplicationLoader: tests/console-application.php
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    treatPhpDocTypesAsCertain: false
