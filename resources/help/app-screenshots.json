                {
                    "click": {
                        "selector": "label",
                        "text": "Leitung der Notaufnahme"
                    }
                },
                {
                    "fill": {
                        "selector": "[name='hospital_assignment_request[explanation]']",
                        "value": "Ich leite die Zentrale Notaufnahme und möchte die Zuweisungen unserer Klinik hochladen."
