{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.state.show'|trans({}, 'allocation') }}: {{ state.name }} - {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include('@Shared/_includes/subnav_explore.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                    { label: 'link.explore', path: path('app_explore_index') },
                    { label: 'title.state.list', path: path('app_explore_state_list') },
                    { label: state.name }
                ]"
        />

        <div class="row align-items-center">
            <div class="col-auto">
                <span class="avatar avatar-lg rounded">
                    <twig:ux:icon name="tabler:map-2" width="36px" height="36px" />
                </span>
            </div>
            <div class="col">
                <h1 id="state-name" class="fw-bold">{{ state.name }}</h1>
                <div class="list-inline list-inline-dots text-muted">
                    <div class="list-inline-item">
                        {{ 'catalog.type.state'|trans({}, 'allocation') }}
                    </div>
                </div>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <a class="btn" href="{{ path('app_explore_state_list') }}">
                        <twig:ux:icon name="tabler:chevron-left" class="me-2" width="1em" height="1em" />
                        {{ 'label.back_to_list'|trans({}, 'messages') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    {% embed '@Allocation/catalog/_detail.html.twig' with {
        coverage: coverage,
        actions: actions,
        orientationMap: orientationMap,
    } %}
        {% block catalog_sidebar_extra %}
                {% import '@Shared/_macros/users.html.twig' as users %}
            <div class="card mb-3" data-testid="catalog-basic-info">
                <div class="card-body">
                    <div class="card-title">
                        {{ 'label.basic_info'|trans({}, 'messages') }}
                    </div>
                    <div class="mb-2">
                        <twig:ux:icon name="tabler:calendar-clock" width="1.5em" height="1.5em" />
                        {{ 'label.created_at'|trans({}, 'messages') }} <strong>{{ state.createdAt|date('d.m.Y H:i') }}</strong>
                    </div>
                    <div class="mb-2">
                        <twig:ux:icon name="tabler:user" width="1.5em" height="1.5em" />
                        {{ 'label.created_by'|trans({}, 'messages') }} <strong>{{ users.link(state.createdBy) }}</strong>
                    </div>
                    {% if state.updatedBy and state.updatedAt %}
                        <div class="mt-1 mb-2">
                            <twig:ux:icon name="tabler:calendar-clock" width="1.5em" height="1.5em" />
                            {{ 'label.updated_at'|trans({}, 'messages') }} <strong>{{ state.updatedAt|date('d.m.Y H:i') }}</strong>
                        </div>
                        <div class="mb-2">
                            <twig:ux:icon name="tabler:user" width="1.5em" height="1.5em" />
                            {{ 'label.updated_by'|trans({}, 'messages') }} <strong>{{ users.link(state.updatedBy) }}</strong>
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if state.dispatchAreas is not empty %}
                <div class="card mb-3" data-testid="catalog-related-entities">
                    <div class="card-body">
                        <div class="card-title">
                            {{ 'catalog.section.related_entities'|trans({}, 'allocation') }}
                        </div>
                        <div class="text-muted mb-1">{{ 'catalog.relation.dispatch_areas'|trans({}, 'allocation') }}</div>
                        <ul class="list-unstyled mb-0">
                            {% for area in state.dispatchAreas|sort((a, b) => a.name <=> b.name) %}
                                <li class="mb-1">
                                    {% if area.publicId %}
                                        <a href="{{ path('app_explore_dispatch_area_show', {publicId: area.publicId}) }}">{{ area.name }}</a>
                                    {% else %}
                                        {{ area.name }}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
