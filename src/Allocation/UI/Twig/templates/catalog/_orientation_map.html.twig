{% set orientationMap = orientationMap|default(null) %}
{% if orientationMap is not null and orientationMap.enabled %}
    <div class="card mb-3"
         data-controller="catalog-orientation-map"
         data-catalog-orientation-map-geo-url-value="{{ asset('geo/hessen-landkreise.geojson') }}"
         {% if orientationMap.highlightKey %}
             data-catalog-orientation-map-highlight-key-value="{{ orientationMap.highlightKey }}"
         {% endif %}
         data-catalog-orientation-map-show-all-value="{{ orientationMap.showAllAreas ? 'true' : 'false' }}"
         {% if orientationMap.hasMarker %}
             data-catalog-orientation-map-marker-lat-value="{{ orientationMap.markerLatitude }}"
             data-catalog-orientation-map-marker-lng-value="{{ orientationMap.markerLongitude }}"
             {% if orientationMap.markerLabel %}
                 data-catalog-orientation-map-marker-label-value="{{ orientationMap.markerLabel }}"
             {% endif %}
         {% endif %}
         data-testid="catalog-orientation-map">
        <div class="card-body">
            <div class="card-title">{{ 'catalog.section.orientation_map'|trans({}, 'allocation') }}</div>
            <div class="catalog-orientation-map-frame">
                <div class="case-flow-map-container"
                     data-catalog-orientation-map-target="mapContainer"></div>
            </div>
        </div>
    </div>
{% endif %}
