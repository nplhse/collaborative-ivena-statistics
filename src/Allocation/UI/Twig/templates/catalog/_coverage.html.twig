{% if coverage %}
    <twig:Card class="mb-3" data-testid="catalog-coverage">
            <div class="card-title">{{ 'catalog.section.coverage'|trans({}, 'allocation') }}</div>

            {% if coverage.suppressed %}
                <twig:Alert type="warning" class="mb-0" data-testid="catalog-coverage-suppressed">
                    {{ 'catalog.coverage.suppressed'|trans({threshold: constant('App\\Allocation\\Application\\Explore\\Catalog\\CatalogPrivacyPolicy::MIN_ALLOCATIONS')}, 'allocation') }}
                </twig:Alert>
            {% elseif not coverage.hasData %}
                {% set hospitalCoverage = coverageLayout is defined and coverageLayout == 'hospital' %}
                <div data-testid="catalog-coverage-empty">
                    <twig:EmptyState
                        title="{{ (hospitalCoverage ? 'empty.hospital.coverage.title' : 'catalog.section.coverage')|trans({}, 'allocation') }}"
                        description="{{ (hospitalCoverage ? (canImport|default(false) ? 'empty.hospital.coverage.description' : 'empty.hospital.coverage.no_permission.description') : 'catalog.coverage.empty')|trans({}, 'allocation') }}"
                        icon="tabler:database-off"
                    >
                        <twig:block name="actions">
                            {% if hospitalCoverage and canImport|default(false) %}
                                <a class="btn btn-primary" href="{{ path('app_import_new') }}" target="_top">{{ 'empty.hospital.coverage.cta'|trans({}, 'allocation') }}</a>
                            {% endif %}
                        </twig:block>
                    </twig:EmptyState>
                </div>
            {% else %}
                {% set hospitalLayout = coverageLayout is defined and coverageLayout == 'hospital' %}
                <div class="datagrid" data-testid="catalog-coverage-metrics">
                    {% if coverage.revealSensitiveMetrics %}
                        <div class="datagrid-item">
                            <div class="datagrid-title">{{ 'catalog.metric.allocations'|trans({}, 'allocation') }}</div>
                            <div class="datagrid-content">{{ coverage.allocationCount|number_format(0, ',', '.') }}</div>
                        </div>
                    {% endif %}
                    {% if coverage.sharePercent is not null %}
                        <div class="datagrid-item">
                            <div class="datagrid-title">{{ 'catalog.metric.share'|trans({}, 'allocation') }}</div>
                            <div class="datagrid-content">{{ coverage.sharePercent|number_format(2, ',', '.') }}&nbsp;%</div>
                        </div>
                    {% endif %}
                    {% if not hospitalLayout %}
                        <div class="datagrid-item">
                            <div class="datagrid-title">{{ 'catalog.metric.hospitals'|trans({}, 'allocation') }}</div>
                            <div class="datagrid-content">{{ coverage.hospitalCount|number_format(0, ',', '.') }}</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">{{ 'catalog.metric.dispatch_areas'|trans({}, 'allocation') }}</div>
                            <div class="datagrid-content">{{ coverage.dispatchAreaCount|number_format(0, ',', '.') }}</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">{{ 'catalog.metric.states'|trans({}, 'allocation') }}</div>
                            <div class="datagrid-content">{{ coverage.stateCount|number_format(0, ',', '.') }}</div>
                        </div>
                    {% endif %}
                    {% if coverage.firstAt and coverage.lastAt %}
                        <div class="datagrid-item">
                            <div class="datagrid-title">{{ 'catalog.metric.period'|trans({}, 'allocation') }}</div>
                            <div class="datagrid-content">
                                {{ coverage.firstAt|date('d.m.Y') }}
                                –
                                {{ coverage.lastAt|date('d.m.Y') }}
                            </div>
                        </div>
                    {% endif %}
                </div>

                {% if not coverage.revealSensitiveMetrics %}
                    <twig:Alert type="info" class="mt-3 mb-0" data-testid="catalog-coverage-sensitive-hidden">
                        {{ 'catalog.coverage.sensitive_hidden'|trans({}, 'allocation') }}
                    </twig:Alert>
                {% endif %}

                {% set yearHeatmap = coverage.yearHeatmap %}
                {% set yearExploreUrls = yearExploreUrls|default({}) %}
                {% if yearHeatmap is not empty %}
                    <div class="mt-3" data-testid="catalog-coverage-years">
                        <div class="text-muted mb-2">{{ 'catalog.metric.years'|trans({}, 'allocation') }}</div>
                        <div class="catalog-year-heatmap" data-testid="catalog-coverage-year-heatmap">
                            {% for row in yearHeatmap %}
                                <div class="catalog-year-heatmap-row">
                                    {% for cell in row %}
                                        {% set yearUrl = yearExploreUrls[cell.year]|default(null) %}
                                        {% set yearLinked = yearUrl and cell.hasData and not cell.future and not cell.countHidden %}
                                        {% set cellTag = yearLinked ? 'a' : 'div' %}
                                        <{{ cellTag }}
                                            {% if yearLinked %}
                                                href="{{ yearUrl }}"
                                                data-testid="catalog-coverage-year-link"
                                            {% endif %}
                                            class="catalog-year-heatmap-cell{{ cell.future ? ' is-future' : (not cell.hasData ? ' is-empty' : (cell.countHidden ? ' is-sensitive' : '')) }}{{ cell.intensity >= 0.45 ? ' is-hot' : '' }}"
                                            style="--catalog-heat: {{ cell.intensity }}"
                                            {% if cell.future %}
                                                title="{{ cell.year }}: —"
                                            {% elseif cell.countHidden %}
                                                title="{{ cell.year }}: {{ 'catalog.coverage.year_count_hidden'|trans({}, 'allocation') }}"
                                            {% else %}
                                                title="{{ cell.year }}: {{ cell.count|number_format(0, ',', '.') }}"
                                            {% endif %}
                                        >
                                            <div class="catalog-year-heatmap-year">{{ cell.year }}</div>
                                            <div class="catalog-year-heatmap-count">
                                                {% if cell.future %}
                                                    —
                                                {% elseif cell.countHidden %}
                                                    {{ 'catalog.coverage.year_count_hidden'|trans({}, 'allocation') }}
                                                {% else %}
                                                    {{ cell.count|number_format(0, ',', '.') }}
                                                {% endif %}
                                            </div>
                                        </{{ cellTag }}>
                                    {% endfor %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endif %}
    </twig:Card>
{% endif %}
