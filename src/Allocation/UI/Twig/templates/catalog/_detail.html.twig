{% set coverage = coverage|default(null) %}
{% set actions = actions|default([]) %}
{% set orientationMap = orientationMap|default(null) %}
{% set qualityWarnings = qualityWarnings|default([]) %}
{% set normalization = normalization|default(null) %}
{% set definitionChanges = definitionChanges|default([]) %}

<div class="row g-3" data-testid="catalog-detail">
    <div class="col-lg-8">
        {{ include('@Allocation/catalog/_quality_warnings.html.twig', {qualityWarnings: qualityWarnings}) }}

        {{ include('@Allocation/catalog/_coverage.html.twig', {coverage: coverage}) }}

        {{ include('@Allocation/catalog/_normalization.html.twig', {normalization: normalization}) }}

        {{ include('@Allocation/catalog/_definition_changes.html.twig', {definitionChanges: definitionChanges}) }}

        {{ include('@Allocation/catalog/_orientation_map.html.twig', {orientationMap: orientationMap}) }}
    </div>

    <div class="col-lg-4">
        {% if actions is not empty %}
            <div class="card mb-3" data-testid="catalog-actions">
                <div class="card-body">
                    <div class="card-title">{{ 'catalog.section.actions'|trans({}, 'allocation') }}</div>
                    <div class="btn-list flex-column">
                        {% for action in actions %}
                            <a
                                href="{{ action.url }}"
                                class="btn{{ action.primary ? ' btn-primary' : '' }}"
                                data-testid="catalog-action"
                            >
                                <twig:ux:icon name="{{ action.icon }}" class="me-2" width="1em" height="1em" />
                                {{ action.label }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        {% block catalog_sidebar_extra %}{% endblock %}
    </div>
</div>
