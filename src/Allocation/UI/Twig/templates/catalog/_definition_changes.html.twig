{% if definitionChanges is not empty %}
    <div class="card mb-3" data-testid="catalog-definition-changes">
        <div class="card-header">
            <h3 class="card-title">{{ 'catalog.section.definition_changes'|trans({}, 'allocation') }}</h3>
        </div>
        <div class="list-group list-group-flush">
            {% for change in definitionChanges %}
                <div class="list-group-item" data-testid="catalog-definition-change">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="badge bg-secondary-lt">{{ change.action }}</span>
                        </div>
                        <div class="col">
                            <div>{{ change.summary }}</div>
                            <div class="text-secondary small">
                                {{ change.occurredAt|date('d.m.Y H:i') }}
                                {% if change.actorLabel %}
                                    · {{ change.actorLabel }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
