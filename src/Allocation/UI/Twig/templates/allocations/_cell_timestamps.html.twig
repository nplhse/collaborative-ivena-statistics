{# Labels show in DataTable cards only (column option mobileLabel: false); the table keeps the icons. #}
<div class="data-table-cell__pair">
    <span class="data-table-cell__label">{{ 'label.created_at'|trans({}, 'messages') }}</span>
    <span><twig:ux:icon name="tabler:clock-play" class="w-3 h-3" /> {{ row.createdAt|date('d.m.Y H:i') }}</span>
</div>
<div class="data-table-cell__pair">
    <span class="data-table-cell__label">{{ 'label.arrival_at'|trans({}, 'messages') }}</span>
    <span><twig:ux:icon name="tabler:clock-check" class="w-3 h-3" /> {{ row.arrivalAt|date('d.m.Y H:i') }}</span>
</div>
