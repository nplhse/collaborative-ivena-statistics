{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.allocation.list'|trans({}, 'allocation') }} - {{ parent() }}{% endblock %}

{% block turbo_drive %}data-turbo=true{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include(('@Shared/_includes/subnav_explore.html.twig')) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <twig:PageHeader :title="'title.allocation.list'|trans({}, 'allocation')">
        <twig:block name="breadcrumbs">
            <twig:Breadcrumbs :items="[
                { label: 'link.explore', path: path('app_explore_index') },
                { label: 'title.allocation.list' }
            ]" />
        </twig:block>
        <twig:block name="context">
            {{ include('@Shared/components/data_table/_page_result_count.html.twig') }}
        </twig:block>
        <twig:block name="actions">
            <twig:FilterDrawerTrigger
                drawerId="allocation-filters"
                :activeCount="activeFilterCount"
                resetUrl="{{ activeFilterCount > 0 ? path('app_explore_allocation_list') : null }}"
            />
        </twig:block>
    </twig:PageHeader>
{% endblock %}

{% block page_content %}
    <turbo-frame id="allocation-list" data-turbo-action="advance">
        {% import '@Shared/_macros/filters.html.twig' as activeFilters %}

        {% if activeFilterCount > 0 %}
            {{ activeFilters.allocation_filter_badges(filters, states, dispatchAreas, indications, secondaryTransports, infections, departments, specialities, transportTypes, assignments, occasions, hospitalScopeOptions) }}
        {% endif %}

        {% set listIsFiltered = activeFilterCount > 0 %}
        <twig:DataTable
            :paginator="paginator"
            :paginationRoute="pagination_route"
            :sortBy="sortBy"
            :orderBy="orderBy"
            emptyTitle="{{ (listIsFiltered ? 'empty.filtered.title' : (canImport ? 'empty.allocation.initial.title' : 'empty.allocation.no_permission.title'))|trans({}, listIsFiltered ? 'shared' : 'allocation') }}"
            emptyDescription="{{ (listIsFiltered ? 'empty.filtered.description' : (canImport ? 'empty.allocation.initial.description' : 'empty.allocation.no_permission.description'))|trans({}, listIsFiltered ? 'shared' : 'allocation') }}"
            emptyIcon="{{ listIsFiltered ? 'tabler:filter-off' : 'tabler:ambulance' }}"
            rowClassProperty="departmentWasClosed"
            rowClass="allocation-row-department-closed"
            :columns="[
                { key: 'timestamps', type: 'custom', label: 'label.timestamps', sortable: true, sortKey: 'arrivalAt', width: 'col-2', cellTemplate: '@Allocation/allocations/_cell_timestamps.html.twig' },
                { key: 'age', type: 'custom', label: 'label.age', sortable: true, sortKey: 'age', width: 'col-1', cellTemplate: '@Allocation/allocations/_cell_age.html.twig' },
                { key: 'hospital', type: 'custom', label: 'label.hospital', width: 'col-3', cellTemplate: '@Allocation/allocations/_cell_hospital.html.twig' },
                { key: 'indication', type: 'custom', label: 'label.indication', width: 'col-3', cellTemplate: '@Allocation/allocations/_cell_indication.html.twig' },
                { key: 'urgency', type: 'badge', label: 'label.urgency', property: 'urgency', width: 'col-1', badgePalette: 'allocation_urgency' },
                { key: 'properties', type: 'custom', label: 'label.properties', width: 'col-1', cellTemplate: '@Allocation/allocations/_cell_properties.html.twig' },
                { key: 'actions', type: 'actions', label: '', width: 'col-1', route: 'app_explore_allocation_show', routeParams: {publicId: 'publicId'} },
            ]"
        >
            <twig:block name="empty_actions">
                {% if listIsFiltered %}
                    <a class="btn btn-primary" href="{{ path('app_explore_allocation_list') }}">{{ 'empty.filtered.cta'|trans({}, 'shared') }}</a>
                {% elseif canImport %}
                    <a class="btn btn-primary" href="{{ path('app_import_new') }}" target="_top">{{ 'empty.allocation.initial.cta'|trans({}, 'allocation') }}</a>
                {% else %}
                    <a class="btn btn-outline-secondary" href="{{ path('app_default') }}" target="_top">{{ 'empty.onboarding.cta'|trans({}, 'shared') }}</a>
                {% endif %}
            </twig:block>
        </twig:DataTable>
</turbo-frame>

    {{ include('@Allocation/allocations/_allocation_filter_drawer.html.twig') }}
{% endblock %}
