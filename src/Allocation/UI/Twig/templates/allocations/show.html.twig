{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.allocation.show'|trans({}, 'allocation') }}: {{ allocation.id }} - {{ 'title.data'|trans({}, 'messages') }} - {{ parent() }}{% endblock %}

{% import '@Shared/_macros/badges.html.twig' as badges %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include('@Shared/_includes/subnav_explore.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
        <div class="container-xl">
            <twig:Breadcrumbs
                :items="[
                    { label: 'link.explore', path: path('app_explore_index') },
                    { label: 'link.allocations', path: path('app_explore_allocation_list') },
                    { label: 'title.allocation.show' },
                ]"
            />

            <div class="row align-items-center">
                <div class="col-auto">
                    <span class="avatar avatar-lg rounded">
                        <twig:ux:icon name="tabler:ambulance" class="w-5 h-5" />
                    </span>
                </div>
                <div class="col">
                    <h1 id="allocation-id" class="fw-bold">{{ 'label.allocation'|trans({}, 'messages') }} #{{ allocation.id }}</h1>
                    <div class="list-inline list-inline-dots text-muted">
                        <div class="list-inline-item">
                            <twig:ux:icon name="tabler:map" class="w-3 h-3" />
                            {{ explore_entity_link(allocation.dispatchArea, {class: 'link-secondary'}) }}, {{ explore_entity_link(allocation.state, {class: 'link-secondary'}) }}
                        </div>
                    </div>
                </div>
                <div class="col-auto ms-auto">
                    <div class="btn-list">
                        <span class="d-none d-sm-inline">
                            <a class="btn" href="{{ path('app_explore_allocation_list') }}">
                                <twig:ux:icon name="tabler:chevron-left" class="w-3 h-3" />
                                {{ 'label.back_to_list'|trans({}, 'messages') }}
                            </a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
{% endblock %}

{% block page_content %}
    <div class="row g-3">
        <div class="col">
            <div class="col-12 mb-3">
                <twig:Card
                    title="{{ 'label.speciality'|trans({}, 'messages') }}"
                >
                    <div class="department-line">
                        <div class="d-flex align-items-center">
                            <span class="fw-bold me-1">{{ explore_entity_link(allocation.department) }}</span>
                            <span class="text-muted">({{ explore_entity_link(allocation.speciality) }})</span>

                            {% if allocation.departmentWasClosed %}
                                {{ include('@Allocation/allocations/_department_was_closed_indicator.html.twig') }}
                            {% endif %}
                        </div>
                    </div>
                </twig:Card>
            </div>
            <div class="col-12 mb-3">
                <twig:Card
                    title="{{ 'label.indication'|trans({}, 'messages') }}"
                >
                    <div class="allocation-assignment row">
                        <p>
                            {{ 'label.indication.raw'|trans({}, 'messages') }}: <strong>{{ allocation.indicationRaw.name }}</strong> <span class="badge">{{ allocation.indicationRaw.code }}</span>
                        </p>
                        <p>
                            {{ 'label.indication.normalized'|trans({}, 'messages') }}:
                            {% if allocation.indicationNormalized is not null %}
                                <strong>{{ explore_entity_link(allocation.indicationNormalized) }}</strong> <span class="badge">{{ allocation.indicationNormalized.code }}</span>
                            {% else %}
                                <strong>{{ 'label.no_indication'|trans({}, 'messages') }}</strong>
                            {% endif %}
                        </p>
                        <p>
                            {{ 'label.indication.secondary_raw'|trans({}, 'messages') }}:
                            {% if allocation.secondaryIndicationRaw is not null %}
                                <strong>{{ allocation.secondaryIndicationRaw.name }}</strong> <span class="badge">{{ allocation.secondaryIndicationRaw.code }}</span>
                            {% else %}
                                <strong>{{ 'label.no_secondary_indication'|trans({}, 'messages') }}</strong>
                            {% endif %}
                        </p>
                        <p>
                            {{ 'label.indication.secondary_normalized'|trans({}, 'messages') }}:
                            {% if allocation.secondaryIndicationNormalized is not null %}
                                <strong>{{ explore_entity_link(allocation.secondaryIndicationNormalized) }}</strong> <span class="badge">{{ allocation.secondaryIndicationNormalized.code }}</span>
                            {% else %}
                                <strong>{{ 'label.no_secondary_indication'|trans({}, 'messages') }}</strong>
                            {% endif %}
                        </p>
                    </div>
                </twig:Card>
            </div>
            <div class="col-12 mb-3">
                <twig:Card
                    title="{{ 'label.background'|trans({}, 'messages') }}"
                >
                    <div class="allocation-assignment row">
                        <div class="col-6">
                            {{ 'label.assignment'|trans({}, 'messages') }}: <strong>{{ explore_entity_link(allocation.assignment) }}</strong>
                        </div>
                        <div class="col-6">
                            {{ 'label.occasion'|trans({}, 'messages') }}:
                            {% if allocation.occasion is not null %}
                                <strong>{{ explore_entity_link(allocation.occasion) }}</strong>
                            {% else %}
                                <strong>{{ 'label.no_occasion'|trans({}, 'messages') }}</strong>
                            {% endif %}
                        </div>
                        <div class="col-6 mt-2">
                            {{ 'label.secondary_transport'|trans({}, 'messages') }}:
                            {% if allocation.secondaryTransport is not null %}
                                <strong>{{ explore_entity_link(allocation.secondaryTransport) }}</strong>
                            {% else %}
                                <strong>{{ 'label.no_secondary_transport'|trans({}, 'messages') }}</strong>
                            {% endif %}
                        </div>
                    </div>
                </twig:Card>
            </div>
            {% set originArea = allocation.dispatchArea %}
            {% set destinationHospital = allocation.hospital %}
            {% set destinationArea = destinationHospital.dispatchArea %}
            {% set isCrossDistrict = originArea.id != destinationArea.id %}
            <div class="col-12 mb-3">
                <twig:Card
                    title="{{ 'allocation.section.origin_destination'|trans({}, 'allocation') }}"
                >
                    <div data-testid="allocation-origin-destination">
                        {% import '@Shared/_macros/badges.html.twig' as badges %}
                        <div class="row g-3">
                            <div class="col-md-6" data-testid="allocation-origin">
                                <div class="text-muted small text-uppercase mb-1">{{ 'allocation.label.origin'|trans({}, 'allocation') }}</div>
                                <div class="fw-semibold">
                                    {{ explore_entity_link(originArea) }}
                                </div>
                                {% if orientationMap is defined and orientationMap is not null and orientationMap.hasDistrictLabel %}
                                    <div class="text-muted small mt-1" data-testid="allocation-origin-district">
                                        {{ 'allocation.label.origin_district'|trans({}, 'allocation') }}:
                                        {{ orientationMap.districtLabel }}
                                    </div>
                                {% endif %}
                                <div class="text-muted small mt-1">
                                    {{ explore_entity_link(allocation.state, {class: 'link-secondary'}) }}
                                </div>
                            </div>
                            <div class="col-md-6" data-testid="allocation-destination">
                                <div class="text-muted small text-uppercase mb-1">{{ 'allocation.label.destination'|trans({}, 'allocation') }}</div>
                                <div class="fw-semibold">
                                    {{ explore_entity_link(destinationHospital) }}
                                </div>
                                <div class="mt-2 d-flex flex-wrap gap-1" data-testid="allocation-destination-profile">
                                    {% if destinationHospital.location %}
                                        {{ badges.render('hospital_location', destinationHospital.location.value) }}
                                    {% endif %}
                                    {% if destinationHospital.tier %}
                                        {{ badges.render('hospital_tier', destinationHospital.tier.value) }}
                                    {% endif %}
                                    {% if destinationHospital.size %}
                                        {{ badges.render('hospital_size', destinationHospital.size.value, destinationHospital.beds) }}
                                    {% endif %}
                                </div>
                                <div class="text-secondary small mt-2 d-flex align-items-start gap-2">
                                    <twig:ux:icon name="tabler:map-pin" class="w-3 h-3 mt-1" />
                                    <span>
                                        {{ destinationHospital.address.street }}, {{ destinationHospital.address.postalCode }} {{ destinationHospital.address.city }}
                                        · {{ destinationHospital.address.country }}
                                    </span>
                                </div>
                                <div class="text-muted small mt-1">
                                    {{ explore_entity_link(destinationArea, {class: 'link-secondary'}) }}
                                    · {{ explore_entity_link(destinationHospital.state, {class: 'link-secondary'}) }}
                                </div>
                            </div>
                        </div>
                        {% if isCrossDistrict %}
                            <p class="small text-muted mb-0 mt-3" data-testid="allocation-cross-district">
                                {{ 'allocation.hint.cross_district'|trans({}, 'allocation') }}
                            </p>
                        {% endif %}
                        {{ include('@Allocation/catalog/_orientation_map.html.twig', {
                            orientationMap: orientationMap|default(null),
                            orientationMapEmbed: true,
                        }) }}
                    </div>
                </twig:Card>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="row row-cards">
                <div class="col-12">
                    <twig:Card
                        title="{{ 'label.basic_info'|trans({}, 'messages') }}"
                    >
                        {% import '@Shared/_macros/badges.html.twig' as badges %}

                        <div id="allocation-created-at" class="mb-2">
                            <twig:ux:icon name="tabler:clock-play" class="w-3 h-3" />
                            {{ 'label.created_at'|trans({}, 'messages') }} <strong>{{ allocation.createdAt|date('d.m.Y H:i') }}</strong>
                        </div>
                        <div id="allocation-arrival-at" class="mb-2">
                            <twig:ux:icon name="tabler:clock-check" class="w-3 h-3" />
                            {{ 'label.arrival_at'|trans({}, 'messages') }} <strong>{{ allocation.arrivalAt|date('d.m.Y H:i') }}</strong>
                        </div>
                        <div id="allocation-age" class="mb-2">
                            <twig:ux:icon name="tabler:user" class="w-3 h-3" />
                            {{ 'field.age'|trans({}, 'messages') }} <strong>{{ allocation.age }}</strong>
                        </div>
                        <div id="allocation-gender" class="mb-2">
                            {% if allocation.gender is not null %}
                                {% if allocation.gender.value == 'M' %}
                                    <twig:ux:icon name="tabler:gender-male" class="w-3 h-3" />
                                {% elseif allocation.gender.value == 'F' %}
                                    <twig:ux:icon name="tabler:gender-female" class="w-3 h-3" />
                                {% else %}
                                    <twig:ux:icon name="tabler:gender-agender" class="w-3 h-3" />
                                {% endif %}
                                {{ 'field.gender'|trans({}, 'messages') }} <strong>{{ allocation.gender.label|trans }}</strong>
                            {% else %}
                                <twig:ux:icon name="tabler:gender-agender" class="w-3 h-3" />
                                {{ 'field.gender'|trans({}, 'messages') }} <strong>—</strong>
                            {% endif %}
                        </div>
                        <div id="allocation-urgency" class="mb-2">
                            <twig:ux:icon name="tabler:traffic-lights" class="w-3 h-3" />
                            {{ 'field.urgency'|trans({}, 'messages') }}
                            {% if allocation.urgency is not null %}
                                {{ badges.render('allocation_urgency', allocation.urgency.value) }}
                            {% else %}
                                —
                            {% endif %}
                        </div>
                        <div id="allocation-infection">
                            <twig:ux:icon name="tabler:biohazard" class="w-3 h-3" />
                            {{ 'field.infection'|trans({}, 'messages') }}
                            {% if allocation.infection is not null %}
                                {{ explore_entity_link(allocation.infection, {class: 'badge bg-orange text-orange-fg'}) }}
                            {% else %}
                                <strong>{{ 'label.no_infection'|trans({}, 'messages') }}</strong>
                            {% endif %}
                        </div>
                    </twig:Card>
                </div>
                <div class="col-12">
                    <twig:Card
                        title="{{ 'label.transport'|trans({}, 'messages') }}"
                    >
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'field.transportType'|trans({}, 'messages') }}</div>
                                <div class="datagrid-content" data-testid="allocation-transport-type">
                                    {% if allocation.transportType is not null and allocation.transportType.value == 'G' %}
                                        <twig:ux:icon name="tabler:ambulance" class="w-3 h-3" />
                                        <strong>{{ allocation.transportType.label()|trans }}</strong>
                                    {% elseif allocation.transportType is not null and allocation.transportType.value == 'A' %}
                                        <twig:ux:icon name="tabler:helicopter" class="w-3 h-3" />
                                        <strong>{{ allocation.transportType.label()|trans }}</strong>
                                    {% else %}
                                        {{ 'field.transportType.unknown'|trans({}, 'messages') }}
                                    {% endif %}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'field.isWithPhysician'|trans({}, 'messages') }}</div>
                                <div class="datagrid-content">
                                    {% if allocation.isWithPhysician %}
                                        <strong>{{ 'field.isWithPhysician.true'|trans({}, 'messages') }}</strong>
                                    {% else %}
                                        {{ 'field.isWithPhysician.false'|trans({}, 'messages') }}
                                    {% endif %}</div>
                            </div>
                        </div>
                    </twig:Card>
                </div>
                <div class="col-12">
                    <twig:Card
                        title="{{ 'label.properties'|trans({}, 'messages') }}"
                    >
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'field.requiresResus'|trans({}, 'messages') }}</div>
                                <div class="datagrid-content">
                                    {% if allocation.requiresResus %}
                                        <span class="status status-green">{{ 'field.true'|trans({}, 'messages') }}</span>
                                    {% else %}
                                        <span class="status status-red">{{ 'field.false'|trans({}, 'messages') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'field.requiresCathlab'|trans({}, 'messages') }}</div>
                                <div class="datagrid-content">
                                    {% if allocation.requiresCathlab %}
                                        <span class="status status-green">{{ 'field.true'|trans({}, 'messages') }}</span>
                                    {% else %}
                                        <span class="status status-red">{{ 'field.false'|trans({}, 'messages') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'field.isCPR'|trans({}, 'messages') }}</div>
                                <div class="datagrid-content">
                                    {% if allocation.isCPR %}
                                        <span class="status status-green">{{ 'field.true'|trans({}, 'messages') }}</span>
                                    {% else %}
                                        <span class="status status-red">{{ 'field.false'|trans({}, 'messages') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'allocations.field.isVentilated'|trans({}, 'allocation') }}</div>
                                <div class="datagrid-content">
                                    {% if allocation.isVentilated %}
                                        <span class="status status-green">{{ 'field.true'|trans({}, 'messages') }}</span>
                                    {% else %}
                                        <span class="status status-red">{{ 'field.false'|trans({}, 'messages') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'allocations.field.isShock'|trans({}, 'allocation') }}</div>
                                <div class="datagrid-content">
                                    {% if allocation.isShock %}
                                        <span class="status status-green">{{ 'field.true'|trans({}, 'messages') }}</span>
                                    {% else %}
                                        <span class="status status-red">{{ 'field.false'|trans({}, 'messages') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'allocations.field.isPregnant'|trans({}, 'allocation') }}</div>
                                <div class="datagrid-content">
                                    {% if allocation.isPregnant %}
                                        <span class="status status-green">{{ 'field.true'|trans({}, 'messages') }}</span>
                                    {% else %}
                                        <span class="status status-red">{{ 'field.false'|trans({}, 'messages') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">{{ 'allocations.field.isWorkAccident'|trans({}, 'allocation') }}</div>
                                <div class="datagrid-content">
                                    {% if allocation.isWorkAccident %}
                                        <span class="status status-green">{{ 'field.true'|trans({}, 'messages') }}</span>
                                    {% else %}
                                        <span class="status status-red">{{ 'field.false'|trans({}, 'messages') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </twig:Card>
                </div>
                {% if allocation.assessment %}
                    <div class="col-12">
                        <twig:Card
                            title="{{ 'label.assessment'|trans({}, 'messages') }}"
                        >
                            <div class="datagrid">
                                <div class="datagrid-item">
                                    <div class="datagrid-title">{{ 'field.assessment.airway'|trans({}, 'messages') }}</div>
                                    <div class="datagrid-content">
                                        {{ allocation.assessment.airway.label|trans }}
                                    </div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">{{ 'field.assessment.breathing'|trans({}, 'messages') }}</div>
                                    <div class="datagrid-content">
                                        {{ allocation.assessment.breathing.label|trans }}
                                    </div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">{{ 'field.assessment.circulation'|trans({}, 'messages') }}</div>
                                    <div class="datagrid-content">
                                        {{ allocation.assessment.circulation.label|trans }}
                                    </div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">{{ 'field.assessment.disability'|trans({}, 'messages') }}</div>
                                    <div class="datagrid-content">
                                        {{ allocation.assessment.disability.label|trans }}
                                    </div>
                                </div>
                            </div>
                        </twig:Card>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
