{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.hospital.list'|trans({}, 'allocation') }} - {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include(('@Shared/_includes/subnav_explore.html.twig')) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                    { label: 'link.explore', path: path('app_explore_index') },
                    { label: 'link.hospitals' }
                ]"
        />

        <div class="page-header d-print-none">
            <div class="row align-items-center">
                <div class="col">
                    {% block page_intro %}
                        <h2 class="page-title">
                            {% block page_title %}{{ 'title.hospital.list'|trans({}, 'allocation') }}{% endblock %}
                        </h2>
                    {% endblock %}
                </div>

                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <twig:FilterDrawerTrigger
                            drawerId="hospital-filters"
                            :activeCount="activeFilterCount"
                            resetUrl="{{ activeFilterCount > 0 ? path('app_explore_hospital_list') : null }}"
                            openTestId="hospital-filters-drawer-trigger"
                            clearTestId="hospital-filters-clear"
                        />

                        <form
                            method="GET"
                            action="{{ path('app_explore_hospital_list') }}"
                            data-controller="autosubmit"
                            data-turbo-frame="hospital-list"
                        >
                            <div class="input-icon">
                                <input
                                    type="search"
                                    name="search"
                                    value="{{ app.request.query.get('search') }}"
                                    aria-label="{{ 'label.search'|trans({}, 'messages') }}"
                                    placeholder="{{ 'label.search'|trans({}, 'messages') }}"
                                    class="form-control d-inline-block w-9 me-3"
                                    data-action="autosubmit#debouncedSubmit"
                                    autofocus
                                >
                                <span class="input-icon-addon">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="icon"
                                        width="24" height="24" viewBox="0 0 24 24"
                                        stroke-width="2" stroke="currentColor"
                                        fill="none"
                                        stroke-linecap="round" stroke-linejoin="round"
                                    >
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <circle cx="10" cy="10" r="7" />
                                        <line x1="21" y1="21" x2="15" y2="15" />
                                    </svg>
                                </span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    <turbo-frame id="hospital-list" data-turbo-action="advance">
        {% import '@Shared/_macros/filters.html.twig' as activeFilters %}

        {% if activeFilterCount > 0 %}
            {{ activeFilters.hospital_filter_badges(filters, states, dispatchAreas) }}
        {% endif %}

        <twig:DataTable
            :paginator="paginator"
            :paginationRoute="pagination_route"
            :sortBy="sortBy"
            :orderBy="orderBy"
            :columns="[
                { key: 'participating', type: 'boolean', label: '', property: 'participating' },
                { key: 'name', type: 'link', label: 'label.name', property: 'name', sortable: true, sortKey: 'name', width: 'col-3', route: 'app_explore_hospital_show', routeParams: {publicId: 'publicId'} },
                { key: 'dispatchArea', type: 'text', label: 'label.dispatch_area', property: 'dispatchArea', sortable: true, sortKey: 'dispatchArea', width: 'col-2' },
                { key: 'state', type: 'text', label: 'label.state', property: 'state', sortable: true, sortKey: 'state', width: 'col-2' },
                { key: 'location', type: 'badge', label: 'label.location', property: 'location', sortable: true, sortKey: 'location', width: 'col-1', badgePalette: 'hospital_location' },
                { key: 'tier', type: 'badge', label: 'label.tier', property: 'tier', sortable: true, sortKey: 'tier', width: 'col-1', badgePalette: 'hospital_tier' },
                { key: 'size', type: 'badge', label: 'label.size', property: 'size', sortable: true, sortKey: 'size', width: 'col-1', badgePalette: 'hospital_size', numberProperty: 'beds' },
                { key: 'lastChange', type: 'custom', label: 'label.last_change', sortable: true, sortKey: 'lastChange', width: 'col-2', cellTemplate: '@Allocation/hospitals/_cell_last_change.html.twig' },
            ]"
        />
</turbo-frame>

    <twig:FilterDrawer
        id="hospital-filters"
        formId="hospital-filter-form"
        formAction="{{ path('app_explore_hospital_list') }}"
        resetUrl="{{ path('app_explore_hospital_list') }}"
        testId="hospital-filters-drawer"
        cancelTestId="hospital-filters-cancel"
        applyTestId="hospital-filters-apply"
        resetTestId="hospital-filters-reset"
        :keepQueryKeys="['search', 'sortBy', 'orderBy']"
    >
                <div class="mb-3">
                    <label class="form-label">{{ 'label.tier'|trans({}, 'messages') }}</label>
                    <select name="tier" class="form-select">
                        <option value="">{{ 'label.all_tiers'|trans({}, 'messages') }}</option>
                        {% for tier in tiers %}
                            <option
                                value="{{ tier.value }}"
                                {{ filters.tier == tier.value ? 'selected' }}
                            >
                                {{ ('hospital.tier.' ~ tier.value)|trans({}, 'allocation') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ 'label.location'|trans({}, 'messages') }}</label>
                    <select name="location" class="form-select">
                        <option value="">{{ 'label.all_locations'|trans({}, 'messages') }}</option>
                        {% for location in locations %}
                            <option
                                value="{{ location.value }}"
                                {{ filters.location == location.value ? 'selected' }}
                            >
                                {{ ('hospital.location.' ~ location.value)|trans({}, 'allocation') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ 'label.size'|trans({}, 'messages') }}</label>
                    <select name="size" class="form-select">
                        <option value="">{{ 'label.all_sizes'|trans({}, 'messages') }}</option>
                        {% for size in sizes %}
                            <option
                                value="{{ size.value }}"
                                {{ filters.size == size.value ? 'selected' }}
                            >
                                {{ ('hospital.size.' ~ size.value)|trans({}, 'allocation') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ 'label.dispatch_area'|trans({}, 'messages') }}</label>
                    <select name="dispatchArea" class="form-select">
                        <option value="">{{ 'label.all_dispatch_areas'|trans({}, 'messages') }}</option>
                        {% for area in dispatchAreas %}
                            <option
                                value="{{ area.id }}"
                                {{ filters.dispatchArea == area.id ? 'selected' }}
                            >
                                {{ area.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ 'label.state'|trans({}, 'messages') }}</label>
                    <select name="state" class="form-select">
                        <option value="">{{ 'label.all_states'|trans({}, 'messages') }}</option>
                        {% for state in states %}
                            <option
                                value="{{ state.id }}"
                                {{ filters.state == state.id ? 'selected' }}
                            >
                                {{ state.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ 'label.participation'|trans({}, 'messages') }}</label>
                    <select name="participating" class="form-select">
                        <option value="">{{ 'label.all_modes'|trans({}, 'messages') }}</option>
                        <option
                            value="1"
                            {{ filters.participating == '1' ? 'selected' }}
                        >
                            {{ 'label.is_participating.yes'|trans({}, 'messages') }}
                        </option>
                        <option
                            value="0"
                            {{ filters.participating == '0' ? 'selected' }}
                        >
                            {{ 'label.is_participating.not'|trans({}, 'messages') }}
                        </option>
                    </select>
                </div>
    </twig:FilterDrawer>
{% endblock %}
