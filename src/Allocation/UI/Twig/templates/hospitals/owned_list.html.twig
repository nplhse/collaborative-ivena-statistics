{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.hospitals.my'|trans({}, 'allocation') }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                { label: 'title.hospitals.my' }
            ]"
        />

        <div class="page-header d-print-none">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ 'title.hospitals.my'|trans({}, 'allocation') }}</h2>
                    <div class="text-body-secondary mt-1" data-testid="my-hospitals-header-count">
                        {% if selection.isAll %}
                            {{ 'my_hospitals.header.count'|trans({count: scope.count}, 'allocation') }}
                        {% else %}
                            {{ 'my_hospitals.header.selected'|trans({total: scope.count}, 'allocation') }}
                        {% endif %}
                    </div>
                </div>
                {% if selection.canChoose %}
                    <div class="col-auto ms-auto d-print-none">
                        {{ include('@Allocation/hospitals/_my_hospitals_selection.html.twig') }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    {% if overview %}
        {{ include('@Allocation/hospitals/_my_hospitals_summary.html.twig') }}

        {% set showCoverage = overview.hospitals|filter(status => status.history is not empty)|length > 0 %}
        <div class="row row-cards">
            <div class="{{ showCoverage ? 'col-lg-8' : 'col-12' }}">
                <div class="row row-cards" data-testid="my-hospitals-cards">
                    {% for status in overview.hospitals %}
                        <div class="col-12">
                            {{ include('@Allocation/hospitals/_my_hospitals_card.html.twig') }}
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% if showCoverage %}
                <div class="col-lg-4">
                    {{ include('@Allocation/hospitals/_my_hospitals_coverage.html.twig') }}
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="card">
            <div class="card-body">
                <twig:EmptyState
                    title="{{ 'empty.owned.title'|trans({}, 'allocation') }}"
                    description="{{ 'empty.owned.description'|trans({}, 'allocation') }}"
                    icon="tabler:building-hospital"
                >
                    <twig:block name="actions">
                        <a class="btn btn-primary" href="{{ path('app_default') }}" target="_top">{{ 'empty.owned.cta'|trans({}, 'allocation') }}</a>
                    </twig:block>
                </twig:EmptyState>
            </div>
        </div>
    {% endif %}
{% endblock %}
