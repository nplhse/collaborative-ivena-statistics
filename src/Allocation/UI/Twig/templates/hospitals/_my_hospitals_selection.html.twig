{#
    Hospital selection of My Hospitals (#971): all hospitals (default) or a single one, as `?hospital=<public id>`.
    Shown only with more than one hospital.
#}
<div class="dropdown" data-testid="my-hospitals-selection">
    <button
        type="button"
        class="btn dropdown-toggle"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        data-testid="my-hospitals-selection-toggle"
    >
        <twig:ux:icon name="tabler:building-hospital" class="icon" />
        {{ selection.single ? selection.single.hospital.name : 'my_hospitals.selection.all'|trans({}, 'allocation') }}
    </button>
    <div class="dropdown-menu dropdown-menu-end my-hospitals-selection-menu">
        <a
            class="dropdown-item{{ selection.isAll ? ' active' : '' }}"
            href="{{ path('app_hospitals_index') }}"
            {% if selection.isAll %}aria-current="true"{% endif %}
            data-testid="my-hospitals-selection-all"
        >
            {{ 'my_hospitals.selection.all'|trans({}, 'allocation') }}
        </a>
        <div class="dropdown-divider"></div>
        {% for entry in selection.available.entries %}
            <a
                class="dropdown-item{{ selection.isSelected(entry) ? ' active' : '' }}"
                href="{{ path('app_hospitals_index', {hospital: entry.hospital.publicIdString}) }}"
                {% if selection.isSelected(entry) %}aria-current="true"{% endif %}
                data-testid="my-hospitals-selection-option"
            >
                {{ entry.hospital.name }}
            </a>
        {% endfor %}
    </div>
</div>
