{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ page.titleKey|trans({}, 'allocation') }} - {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            <twig:Navigation:Sidebar menu="explore" />
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                    { label: 'link.explore', path: path('app_explore_index') },
                    { label: 'title.glossary.index', path: path('app_explore_glossary_index') },
                    { label: page.titleKey }
                ]"
        />

        <div class="row align-items-center">
            <div class="col-auto">
                <span class="avatar avatar-lg rounded">
                    <twig:ux:icon name="{{ page.icon }}" width="36px" height="36px" />
                </span>
            </div>
            <div class="col">
                <h1 class="fw-bold" data-testid="glossary-title">{{ page.titleKey|trans({}, 'allocation') }}</h1>
                <div class="list-inline list-inline-dots text-secondary">
                    <div class="list-inline-item">
                        {{ 'catalog.type.glossary'|trans({}, 'allocation') }}
                    </div>
                </div>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <a class="btn" href="{{ path('app_explore_glossary_index') }}">
                        <twig:ux:icon name="tabler:chevron-left" class="me-2" width="1em" height="1em" />
                        {{ 'label.back_to_list'|trans({}, 'messages') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    <div data-testid="glossary-detail">
        {% for section in page.sections %}
            {% set sectionUsages = catalogUsages|filter(usage => usage.section == section.key) %}
            <div class="card mb-3" data-testid="glossary-section"{% if section.key is not null %} id="{{ section.key }}" data-section-key="{{ section.key }}"{% endif %}>
                <div class="card-header">
                    <h3 class="card-title">{{ section.titleKey|trans({}, section.titleDomain) }}</h3>
                </div>
                {% if sectionUsages is not empty %}
                    <div class="card-body py-2 small" data-testid="glossary-catalog-usages">
                        <span class="text-secondary me-1">{{ 'catalog.glossary.stored_as'|trans({}, 'allocation') }}</span>
                        {% for usage in sectionUsages %}
                            <a href="{{ path('app_explore_data_catalog_show', {objectKey: usage.objectKey}) }}#{{ usage.variable.anchor }}" class="badge bg-azure-lt text-decoration-none me-1" data-testid="glossary-catalog-usage" data-variable-key="{{ usage.variable.key }}"><twig:ux:icon name="tabler:database" class="me-1" width="1em" height="1em" aria-hidden="true" />{{ usage.objectTitleKey|trans({}, usage.objectDomain) }} · {{ usage.variable.labelKey|trans({}, usage.objectDomain) }}</a>
                        {% endfor %}
                    </div>
                {% endif %}
                <div class="table-responsive">
                    <table class="table table-vcenter card-table mb-0 glossary-table">
                        <colgroup>
                            <col class="glossary-table__code">
                            <col class="glossary-table__label">
                            <col>
                            <col class="glossary-table__action">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>{{ 'catalog.glossary.column.code'|trans({}, 'allocation') }}</th>
                                <th>{{ 'catalog.glossary.column.label'|trans({}, 'allocation') }}</th>
                                <th>{{ 'catalog.glossary.column.definition'|trans({}, 'allocation') }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for term in section.terms %}
                                <tr data-testid="glossary-term">
                                    <td><code>{{ term.code }}</code></td>
                                    <td>{{ term.labelKey|trans({}, term.labelDomain) }}</td>
                                    <td class="text-secondary">
                                        {% if term.descriptionKey %}
                                            {{ term.descriptionKey|trans({}, term.descriptionDomain) }}
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if term.hasFilter %}
                                            <a
                                                class="btn btn-sm btn-outline-primary"
                                                href="{{ path(term.filterRoute, term.filterParams) }}"
                                                data-testid="glossary-term-filter"
                                            >
                                                {{ term.actionLabelKey|trans({}, 'allocation') }}
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
