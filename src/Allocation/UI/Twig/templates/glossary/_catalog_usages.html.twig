{# "Stored as" links from a glossary section to the visible catalog variables it defines (#1507). Expects `usages` (list of CatalogGlossaryUsage). #}
{% if usages is not empty %}
    <div class="card-body py-2 small" data-testid="glossary-catalog-usages">
        <span class="text-secondary me-1">{{ 'catalog.glossary.stored_as'|trans({}, 'allocation') }}</span>
        {% for usage in usages %}
            <a href="{{ path('app_help_data_catalog_show', {objectKey: usage.objectKey}) }}#{{ usage.variable.anchor }}" class="badge bg-azure-lt text-decoration-none me-1" data-testid="glossary-catalog-usage" data-variable-key="{{ usage.variable.key }}"><twig:ux:icon name="tabler:database" class="me-1" width="1em" height="1em" aria-hidden="true" />{{ usage.objectTitleKey|trans({}, usage.objectDomain) }} · {{ usage.variable.labelKey|trans({}, usage.objectDomain) }}</a>
        {% endfor %}
    </div>
{% endif %}
