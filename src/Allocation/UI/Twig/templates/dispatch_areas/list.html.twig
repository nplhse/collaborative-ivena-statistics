{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.dispatch_area.list'|trans({}, 'allocation') }} - {{ parent() }}{% endblock %}

{% block turbo_drive %}data-turbo=true{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include(('@Shared/_includes/subnav_explore.html.twig')) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <twig:PageHeader :title="'title.dispatch_area.list'|trans({}, 'allocation')">
        <twig:block name="breadcrumbs">
            <twig:Breadcrumbs :items="[
                { label: 'link.explore', path: path('app_explore_index') },
                { label: 'title.dispatch_area.list' }
            ]" />
        </twig:block>
        <twig:block name="context">
            {{ include('@Shared/components/data_table/_page_result_count.html.twig') }}
        </twig:block>
        <twig:block name="actions">
            <twig:FilterDrawerTrigger
                drawerId="area-filters"
                :activeCount="activeFilterCount"
                resetUrl="{{ activeFilterCount > 0 ? path('app_explore_dispatch_area_list') : null }}"
                openTestId="area-filters-drawer-trigger"
                clearTestId="area-filters-clear"
            />

            <form
                method="GET"
                action="{{ path('app_explore_dispatch_area_list') }}"
                data-controller="autosubmit"
                data-turbo-frame="area-list"
            >
                <div class="input-icon">
                    <input
                        type="search"
                        name="search"
                        value="{{ app.request.query.get('search') }}"
                        aria-label="{{ 'label.search'|trans({}, 'messages') }}"
                        placeholder="{{ 'label.search'|trans({}, 'messages') }}"
                        class="form-control d-inline-block w-9 me-3"
                        data-action="autosubmit#debouncedSubmit"
                        autofocus
                    >
                    <span class="input-icon-addon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="icon"
                            width="24" height="24" viewBox="0 0 24 24"
                            stroke-width="2" stroke="currentColor"
                            fill="none"
                            stroke-linecap="round" stroke-linejoin="round"
                        >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <circle cx="10" cy="10" r="7" />
                            <line x1="21" y1="21" x2="15" y2="15" />
                        </svg>
                    </span>
                </div>
            </form>
        </twig:block>
    </twig:PageHeader>
{% endblock %}

{% block page_content %}
    <turbo-frame id="area-list" data-turbo-action="advance">
        {% import '@Shared/_macros/filters.html.twig' as activeFilters %}

        {% if activeFilterCount > 0 %}
            {{ activeFilters.area_filter_badges(filters, states) }}
        {% endif %}

        <twig:DataTable
            :paginator="paginator"
            :paginationRoute="pagination_route"
            :sortBy="sortBy"
            :orderBy="orderBy"
            :columns="catalog_list_columns('app_explore_dispatch_area_show', [{
                key: 'state',
                type: 'text',
                label: 'label.state',
                property: 'state',
                sortable: true,
                sortKey: 'state',
                width: 'col-2',
            }])"
        />
</turbo-frame>

    <twig:FilterDrawer
        id="area-filters"
        formId="area-filter-form"
        formAction="{{ path('app_explore_dispatch_area_list') }}"
        resetUrl="{{ path('app_explore_dispatch_area_list') }}"
        testId="area-filters-drawer"
        cancelTestId="area-filters-cancel"
        applyTestId="area-filters-apply"
        resetTestId="area-filters-reset"
        :keepQueryKeys="['search', 'sortBy', 'orderBy']"
    >
                <div class="mb-3">
                    <label class="form-label">{{ 'label.state'|trans({}, 'messages') }}</label>
                    <select name="state" class="form-select">
                        <option value="">{{ 'label.all_states'|trans({}, 'messages') }}</option>
                        {% for state in states %}
                            <option
                                value="{{ state.id }}"
                                {{ filters.state == state.id ? 'selected' }}
                            >
                                {{ state.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
    </twig:FilterDrawer>
{% endblock %}
