{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.indication.show'|trans({}, 'allocation') }}: {{ indication.name }} - {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include('@Shared/_includes/subnav_explore.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                    { label: 'link.explore', path: path('app_explore_index') },
                    { label: 'title.indication.list', path: path('app_explore_indication_list') },
                    { label: indication.name }
                ]"
        />

        <div class="row align-items-center">
            <div class="col-auto">
                <span class="avatar avatar-lg rounded">
                    <twig:ux:icon name="tabler:stethoscope" width="36px" height="36px" />
                </span>
            </div>
            <div class="col">
                <h1 id="indication-name" class="fw-bold">{{ indication.name }}</h1>
                <div class="list-inline list-inline-dots text-muted">
                    <div class="list-inline-item">
                        <span class="badge">{{ indication.code }}</span>
                    </div>
                </div>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <a class="btn btn-outline-secondary" href="{{ path('app_explore_indication_list', {type: 'normalized'}) }}">
                        <twig:ux:icon name="tabler:chevron-left" width="1em" height="1em" />
                        {{ 'label.back_to_list'|trans({}, 'messages') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    <div class="container-xl">
        {% embed '@Allocation/catalog/_detail.html.twig' with {
            coverage: coverage,
            actions: actions,
            description: description,
            qualityWarnings: qualityWarnings,
            normalization: normalization,
            definitionChanges: definitionChanges,
        } %}
            {% block catalog_sidebar_extra %}
                <div class="card mb-3" data-testid="catalog-basic-info">
                    <div class="card-body">
                        <div class="card-title">
                            {{ 'label.basic_info'|trans({}, 'messages') }}
                        </div>
                        <div class="mb-2">
                            <twig:ux:icon name="tabler:calendar-clock" width="1.5em" height="1.5em" />
                            {{ 'label.created_at'|trans({}, 'messages') }} <strong>{{ indication.createdAt|date('d.m.Y H:i') }}</strong>
                        </div>
                        <div class="mb-2">
                            <twig:ux:icon name="tabler:user" width="1.5em" height="1.5em" />
                            {{ 'label.created_by'|trans({}, 'messages') }} <strong>{{ indication.createdBy }}</strong>
                        </div>
                        {% if indication.updatedBy and indication.updatedAt %}
                            <div class="mt-1 mb-2">
                                <twig:ux:icon name="tabler:calendar-clock" width="1.5em" height="1.5em" />
                                {{ 'label.updated_at'|trans({}, 'messages') }} <strong>{{ indication.updatedAt|date('d.m.Y H:i') }}</strong>
                            </div>
                            <div class="mb-2">
                                <twig:ux:icon name="tabler:user" width="1.5em" height="1.5em" />
                                {{ 'label.updated_by'|trans({}, 'messages') }} <strong>{{ indication.updatedBy }}</strong>
                            </div>
                        {% endif %}
                        {% if indication.groups is not empty %}
                            <div class="mt-3">
                                <div class="text-muted mb-1">{{ 'catalog.relation.groups'|trans({}, 'allocation') }}</div>
                                <ul class="list-unstyled mb-0">
                                    {% for group in indication.groups %}
                                        <li>
                                            {% if group.publicId %}
                                                <a href="{{ path('app_explore_indication_group_show', {publicId: group.publicId}) }}">{{ group.name }}</a>
                                            {% else %}
                                                {{ group.name }}
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
