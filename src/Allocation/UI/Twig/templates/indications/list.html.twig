{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.indication.list'|trans({}, 'allocation') }} - {{ parent() }}{% endblock %}

{% block turbo_drive %}data-turbo=true{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include(('@Shared/_includes/subnav_explore.html.twig')) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <twig:PageHeader :title="'title.indication.list'|trans({}, 'allocation')">
        <twig:block name="breadcrumbs">
            <twig:Breadcrumbs :items="[
                { label: 'link.explore', path: path('app_explore_index') },
                { label: 'title.indication.list' }
            ]" />
        </twig:block>
        <twig:block name="context">
            {{ include('@Shared/components/data_table/_page_result_count.html.twig') }}
        </twig:block>
        <twig:block name="actions">
            {{ include('@Allocation/catalog/_list_top_list_action.html.twig', {dimension: 'indication'}) }}
            <a href="{{ path('app_explore_indication_raw_review_worklist') }}" class="btn" target="_top">
                <twig:ux:icon name="tabler:clipboard-check" class="w-3 h-3 me-1" />
                {{ 'btn.indication.review_worklist'|trans({}, 'allocation') }}
            </a>
            <form
                method="GET"
                action="{{ path('app_explore_indication_list') }}"
                data-controller="autosubmit query-state"
                data-query-state-omit-value="{{ ['search', 'type']|json_encode }}"
                data-turbo-frame="indication-list"
            >
                {{ include('@Shared/components/data_table/_query_hidden_fields.html.twig', {omit: ['search', 'type']}) }}
                <div class="input-icon">
                    <input
                        type="search"
                        name="search"
                        value="{{ app.request.query.get('search') }}"
                        aria-label="{{ 'label.search'|trans({}, 'messages') }}"
                        placeholder="{{ 'label.search'|trans({}, 'messages') }}"
                        class="form-control d-inline-block w-9 me-3"
                        data-action="autosubmit#debouncedSubmit"
                        autofocus
                    >
                    <span class="input-icon-addon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="icon"
                            width="24" height="24" viewBox="0 0 24 24"
                            stroke-width="2" stroke="currentColor"
                            fill="none"
                            stroke-linecap="round" stroke-linejoin="round"
                        >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <circle cx="10" cy="10" r="7" />
                            <line x1="21" y1="21" x2="15" y2="15" />
                        </svg>
                    </span>
                </div>

                <input type="hidden" name="type" value="{{ type }}">
            </form>
        </twig:block>
    </twig:PageHeader>
{% endblock %}

{% block page_content %}
    <turbo-frame id="indication-list" data-turbo-action="advance">
        {% if search is not empty %}
            <twig:Alert type="info" :message="'label.searching_for'|trans(({term: search}), 'messages')" />
        {% endif %}

        <twig:DataTable
            :paginator="paginator"
            :paginationRoute="pagination_route"
            :sortBy="sortBy"
            :orderBy="orderBy"
            :tabs="tabs"
            emptyTitle="{{ (search is not empty ? 'empty.filtered.title' : 'empty.catalog.title')|trans({}, 'shared') }}"
            emptyDescription="{{ (search is not empty ? 'empty.filtered.description' : 'empty.catalog.description')|trans({}, 'shared') }}"
            emptyIcon="{{ search is not empty ? 'tabler:filter-off' : 'tabler:inbox' }}"
            :columns="indicationColumns"
            columnVisibilityEnabled
            columnOrderingEnabled
            :visibleColumnKeys="indicationPreferences.visibleColumns"
            :columnOrder="indicationPreferences.columnOrder"
            :preferenceKey="indicationPreferencesPersisted ? indicationPreferenceKey : null"
            :preferenceSaveUrl="indicationPreferencesPersisted ? path('app_data_table_preferences_save') : null"
            :preferenceCsrfToken="indicationPreferencesPersisted ? csrf_token('data_table_preference_' ~ indicationPreferenceKey) : null"
            :preferenceReturnUrl="indicationPreferencesPersisted ? app.request.requestUri : null"
            :cellContext="cellContext"
        >
            <twig:block name="empty_actions">
                {% if search is not empty %}
                    <a class="btn btn-primary" href="{{ path(pagination_route, data_table_view_query()|merge({type: active_type})) }}">{{ 'empty.filtered.cta'|trans({}, 'shared') }}</a>
                {% endif %}
            </twig:block>
        </twig:DataTable>
</turbo-frame>
{% endblock %}
