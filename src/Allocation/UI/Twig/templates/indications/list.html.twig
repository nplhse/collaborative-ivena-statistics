{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.indication.list'|trans({}, 'allocation') }} - {{ parent() }}{% endblock %}

{% block turbo_drive %}data-turbo=true{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include(('@Shared/_includes/subnav_explore.html.twig')) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                    { label: 'link.explore', path: path('app_explore_index') },
                    { label: 'title.indication.list' }
                ]"
        />

        <div class="page-header d-print-none">
            <div class="row align-items-center">
                <div class="col">
                    {% block page_intro %}
                        <h2 class="page-title">
                            {% block page_title %}{{ 'title.indication.list'|trans({}, 'allocation') }}{% endblock %}
                        </h2>
                    {% endblock %}
                    </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        {{ include('@Allocation/catalog/_list_top_list_action.html.twig', {dimension: 'indication'}) }}
                        <a href="{{ path('app_explore_indication_raw_review_worklist') }}" class="btn" target="_top">
                            <twig:ux:icon name="tabler:clipboard-check" class="w-3 h-3 me-1" />
                            {{ 'btn.indication.review_worklist'|trans({}, 'allocation') }}
                        </a>
                        <form
                            method="GET"
                            action="{{ path('app_explore_indication_list') }}"
                            data-controller="autosubmit"
                            data-turbo-frame="indication-list"
                        >
                            <div class="input-icon">
                                <input
                                    type="search"
                                    name="search"
                                    value="{{ app.request.query.get('search') }}"
                                    aria-label="{{ 'label.search'|trans({}, 'messages') }}"
                                    placeholder="{{ 'label.search'|trans({}, 'messages') }}"
                                    class="form-control d-inline-block w-9 me-3"
                                    data-action="autosubmit#debouncedSubmit"
                                    autofocus
                                >
                                <span class="input-icon-addon">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="icon"
                                        width="24" height="24" viewBox="0 0 24 24"
                                        stroke-width="2" stroke="currentColor"
                                        fill="none"
                                        stroke-linecap="round" stroke-linejoin="round"
                                    >
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <circle cx="10" cy="10" r="7" />
                                        <line x1="21" y1="21" x2="15" y2="15" />
                                    </svg>
                                </span>
                            </div>

                            <input type="hidden" name="type" value="{{ type }}">
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    <turbo-frame id="indication-list" data-turbo-action="advance">
        {% if search is not empty %}
            <twig:Alert type="info" :message="'label.searching_for'|trans(({term: search}), 'messages')" />
        {% endif %}

        {% if active_type == 'raw' %}
            {% set indication_columns = [
                {key: 'code', type: 'badge', label: 'label.indication.code', property: 'code', sortable: true, sortKey: 'code', width: 'col-1'},
                {key: 'name', type: 'custom', label: 'label.name', sortable: true, sortKey: 'name', width: 'col-3', cellTemplate: '@Allocation/indications/_cell_raw_name.html.twig'},
                {key: 'reviewStatus', type: 'custom', label: 'label.indication.review_status', width: 'col-2', cellTemplate: '@Allocation/indications/_cell_review_status.html.twig'},
                {key: 'normalized', type: 'custom', label: 'label.normalized', width: 'col-2', cellTemplate: '@Allocation/indications/_cell_normalized_target.html.twig'},
                {key: 'lastChange', type: 'datetime', label: 'label.last_changed_at', property: 'updatedAt', fallbackProperty: 'createdAt', sortable: true, sortKey: 'lastChange', width: 'col-2'},
                {key: 'lastChangedBy', type: 'user', label: 'label.last_changed_by', property: 'updatedBy', fallbackProperty: 'createdBy', width: 'col-2'},
            ] %}
        {% else %}
            {% set indication_columns = [
                {key: 'code', type: 'badge', label: 'label.indication.code', property: 'code', sortable: true, sortKey: 'code', width: 'col-1'},
                {key: 'name', type: 'custom', label: 'label.name', sortable: true, sortKey: 'name', width: 'col-7', cellTemplate: '@Allocation/indications/_cell_normalized_name.html.twig'},
                {key: 'lastChange', type: 'datetime', label: 'label.last_changed_at', property: 'updatedAt', fallbackProperty: 'createdAt', sortable: true, sortKey: 'lastChange', width: 'col-2'},
                {key: 'lastChangedBy', type: 'user', label: 'label.last_changed_by', property: 'updatedBy', fallbackProperty: 'createdBy', width: 'col-2'},
            ] %}
        {% endif %}
        <twig:DataTable
            :paginator="paginator"
            :paginationRoute="pagination_route"
            :sortBy="sortBy"
            :orderBy="orderBy"
            :tabs="tabs"
            :columns="indication_columns"
        />
</turbo-frame>
{% endblock %}
