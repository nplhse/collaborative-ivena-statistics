{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.infection.show'|trans({}, 'allocation') }}: {{ infection.name }} - {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include('@Shared/_includes/subnav_explore.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                    { label: 'link.explore', path: path('app_explore_index') },
                    { label: 'title.infection.list', path: path('app_explore_infection_list') },
                    { label: infection.name }
                ]"
        />

        <div class="row align-items-center">
            <div class="col-auto">
                <span class="avatar avatar-lg rounded">
                    <twig:ux:icon name="tabler:biohazard" width="36px" height="36px" />
                </span>
            </div>
            <div class="col">
                <h1 id="infection-name" class="fw-bold">{{ infection.name }}</h1>
                <div class="list-inline list-inline-dots text-muted">
                    <div class="list-inline-item">
                        {{ 'catalog.type.infection'|trans({}, 'allocation') }}
                    </div>
                </div>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <a class="btn" href="{{ path('app_explore_infection_list') }}">
                        <twig:ux:icon name="tabler:chevron-left" class="me-2" width="1em" height="1em" />
                        {{ 'label.back_to_list'|trans({}, 'messages') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
        {% embed '@Allocation/catalog/_detail.html.twig' with {
            coverage: coverage,
            actions: actions,
        } %}
            {% block catalog_sidebar_extra %}
                <div class="card mb-3" data-testid="catalog-basic-info">
                    <div class="card-body">
                        <div class="card-title">
                            {{ 'label.basic_info'|trans({}, 'messages') }}
                        </div>
                        <div class="mb-2">
                            <twig:ux:icon name="tabler:calendar-clock" width="1.5em" height="1.5em" />
                            {{ 'label.created_at'|trans({}, 'messages') }} <strong>{{ infection.createdAt|date('d.m.Y H:i') }}</strong>
                        </div>
                        <div class="mb-2">
                            <twig:ux:icon name="tabler:user" width="1.5em" height="1.5em" />
                            {{ 'label.created_by'|trans({}, 'messages') }} <strong>{{ infection.createdBy }}</strong>
                        </div>
                        {% if infection.updatedBy and infection.updatedAt %}
                            <div class="mt-1 mb-2">
                                <twig:ux:icon name="tabler:calendar-clock" width="1.5em" height="1.5em" />
                                {{ 'label.updated_at'|trans({}, 'messages') }} <strong>{{ infection.updatedAt|date('d.m.Y H:i') }}</strong>
                            </div>
                            <div class="mb-2">
                                <twig:ux:icon name="tabler:user" width="1.5em" height="1.5em" />
                                {{ 'label.updated_by'|trans({}, 'messages') }} <strong>{{ infection.updatedBy }}</strong>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endblock %}
        {% endembed %}
{% endblock %}
