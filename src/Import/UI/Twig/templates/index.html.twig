{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.import.index'|trans({}, 'import') }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <twig:PageHeader :title="'title.import.index'|trans({}, 'import')">
        <twig:block name="breadcrumbs">
            <twig:Breadcrumbs :items="[
                { label: 'link.import' }
            ]" />
        </twig:block>
        <twig:block name="context">
            {{ include('@Shared/components/data_table/_page_result_count.html.twig') }}
        </twig:block>
        <twig:block name="actions">
            {% if canImport %}
                <a class="btn btn-primary" href="{{ path('app_import_new') }}">{{ 'label.import.new'|trans({}, 'import') }}</a>
            {% endif %}
            <twig:FilterDrawerTrigger
                drawerId="import-filters"
                :activeCount="activeFilterCount"
                resetUrl="{{ activeFilterCount > 0 ? path('app_import_index', data_table_view_query()|merge(search is not empty ? {search: search} : {})) : null }}"
                openTestId="import-filters-drawer-trigger"
                clearTestId="import-filters-clear"
                keepViewState
            />

            <form
                method="GET"
                action="{{ path('app_import_index') }}"
                data-controller="autosubmit query-state"
                data-query-state-omit-value="{{ ['search']|json_encode }}"
                data-turbo-frame="import-list"
            >
                {{ include('@Shared/components/data_table/_query_hidden_fields.html.twig', {omit: ['search']}) }}
                <div class="input-icon">
                    <input
                        type="search"
                        name="search"
                        value="{{ app.request.query.get('search') }}"
                        aria-label="{{ 'label.search'|trans({}, 'messages') }}"
                        placeholder="{{ 'label.search'|trans({}, 'messages') }}"
                        class="form-control d-inline-block w-9 me-3"
                        data-action="autosubmit#debouncedSubmit"
                        autofocus
                    >
                    <span class="input-icon-addon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="icon"
                            width="24" height="24" viewBox="0 0 24 24"
                            stroke-width="2" stroke="currentColor"
                            fill="none"
                            stroke-linecap="round" stroke-linejoin="round"
                        >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <circle cx="10" cy="10" r="7" />
                            <line x1="21" y1="21" x2="15" y2="15" />
                        </svg>
                    </span>
                </div>
            </form>
        </twig:block>
    </twig:PageHeader>
{% endblock %}

{% block page_content %}
    <turbo-frame id="import-list" data-turbo-action="advance">
        {% import '@Shared/_macros/filters.html.twig' as activeFilters %}

        {% if activeFilterCount > 0 %}
            {{ activeFilters.import_filter_badges(filters, hospitals, owners) }}
        {% endif %}

        {% if batch %}
            {% if batchProgress %}
                {% set batchMessage = (batchProgress.finished ? 'import.batch.progress.finished' : 'import.batch.progress.running')|trans({
                    total: batchProgress.total,
                    succeeded: batchProgress.succeeded,
                    failed: batchProgress.failed,
                    superseded: batchProgress.superseded,
                    open: batchProgress.open,
                }, 'import') %}
                {% set batchType = batchProgress.finished ? (batchProgress.failed > 0 ? 'warning' : 'success') : 'info' %}
            {% else %}
                {% set batchMessage = 'import.batch.filtered'|trans({}, 'import') %}
                {% set batchType = 'info' %}
            {% endif %}
            <twig:Alert :type="batchType" :message="batchMessage" icon="tabler:refresh" data-testid="import-batch-progress">
                <twig:block name="actions">
                    <a class="btn btn-sm" href="{{ path('app_import_index', data_table_view_query()) }}" target="_top" data-testid="import-batch-clear">{{ 'import.batch.clear'|trans({}, 'import') }}</a>
                </twig:block>
            </twig:Alert>
        {% endif %}

        {% set listIsFiltered = activeFilterCount > 0 %}
        <twig:DataTable
            :paginator="paginator"
            :paginationRoute="pagination_route"
            :sortBy="sortBy"
            :orderBy="orderBy"
            emptyTitle="{{ (listIsFiltered ? 'empty.filtered.title' : (canImport ? 'empty.import.initial.title' : 'empty.import.no_permission.title'))|trans({}, listIsFiltered ? 'shared' : 'import') }}"
            emptyDescription="{{ (listIsFiltered ? 'empty.filtered.description' : (canImport ? 'empty.import.initial.description' : 'empty.import.no_permission.description'))|trans({}, listIsFiltered ? 'shared' : 'import') }}"
            emptyIcon="{{ listIsFiltered ? 'tabler:filter-off' : 'tabler:database-import' }}"
            :bulkActions="bulkActions"
            :bulkFormAction="path('app_import_bulk')"
            :bulkCsrfToken="csrf_token(constant('App\\Import\\UI\\Http\\Controller\\BulkImportActionController::CSRF_TOKEN'))"
            :bulkSelectableIds="bulkSelectableIds"
            bulkId="import-bulk"
            mobileLayout="cards"
            mobilePrimaryColumn="name"
            mobileBreakpoint="lg"
            :columns="importColumns"
            columnVisibilityEnabled
            columnOrderingEnabled
            :visibleColumnKeys="importPreferences.visibleColumns"
            :columnOrder="importPreferences.columnOrder"
            :preferenceKey="importPreferenceKey"
            :preferenceSaveUrl="path('app_data_table_preferences_save')"
            :preferenceCsrfToken="csrf_token('data_table_preference_' ~ importPreferenceKey)"
            :preferenceReturnUrl="app.request.requestUri"
        >
            <twig:block name="empty_actions">
                {% if listIsFiltered %}
                    <a class="btn btn-primary" href="{{ path('app_import_index', data_table_view_query()) }}">{{ 'empty.filtered.cta'|trans({}, 'shared') }}</a>
                {% elseif canImport %}
                    <a class="btn btn-primary" href="{{ path('app_import_new') }}" target="_top">{{ 'empty.import.initial.cta'|trans({}, 'import') }}</a>
                {% else %}
                    <a class="btn btn-outline-secondary" href="{{ path('app_default') }}" target="_top">{{ 'empty.onboarding.cta'|trans({}, 'shared') }}</a>
                {% endif %}
            </twig:block>
        </twig:DataTable>
</turbo-frame>

    <twig:FilterDrawer
        id="import-filters"
        formId="import-filter-form"
        formAction="{{ path('app_import_index') }}"
        resetUrl="{{ path('app_import_index', data_table_view_query()|merge(search is not empty ? {search: search} : {})) }}"
        testId="import-filters-drawer"
        cancelTestId="import-filters-cancel"
        applyTestId="import-filters-apply"
        resetTestId="import-filters-reset"
        :keepQueryKeys="['search']"
        keepViewState
    >
                <div class="mb-3">
                    <label class="form-label" for="import-filter-hospital">{{ 'label.hospital'|trans({}, 'messages') }}</label>
                    <select name="hospitalId" id="import-filter-hospital" class="form-select">
                        <option value="">{{ 'label.import.filter.all_hospitals'|trans({}, 'import') }}</option>
                        {% for hospital in hospitals %}
                            <option
                                value="{{ hospital.id }}"
                                {{ filters.hospitalId == hospital.id ? 'selected' }}
                            >
                                {{ hospital.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="import-filter-owner">{{ 'label.import.filter.owner'|trans({}, 'import') }}</label>
                    <select name="ownerId" id="import-filter-owner" class="form-select">
                        <option value="">{{ 'label.import.filter.all_owners'|trans({}, 'import') }}</option>
                        {% for owner in owners %}
                            <option
                                value="{{ owner.id }}"
                                {{ filters.ownerId == owner.id ? 'selected' }}
                            >
                                {{ owner.username }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="import-filter-status">{{ 'label.status'|trans({}, 'messages') }}</label>
                    <select name="status" id="import-filter-status" class="form-select">
                        <option value="">{{ 'label.import.filter.all_statuses'|trans({}, 'import') }}</option>
                        {% for status in statuses %}
                            <option
                                value="{{ status.value }}"
                                {{ filters.status == status.value ? 'selected' }}
                            >
                                {{ ('import.status.label.' ~ status.value|lower)|trans({}, 'import') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="import-filter-created-from">{{ 'label.import.filter.created_from'|trans({}, 'import') }}</label>
                    <input
                        type="date"
                        name="createdFrom"
                        id="import-filter-created-from"
                        class="form-control"
                        value="{{ filters.createdFrom }}"
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label" for="import-filter-created-until">{{ 'label.import.filter.created_until'|trans({}, 'import') }}</label>
                    <input
                        type="date"
                        name="createdUntil"
                        id="import-filter-created-until"
                        class="form-control"
                        value="{{ filters.createdUntil }}"
                    >
                </div>
    </twig:FilterDrawer>
{% endblock %}
