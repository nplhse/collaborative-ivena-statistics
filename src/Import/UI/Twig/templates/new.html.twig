{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.import.new'|trans({}, 'import') }} - {{ parent() }}{% endblock %}

{% block page_header %}
        <div class="container-xl">
            <twig:Breadcrumbs
                :items="[
                    { label: 'title.import.index', path: path('app_import_index') },
                    { label: 'title.import.new' }
                ]"
            />

            <div class="page-header d-print-none">
                <div class="row align-items-center">
                    <div class="col">
                        {% block page_intro %}
                            <h2 class="page-title">
                                {% block page_title %}{{ 'title.import.new'|trans({}, 'import') }}{% endblock %}
                            </h2>
                        {% endblock %}
                    </div>
                    <div class="col-auto ms-auto">
                        <twig:Content:HelpLink key="import.status" />
                    </div>
                </div>
            </div>
        </div>
{% endblock %}

{% block page_content %}
    <div class="page-body">
        <div class="container-xl">
            <twig:Card>
                {# Option values of the types whose extra fields (`import.type_extension`) are shown. #}
                {% set extension_type_values = [] %}
                {% if form.type is defined %}
                    {% for choice in form.type.vars.choices %}
                        {% if choice.data.value in extension_types|default([]) %}
                            {% set extension_type_values = extension_type_values|merge([choice.value]) %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
                {# Background upload of the file (#977): `import-upload` posts the file on selection, the form sends the token. #}
                {{ form_start(form, {attr: {
                    enctype: 'multipart/form-data',
                    'data-turbo': 'false',
                    'data-controller': 'import-type-fields import-upload',
                    'data-import-type-fields-types-value': extension_type_values|json_encode,
                    'data-import-upload-url-value': path('app_import_upload'),
                    'data-import-upload-discard-url-value': path('app_import_upload_discard', {token: '00000000000000000000000000000000'})|replace({'00000000000000000000000000000000': '__TOKEN__'}),
                    'data-import-upload-csrf-value': csrf_token(upload_csrf_token_id),
                    'data-import-upload-pending-name-value': pending_upload ? pending_upload.originalName : '',
                    'data-import-upload-messages-value': {
                        uploading: 'label.import.upload.uploading'|trans({percent: '{percent}'}, 'import'),
                        uploaded: 'label.import.upload.uploaded'|trans({}, 'import'),
                        kept: 'label.import.upload.kept'|trans({}, 'import'),
                        waiting: 'label.import.upload.waiting'|trans({}, 'import'),
                        failed: 'label.import.upload.failed'|trans({}, 'import'),
                        retry: 'label.import.upload.retry'|trans({}, 'import'),
                        remove: 'label.import.upload.remove'|trans({}, 'import'),
                    }|json_encode,
                    'data-action': 'submit->import-upload#submit',
                }}) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.hospital, {attr: {
                        'data-import-type-fields-target': 'hospital',
                        'data-action': 'change->import-type-fields#filterTypes',
                    }}) }}
                    {% if form.type is defined %}
                        {{ form_row(form.type, {attr: {
                            'data-import-type-fields-target': 'type',
                            'data-action': 'change->import-type-fields#toggle',
                        }}) }}
                    {% endif %}
                    {% if extension_fields|default([]) is not empty %}
                        <fieldset class="form-fieldset" data-test="import-type-extension-fields" data-import-type-fields-target="section">
                            <div class="form-label text-secondary">{{ 'label.import.encounter.fields'|trans({}, 'import') }}</div>
                            {% for name in extension_fields %}
                                {{ form_row(attribute(form, name)) }}
                            {% endfor %}
                        </fieldset>
                    {% endif %}
                    <div class="mb-3" data-test="import-file">
                        {{ form_label(form.file) }}
                        <div class="import-dropzone"
                             data-import-upload-target="zone"
                             data-action="dragover->import-upload#dragOver dragleave->import-upload#dragLeave drop->import-upload#drop click->import-upload#browse">
                            <twig:ux:icon name="tabler:file-import" class="import-dropzone-icon text-secondary" />
                            <div class="text-secondary mb-3">{{ 'label.import.upload.dropzone'|trans({}, 'import') }}</div>
                            {{ form_widget(form.file, {attr: {
                                'data-import-upload-target': 'input',
                                'data-action': 'change->import-upload#select',
                            }}) }}
                            <div class="import-upload-status" data-import-upload-target="status" data-test="import-upload-status" role="status" aria-live="polite" hidden></div>
                        </div>
                        {{ form_errors(form.file) }}
                        {{ form_help(form.file) }}
                    </div>
                    {{ form_widget(form.uploadToken, {attr: {'data-import-upload-target': 'token'}}) }}
                    {# Import options (#1352): only those the user may use here; no options, no section. #}
                    {% set import_options = form.vars.import_options|default([]) %}
                    {% if import_options is not empty %}
                        {% set options_open = false %}
                        {% for name in import_options %}
                            {% set field = attribute(form, name) %}
                            {% if field.vars.data or field.vars.errors|length > 0 %}
                                {% set options_open = true %}
                            {% endif %}
                        {% endfor %}
                        <div class="mb-3" data-test="import-options">
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 text-secondary text-decoration-none import-options-toggle{{ options_open ? '' : ' collapsed' }}"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#import-options-body"
                                    aria-expanded="{{ options_open ? 'true' : 'false' }}"
                                    aria-controls="import-options-body">
                                {{ 'label.import.options'|trans({}, 'import') }}
                                <twig:ux:icon name="tabler:chevron-down" class="icon ms-1 import-options-chevron" />
                            </button>
                            <div id="import-options-body" class="collapse{{ options_open ? ' show' : '' }}">
                                <div class="pt-2 ps-3 border-start">
                                    {% if app.environment == 'demo' and 'hospitalOverride' in import_options %}
                                        <div class="alert alert-warning" data-test="import-options-demo-warning">
                                            {{ 'label.import.options.demoWarning'|trans({}, 'import') }}
                                        </div>
                                    {% endif %}
                                    {% for name in import_options %}
                                        {{ form_row(attribute(form, name)) }}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    {# Upload authority (#1565): shown for a selected hospital that still needs it; without JS always. #}
                    {% if form.uploadAuthority is defined %}
                        <div data-import-type-fields-target="authority" data-test="import-upload-authority">
                            {{ form_row(form.uploadAuthority) }}
                        </div>
                    {% endif %}
                    {{ form_row(form.submit, {attr: {'data-import-upload-target': 'submit'}}) }}
                {{ form_end(form) }}
            </twig:Card>
        </div>
    </div>

{% endblock %}
