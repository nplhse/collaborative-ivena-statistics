{#- Numbers follow the recipient's locale: the mailer renders with it (TemplatedEmail::locale()).
    halfup keeps the rounding of number_format(); NumberFormatter would round half-even. -#}
{%- set oneDigit = {fraction_digit: 1, rounding_mode: 'halfup'} -%}
{%- set momShown = content.allocationMomPercent is not null ? content.allocationMomPercent|round(1) : null -%}
{%- set physicianDelta = content.withPhysicianBaselineDeltaPp is not null ? content.withPhysicianBaselineDeltaPp|round(1) : null -%}
{%- set transportDelta = content.meanTransportBaselineDeltaMinutes is not null ? content.meanTransportBaselineDeltaMinutes|round(1) : null -%}
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;margin-top:16px;">
    <tr>
        <td align="center" style="width:50%;padding:8px;vertical-align:top;">
            <div style="font-size:24px;font-weight:600;color:#232b42;">{{ content.allocationCount|format_number }}</div>
            {# More allocations than the previous month is favourable; no change and an undefined change (previous month 0) are neutral. #}
            {% if momShown is null %}
                <div style="font-size:12px;color:#667382;" data-mom="unavailable">—</div>
            {% elseif momShown == 0 %}
                <div style="font-size:12px;color:#667382;" data-mom="flat">0%</div>
            {% else %}
                <div style="font-size:12px;color:{{ momShown > 0 ? '#2fb344' : '#d63939' }};" data-mom="{{ momShown > 0 ? 'up' : 'down' }}">
                    {{ momShown > 0 ? '▲' : '▼' }} {{ momShown|abs|format_number({max_fraction_digit: 1, rounding_mode: 'halfup'}) }}%
                </div>
            {% endif %}
            <div style="color:#667382;font-size:12px;margin-top:4px;">{{ 'monthly_reminder.kpi.allocations'|trans({}, 'engagement') }}</div>
        </td>
        <td align="center" style="width:50%;padding:8px;vertical-align:top;">
            <div style="font-size:16px;font-weight:600;color:{{ content.lastImportStale ? '#d63939' : '#232b42' }};">{{ content.lastImportLabel }}</div>
            <div style="color:#667382;font-size:12px;margin-top:4px;">{{ 'monthly_reminder.kpi.last_import.label'|trans({}, 'engagement') }}</div>
        </td>
    </tr>
    <tr>
        <td align="center" style="width:50%;padding:8px;vertical-align:top;">
            <div style="font-size:24px;font-weight:600;color:#232b42;">{{ content.withPhysicianPercent|format_number(oneDigit) }}%</div>
            {% if physicianDelta is not null and content.baselinePeriodLabel %}
                <div style="font-size:12px;color:#667382;">{{ 'monthly_reminder.kpi.physician_baseline_delta'|trans(({
                    delta: (physicianDelta > 0 ? '+' : '') ~ (physicianDelta == 0 ? 0 : physicianDelta)|format_number(oneDigit) ~ ' ' ~ 'monthly_reminder.unit.percentage_points'|trans({}, 'engagement'),
                    baseline: content.baselinePeriodLabel,
                }), 'engagement') }}</div>
            {% endif %}
            <div style="color:#667382;font-size:12px;margin-top:4px;">{{ 'monthly_reminder.kpi.physician'|trans({}, 'engagement') }}</div>
        </td>
        <td align="center" style="width:50%;padding:8px;vertical-align:top;">
            <div style="font-size:24px;font-weight:600;color:#232b42;">{{ content.meanTransportMinutes|format_number(oneDigit) }} min</div>
            {% if transportDelta is not null and content.baselinePeriodLabel %}
                <div style="font-size:12px;color:#667382;">{{ 'monthly_reminder.kpi.transport_baseline_delta'|trans(({
                    delta: (transportDelta > 0 ? '+' : '') ~ (transportDelta == 0 ? 0 : transportDelta)|format_number(oneDigit),
                    baseline: content.baselinePeriodLabel,
                }), 'engagement') }}</div>
            {% endif %}
            <div style="color:#667382;font-size:12px;margin-top:4px;">{{ 'monthly_reminder.kpi.transport'|trans({}, 'engagement') }}</div>
        </td>
    </tr>
</table>
