{%- set sharePercent = content.closedDepartmentSharePercent -%}
{%- set shareDisplay = sharePercent is not null ? sharePercent|number_format(1, ',', '.') ~ '%' : '—' -%}
{%- set barShare = sharePercent is not null and sharePercent > 0 ? max(sharePercent, 2) : 0 -%}
{%- if barShare > 100 -%}
    {%- set barShare = 100 -%}
{%- endif -%}
{%- set barShareRounded = barShare|round -%}
{%- set barRestRounded = 100 - barShareRounded -%}
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin-top:16px;border-collapse:collapse;background:#f6f7f9;border:1px solid {{ border }};border-radius:4px;">
    <tr>
        <td style="padding:12px 16px;" data-testid="monthly-reminder-closed-department">
            <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;">
                <tr>
                    <td style="font-weight:600;color:{{ fgHeading }};font-size:13px;">{{ 'monthly_reminder.closed_department.title'|trans({}, 'engagement') }}</td>
                    <td align="right" style="font-weight:600;color:{{ fgHeading }};font-size:16px;white-space:nowrap;padding-left:12px;">{{ shareDisplay }}</td>
                </tr>
            </table>
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="width:100%;height:8px;margin-top:8px;border-collapse:collapse;">
                <tr>
                    {% if barShareRounded > 0 %}
                        <td width="{{ barShareRounded }}%" style="width:{{ barShareRounded }}%;background-color:{{ link }};border-radius:{{ barRestRounded <= 0 ? '4px' : '4px 0 0 4px' }};font-size:0;line-height:0;">&nbsp;</td>
                    {% endif %}
                    {% if barRestRounded > 0 %}
                        <td width="{{ barRestRounded }}%" style="width:{{ barRestRounded }}%;background-color:#e9f0f9;border-radius:{{ barShareRounded <= 0 ? '4px' : '0 4px 4px 0' }};font-size:0;line-height:0;">&nbsp;</td>
                    {% endif %}
                </tr>
            </table>
            {% if content.closedDepartmentCount > 0 %}
                <p style="color:{{ muted }};margin:8px 0 0;font-size:13px;">
                    {{ 'monthly_reminder.closed_department.body'|trans(({
                        count: content.closedDepartmentCount|number_format(0, ',', '.'),
                    }), 'engagement') }}
                    {% if content.closedDepartmentMomPercent is not null %}
                        &nbsp;<span style="color:{{ content.closedDepartmentMomPercent > 0 ? '#d63939' : (content.closedDepartmentMomPercent < 0 ? '#2fb344' : muted) }};">{{ content.closedDepartmentMomPercent >= 0 ? '+' : '' }}{{ content.closedDepartmentMomPercent|number_format(1, ',', '.') }}%</span>
                        {{ 'monthly_reminder.closed_department.mom'|trans({}, 'engagement') }}
                    {% endif %}
                </p>
            {% else %}
                <p style="color:{{ muted }};margin:8px 0 0;font-size:13px;">{{ 'monthly_reminder.closed_department.empty'|trans({}, 'engagement') }}</p>
            {% endif %}
            <a href="{{ content.monthlyReportUrl }}" style="display:inline-block;margin-top:8px;color:{{ link }};text-decoration:none;font-size:13px;">{{ 'monthly_reminder.closed_department.link'|trans({}, 'engagement') }}</a>
        </td>
    </tr>
</table>
