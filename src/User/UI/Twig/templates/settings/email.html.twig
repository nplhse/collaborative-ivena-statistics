{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.settings.change_email'|trans({}, 'user') }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                { label: 'title.settings', path: path('app_settings_index') },
                { label: 'title.settings.change_email' },
            ]"
        />
        <div class="page-header d-print-none">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ 'title.settings.change_email'|trans({}, 'user') }}</h2>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_body %}
    <div class="page-body">
        <div class="container-xl">
            <div class="card">
                <div class="row g-0">
                    {{ include('@User/settings/_sidebar.html.twig', {active: 'email'}) }}
                    <div class="col-12 col-md-9 d-flex flex-column">
                        {{ form_start(emailForm, {attr: {class: 'd-flex flex-column flex-grow-1'}}) }}
                        <div class="card-header">
                            <h3 class="card-title">{{ 'title.settings.change_email'|trans({}, 'user') }}</h3>
                        </div>
                        <div class="card-body flex-grow-1">
                            {{ form_row(emailForm.email) }}
                        </div>
                        <div class="card-footer d-flex justify-content-end gap-2">
                            <a class="btn btn-link" href="{{ path('app_settings_index') }}">{{ 'action.cancel'|trans({}, 'messages') }}</a>
                            <button class="btn btn-primary">{{ 'label.settings.save_email'|trans({}, 'user') }}</button>
                        </div>
                        {{ form_end(emailForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
