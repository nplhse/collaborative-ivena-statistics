{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.settings.two_factor_backup_codes'|trans({}, 'user') }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                { label: 'title.settings', path: path('app_settings_index') },
                { label: 'title.settings.two_factor', path: path('app_settings_two_factor') },
                { label: 'title.settings.two_factor_backup_codes' },
            ]"
        />
        <div class="page-header d-print-none">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ 'title.settings.two_factor_backup_codes'|trans({}, 'user') }}</h2>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_body %}
    <div class="page-body">
        <div class="container-xl">
            <div class="card">
                <div class="row g-0">
                    {{ include('@User/settings/_sidebar.html.twig', {active: 'two_factor'}) }}
                    <div class="col-12 col-md-9 d-flex flex-column">
                        <div class="card-header">
                            <h3 class="card-title">{{ 'title.settings.two_factor_backup_codes'|trans({}, 'user') }}</h3>
                        </div>
                        <div class="card-body flex-grow-1" data-controller="copy-to-clipboard">
                            <twig:Alert type="warning">{{ 'text.settings.two_factor.backup_codes_once'|trans({}, 'user') }}</twig:Alert>
                            {# Two columns of five, read top to bottom; copied as one code per line in that order. #}
                            <div class="row g-0 font-monospace fs-3 mb-3" style="max-width: 24rem" data-test="two-factor-backup-codes" data-copy-to-clipboard-target="source">
                                {% for column in codes|batch(5) %}
                                    <ul class="col-6 list-unstyled mb-0">
                                        {% for code in column %}
                                            <li class="py-1">{{ code }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endfor %}
                            </div>
                            <button type="button" class="btn btn-outline-secondary" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-target="button" data-test="two-factor-copy-codes">
                                <span data-copy-to-clipboard-target="defaultIcon"><twig:ux:icon name="tabler:copy" class="icon" aria-hidden="true" /></span>
                                <span class="d-none" data-copy-to-clipboard-target="successIcon"><twig:ux:icon name="tabler:check" class="icon" aria-hidden="true" /></span>
                                {{ 'label.settings.two_factor_copy_codes'|trans({}, 'user') }}
                            </button>
                        </div>
                        <div class="card-footer d-flex justify-content-end">
                            <a class="btn btn-primary" href="{{ path('app_settings_two_factor') }}">{{ 'label.settings.two_factor_codes_saved'|trans({}, 'user') }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
