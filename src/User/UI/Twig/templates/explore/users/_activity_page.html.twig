<turbo-frame id="{{ frameId }}">
    {{ include('@User/explore/users/_activity_items.html.twig', {activities: page.items}) }}
    {% if page.hasMore and page.nextCursor and page.nextFrameId %}
        {{ include('@User/explore/users/_activity_next_frame.html.twig', {
            profilePublicId: profilePublicId,
            nextCursor: page.nextCursor,
            frameId: page.nextFrameId,
        }) }}
    {% endif %}
</turbo-frame>
