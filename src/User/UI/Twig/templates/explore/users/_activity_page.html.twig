<turbo-frame id="{{ frameId }}">
    {{ include('@Content/dashboard/_activity_items.html.twig', {
        activities: page.items,
        previews: previews|default({}),
        activity_item_testid: 'profile-activity-item',
        show_reactions: true,
    }) }}
    {% if page.hasMore and page.nextCursor and page.nextFrameId %}
        {{ include('@User/explore/users/_activity_next_frame.html.twig', {
            profileUsername: profileUsername,
            nextCursor: page.nextCursor,
            frameId: page.nextFrameId,
        }) }}
    {% endif %}
</turbo-frame>
