{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.user.list'|trans({}, 'user') }} - {{ parent() }}{% endblock %}

{% block turbo_drive %}data-turbo=true{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include('@Shared/_includes/subnav_explore.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs
            :items="[
                    { label: 'link.explore', path: path('app_explore_index') },
                    { label: 'link.users' }
                ]"
        />

        <div class="page-header d-print-none">
            <div class="row align-items-center">
                <div class="col">
                    {% block page_intro %}
                        <h2 class="page-title">
                            {% block page_title %}{{ 'title.user.list'|trans({}, 'user') }}{% endblock %}
                        </h2>
                        {{ include('@Shared/components/data_table/_page_result_count.html.twig') }}
                    {% endblock %}
                </div>
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <twig:FilterDrawerTrigger
                            drawerId="user-filters"
                            :activeCount="activeFilterCount"
                            resetUrl="{{ activeFilterCount > 0 ? path('app_explore_user_list', {search: search, sortBy: sortBy, orderBy: orderBy}) : null }}"
                            openTestId="user-directory-filters-toggle"
                            clearTestId="user-directory-filters-reset"
                            countTestId="user-directory-active-filter-count"
                        />

                        <form
                            method="GET"
                            action="{{ path('app_explore_user_list') }}"
                            data-controller="autosubmit"
                            data-turbo-frame="user-list"
                            data-testid="user-directory-search"
                        >
                            <input type="hidden" name="sortBy" value="{{ sortBy }}">
                            <input type="hidden" name="orderBy" value="{{ orderBy }}">
                            {% if filters.hospitalId %}
                                <input type="hidden" name="hospitalId" value="{{ filters.hospitalId }}">
                            {% endif %}
                            {% if filters.wantsParticipant %}
                                <input type="hidden" name="participant" value="1">
                            {% endif %}
                            {% if filters.wantsBoardMember %}
                                <input type="hidden" name="boardMember" value="1">
                            {% endif %}
                            <div class="input-icon">
                                <input
                                    type="search"
                                    name="search"
                                    value="{{ app.request.query.get('search') }}"
                                    aria-label="{{ 'label.user.search'|trans({}, 'user') }}"
                                    placeholder="{{ 'label.user.search'|trans({}, 'user') }}"
                                    class="form-control d-inline-block w-9 me-3"
                                    data-action="autosubmit#debouncedSubmit"
                                    autofocus
                                >
                                <span class="input-icon-addon">
                                    <twig:ux:icon name="tabler:search" width="1em" height="1em" />
                                </span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    <turbo-frame id="user-list" data-turbo-action="advance" data-testid="user-directory-list">
        {% import '@Shared/_macros/filters.html.twig' as activeFilters %}

        {% if activeFilterCount > 0 %}
            {{ activeFilters.user_filter_badges(filters, hospitalChoices, 'user-directory-active-filters') }}
        {% elseif search is not empty %}
            <twig:Alert type="info" :message="'label.searching_for'|trans(({term: search}), 'allocation')" />
        {% endif %}

        <twig:DataTable
            :paginator="paginator"
            :rows="items"
            :paginationRoute="pagination_route"
            :sortBy="sortBy"
            :orderBy="orderBy"
            rowTestId="user-directory-row"
            emptyTitle="{{ 'label.user.empty.list'|trans({}, 'user') }}"
            emptyIcon="tabler:users"
            :columns="[
                { key: 'username', type: 'link', label: 'label.user.username', labelDomain: 'user', property: 'username', sortable: true, sortKey: 'username', width: 'col-3', route: 'app_explore_user_show', routeParams: {publicId: 'publicId'} },
                { key: 'roles', type: 'custom', label: 'label.user.roles', labelDomain: 'user', width: 'col-3', cellTemplate: '@User/explore/users/_cell_roles.html.twig' },
                { key: 'hospitals', type: 'custom', label: 'label.user.hospitals', labelDomain: 'user', width: 'col-4', cellTemplate: '@User/explore/users/_cell_hospitals.html.twig' },
                { key: 'createdAt', type: 'datetime', label: 'label.created_at', property: 'createdAt', sortable: true, sortKey: 'createdAt', width: 'col-2', format: 'd.m.Y' },
            ]"
        />
</turbo-frame>

    <twig:FilterDrawer
        id="user-filters"
        formId="user-filter-form"
        formAction="{{ path('app_explore_user_list') }}"
        resetUrl="{{ path('app_explore_user_list', {search: search, sortBy: sortBy, orderBy: orderBy}) }}"
        testId="user-directory-filters"
        formTestId="user-directory-filter-form"
        cancelTestId="user-directory-filters-cancel"
        applyTestId="user-directory-filters-apply"
        resetTestId="user-directory-filters-reset-drawer"
        :keepQueryKeys="['search', 'sortBy', 'orderBy']"
    >
                <div class="mb-3">
                    <label class="form-label" for="user-filter-hospital">{{ 'label.user.filter.hospital'|trans({}, 'user') }}</label>
                    <select name="hospitalId" id="user-filter-hospital" class="form-select">
                        <option value="">{{ 'label.user.filter.hospital_all'|trans({}, 'user') }}</option>
                        {% for hospital in hospitalChoices %}
                            <option
                                value="{{ hospital.id }}"
                                {{ filters.hospitalId == hospital.id ? 'selected' }}
                            >
                                {{ hospital.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-check">
                        <input
                            type="checkbox"
                            class="form-check-input"
                            name="participant"
                            value="1"
                            {{ filters.wantsParticipant ? 'checked' }}
                        >
                        <span class="form-check-label">{{ 'label.user.badge.participant'|trans({}, 'user') }}</span>
                    </label>
                </div>

                <div class="mb-3">
                    <label class="form-check">
                        <input
                            type="checkbox"
                            class="form-check-input"
                            name="boardMember"
                            value="1"
                            {{ filters.wantsBoardMember ? 'checked' }}
                        >
                        <span class="form-check-label">{{ 'label.user.badge.board_member'|trans({}, 'user') }}</span>
                    </label>
                </div>
    </twig:FilterDrawer>
{% endblock %}
