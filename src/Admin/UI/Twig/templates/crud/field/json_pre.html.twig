{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{% set json = field.formattedValue %}
{% if json is empty or json == '—' %}
    <span class="text-body-secondary">{{ json|default('—') }}</span>
{% else %}
    {# idle/success classes: the colour classes of the EasyAdmin button (default and success) #}
    <div class="ea-json-pre-wrap" data-controller="copy-to-clipboard" data-copy-to-clipboard-idle-class-value="btn-secondary" data-copy-to-clipboard-success-class-value="btn-success">
        <div class="d-flex justify-content-end mb-2">
            <twig:ea:Button type="button" size="sm" icon="far fa-copy" data-copy-to-clipboard-target="button" data-action="copy-to-clipboard#copy">
                {{ 'label.copy'|trans({}, 'admin') }}
            </twig:ea:Button>
        </div>
        <pre class="ea-json-pre mb-0" data-copy-to-clipboard-target="source">{{ json }}</pre>
    </div>
{% endif %}
