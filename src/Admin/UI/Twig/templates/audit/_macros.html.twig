{% macro action_icon(action) %}
    {%- set icons = {
        create: 'fa-plus',
        update: 'fa-pen',
        delete: 'fa-trash',
        export: 'fa-file-export',
        download: 'fa-download',
        impersonate: 'fa-user-secret',
        impersonate_exit: 'fa-right-from-bracket',
    } -%}
    <i class="fa-solid {{ icons[action] ?? 'fa-circle-dot' }} fa-fw" aria-hidden="true"></i>
{%- endmacro %}

{% macro actor(entry) %}
    {%- if entry.actorName is not null -%}
        <a href="{{ path('app_admin_dashboard_audit_timeline', {actor: entry.actorId}) }}">{{ entry.actorName }}</a>
    {%- elseif entry.actorId is not null -%}
        {{ 'audit.timeline.deleted_user'|trans({id: entry.actorId}, 'admin') }}
    {%- else -%}
        <span class="text-secondary">{{ 'audit.timeline.no_actor'|trans({}, 'admin') }}</span>
    {%- endif -%}
{% endmacro %}

{% macro time(at) %}
    <time datetime="{{ at|date('c', 'UTC') }}" class="text-nowrap font-monospace small">{{ at|date('d.m.Y H:i:s', 'Europe/Berlin') }}</time>
{% endmacro %}

{# One entry: time, actor, action on what, intent, changed field names, origin and outcome. No payloads. #}
{% macro entry(entry, show_actor = true) %}
    {% import _self as audit %}
    <div class="ea-audit-entry d-flex flex-wrap align-items-baseline gap-2" data-audit-entry="{{ entry.id }}">
        {{ audit.time(entry.occurredAt) }}
        {% if show_actor %}<span class="ea-audit-actor">{{ audit.actor(entry) }}</span>{% endif %}
        <span class="ea-audit-summary">
            {{ audit.action_icon(entry.action) }}
            <span class="fw-semibold">{{ ('audit.action.' ~ entry.action)|trans({}, 'admin') }}</span>
            <a href="{{ path('app_admin_dashboard_audit_timeline', {entity: entry.entityClass}|merge(entry.entityId is null ? {} : {entityId: entry.entityId})) }}">{{ entry.entityName }}{% if entry.entityId is not null %} #{{ entry.entityId }}{% endif %}</a>
        </span>
        {% if entry.intent is not null %}
            <a class="badge text-bg-light border font-monospace text-decoration-none" href="{{ path('app_admin_dashboard_audit_timeline', {intent: entry.intent}) }}">{{ entry.intent }}</a>
        {% endif %}
        {% if entry.changedFields is not empty %}
            <span class="text-secondary small">
                {{ entry.changedFields|slice(0, 4)|join(', ') }}
                {%- if entry.changedFields|length > 4 %} {{ 'audit.timeline.fields_more'|trans({count: entry.changedFields|length - 4}, 'admin') }}{% endif %}
            </span>
        {% endif %}
        {% if entry.outcome is not null %}
            <span class="badge {{ entry.outcome == 'success' ? 'text-bg-success' : 'text-bg-danger' }}">{{ ('audit.outcome.' ~ entry.outcome)|trans({}, 'admin') }}</span>
        {% endif %}
        <span class="badge text-bg-secondary">{{ ('audit.origin.' ~ entry.origin)|trans({}, 'admin') }}</span>
        <a class="small ms-auto" href="{{ path('app_admin_dashboard_audit_log_detail', {entityId: entry.id}) }}">{{ 'audit.timeline.details'|trans({}, 'admin') }}<span class="visually-hidden"> #{{ entry.id }}</span></a>
    </div>
{% endmacro %}
