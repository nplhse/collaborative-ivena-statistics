{% macro icon(action) -%}
    {{- {
        create: 'tabler:plus',
        update: 'tabler:pencil',
        delete: 'tabler:trash',
        export: 'tabler:database-export',
        download: 'tabler:download',
        impersonate: 'tabler:arrows-exchange',
        impersonate_exit: 'tabler:door-off',
    }[action] ?? 'tabler:circle' -}}
{%- endmacro %}

{# Colour only repeats what the visible category label says. #}
{% macro tone(entry) -%}
    {%- if entry.outcome == 'failed' or entry.action == 'delete' -%}danger
    {%- elseif entry.outcome == 'blocked' -%}warning
    {%- elseif entry.outcome == 'success' -%}success
    {%- else -%}default{%- endif -%}
{%- endmacro %}

{% macro actor_name(entry) -%}
    {%- if entry.actorName is not null -%}{{ entry.actorName }}
    {%- elseif entry.actorId is not null -%}{{ 'audit.timeline.deleted_user'|trans({id: entry.actorId}, 'admin') }}
    {%- else -%}{{ 'audit.timeline.no_actor'|trans({}, 'admin') }}{%- endif -%}
{%- endmacro %}

{# Summary line of one entry. Plain text only: it is the toggle of the expandable item. #}
{% macro summary(entry, show_actor = true) %}
    {% import _self as audit %}
    {% if show_actor %}<span class="ea-audit-actor">{{ audit.actor_name(entry) }}</span>{% endif %}
    <span class="ea-audit-object">{{ entry.entityName }}{% if entry.entityId is not null %} #{{ entry.entityId }}{% endif %}</span>
    {% if entry.intent is not null %}<code class="ea-audit-intent">{{ entry.intent }}</code>{% endif %}
    {% if entry.changedFields is not empty %}
        <span class="ea-audit-fields">
            {{- entry.changedFields|slice(0, 4)|join(', ') -}}
            {%- if entry.changedFields|length > 4 %} {{ 'audit.timeline.fields_more'|trans({count: entry.changedFields|length - 4}, 'admin') }}{% endif -%}
        </span>
    {% endif %}
    {% if entry.outcome is not null %}<span class="badge text-bg-light border">{{ ('audit.outcome.' ~ entry.outcome)|trans({}, 'admin') }}</span>{% endif %}
    <span class="badge text-bg-light border">{{ ('audit.origin.' ~ entry.origin)|trans({}, 'admin') }}</span>
{% endmacro %}

{# One entry as a TimelineItem whose details load on expansion. #}
{% macro item(entry, show_actor = true) %}
    {% import _self as audit %}
    <twig:TimelineItem
        :icon="audit.icon(entry.action)|trim"
        :category="('audit.action.' ~ entry.action)|trans({}, 'admin')"
        :time="entry.occurredAt"
        :tone="audit.tone(entry)|trim"
        :detailsUrl="path('app_admin_dashboard_audit_entry_details', {id: entry.id})"
        :detailsLabel="'audit.entry.show_details'|trans({}, 'admin')"
        :detailsErrorLabel="'audit.entry.details_failed'|trans({}, 'admin')"
        data-audit-entry="{{ entry.id }}"
    >{% import '@Admin/audit/_macros.html.twig' as audit %}{{ audit.summary(entry, show_actor) }}</twig:TimelineItem>
{% endmacro %}

{% macro value(value) %}
    {%- if value.kind == 'null' -%}<span class="text-secondary">–</span>
    {%- elseif value.kind == 'json' -%}<pre class="ea-audit-json mb-0">{{ value.text }}</pre>
    {%- elseif value.kind == 'string' and value.text == '' -%}<span class="text-secondary">{{ 'audit.entry.empty_string'|trans({}, 'admin') }}</span>
    {%- elseif value.kind == 'string' -%}<span class="text-break">{{ value.text }}</span>
    {%- else -%}<code>{{ value.text }}</code>
    {%- endif -%}
    {%- if value.truncated %} <span class="text-secondary small">{{ 'audit.entry.truncated'|trans({}, 'admin') }}</span>{% endif -%}
{% endmacro %}
