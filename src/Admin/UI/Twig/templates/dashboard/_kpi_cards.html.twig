<div class="ea-dashboard-kpi mb-4">
    <div class="row">
        {{ include('@Admin/dashboard/_kpi_card.html.twig', {
            key: 'active_users',
            label: 'kpi.card.active_users'|trans({}, 'admin'),
            icon: 'fas fa-users',
            value: kpi_users.mau,
            is_percent: false,
            detail: 'kpi.card.active_users.detail'|trans({dau: kpi_users.dau, wau: kpi_users.wau}, 'admin'),
            change: kpi_users_change,
            url: kpi_users_url,
        }) }}
        {% for card in kpi_cards.cards %}
            {{ include('@Admin/dashboard/_kpi_card.html.twig', {
                key: card.label.message|replace({'kpi.card.': ''}),
                label: card.label|trans,
                icon: card.icon,
                value: card.value,
                is_percent: card.isPercent,
                detail: card.detail ? card.detail|trans : null,
                change: card.change,
                url: card.detailUrl,
            }) }}
        {% endfor %}
    </div>
</div>
