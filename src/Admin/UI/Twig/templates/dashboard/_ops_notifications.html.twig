{# Events an admin may need to act on (RecentNotificationEvents::INTENTS), shown like the audit timeline (#1137). #}
{% set event_styles = {
    'import.run.failed': {icon: 'tabler:alert-triangle', tone: 'danger'},
    'user.registered': {icon: 'tabler:user-plus', tone: 'success'},
    'hospital.reminder_sent': {icon: 'tabler:mail', tone: 'default'},
} %}

<div class="ea-dashboard-ops-notifications mb-4">
    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
        <h3 class="h5 text-secondary text-uppercase mb-0">{{ 'ops.notifications.title'|trans({}, 'admin') }}</h3>
        <a href="{{ path('app_admin_dashboard_audit_timeline') }}" class="small" data-testid="ops-notifications-show-all">
            {{ 'ops.notifications.show_all'|trans({}, 'admin') }}
        </a>
    </div>
    <div class="card">
        <div class="card-body">
            {% if recent_notifications is empty %}
                <p class="text-secondary text-center py-3 mb-0">{{ 'ops.notifications.empty'|trans({}, 'admin') }}</p>
            {% else %}
                <twig:Timeline :label="'ops.notifications.title'|trans({}, 'admin')">
                    {% for event in recent_notifications %}
                        {% set style = event_styles[event.intent] ?? {icon: 'tabler:circle', tone: 'default'} %}
                        <twig:TimelineItem
                            :icon="style.icon"
                            :tone="style.tone"
                            :category="('ops.notifications.event.' ~ event.intent)|trans({}, 'admin')"
                            :time="event.occurredAt"
                            timeFormat="d.m.Y H:i"
                            data-notification-intent="{{ event.intent }}"
                        >
                            {%- set subject = event.subject ?? ('#' ~ (event.subjectId ?? '?')) -%}
                            <span class="ea-notification-context">
                                {%- if event.intent == 'import.run.failed' -%}
                                    {{ 'ops.notifications.context.import_failed'|trans({
                                        import: subject,
                                        hospital: event.hospital ?? '–',
                                        reason: event.reasonCode
                                            ? ('ops.notifications.reason.' ~ event.reasonCode)|trans({}, 'admin')
                                            : 'ops.notifications.reason.unknown'|trans({}, 'admin'),
                                    }, 'admin') }}
                                {%- elseif event.intent == 'user.registered' -%}
                                    {{ 'ops.notifications.context.user_registered'|trans({user: subject}, 'admin') }}
                                {%- elseif event.intent == 'hospital.reminder_sent' -%}
                                    {{ 'ops.notifications.context.reminder_sent'|trans({
                                        hospital: subject,
                                        period: event.reportingPeriod ? event.reportingPeriod|format_date(pattern: 'MMMM yyyy') : '–',
                                    }, 'admin') }}
                                {%- endif -%}
                            </span>
                            <a href="{{ path('app_admin_dashboard_audit_request', {requestId: event.requestId}) }}"
                               class="ea-notification-link ms-2 text-nowrap small"
                               data-testid="ops-notification-audit-link">
                                {{- 'ops.notifications.open_in_audit'|trans({}, 'admin') -}}
                                {{ ux_icon('tabler:arrow-right', {width: 12, height: 12, class: 'ms-1', 'aria-hidden': 'true'}) }}
                            </a>
                        </twig:TimelineItem>
                    {% endfor %}
                </twig:Timeline>
            {% endif %}
        </div>
    </div>
</div>
