<div class="ea-dashboard-kpi mb-3">
    <div class="card ea-ops-health-banner border-2">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <div class="d-flex align-items-center gap-3">
                    {% set statusIcon = ops_health.status.value == 'healthy' ? 'fas fa-circle-check' : (ops_health.status.value == 'degraded' ? 'fas fa-circle-exclamation' : 'fas fa-circle-xmark') %}
                    {% set statusClass = ops_health.status.value == 'healthy' ? 'success' : (ops_health.status.value == 'degraded' ? 'warning' : 'danger') %}
                    <i class="{{ statusIcon }} fa-2x text-{{ statusClass }}" aria-hidden="true"></i>
                    <div>
                        <div class="h4 mb-0">{{ ('ops.health.status.' ~ ops_health.status.value)|trans({}, 'admin') }}</div>
                        <div class="text-secondary small">{{ 'ops.health.version'|trans({'%version%': ops_health.appVersion}, 'admin') }}</div>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                {% for item in ops_health.items %}
                    {% if item.key == 'storage' %}
                        {{ include('@Admin/dashboard/_ops_health_storage.html.twig') }}
                    {% elseif item.detailUrl %}
                        <a href="{{ item.detailUrl }}" class="text-decoration-none" data-health-check="{{ item.key }}"><twig:ea:Badge color="{{ item.severity }}" variant="solid" radius="full" size="lg" icon="{{ item.icon }}" class="ea-ops-health-badge"><span class="fw-semibold">{{ item.labelKey|trans({}, 'admin') }}:</span> {{ item.value }}</twig:ea:Badge></a>
                    {% else %}
                        <twig:ea:Badge color="{{ item.severity }}" variant="solid" radius="full" size="lg" icon="{{ item.icon }}" class="ea-ops-health-badge" data-health-check="{{ item.key }}"><span class="fw-semibold">{{ item.labelKey|trans({}, 'admin') }}:</span> {{ item.value }}</twig:ea:Badge>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
