<div class="ea-dashboard-ops h-100">
    <div class="card h-100 ea-sign-in-card" data-testid="sign-in-security-card">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-user-lock fa-lg text-secondary" aria-hidden="true"></i>
                    <span class="text-secondary small">{{ 'sign_in_security.card.title'|trans({}, 'admin') }}</span>
                </div>
                <twig:ea:Button htmlElement="a" href="{{ ops_sign_in_url }}" size="sm" icon="fas fa-arrow-right" withTrailingIcon>
                    {{ 'sign_in_security.card.details'|trans({}, 'admin') }}
                </twig:ea:Button>
            </div>

            <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                <span class="ea-kpi-value">{{ ops_sign_in.attempts|format_number }}</span>
                <span class="text-secondary">{{ 'sign_in_security.card.attempts'|trans({days: constant('App\\User\\Application\\LoginFailure\\LoginFailureTrend::DAYS')}, 'admin') }}</span>
            </div>

            {% set peak = ops_sign_in.peak %}
            <div class="ea-sign-in-bars mb-2" role="img" aria-label="{{ 'sign_in_security.card.bars_label'|trans({}, 'admin') }}">
                {% for day in ops_sign_in.days %}
                    <span class="ea-sign-in-bar{{ day.flagged ? ' is-flagged' : '' }}{{ day.attempts is null ? ' is-uncounted' : '' }}"
                          style="height: {{ day.attempts is null ? 0 : (day.attempts / peak * 100)|round }}%;"
                          title="{{ day.date|format_date('medium') }}: {{ day.attempts is null ? 'sign_in_security.not_counted'|trans({}, 'admin') : day.attempts|format_number }}"></span>
                {% endfor %}
            </div>

            <div class="small d-flex flex-wrap gap-3">
                <span class="{{ ops_sign_in.flaggedDays > 0 ? 'text-danger fw-semibold' : 'text-secondary' }}">
                    {{ 'sign_in_security.card.flagged_days'|trans({count: ops_sign_in.flaggedDays}, 'admin') }}
                </span>
                <span class="{{ ops_sign_in.lockedAccounts > 0 ? 'text-warning fw-semibold' : 'text-secondary' }}">
                    {{ 'sign_in_security.card.locked_accounts'|trans({count: ops_sign_in.lockedAccounts}, 'admin') }}
                </span>
            </div>
        </div>
    </div>
</div>
