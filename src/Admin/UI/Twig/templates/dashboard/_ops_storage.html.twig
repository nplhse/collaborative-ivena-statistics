<div class="ea-dashboard-ops mb-4">
    <div class="card ea-storage-card">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-hard-drive fa-lg text-secondary" aria-hidden="true"></i>
                    <span class="text-secondary small">{{ 'storage.card.title'|trans({}, 'storage') }}</span>
                </div>
                <a href="{{ ops_storage_url }}" class="btn btn-sm btn-outline-secondary">
                    {{ 'storage.card.details'|trans({}, 'storage') }}<i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
                </a>
            </div>

            {% if ops_storage is null %}
                <div class="ea-storage-empty text-secondary">
                    <p class="mb-1">{{ 'storage.empty.title'|trans({}, 'storage') }}</p>
                    <p class="small mb-0">{{ 'storage.empty.hint'|trans({}, 'storage') }} <code>bin/console app:storage:analyze --persist</code></p>
                </div>
            {% else %}
                <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-2">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <span class="ea-kpi-value">{{ ops_storage.usedBytes is not null ? ops_storage.usedBytes|format_bytes : '–' }}</span>
                        {% if ops_storage.hasCapacity %}
                            <span class="text-secondary">{{ 'storage.card.of_capacity'|trans({capacity: ops_storage.capacityBytes|format_bytes}, 'storage') }}</span>
                        {% endif %}
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">{{ ops_storage.capacitySource.labelKey|trans({}, 'storage') }}</span>
                    </div>
                    <span class="small d-inline-flex flex-wrap align-items-center gap-1 ea-storage-card__status">
                        {% if ops_storage.remainingBytes is not null %}
                            <span class="{{ ops_storage.isExceeded ? 'text-danger fw-semibold' : 'text-secondary' }}">
                                {% if ops_storage.isExceeded %}
                                    {{ 'storage.card.exceeded_by'|trans({size: (0 - ops_storage.remainingBytes)|format_bytes, percent: ops_storage.usedPercent}, 'storage') }}
                                {% else %}
                                    {{ 'storage.card.remaining'|trans({size: ops_storage.remainingBytes|format_bytes, percent: ops_storage.usedPercent}, 'storage') }}
                                {% endif %}
                            </span>
                            <span class="text-secondary" aria-hidden="true">·</span>
                        {% endif %}
                        {{ include('@Admin/operations/storage/_measured_at.html.twig', {summary: ops_storage}) }}
                    </span>
                </div>
                {{ include('@Admin/operations/storage/_bar.html.twig', {summary: ops_storage}) }}
            {% endif %}
        </div>
    </div>
</div>
