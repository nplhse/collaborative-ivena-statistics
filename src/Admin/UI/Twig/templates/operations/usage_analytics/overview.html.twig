{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'usage_analytics.overview.title'|trans({}, 'admin') }}{% endblock %}

{% block main %}
    {{ include('@Admin/operations/usage_analytics/_privacy_note.html.twig') }}

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card"><div class="card-body">
                <div class="text-secondary small">{{ 'usage_analytics.overview.requests_today'|trans({}, 'admin') }}</div>
                <div class="fs-2 fw-bold">{{ overview.requestsToday|number_format(0, ',', '.') }}</div>
            </div></div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card"><div class="card-body">
                <div class="text-secondary small">{{ 'usage_analytics.overview.requests_7_days'|trans({}, 'admin') }}</div>
                <div class="fs-2 fw-bold">{{ overview.requestsLast7Days|number_format(0, ',', '.') }}</div>
            </div></div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card"><div class="card-body">
                <div class="text-secondary small">{{ 'usage_analytics.overview.active_users'|trans({}, 'admin') }}</div>
                <div class="fs-4 fw-bold">{{ overview.retention.dau|number_format(0, ',', '.') }} / {{ overview.retention.wau|number_format(0, ',', '.') }} / {{ overview.retention.mau|number_format(0, ',', '.') }}</div>
            </div></div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card"><div class="card-body">
                <div class="text-secondary small">{{ 'usage_analytics.overview.sessions_7_days'|trans({}, 'admin') }}</div>
                <div class="fs-2 fw-bold">{{ overview.retention.sessionsLast7Days|number_format(0, ',', '.') }}</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">{{ 'usage_analytics.overview.feature_areas.title'|trans({}, 'admin') }}</div>
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead><tr><th>{{ 'usage_analytics.overview.column.area'|trans({}, 'admin') }}</th><th class="text-end">{{ 'usage_analytics.overview.column.requests'|trans({}, 'admin') }}</th><th class="text-end">{{ 'usage_analytics.overview.column.share'|trans({}, 'admin') }}</th></tr></thead>
                        <tbody>
                            {% for row in overview.featureAreas %}
                                <tr>
                                    <td>{{ row.featureArea }}</td>
                                    <td class="text-end">{{ row.requestCount }}</td>
                                    <td class="text-end">{{ row.sharePercent }}%</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="3" class="text-secondary">{{ 'usage_analytics.overview.empty'|trans({}, 'admin') }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">{{ 'usage_analytics.overview.authentication.title'|trans({}, 'admin') }}</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-6">{{ 'usage_analytics.overview.authentication.authenticated'|trans({}, 'admin') }}</dt>
                        <dd class="col-6">{{ overview.authenticationSplit.authenticated }}</dd>
                        <dt class="col-6">{{ 'usage_analytics.overview.authentication.anonymous'|trans({}, 'admin') }}</dt>
                        <dd class="col-6">{{ overview.authenticationSplit.anonymous }}</dd>
                        <dt class="col-6">{{ 'usage_analytics.overview.requests_30_days'|trans({}, 'admin') }}</dt>
                        <dd class="col-6">{{ overview.requestsLast30Days }}</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-2">
        <div class="card-header">{{ 'usage_analytics.overview.top_routes.title'|trans({}, 'admin') }}</div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead><tr><th>{{ 'usage_analytics.overview.column.route'|trans({}, 'admin') }}</th><th class="text-end">{{ 'usage_analytics.overview.column.requests'|trans({}, 'admin') }}</th></tr></thead>
                <tbody>
                    {% for row in overview.topRoutes %}
                        <tr><td><code>{{ row.routeName }}</code></td><td class="text-end">{{ row.requestCount }}</td></tr>
                    {% else %}
                        <tr><td colspan="2" class="text-secondary">{{ 'usage_analytics.overview.empty'|trans({}, 'admin') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
