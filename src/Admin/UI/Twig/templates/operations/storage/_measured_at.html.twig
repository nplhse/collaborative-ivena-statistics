<span class="text-secondary">{{ 'storage.measured_at'|trans({date: summary.measuredAt|date('d.m.Y H:i', 'Europe/Berlin')}, 'storage') }}</span>
{% if summary.stale %}
    <twig:ea:Badge color="warning" icon="fas fa-clock-rotate-left" class="ms-1" title="{{ 'storage.stale.hint'|trans({hours: summary.maxAgeHours}, 'storage') }}">{{ 'storage.stale.badge'|trans({}, 'storage') }}</twig:ea:Badge>
{% endif %}
