{% set page = entity.instance %}
{% set locales = ['en', 'de'] %}
<table class="table table-sm mb-0">
    <thead>
        <tr>
            <th>Locale</th>
            <th>{{ 'label.status'|trans({}, 'messages') }}</th>
            <th>{{ 'label.title'|trans({}, 'messages') }}</th>
            <th>{{ 'label.path'|trans({}, 'messages') }}</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {% for locale in locales %}
            {% set translation = null %}
            {% for candidate in page.translations %}
                {% if candidate.locale == locale %}
                    {% set translation = candidate %}
                {% endif %}
            {% endfor %}
            <tr>
                <td><code>{{ locale }}</code></td>
                {% if translation %}
                    {% set pathSegment = translation.path|default('')|trim('/') %}
                    <td>
                        {% if translation.status == 'published' %}
                            <twig:ea:Badge color="success">{{ 'label.published'|trans({}, 'admin') }}</twig:ea:Badge>
                        {% else %}
                            <twig:ea:Badge>{{ 'label.draft'|trans({}, 'admin') }}</twig:ea:Badge>
                        {% endif %}
                        {% if translation.hasDraft %}
                            <twig:ea:Badge color="warning">{{ 'page.editor.draft.badge'|trans({}, 'content') }}</twig:ea:Badge>
                        {% endif %}
                    </td>
                    <td>{{ translation.title }}</td>
                    <td>
                        {% if pathSegment != '' %}
                            <code>{{ '/' ~ pathSegment }}</code>
                        {% else %}
                            <span class="text-secondary">—</span>
                        {% endif %}
                    </td>
                    <td class="text-end text-nowrap">
                        {% if translation.status == 'published' and pathSegment != '' %}
                            <twig:ea:Button
                                htmlElement="a"
                                size="sm"
                                href="{{ path('app_page_show', {path: pathSegment}) }}"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                {{ 'admin.page.action.view_public'|trans({}, 'admin') }}
                            </twig:ea:Button>
                        {% endif %}
                        <twig:ea:Button htmlElement="a" color="primary" size="sm" href="{{ ea_url()
                            .setController('App\\Admin\\UI\\Http\\Controller\\Page\\PageTranslationCrudController')
                            .setAction('edit')
                            .setEntityId(translation.id) }}">
                            {{ 'action.edit'|trans({}, 'EasyAdminBundle') }}
                        </twig:ea:Button>
                    </td>
                {% else %}
                    <td><twig:ea:Badge color="warning">{{ 'label.missing'|trans({}, 'content') }}</twig:ea:Badge></td>
                    <td>—</td>
                    <td>—</td>
                    <td class="text-end">
                        <twig:ea:Button htmlElement="a" color="success" size="sm" href="{{ ea_url()
                            .setController('App\\Admin\\UI\\Http\\Controller\\Page\\PageTranslationCrudController')
                            .setAction('new')
                            .unset('entityId')
                            .set('pageId', page.id)
                            .set('locale', locale) }}">
                            {{ 'admin.page.action.add_translation'|trans({}, 'admin') }}
                        </twig:ea:Button>
                    </td>
                {% endif %}
            </tr>
        {% endfor %}
    </tbody>
</table>
