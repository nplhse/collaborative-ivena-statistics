{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block configured_stylesheets %}
    {{ parent() }}
    {% if media_public_url is defined and media_public_url is not empty %}
        <link rel="stylesheet" href="{{ asset('styles/admin/media-detail.css') }}">
    {% endif %}
{% endblock %}

{% block main %}
    {{ parent() }}

    {% if media_public_url is defined and media_public_url is not empty %}
        {% set media = entity.instance %}
        <section class="media-detail-usage">
            <div class="form-fieldset">
                <fieldset>
                    <div class="form-fieldset-header">
                        <div class="form-fieldset-title">
                            <span class="not-collapsible form-fieldset-title-content">
                                {{ 'label.media_usage'|trans({}, 'content') }}
                            </span>
                        </div>
                    </div>
                    <div class="form-fieldset-body show">
                        <div class="media-detail-usage__snippet" data-controller="copy-to-clipboard">
                            <div class="media-detail-usage__toolbar">
                                <label for="media-snippet">{{ 'label.html_snippet'|trans({}, 'messages') }}</label>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary media-detail-usage__copy"
                                        data-copy-to-clipboard-target="button"
                                        data-action="copy-to-clipboard#copy"
                                        title="{{ 'action.copy_snippet'|trans({}, 'messages') }}"
                                        aria-label="{{ 'action.copy_snippet'|trans({}, 'messages') }}">
                                    <span data-copy-to-clipboard-target="defaultIcon">
                                        <twig:ux:icon name="tabler:clipboard" class="media-detail-usage__copy-icon media-detail-usage__copy-icon--default w-4 h-4" />
                                    </span>
                                    <span class="d-none" data-copy-to-clipboard-target="successIcon">
                                        <twig:ux:icon name="tabler:check" class="media-detail-usage__copy-icon media-detail-usage__copy-icon--success w-4 h-4" />
                                    </span>
                                </button>
                            </div>
                            <textarea id="media-snippet"
                                      class="media-detail-usage__code form-control font-monospace"
                                      data-copy-to-clipboard-target="source"
                                      rows="6"
                                      readonly>{{ media_snippet }}</textarea>
                        </div>

                        {% if media.type.value == 'image' %}
                            <div class="alert alert-secondary media-detail-usage__hint mt-3 mb-0">
                                <p class="media-detail-usage__hint-title mb-2">{{ 'help.media.image_layout.title'|trans({}, 'content') }}</p>
                                <ul>
                                    <li>{{ 'help.media.image_layout.size'|trans({}, 'content') }}</li>
                                    <li>{{ 'help.media.image_layout.float'|trans({}, 'content') }}</li>
                                    <li>{{ 'help.media.image_layout.mobile'|trans({}, 'content') }}</li>
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </fieldset>
            </div>
        </section>
    {% endif %}
{% endblock %}
