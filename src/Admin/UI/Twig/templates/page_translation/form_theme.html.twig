{# Page content blocks: EasyAdmin's collection entry does not render errors of the entry itself. #}
{% block page_content_block_widget %}
    {% if errors|length > 0 %}
        <div class="col-12">{{ form_errors(form) }}</div>
    {% endif %}
    {{ block('form_widget_compound') }}
{% endblock page_content_block_widget %}

{# Data fields of every block type, used by the page-block-editor controller to swap fields when the type changes. #}
{% block _PageTranslation_content_row %}
    {{ block('collection_row') }}
    {% if prototype is defined and prototype.vars.type_templates is defined %}
        <div hidden data-page-block-type-templates>
            {% for type, template in prototype.vars.type_templates %}
                <template data-block-type="{{ type }}">{{ form_widget(template) }}</template>
            {% endfor %}
        </div>
    {% endif %}
{% endblock _PageTranslation_content_row %}
