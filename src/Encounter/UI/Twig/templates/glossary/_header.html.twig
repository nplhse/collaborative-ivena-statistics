{# Page header of the MTS glossary pages. Expects `breadcrumbs`, `title`, `subtitle` and `back_path`. #}
<div class="container-xl">
    <twig:Breadcrumbs :items="breadcrumbs" />

    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg rounded">
                <twig:ux:icon name="tabler:stethoscope" width="36px" height="36px" />
            </span>
        </div>
        <div class="col">
            <h1 class="fw-bold" data-testid="glossary-title">{{ title }}</h1>
            <div class="list-inline list-inline-dots text-secondary">
                <div class="list-inline-item">{{ subtitle }}</div>
            </div>
        </div>
        <div class="col-auto ms-auto">
            <div class="btn-list">
                <a class="btn" href="{{ back_path }}">
                    <twig:ux:icon name="tabler:chevron-left" class="me-2" width="1em" height="1em" />
                    {{ 'label.back_to_list'|trans({}, 'messages') }}
                </a>
            </div>
        </div>
    </div>
</div>
