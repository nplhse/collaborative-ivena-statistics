{# Overview tab: KPI deck, segmented distributions, time series and distribution cards (8/4). #}
{% set coverage = overview.coverage %}
{% set ems = overview.routeLink[0] %}
{% set admitted = overview.dispositions|filter(r => r.key == 'admitted')|first %}
{% set physician = overview.processTimes[1] %}
{% set discharge = overview.processTimes[2] %}
{% import _self as fmt %}
{% macro minutes(value) %}{{ value is null ? '–' : 'encounter.unit.minutes_decimal'|trans({minutes: value|round(1)}, 'encounter') }}{% endmacro %}

<div class="row row-deck row-cards mb-3" data-testid="encounter-overview-summary">
    <div class="col-12 col-md-6 col-lg-4">
        {{ include('@Encounter/overview/_kpi.html.twig', {
            key: 'visits',
            title: 'encounter.overview_page.kpi.visits'|trans({}, d),
            value: coverage.visits|format_number,
            detail: 'encounter.overview_page.kpi.visits_detail'|trans({days: coverage.days, imports: coverage.imports}, d),
            info: 'encounter.overview_page.info.population'|trans({}, d),
        }) }}
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        {{ include('@Encounter/overview/_segment_card.html.twig', {
            testid: 'encounter-routes',
            title: 'encounter.overview_page.column.arrival_route'|trans({}, d),
            info: 'encounter.overview_page.info.routes'|trans({}, d),
            segments: overview.routes,
            labels: route_labels,
            colors: route_colors,
        }) }}
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        {{ include('@Encounter/overview/_segment_card.html.twig', {
            testid: 'encounter-categories-bar',
            title: 'encounter.overview_page.mts.categories'|trans({}, d),
            info: 'encounter.overview_page.info.categories'|trans({}, d),
            segments: overview.categories,
            labels: category_labels,
            colors: category_colors,
        }) }}
    </div>
</div>

<div class="row row-deck row-cards mb-3" data-testid="encounter-overview-kpis">
    <div class="col-12 col-md-6 col-lg-3">
        {{ include('@Encounter/overview/_kpi.html.twig', {
            key: 'ems_linked',
            title: 'encounter.overview_page.kpi.ems_linked'|trans({}, d),
            value: ems.linked.share is null ? (ems.linked.count.suppressed ? 'encounter.mts.counts.suppressed'|trans({threshold: threshold}, d) : '–') : ems.linked.share|format_number({fraction_digit: 1}) ~ ' %',
            detail: ems.linked.count.value is not null and ems.total.count.value is not null ? 'encounter.overview_page.kpi.ems_linked_detail'|trans({linked: ems.linked.count.value, total: ems.total.count.value}, d) : null,
            info: 'encounter.overview_page.info.ems_linked'|trans({}, d),
        }) }}
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        {{ include('@Encounter/overview/_kpi.html.twig', {
            key: 'physician',
            title: 'encounter.overview_page.kpi.physician'|trans({}, d),
            value: fmt.minutes(physician.median),
            detail: physician.suppressed ? 'encounter.overview_page.process.suppressed'|trans({threshold: threshold}, d) : 'encounter.overview_page.kpi.iqr'|trans({q1: physician.q1|round(1), q3: physician.q3|round(1)}, d),
            info: 'encounter.process.admission_to_physician.definition'|trans({}, d) ~ ' ' ~ 'encounter.overview_page.info.process'|trans({hours: max_hours, threshold: threshold}, d),
        }) }}
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        {{ include('@Encounter/overview/_kpi.html.twig', {
            key: 'length_of_stay',
            title: 'encounter.overview_page.kpi.length_of_stay'|trans({}, d),
            value: fmt.minutes(discharge.median),
            detail: discharge.suppressed ? 'encounter.overview_page.process.suppressed'|trans({threshold: threshold}, d) : 'encounter.overview_page.kpi.iqr'|trans({q1: discharge.q1|round(1), q3: discharge.q3|round(1)}, d),
            info: 'encounter.process.admission_to_discharge.definition'|trans({}, d) ~ ' ' ~ 'encounter.overview_page.info.process'|trans({hours: max_hours, threshold: threshold}, d),
        }) }}
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        {{ include('@Encounter/overview/_kpi.html.twig', {
            key: 'admitted',
            title: 'encounter.overview_page.kpi.admitted'|trans({}, d),
            value: admitted.share is null ? (admitted.count.suppressed ? 'encounter.mts.counts.suppressed'|trans({threshold: threshold}, d) : '–') : admitted.share|format_number({fraction_digit: 1}) ~ ' %',
            detail: 'encounter.overview_page.kpi.admitted_detail'|trans({}, d),
            info: 'encounter.overview_page.info.dispositions'|trans({}, d),
        }) }}
    </div>
</div>

<div class="row g-3 align-items-start">
    <div class="col-12 col-lg-8">
        <div class="card" data-testid="encounter-time-series">
            {{ include('@Encounter/overview/_card_header.html.twig', {
                title: ('encounter.overview_page.time_series.title_' ~ overview.grain.value)|trans({}, d),
                info: 'encounter.overview_page.info.time_series'|trans({days: constant('App\\Encounter\\Application\\Overview\\TimeGrain::MAX_WEEK_SPAN_DAYS')}, d),
            }) }}
            <div class="card-body">
                {% set bucket_pattern = overview.grain.value == 'week' ? 'dd.MM.yy' : 'MMM yyyy' %}
                <div data-controller="encounter-overview-chart" data-encounter-overview-chart-chart-value="{{ {
                    categories: overview.timeSeries|map(b => b.start|format_date(pattern: bucket_pattern)),
                    stacked: true,
                    height: 320,
                    series: ['ems', 'self', 'unknown']|map(route => {
                        name: route_labels[route],
                        color: {ems: '#206bc4', self: '#0ca678', unknown: '#adb5bd'}[route],
                        data: overview.timeSeries|map(b => b.routes[route].shownValue),
                    }),
                }|json_encode|e('html_attr') }}"></div>
            </div>
        </div>
        <div class="row g-3 mt-0">
            <div class="col-12 col-md-6">
            {{ include('@Encounter/overview/_bar_list_card.html.twig', {
                testid: 'encounter-dispositions-card',
                title: 'encounter.overview_page.disposition.title'|trans({}, d),
                info: 'encounter.overview_page.info.dispositions'|trans({}, d),
                rows: overview.dispositions,
                labels: disposition_labels,
                colors: {},
            }) }}
            </div>
            <div class="col-12 col-md-6">
            {{ include('@Encounter/overview/_bar_list_card.html.twig', {
                testid: 'encounter-care-levels-card',
                title: 'encounter.overview_page.care_level.title'|trans({}, d),
                info: 'encounter.overview_page.info.care_levels'|trans({visits: overview.careLevelDenominator}, d),
                rows: overview.careLevels,
                labels: care_level_labels,
                colors: {},
            }) }}
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="d-grid gap-3">
            {{ include('@Encounter/overview/_bar_list_card.html.twig', {
                testid: 'encounter-links',
                title: 'encounter.overview_page.route_link.short_title'|trans({}, d),
                info: 'encounter.overview_page.info.links'|trans({}, d),
                rows: overview.links,
                labels: link_labels,
                colors: link_colors,
                link: {url: path('app_encounter_hospital_overview', {id: hospital.id, tab: 'link'}|merge(period_query)), label: 'encounter.overview_page.details'|trans({}, d)},
            }) }}
            {{ include('@Encounter/overview/_bar_list_card.html.twig', {
                testid: 'encounter-top-diagrams',
                title: 'encounter.overview_page.mts.top_short'|trans({top: 5}, d),
                info: 'encounter.overview_page.info.diagrams'|trans({}, d),
                rows: overview.diagrams|filter(r => r.key != 'other' and r.key != '')|slice(0, 5),
                labels: diagram_labels,
                colors: {},
                link: {url: path('app_encounter_hospital_overview', {id: hospital.id, tab: 'distributions'}|merge(period_query)), label: 'encounter.overview_page.show_all'|trans({}, d)},
            }) }}
        </div>
    </div>
</div>
