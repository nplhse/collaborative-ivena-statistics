{# Distributions tab: full tables of MTS categories, diagrams, disposition and care level. #}
<div class="row row-cards">
    {% for table in [
        {rows: overview.categories, labels: category_labels, testid: 'encounter-categories', title: 'encounter.overview_page.mts.categories'|trans({}, d), header: 'encounter.course.field.category'|trans({}, d), info: 'encounter.overview_page.info.categories'|trans({}, d)},
        {rows: overview.diagrams, labels: diagram_labels, testid: 'encounter-diagrams', title: 'encounter.overview_page.mts.diagrams'|trans({top: overview.diagramsShown}, d), header: 'encounter.course.field.diagram'|trans({}, d), info: 'encounter.overview_page.info.diagrams'|trans({}, d)},
        {rows: overview.dispositions, labels: disposition_labels, testid: 'encounter-dispositions', title: 'encounter.overview_page.disposition.title'|trans({}, d), header: 'encounter.course.field.disposition'|trans({}, d), info: 'encounter.overview_page.info.dispositions'|trans({}, d)},
        {rows: overview.careLevels, labels: care_level_labels, testid: 'encounter-care-levels', title: 'encounter.overview_page.care_level.title'|trans({}, d), header: 'encounter.course.field.care_level'|trans({}, d), info: 'encounter.overview_page.info.care_levels'|trans({visits: overview.careLevelDenominator}, d)},
    ] %}
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                {{ include('@Encounter/overview/_card_header.html.twig', {title: table.title, info: table.info}) }}
                {{ include('@Encounter/overview/_count_table.html.twig', {
                    rows: table.rows,
                    labels: table.labels,
                    testid: table.testid,
                    label_header: table.header,
                }) }}
            </div>
        </div>
    {% endfor %}
</div>
