{# Segmented bar with legend as in the statistics overview (gender, urgency). Suppressed segments are not drawn; the legend shows "< 5". #}
<div class="card" data-testid="{{ testid }}">
    <div class="card-body">
        <p class="mb-2 d-flex align-items-center">{{ title }}{% if info is defined and info %}{{ include('@Encounter/overview/_info.html.twig', {text: info}) }}{% endif %}</p>
        <div class="progress progress-separated mb-3">
            {% for seg in segments %}
                {% if seg.share is not null %}
                    <div class="progress-bar {{ colors[seg.key] ?? 'bg-secondary' }}" style="width: {{ seg.share }}%" aria-label="{{ labels[seg.key] ?? seg.key }}"></div>
                {% endif %}
            {% endfor %}
        </div>
        <div class="d-flex flex-wrap gap-2">
            {% for seg in segments|filter(s => s.count.suppressed or s.count.value > 0) %}
                <div class="d-flex align-items-center" data-testid="{{ testid }}-segment" data-key="{{ seg.key }}">
                    <span class="legend me-2 {{ colors[seg.key] ?? 'bg-secondary' }}"></span>
                    <span>{{ labels[seg.key] ?? seg.key }}</span>
                    <span class="text-secondary ms-2"><span data-testid="encounter-count">{{ include('@Encounter/glossary/_count.html.twig', {count: seg.count}) }}</span>{% if seg.share is not null %} ({{ seg.share|format_number({fraction_digit: 1}) }}&nbsp;%){% endif %}</span>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
