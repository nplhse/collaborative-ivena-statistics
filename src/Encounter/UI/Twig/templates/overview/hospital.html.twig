{% extends '@Shared/_layout_vertical.html.twig' %}

{% set d = 'encounter' %}
{% set threshold = constant('App\\Encounter\\Application\\Glossary\\MtsCount::THRESHOLD') %}
{% set max_hours = constant('App\\Encounter\\Application\\Overview\\ProcessInterval::MAX_PLAUSIBLE_MINUTES') / 60 %}
{% set period_query = overview.period.queryParameters() %}

{% block title %}{{ 'encounter.overview_page.title'|trans({}, d) }}: {{ hospital.name }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs :items="[
            { label: 'encounter.nav'|trans({}, 'encounter'), translatable: false, path: path('app_encounter_index') },
            { label: 'encounter.overview_page.heading'|trans({}, 'encounter'), translatable: false }
        ]" />
        <div class="page-header d-print-none">
            <div class="row g-2 align-items-center">
                <div class="col min-w-0">
                    <div class="page-pretitle">{{ 'encounter.overview_page.pretitle'|trans({}, d) }}</div>
                    <h2 class="page-title mb-0" data-testid="encounter-overview-heading">{{ 'encounter.overview_page.heading'|trans({}, d) }}</h2>
                </div>
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-group" role="group" data-testid="encounter-overview-context">
                        <button type="button" class="btn d-inline-flex align-items-center" data-bs-toggle="offcanvas" data-bs-target="#encounter-overview-drawer" aria-controls="encounter-overview-drawer" data-testid="encounter-overview-context-hospital">
                            <twig:ux:icon name="tabler:map-pin" class="icon icon-sm flex-shrink-0" />
                            <span class="ms-2 text-truncate">{{ hospital.name }}</span>
                        </button>
                        <button type="button" class="btn d-inline-flex align-items-center" data-bs-toggle="offcanvas" data-bs-target="#encounter-overview-drawer" aria-controls="encounter-overview-drawer" data-testid="encounter-overview-context-period">
                            <twig:ux:icon name="tabler:calendar" class="icon icon-sm flex-shrink-0" />
                            <span class="ms-2">{{ include('@Encounter/overview/_period_label.html.twig') }}</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    {{ include('@Encounter/overview/_filter_drawer.html.twig') }}

    {% if not overview.period.isAllTime() %}
        <twig:ActiveFilters
            :badges="[{label: 'encounter.overview_page.filter.period'|trans({}, 'encounter'), value: include('@Encounter/overview/_period_label.html.twig')}]"
            data-testid="encounter-overview-active-filters"
        />
    {% endif %}

    <nav class="overflow-x-auto mb-4" aria-label="{{ 'encounter.overview_page.tabs.label'|trans({}, d) }}" data-testid="encounter-overview-tabs">
        <ul class="nav nav-tabs analytics-library-tabs flex-nowrap" role="tablist">
            {% for key in tabs %}
                <li class="nav-item" role="presentation">
                    <a class="nav-link{{ tab == key ? ' active' }}"
                       href="{{ path('app_encounter_hospital_overview', {id: hospital.id}|merge(period_query)|merge(key != 'overview' ? {tab: key} : {})) }}"
                       {% if tab == key %}aria-current="page"{% endif %}
                       data-testid="encounter-overview-tab-{{ key }}">
                        {{ ('encounter.overview_page.tabs.' ~ key)|trans({}, d) }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>

    {% set route_labels = {
        ems: 'encounter.arrival_route.ems'|trans({}, d),
        self: 'encounter.arrival_route.self'|trans({}, d),
        unknown: 'encounter.arrival_route.unknown'|trans({}, d),
        total: 'encounter.overview_page.total'|trans({}, d),
    } %}
    {% set route_colors = {ems: 'bg-blue', self: 'bg-teal', unknown: 'bg-secondary'} %}
    {% set link_labels = {
        automatic: 'encounter.link.automatic'|trans({}, d),
        confirmed: 'encounter.link.confirmed'|trans({}, d),
        not_linked: 'encounter.link.not_linked'|trans({}, d),
    } %}
    {% set link_colors = {automatic: 'bg-blue', confirmed: 'bg-green', not_linked: 'bg-secondary'} %}
    {% set not_documented = 'encounter.overview_page.not_documented'|trans({}, d) %}
    {% set category_labels = {'': not_documented} %}
    {% for row in overview.categories|filter(r => r.key != '') %}
        {% set category_labels = category_labels|merge({(row.key): ('encounter.mts.category.' ~ row.key ~ '.name')|trans({}, d)}) %}
    {% endfor %}
    {% set category_colors = {red: 'bg-red', orange: 'bg-orange', yellow: 'bg-yellow', green: 'bg-green', blue: 'bg-blue', '': 'bg-secondary'} %}
    {% set disposition_labels = {'': not_documented} %}
    {% for row in overview.dispositions|filter(r => r.key != '') %}
        {% set disposition_labels = disposition_labels|merge({(row.key): ('encounter.disposition.' ~ row.key)|trans({}, d)}) %}
    {% endfor %}
    {% set care_level_labels = {'': not_documented} %}
    {% for row in overview.careLevels|filter(r => r.key != '') %}
        {% set care_level_labels = care_level_labels|merge({(row.key): ('encounter.care_level.' ~ row.key)|trans({}, d)}) %}
    {% endfor %}
    {% set diagram_labels = diagram_names|merge({other: 'encounter.overview_page.mts.other_diagrams'|trans({}, d), '': not_documented}) %}

    {% if overview.empty and tab != 'coverage' %}
        <div data-testid="encounter-overview-empty">
            <twig:EmptyState title="{{ 'encounter.overview_page.empty'|trans({}, 'encounter') }}" icon="tabler:calendar-off" />
        </div>
    {% elseif tab == 'overview' %}
        {{ include('@Encounter/overview/_tab_overview.html.twig') }}
    {% elseif tab == 'process' %}
        {{ include('@Encounter/overview/_tab_process.html.twig') }}
    {% elseif tab == 'link' %}
        {{ include('@Encounter/overview/_tab_link.html.twig') }}
    {% elseif tab == 'distributions' %}
        {{ include('@Encounter/overview/_tab_distributions.html.twig') }}
    {% else %}
        {{ include('@Encounter/overview/_tab_coverage.html.twig') }}
    {% endif %}

    <p class="small text-secondary mt-3 mb-0" data-testid="encounter-overview-method">
        {{ 'encounter.overview_page.method'|trans({threshold: threshold}, d) }}
    </p>
{% endblock %}
