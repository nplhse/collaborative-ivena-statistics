{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'encounter.key_change.title'|trans({}, 'encounter') }} - {{ hospital.name }} - {{ parent() }}{% endblock %}

{% block page_header %}
    {{ include('@Allocation/hospitals/_hospital_edit_page_header.html.twig') }}
{% endblock %}

{% block page_body %}
    {% embed '@Allocation/hospitals/_edit_shell.html.twig' with {
        hospital: hospital,
        activeSection: 'encounter.key_change',
        summary: summary,
        form: form,
    } %}
        {% block edit_card_title %}{{ 'encounter.key_change.title'|trans({}, 'encounter') }}{% endblock %}
        {% block edit_content %}
            <p class="text-secondary">{{ 'encounter.key_change.intro'|trans({}, 'encounter') }}</p>

            <dl class="row" data-test="encounter-key-change-summary">
                <dt class="col-sm-5">{{ 'encounter.key_change.summary.generation'|trans({}, 'encounter') }}</dt>
                <dd class="col-sm-7">{{ summary.generation }}</dd>
                <dt class="col-sm-5">{{ 'encounter.key_change.summary.check_value'|trans({}, 'encounter') }}</dt>
                <dd class="col-sm-7">{{ (summary.check_value_registered ? 'encounter.key_change.summary.registered' : 'encounter.key_change.summary.not_registered')|trans({}, 'encounter') }}</dd>
                <dt class="col-sm-5">{{ 'encounter.key_change.summary.encounters'|trans({}, 'encounter') }}</dt>
                <dd class="col-sm-7" data-test="encounter-key-change-encounters">
                    {{ summary.encounters }}
                    {% if summary.encounters_by_generation|length > 1 %}
                        <span class="text-secondary">
                            ({% for generation, count in summary.encounters_by_generation %}{{ 'encounter.key_change.summary.by_generation'|trans({generation: generation, count: count}, 'encounter') }}{{ not loop.last ? ', ' }}{% endfor %})
                        </span>
                    {% endif %}
                </dd>
                <dt class="col-sm-5">{{ 'encounter.key_change.summary.imports'|trans({}, 'encounter') }}</dt>
                <dd class="col-sm-7" data-test="encounter-key-change-imports">{{ summary.imports }}</dd>
            </dl>

            {% if summary.key_change_in_progress %}
                <div class="alert alert-warning mb-0" role="alert" data-test="encounter-key-change-in-progress">
                    {{ 'encounter.key_change.in_progress'|trans({}, 'encounter') }}
                </div>
            {% else %}
                <div class="alert alert-danger" role="alert" data-test="encounter-key-change-warning">
                    <h4 class="alert-title">{{ 'encounter.key_change.warning.title'|trans({}, 'encounter') }}</h4>
                    <ul class="mb-0">
                        <li>{{ 'encounter.key_change.warning.uploads'|trans({}, 'encounter') }}</li>
                        <li>{{ 'encounter.key_change.warning.old_imports'|trans({}, 'encounter') }}</li>
                        <li>{{ 'encounter.key_change.warning.key_file'|trans({}, 'encounter') }}</li>
                        <li>{{ 'encounter.key_change.warning.delete'|trans({encounters: summary.encounters, imports: summary.imports}, 'encounter') }}</li>
                        <li><strong>{{ 'encounter.key_change.warning.keep'|trans({}, 'encounter') }}</strong></li>
                    </ul>
                </div>

                {{ form_start(form, {attr: {'data-test': 'encounter-key-change-form'}}) }}
                    {{ form_row(form.option) }}
                    {{ form_row(form.confirmName) }}
                    <button class="btn btn-danger" type="submit">{{ 'encounter.key_change.action.submit'|trans({}, 'encounter') }}</button>
                {{ form_end(form) }}
            {% endif %}
        {% endblock %}
        {% block edit_footer %}
            <a class="btn btn-link" href="{{ path('app_explore_hospital_show', {publicId: hospital.publicId}) }}">{{ 'label.hospital.back_to_profile'|trans({}, 'messages') }}</a>
        {% endblock %}
    {% endembed %}
{% endblock %}
