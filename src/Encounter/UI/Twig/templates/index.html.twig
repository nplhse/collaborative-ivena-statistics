{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'encounter.title'|trans({}, 'encounter') }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <twig:PageHeader :title="'encounter.title'|trans({}, 'encounter')">
        <twig:block name="breadcrumbs">
            <twig:Breadcrumbs :items="[
                { label: 'encounter.nav', label_domain: 'encounter' }
            ]" />
        </twig:block>
    </twig:PageHeader>
{% endblock %}

{% block page_content %}
    <div class="card">
        <div class="card-body">
            <p class="text-secondary">{{ 'encounter.overview.intro'|trans({}, 'encounter') }}</p>
            {% if is_granted('ROLE_ADMIN') %}
                <p class="text-secondary mb-0" data-test="encounter-admin-access">{{ 'encounter.overview.admin_access'|trans({}, 'encounter') }}</p>
            {% endif %}
        </div>
    </div>

    <div class="card mt-3" data-testid="encounter-overview-hospitals">
        <div class="card-header">
            <h3 class="card-title">{{ 'encounter.overview_page.index_title'|trans({}, 'encounter') }}</h3>
        </div>
        {% if overview_hospitals is empty %}
            <div class="card-body">
                <p class="text-secondary mb-0" data-testid="encounter-overview-hospitals-none">{{ 'encounter.overview_page.index_none'|trans({}, 'encounter') }}</p>
            </div>
        {% else %}
            <div class="list-group list-group-flush">
                {% for id, name in overview_hospitals %}
                    <a class="list-group-item list-group-item-action" href="{{ path('app_stats_encounter_analytics', {scope: 'hospital', hospital: id}) }}" data-testid="encounter-overview-hospital" data-hospital="{{ id }}">{{ name }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="card mt-3" data-test="encounter-imports-link">
        <div class="card-body d-flex align-items-center justify-content-between gap-2">
            <span class="text-secondary">{{ 'encounter.overview.imports_intro'|trans({}, 'encounter') }}</span>
            <a class="btn btn-outline-primary" href="{{ path('app_import_new') }}">{{ 'encounter.import.action.new'|trans({}, 'encounter') }}</a>
        </div>
    </div>

    <div class="card mt-3" data-test="encounter-review-link">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span class="text-secondary">{{ 'encounter.review.overview_intro'|trans({}, 'encounter') }}</span>
            <a class="btn btn-outline-primary" href="{{ path('app_encounter_review_index') }}">{{ 'encounter.review.title'|trans({}, 'encounter') }}</a>
        </div>
    </div>

    {% if is_granted('ROLE_ENCOUNTER_CATALOG_REVIEWER') %}
        <div class="card mt-3" data-test="encounter-plausibility-link">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span class="text-secondary">{{ 'encounter.plausibility.overview_intro'|trans({}, 'encounter') }}</span>
                <a class="btn btn-outline-primary" href="{{ path('app_encounter_plausibility') }}">{{ 'encounter.plausibility.title'|trans({}, 'encounter') }}</a>
            </div>
        </div>
    {% endif %}

    <div class="card mt-3">
        <div class="card-header">
            <h3 class="card-title">{{ 'encounter.overview.my_grants'|trans({}, 'encounter') }}</h3>
        </div>
        {% if grants is empty %}
            <div class="card-body" data-test="encounter-no-grants">
                <p class="text-secondary mb-0">{{ 'encounter.overview.no_grants'|trans({}, 'encounter') }}</p>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>{{ 'encounter.grant.column.hospital'|trans({}, 'encounter') }}</th>
                            <th>{{ 'encounter.grant.column.actions'|trans({}, 'encounter') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for grant in grants %}
                            <tr>
                                <td>{{ grant.hospital.name }}</td>
                                <td>{{ include('@Encounter/grants/_actions.html.twig', {grant: grant}) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <div class="card mt-3" data-test="encounter-data-prep">
        <div class="card-header">
            <h3 class="card-title">{{ 'encounter.data_prep.overview.title'|trans({}, 'encounter') }}</h3>
        </div>
        <div class="card-body">
            <p class="text-secondary">{{ 'encounter.data_prep.overview.intro'|trans({}, 'encounter') }}</p>
            <p class="text-secondary">{{ 'encounter.data_prep.overview.profiles'|trans({}, 'encounter') }}</p>
            <p class="text-secondary">{{ 'encounter.data_prep.overview.local_files'|trans({}, 'encounter') }}</p>
            <a href="{{ path('app_encounter_data_prep') }}" class="btn btn-primary" data-test="encounter-data-prep-guide">
                {{ 'encounter.data_prep.overview.guide'|trans({}, 'encounter') }}
            </a>
            <a href="{{ path('app_encounter_data_prep_download') }}" class="btn btn-outline-primary" download="{{ data_prep.fileName() }}">
                {{ 'encounter.data_prep.overview.download'|trans({}, 'encounter') }}
            </a>
            <span class="text-secondary ms-2">{{ 'encounter.data_prep.overview.version'|trans({}, 'encounter') }} {{ data_prep.version }} · {{ data_prep.releasedAt }}</span>
        </div>
    </div>
{% endblock %}
