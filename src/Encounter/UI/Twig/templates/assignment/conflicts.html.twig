{% extends '@Shared/_layout_vertical.html.twig' %}

{% set d = 'encounter' %}

{% block title %}{{ 'encounter.assignment.title'|trans({}, d) }} - {{ hospital.name }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <twig:PageHeader :title="'encounter.assignment.title'|trans({}, d)" :pretitle="hospital.name">
        <twig:block name="breadcrumbs">
            <twig:Breadcrumbs :items="[
                { label: 'link.tools', label_domain: 'shared', path: path('app_tools_index') },
                { label: 'encounter.assignment.title', label_domain: 'encounter', translatable: true, path: path('app_tools_encounter_assignments') },
                { label: hospital.name }
            ]" />
        </twig:block>
    </twig:PageHeader>
{% endblock %}

{% block page_content %}
    <div class="card">
        <div class="card-body">
            <p class="text-secondary">{{ 'encounter.assignment.conflicts_intro'|trans({}, d) }}</p>
            {% if conflicts is empty %}
                <p class="text-secondary mb-0" data-test="encounter-assignment-no-conflicts">{{ 'encounter.assignment.no_conflicts'|trans({}, d) }}</p>
            {% else %}
                {% if total > conflicts|length %}
                    <p class="text-secondary" data-test="encounter-assignment-limited">{{ 'encounter.assignment.limited'|trans({shown: conflicts|length, total: total}, d) }}</p>
                {% endif %}
                <div class="table-responsive">
                    <table class="table table-vcenter" data-test="encounter-assignment-conflicts">
                        <thead>
                            <tr>
                                <th>{{ 'encounter.assignment.column.schema'|trans({}, d) }}</th>
                                <th>{{ 'encounter.assignment.column.kind'|trans({}, d) }}</th>
                                <th>{{ 'encounter.assignment.column.import'|trans({}, d) }}</th>
                                <th>{{ 'encounter.assignment.column.candidates'|trans({}, d) }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for conflict in conflicts %}
                                <tr data-test="encounter-assignment-conflict" data-record="{{ conflict.recordId }}">
                                    <td>{{ schema_labels[conflict.schema]|trans }}</td>
                                    <td data-test="encounter-assignment-kind">{{ ('encounter.assignment.kind.' ~ conflict.kind.value)|trans({}, d) }}</td>
                                    <td><a href="{{ path('app_import_show', {id: conflict.importId}) }}">{{ conflict.importName }}</a></td>
                                    <td>
                                        <ul class="list-unstyled mb-0">
                                            {% for candidate in conflict.candidates %}
                                                <li data-test="encounter-assignment-candidate">
                                                    {% if candidate.visitUid is not null %}
                                                        <a href="{{ path('app_explore_ed_visit_show', {visitUid: candidate.visitUid}) }}">{{ candidate.anchorAt|format_datetime('short', 'short') }}</a>
                                                    {% else %}
                                                        <span class="text-secondary">{{ 'encounter.assignment.candidate_gone'|trans({}, d) }}</span>
                                                    {% endif %}
                                                    <span class="text-secondary">· {{ ('encounter.assignment.reason.' ~ candidate.reason.value)|trans({}, d) }}</span>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
