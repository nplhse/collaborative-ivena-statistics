{% extends '@Shared/_layout_vertical.html.twig' %}

{%- set g = 'encounter.data_prep.guide.' -%}

{% block title %}{{ (g ~ 'map.title')|trans({}, 'encounter') }} - {{ parent() }}{% endblock %}

{% block page_header %}
    {{ include('@Encounter/data_prep/_subpage_header.html.twig', {subpage_title: g ~ 'map.title'}) }}
{% endblock %}

{% block page_content %}
    <div class="row row-cards">
        <div class="col-lg-8">
            <div class="card" data-test="data-prep-local-map">
                <div class="card-body">
                    <p>{{ (g ~ 'map.purpose')|trans({}, 'encounter') }}</p>
                    <p>{{ (g ~ 'map.when')|trans({}, 'encounter') }}</p>
                    <p>{{ (g ~ 'map.in_tool')|trans({}, 'encounter') }}</p>
                    <p class="text-secondary mb-0">{{ (g ~ 'map.private')|trans({}, 'encounter') }}</p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">{{ (g ~ 'map.format_title')|trans({}, 'encounter') }}</h3>
                </div>
                <div class="table-responsive">
                    <table class="table card-table table-vcenter">
                        <thead>
                            <tr>
                                <th>{{ (g ~ 'map.column.key')|trans({}, 'encounter') }}</th>
                                <th>{{ (g ~ 'map.column.source')|trans({}, 'encounter') }}</th>
                                <th>{{ (g ~ 'map.column.target')|trans({}, 'encounter') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>departments</code></td>
                                <td>{{ (g ~ 'map.departments.source')|trans({}, 'encounter') }}</td>
                                <td>{{ (g ~ 'map.departments.target')|trans({}, 'encounter') }}</td>
                            </tr>
                            <tr>
                                <td><code>stations</code></td>
                                <td>{{ (g ~ 'map.stations.source')|trans({}, 'encounter') }}</td>
                                <td>
                                    {{ (g ~ 'map.stations.target')|trans({}, 'encounter') }}
                                    <ul class="mb-0" data-test="data-prep-care-levels">
                                        {% for level in care_levels %}
                                            <li><code>{{ level.value }}</code> – {{ ('encounter.care_level.' ~ level.value)|trans({}, 'encounter') }}</li>
                                        {% endfor %}
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td><code>dispositions</code></td>
                                <td>{{ (g ~ 'map.dispositions.source')|trans({}, 'encounter') }}</td>
                                <td>
                                    {{ (g ~ 'map.dispositions.target')|trans({codes: care_level_dispositions|map(d => d.value)|join(', ')}, 'encounter') }}
                                    <ul class="mb-0" data-test="data-prep-dispositions">
                                        {% for disposition in dispositions %}
                                            <li><code>{{ disposition.value }}</code> – {{ ('encounter.disposition.' ~ disposition.value)|trans({}, 'encounter') }}</li>
                                        {% endfor %}
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-secondary">{{ (g ~ 'map.matching')|trans({}, 'encounter') }}</div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">{{ (g ~ 'map.example_title')|trans({}, 'encounter') }}</h3>
                </div>
                <div class="card-body">
                    <pre class="mb-0" data-test="data-prep-local-map-example">{{ local_map_example }}</pre>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card" data-test="data-prep-local-map-downloads">
                <div class="card-header">
                    <h3 class="card-title">{{ (g ~ 'map.downloads_title')|trans({}, 'encounter') }}</h3>
                </div>
                <div class="card-body d-grid gap-2">
                    <a class="btn btn-primary" href="{{ path('app_encounter_data_prep_local_map', {variant: 'template'}) }}" download data-test="data-prep-local-map-template">{{ (g ~ 'map.download_template')|trans({}, 'encounter') }}</a>
                    <a class="btn btn-outline-secondary" href="{{ path('app_encounter_data_prep_local_map', {variant: 'example'}) }}" download>{{ (g ~ 'map.download_example')|trans({}, 'encounter') }}</a>
                </div>
            </div>

            <div class="card mt-3" data-test="data-prep-department-names-card">
                <div class="card-header">
                    <h3 class="card-title">{{ (g ~ 'map.department_names_title')|trans({}, 'encounter') }}</h3>
                </div>
                <div class="card-body">
                    <p class="text-secondary">{{ (g ~ 'map.department_names_help')|trans({}, 'encounter') }}</p>
                    {% if department_names is empty %}
                        <p class="text-secondary mb-0">{{ (g ~ 'map.department_names_none')|trans({}, 'encounter') }}</p>
                    {% else %}
                        <ul class="mb-0" data-test="data-prep-department-names">
                            {% for name in department_names %}
                                <li data-test="data-prep-department-name">{{ name }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
