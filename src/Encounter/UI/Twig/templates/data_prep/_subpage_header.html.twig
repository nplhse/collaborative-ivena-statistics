{#- Page header of a subpage of the data preparation tool's landing page (#1130); expects `subpage_title`. -#}
<twig:PageHeader :title="subpage_title|trans({}, 'encounter')">
    <twig:block name="breadcrumbs">
        <twig:Breadcrumbs :items="[
            { label: 'encounter.nav', label_domain: 'encounter', translatable: true, path: path('app_encounter_index') },
            { label: 'encounter.data_prep.guide.title', label_domain: 'encounter', translatable: true, path: path('app_encounter_data_prep') },
            { label: subpage_title, label_domain: 'encounter', translatable: true }
        ]" />
    </twig:block>
</twig:PageHeader>
