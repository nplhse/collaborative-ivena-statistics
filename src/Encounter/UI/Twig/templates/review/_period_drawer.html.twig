{# Filter drawer of the review pages: period, and the arrival route on the unlinked-visits segment. Expects `context`, `hospital`, `route_name`. #}
<twig:FilterDrawer
    id="encounter-review-filters"
    formId="encounter-review-filter-form"
    formAction="{{ path(route_name, {id: hospital.id}) }}"
    resetUrl="{{ path(route_name, {id: hospital.id, segment: context.filter.value}) }}"
    testId="encounter-review-filters"
    :keepQueryKeys="['segment', 'sortBy', 'orderBy']"
>
    <div class="mb-3">
        <label class="form-label" for="review-from">{{ 'encounter.review.period.from'|trans({}, 'encounter') }}</label>
        <input class="form-control" type="date" id="review-from" name="from" value="{{ context.period.from|date('Y-m-d') }}">
    </div>
    <div class="mb-3">
        <label class="form-label" for="review-to">{{ 'encounter.review.period.to'|trans({}, 'encounter') }}</label>
        <input class="form-control" type="date" id="review-to" name="to" value="{{ context.period.to|date('Y-m-d') }}">
        <small class="form-hint">{{ 'encounter.review.period.help'|trans({days: constant('App\\Encounter\\Application\\Review\\ReviewPeriod::MAX_DAYS')}, 'encounter') }}</small>
    </div>
    {% if context.filter.value == 'unlinked_visits' %}
        <div class="mb-3">
            <label class="form-label" for="review-route">{{ 'encounter.review.column.route'|trans({}, 'encounter') }}</label>
            <select class="form-select" id="review-route" name="route">
                <option value="">{{ 'encounter.review.route_all'|trans({}, 'encounter') }}</option>
                {% for option in routes|default([]) %}
                    <option value="{{ option.value }}" {{ context.route == option ? 'selected' }}>{{ ('encounter.review.value.route_' ~ option.value)|trans({}, 'encounter') }}</option>
                {% endfor %}
            </select>
        </div>
    {% endif %}
</twig:FilterDrawer>
