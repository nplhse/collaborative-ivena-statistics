{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'encounter.review.title'|trans({}, 'encounter') }} - {{ hospital.name }} - {{ parent() }}{% endblock %}

{% block turbo_drive %}data-turbo=true{% endblock %}

{% block page_header %}
    <twig:PageHeader :title="'encounter.review.title'|trans({}, 'encounter')" :pretitle="hospital.name">
        <twig:block name="breadcrumbs">
            <twig:Breadcrumbs :items="[
                { label: 'link.tools', label_domain: 'shared', path: path('app_tools_index') },
                { label: 'encounter.review.title', label_domain: 'encounter', translatable: true, path: path('app_tools_encounter_review') },
                { label: hospital.name, translatable: false }
            ]" />
        </twig:block>
        <twig:block name="context">
            {{ include('@Encounter/review/_period_context.html.twig', {period: context.period}) }}
            {{ include('@Shared/components/data_table/_page_result_count.html.twig') }}
        </twig:block>
        <twig:block name="actions">
            <a class="btn" href="{{ path('app_tools_encounter_review_overview', {id: hospital.id}|merge(context.period.query())) }}" data-test="encounter-review-overview-link">
                <twig:ux:icon name="tabler:chart-bar" class="w-3 h-3 me-1" /> {{ 'encounter.review.overview.link'|trans({}, 'encounter') }}
            </a>
            <a class="btn btn-primary" href="{{ path('app_tools_encounter_review_start', {id: hospital.id}|merge(context.query())) }}" data-test="encounter-review-start">
                {{ 'encounter.review.action.start'|trans({}, 'encounter') }} <twig:ux:icon name="tabler:arrow-right" class="w-3 h-3 ms-1" />
            </a>
            <twig:FilterDrawerTrigger
                drawerId="encounter-review-filters"
                :activeCount="context.activeFilterCount()"
                resetUrl="{{ context.activeFilterCount() > 0 ? path('app_tools_encounter_review_hospital', {id: hospital.id}|merge(context.withFilter(context.filter).query())) : null }}"
                openTestId="encounter-review-filters-toggle"
            />
        </twig:block>
    </twig:PageHeader>
{% endblock %}

{% block page_content %}
    {% set cell = '@Encounter/review/_cell.html.twig' %}
    {% set action = {key: 'action', type: 'custom', label: '', align: 'end', cellTemplate: cell, mobileAction: true, mobileMenuTemplate: '@Encounter/review/_menu_action.html.twig'} %}
    {% set pair_columns = [
        {key: 'arrival', type: 'custom', label: 'encounter.review.column.arrival', labelDomain: 'encounter', cellTemplate: cell, sortable: true, sortKey: 'arrival'},
        {key: 'anchor', type: 'custom', label: 'encounter.review.column.anchor', labelDomain: 'encounter', cellTemplate: cell},
        {key: 'difference', type: 'custom', label: 'encounter.review.column.difference', labelDomain: 'encounter', cellTemplate: cell, sortable: true, sortKey: 'difference'},
        {key: 'agreement', type: 'custom', label: 'encounter.review.column.agreement', labelDomain: 'encounter', cellTemplate: cell, sortable: true, sortKey: 'agreement'},
        {key: 'patient', type: 'custom', label: 'encounter.review.column.patient', labelDomain: 'encounter', cellTemplate: cell},
        {key: context.filter.value == 'open' ? 'open_status' : 'status', type: 'custom', label: 'encounter.review.column.status', labelDomain: 'encounter', cellTemplate: cell},
        action,
    ] %}
    {% set columns = context.filter.value == 'no_proposal' ? [
        {key: 'allocation', type: 'custom', label: 'encounter.review.column.arrival', labelDomain: 'encounter', cellTemplate: cell},
        {key: 'allocation_details', type: 'custom', label: 'encounter.review.column.allocation', labelDomain: 'encounter', cellTemplate: cell},
        action,
    ] : pair_columns %}

    <div data-test="encounter-review-list">
        <twig:DataTable
            mobileLayout="cards"
            :mobilePrimaryColumn="columns[0].key"
            mobileBreakpoint="lg"
            :paginator="paginator"
            paginationRoute="app_tools_encounter_review_hospital"
            :sortBy="context.isSortable() ? context.sortBy : null"
            :orderBy="context.isSortable() ? context.orderBy : null"
            :tabs="tabs"
            :columns="columns"
            :cellContext="{hospital_id: hospital.id, query: context.query()}"
            emptyTitle="{{ 'encounter.review.empty'|trans({}, 'encounter') }}"
            emptyIcon="tabler:checks"
        />
    </div>

    {{ include('@Encounter/review/_period_drawer.html.twig', {
        route_name: 'app_tools_encounter_review_hospital',
        period: context.period,
        keep: ['segment', 'sortBy', 'orderBy'],
        reset: {segment: context.filter.value},
    }) }}
{% endblock %}
