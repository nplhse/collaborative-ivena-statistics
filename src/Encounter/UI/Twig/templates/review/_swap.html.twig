{# A swap proposal; with `form` the apply button, bound to a form element rendered outside the decision form (forms cannot nest). #}
<div data-test="encounter-review-swap">
    <div class="fw-medium">{{ ('encounter.review.swap.kind.' ~ swap.kind)|trans({}, 'encounter') }}</div>
    <ul class="list-unstyled mb-2 small">
        <li>
            <a href="{{ path('app_encounter_review_allocation', {id: hospital_id, allocationId: swap.allocationId}|merge(query)) }}">{{ 'encounter.review.allocation'|trans({id: swap.allocationId}, 'encounter') }}</a>:
            {{ 'encounter.review.swap.move'|trans({from: swap.currentEncounterId, to: swap.newEncounterId(), before: swap.currentPoints, after: swap.newLink.points}, 'encounter') }}
        </li>
        {% if swap.otherLink %}
            <li>
                <a href="{{ path('app_encounter_review_allocation', {id: hospital_id, allocationId: swap.otherAllocationId()}|merge(query)) }}">{{ 'encounter.review.allocation'|trans({id: swap.otherAllocationId()}, 'encounter') }}</a>:
                {{ 'encounter.review.swap.takes'|trans({visit: swap.currentEncounterId, points: swap.otherLink.points}, 'encounter') }}
            </li>
        {% endif %}
        <li class="text-secondary">{{ 'encounter.review.swap.gain'|trans({links: swap.linkGain(), points: swap.pointsGain()}, 'encounter') }}</li>
    </ul>
    {% if form %}
        <input type="hidden" name="_token" value="{{ csrf_token('encounter_review_swap') }}" form="{{ form_id }}">
        <input type="hidden" name="swap" value="{{ swap.key() }}" form="{{ form_id }}">
        <button type="submit" class="btn btn-sm btn-primary" form="{{ form_id }}" data-test="encounter-review-apply-swap">
            <twig:ux:icon name="tabler:arrows-exchange" class="w-3 h-3 me-1" /> {{ 'encounter.review.swap.apply'|trans({}, 'encounter') }}
        </button>
    {% endif %}
</div>
