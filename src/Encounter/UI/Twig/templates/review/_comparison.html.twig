{# Both tables share these column widths, so the extended rows line up under the features. #}
{% set comparison_columns %}
    <colgroup>
        <col style="width: 22%">
        <col style="width: 26%">
        <col style="width: 30%">
        <col style="width: 22%">
    </colgroup>
{% endset %}
{# Side-by-side comparison of the allocation and one candidate visit: what each side documents per feature and what it contributes. Expects `allocation`, `candidate`. #}
<div class="card-body">
    <div class="row g-3 align-items-stretch mb-3">
        <div class="col-md-5">
            <div class="border rounded p-3 h-100" data-test="encounter-review-allocation">
                <div class="subheader">{{ 'encounter.review.ivena'|trans({}, 'encounter') }}</div>
                <div class="h3 mb-0">{{ allocation.arrival_at|date('d.m.Y H:i') }}</div>
                <div class="text-secondary small">{{ 'encounter.review.expected_arrival'|trans({}, 'encounter') }}</div>
            </div>
        </div>
        <div class="col-md-2 d-flex flex-column align-items-center justify-content-center text-center">
            <div class="h2 mb-0" data-test="encounter-review-agreement-value">{{ candidate.agreement|format_number({fraction_digit: 2}) }}</div>
            <div class="text-secondary small">{{ 'encounter.review.column.agreement'|trans({}, 'encounter') }}</div>
            <div class="text-secondary small">{{ 'encounter.review.minutes'|trans({minutes: candidate.time_difference_minutes}, 'encounter') }}</div>
        </div>
        <div class="col-md-5">
            <div class="border rounded p-3 h-100">
                <div class="subheader">{{ 'encounter.review.visit_heading'|trans({id: candidate.encounter_id}, 'encounter') }}</div>
                <div class="h3 mb-0">{{ candidate.anchor_at|date('d.m.Y H:i') }}</div>
                <div class="text-secondary small">
                    {{ 'encounter.review.column.anchor'|trans({}, 'encounter') }}
                    {% if candidate.substitute %}
                        <twig:Badge variant="purple" data-test="encounter-review-substitute" title="{{ 'encounter.review.substitute_help'|trans({}, 'encounter') }}">{{ 'encounter.review.substitute'|trans({}, 'encounter') }}</twig:Badge>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-vcenter mb-0" data-test="encounter-review-features">
            {{ comparison_columns }}
            <thead>
                <tr>
                    <th>{{ 'encounter.review.column.feature'|trans({}, 'encounter') }}</th>
                    <th>{{ 'encounter.review.column.ivena'|trans({}, 'encounter') }}</th>
                    <th>{{ 'encounter.review.column.ed'|trans({}, 'encounter') }}</th>
                    <th class="text-end">{{ 'encounter.review.column.contribution'|trans({}, 'encounter') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for feature in candidate.features %}
                    <tr data-test="feature-{{ feature.feature }}" data-direction="{{ feature.direction }}">
                        <td class="fw-medium py-2">{{ ('encounter.review.feature.' ~ feature.feature)|trans({}, 'encounter') }}</td>
                        {% for value in [feature.ivena, feature.ed] %}
                            <td class="py-2">{{ value starts with 'key:' ? ('encounter.review.value.' ~ value[4:])|trans({}, 'encounter') : value }}</td>
                        {% endfor %}
                        <td class="text-end text-nowrap py-2">
                            {% set direction = ('encounter.review.direction.' ~ feature.direction)|trans({}, 'encounter') %}
                            <twig:Badge :variant="{for: 'green', against: 'red', neutral: 'secondary'}[feature.direction]" title="{{ direction }}"><span class="d-none d-md-inline">{{ direction }} </span><span class="visually-hidden d-md-none">{{ direction }} </span>{{ '%+d'|format(feature.points) }}</twig:Badge>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="fw-medium">{{ 'encounter.review.points_total'|trans({}, 'encounter') }}</td>
                    <td class="text-end">
                        {% set total = {match: 'green', proposal: 'yellow', weak: 'red'}[candidate.total_level] %}
                        <twig:Badge :variant="total" title="{{ ('encounter.review.total_level.' ~ candidate.total_level)|trans({}, 'encounter') }}" data-test="encounter-review-total" data-level="{{ candidate.total_level }}">
                            <span class="fw-bold">{{ '%+d'|format(candidate.points) }}</span>
                            <span class="d-none d-md-inline"> · {{ ('encounter.review.total_level.' ~ candidate.total_level)|trans({}, 'encounter') }}</span>
                        </twig:Badge>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <details class="mt-3" data-test="encounter-review-extended" {{ candidate.unclear ? 'open' }}>
        <summary class="fw-medium">{{ 'encounter.review.extended.title'|trans({}, 'encounter') }}</summary>
        <p class="text-secondary small mt-2">{{ 'encounter.review.extended.hint'|trans({}, 'encounter') }}</p>
        <div class="table-responsive">
            <table class="table table-sm table-vcenter mb-0" data-test="encounter-review-extended-table">
                {{ comparison_columns }}
                <thead>
                    <tr>
                        <th>{{ 'encounter.review.column.feature'|trans({}, 'encounter') }}</th>
                        <th>{{ 'encounter.review.column.ivena'|trans({}, 'encounter') }}</th>
                        <th>{{ 'encounter.review.column.ed'|trans({}, 'encounter') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-test="extended-urgency">
                        <td class="fw-medium py-2">{{ 'encounter.review.extended.urgency'|trans({}, 'encounter') }}</td>
                        <td class="py-2">{% if allocation_extended.urgency_label %}{{ allocation_extended.urgency_code }} · {{ allocation_extended.urgency_label|trans({}, 'messages') }}{% else %}–{% endif %}</td>
                        <td class="py-2">{% if candidate.extended.category %}{{ ('encounter.mts.category.' ~ candidate.extended.category ~ '.name')|trans({}, 'encounter') }}{% else %}{{ 'encounter.review.value.not_documented'|trans({}, 'encounter') }}{% endif %}</td>
                        <td></td>
                    </tr>
                    <tr data-test="extended-indication">
                        <td class="fw-medium py-2">{{ 'encounter.review.extended.indication'|trans({}, 'encounter') }}</td>
                        <td class="py-2">{{ allocation_extended.indication ?? '–' }}</td>
                        <td class="py-2">{{ candidate.extended.diagram ?? 'encounter.review.value.not_documented'|trans({}, 'encounter') }}</td>
                        <td></td>
                    </tr>
                    <tr data-test="extended-indicator">
                        <td class="fw-medium py-2">{{ 'encounter.review.extended.indicator'|trans({}, 'encounter') }}</td>
                        <td class="py-2">–</td>
                        <td class="py-2">{{ candidate.extended.indicator ?? 'encounter.review.value.not_documented'|trans({}, 'encounter') }}</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </details>

    {% if candidate.rival_allocations is not empty %}
        {# The review passes its context; other pages (the validation item) pass rival_query. #}
        {% set rival_query = rival_query|default(context is defined ? context.query() : {}) %}
        <p class="text-secondary small mt-3 mb-0" data-test="encounter-review-rivals">
            {{ 'encounter.review.rivals'|trans({}, 'encounter') }}
            {% for rival in candidate.rival_allocations %}
                <a href="{{ path('app_encounter_review_allocation', {id: hospital.id, allocationId: rival}|merge(rival_query)) }}">{{ 'encounter.review.allocation'|trans({id: rival}, 'encounter') }}</a>{{ not loop.last ? ', ' }}
            {% endfor %}
        </p>
    {% endif %}
</div>
