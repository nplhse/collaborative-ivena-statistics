{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ groupName }} – {{ parent() }}{% endblock %}

{% block page_content %}
    <div class="container-xl py-4">
        <div data-testid="stats-indication-group-empty">
            <twig:EmptyState
                title="{{ 'stats.indication.group.empty'|trans({}, 'statistics') }}"
                icon="tabler:chart-dots"
            >
                <twig:block name="actions">
                    <a href="{{ path('app_stats_insights') }}" class="btn btn-primary" target="_top">
                        {{ 'link.stats.insights'|trans({}, 'shared') }}
                    </a>
                </twig:block>
            </twig:EmptyState>
        </div>
    </div>
{% endblock %}
