{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ groupName }} – {{ parent() }}{% endblock %}

{% block page_content %}
    <div class="container-xl py-4">
        <div class="alert alert-info" data-testid="stats-indication-group-empty">
            {{ 'stats.indication.group.empty'|trans({}, 'statistics') }}
        </div>
        <a href="{{ path('app_stats_insights') }}" class="btn btn-outline-primary">
            {{ 'link.stats.insights'|trans({}, 'shared') }}
        </a>
    </div>
{% endblock %}
