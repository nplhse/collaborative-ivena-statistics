{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'stats.reports.page_title'|trans({}, 'statistics') }}: {{ reportsPage.headerTitleKey|trans({}, 'statistics') }} – {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include(('@Shared/_includes/subnav_stats.html.twig')) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <div class="d-flex align-items-start justify-content-between gap-3">
            <twig:Breadcrumbs :items="[
                { label: 'link.statistics', path: path('app_stats_dashboard') },
                { label: 'link.stats.reports', path: reportsPage.indexUrl },
                { label: reportsPage.headerTitleKey }
            ]" />

            <div class="flex-shrink-0 d-print-none mt-2">
                {{ include('@Statistics/_data_quality_indicator.html.twig') }}
            </div>
        </div>

        <div class="page-header d-print-none">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle" data-testid="stats-heading-subtitle">
                        {{ reportsPage.headerSubtitleKey|trans({}, 'statistics') }}
                    </div>
                    <h2 class="page-title" data-testid="stats-heading-title">
                        {{ reportsPage.headerTitleKey|trans({}, 'statistics') }}
                        {% if statisticsHeadingPeriod %}
                            <span class="text-secondary fs-3 ps-2">· {{ statisticsHeadingPeriod }}</span>
                        {% endif %}
                    </h2>
                </div>
                {{ include('@Statistics/_header_controls.html.twig', {
                    statsShowFilterDrawer: statsShowFilterDrawer|default(false),
                    statsUseOverviewPeriodControls: true,
                    statsTtpExplorerUrl: reportsPage.currentTypeKey == 'transport_time_profile'
                        ? reportsPage.buildResult.viewModel.explorerTransportTimeUrl
                        : null,
                }) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    {{ include('@Statistics/_data_quality_drawer.html.twig') }}
    {% if statsShowFilterDrawer|default(false) %}
        {{ include('@Statistics/_filter_drawer.html.twig') }}
        {{ include('@Statistics/_filter_active_badges.html.twig') }}
    {% endif %}

    <div data-testid="stats-reports-content">
        {{ include(reportsPage.buildResult.template, {report: reportsPage.buildResult.viewModel}) }}
    </div>

    {% if overviewPeriodViewModel is defined and overviewPeriodViewModel.showNavigation %}
        {{ include('@Statistics/dashboard/_overview_period_navigation.html.twig') }}
    {% endif %}
{% endblock %}
