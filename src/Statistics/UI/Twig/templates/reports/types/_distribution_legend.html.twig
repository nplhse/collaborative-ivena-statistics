{# @var segments \App\Statistics\Application\SummarizedReport\Monthly\Dto\MonthlyReportSegment[] #}
<div class="d-flex flex-column gap-1">
    {% for segment in segments %}
        <div class="d-flex flex-wrap align-items-baseline column-gap-2">
            <span>
                <span class="legend me-2 {{ segment.barClass }}"></span>{{ segment.label }}
            </span>
            <span class="text-muted text-nowrap">
                {{ segment.count|number_format(0, ',', '.') }}
                ({{ segment.percent|number_format(1, ',', '.') }}%{% if segment.percentDeltaPp is not null %}, <twig:Statistics:DeltaIndicator
                    :value="segment.percentDeltaPp"
                    unit="percent"
                    display="text"
                    whenZero="neutral"
                    ariaKey="stats.reports.monthly.distribution.delta.aria"
                />{% endif %})
            </span>
        </div>
    {% endfor %}
</div>
