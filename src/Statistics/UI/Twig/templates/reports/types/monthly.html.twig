{% set report = report %}

{% if not report.hasData %}
    {{ include('@Statistics/reports/types/_report_empty.html.twig', {
        testId: 'stats-monthly-report-empty',
        icon: 'tabler:file-analytics',
        contextTitle: 'stats.reports.monthly.empty.title'|trans({}, 'statistics'),
        contextDescription: 'stats.reports.monthly.empty.body'|trans({period: report.periodLabel}, 'statistics'),
        hasSourceData: report.hasSourceData,
        canImport: report.canImport,
        importUrl: report.importCreateUrl,
        dashboardUrl: report.dashboardUrl,
    }) }}
{% else %}
    <div class="row row-deck row-cards mb-3" data-testid="stats-monthly-report-summary">
        <div class="col-12 col-md-6 col-lg-4">
            <twig:KpiCard
                :label="'stats.reports.monthly.kpi.allocations'|trans({}, 'statistics')"
                :value="report.allocationCount"
                :sparkline="report.allocationTrend"
                data-testid="stats-monthly-report-kpis"
            />
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card" data-testid="stats-monthly-report-gender">
                <div class="card-body">
                    <p class="mb-2">{{ 'stats.reports.monthly.distribution.gender'|trans({}, 'statistics') }}</p>
                    <div class="progress progress-separated mb-3">
                        {% for segment in report.genderSegments %}
                            <div class="progress-bar {{ segment.barClass }}"
                                 style="width: {{ segment.percent }}%"
                                 aria-label="{{ segment.label }}"></div>
                        {% endfor %}
                    </div>
                    {{ include('@Statistics/reports/types/_distribution_legend.html.twig', {segments: report.genderSegments}) }}
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card" data-testid="stats-monthly-report-urgency">
                <div class="card-body">
                    <p class="mb-2">{{ 'stats.reports.monthly.distribution.urgency'|trans({}, 'statistics') }}</p>
                    <div class="progress progress-separated mb-3">
                        {% for segment in report.urgencySegments %}
                            <div class="progress-bar {{ segment.barClass }}"
                                 style="width: {{ segment.percent }}%"
                                 aria-label="{{ segment.label }}"></div>
                        {% endfor %}
                    </div>
                    {{ include('@Statistics/reports/types/_distribution_legend.html.twig', {segments: report.urgencySegments}) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="{% if report.insights is not empty %}col-lg-8{% else %}col-12{% endif %}">
            <div class="card h-100" data-testid="stats-monthly-report-chart">
                <div class="card-header">
                    <h3 class="card-title mb-0">{{ 'stats.reports.monthly.chart.daily'|trans({}, 'statistics') }}</h3>
                </div>
                <div class="card-body">
                    <div data-controller="analysis-chart"
                         data-analysis-chart-spec-value="{{ report.dailyChart|json_encode|e('html_attr') }}">
                        <div class="chart-lg" data-analysis-chart-target="chart"></div>
                    </div>
                </div>
            </div>
        </div>
        {% if report.insights is not empty %}
            <div class="col-lg-4">
                <div class="card h-100 d-flex flex-column" data-testid="stats-monthly-report-insights">
                    <div class="card-header">
                        <h3 class="card-title mb-0">{{ 'stats.reports.monthly.insights.title'|trans({}, 'statistics') }}</h3>
                    </div>
                    <div class="list-group list-group-flush list-group-hoverable flex-grow-1">
                        {% for insight in report.insights %}
                            <div class="list-group-item">
                                <div class="fw-bold">{{ insight.title }}</div>
                                <div class="text-secondary">{{ insight.body }}</div>
                                {% if insight.note %}
                                    <div class="small text-secondary fst-italic mt-1" data-testid="stats-monthly-report-insight-note">{{ insight.note }}</div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="card-footer mt-auto">
                        <a href="{{ report.benchmarkingUrl }}" class="btn btn-outline-primary w-100" data-testid="stats-monthly-report-insights-benchmarking">
                            {{ 'monthly_reminder.insight.link'|trans({}, 'engagement') }}
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    <div class="row row-deck row-cards mb-3" data-testid="stats-monthly-report-side-kpis">
        <div class="col-12 col-md-6 col-lg-4">
            <twig:KpiCard
                :label="'stats.reports.monthly.kpi.with_physician'|trans({}, 'statistics')"
                :value="report.withPhysicianPercent"
                unit="%"
                :delta="report.withPhysicianMomPercent"
                :deltaUnit="'stats.unit.percentage_points.short'|trans({}, 'statistics')"
                :comparisonLabel="'stats.reports.monthly.kpi.mom'|trans({}, 'statistics')"
                :colorizeTrend="true"
                :fractionDigits="1"
                data-testid="stats-monthly-report-with-physician"
            />
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <twig:KpiCard
                :label="'stats.reports.monthly.kpi.mean_transport'|trans({}, 'statistics')"
                :value="report.meanTransportMinutes"
                :unit="'stats.reports.monthly.kpi.minutes'|trans({}, 'statistics')"
                :delta="report.meanTransportMomMinutes"
                :comparisonLabel="'stats.reports.monthly.kpi.mom'|trans({}, 'statistics')"
                :colorizeTrend="true"
                :invertTrend="true"
                :fractionDigits="1"
                data-testid="stats-monthly-report-mean-transport"
            />
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <twig:KpiCard
                :label="'stats.reports.monthly.kpi.resus'|trans({}, 'statistics')"
                :value="report.resusPercent"
                unit="%"
                :delta="report.resusMomPercent"
                :deltaUnit="'stats.unit.percentage_points.short'|trans({}, 'statistics')"
                :comparisonLabel="'stats.reports.monthly.kpi.mom'|trans({}, 'statistics')"
                :colorizeTrend="true"
                :fractionDigits="1"
                data-testid="stats-monthly-report-resus"
            />
        </div>
    </div>

    <div class="card mb-3" data-testid="stats-monthly-report-closed-department">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">{{ 'stats.reports.monthly.closed_department.title'|trans({}, 'statistics') }}</h3>
            <a href="{{ report.closedDepartment.detailUrl }}" class="small" data-testid="stats-monthly-report-closed-department-link">
                {{ 'stats.reports.monthly.closed_department.link'|trans({}, 'statistics') }}
            </a>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-12 col-md-6 col-lg-4">
                    {# The count is passed pre-formatted: it has no fraction digits, its relative change has one. #}
                    <twig:KpiCard
                        :label="'stats.reports.monthly.closed_department.count'|trans({}, 'statistics')"
                        :value="report.closedDepartment.closedCount|format_number({fraction_digit: 0})"
                        :description="report.closedDepartment.sharePercent is not null
                            ? report.closedDepartment.sharePercent|format_number({max_fraction_digit: 1}) ~ '% ' ~ 'stats.reports.monthly.closed_department.share_hint'|trans({}, 'statistics')
                            : null"
                        :delta="report.closedDepartment.closedMomPercent"
                        deltaUnit="%"
                        :comparisonLabel="'stats.reports.monthly.kpi.mom'|trans({}, 'statistics')"
                        :colorizeTrend="true"
                        :invertTrend="true"
                        :fractionDigits="1"
                        class="h-100"
                        data-testid="stats-monthly-report-closed-department-count"
                    />
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    {# No change is computed for this figure; the flags state that more departments is worse. #}
                    <twig:KpiCard
                        :label="'stats.reports.monthly.closed_department.departments'|trans({}, 'statistics')"
                        :value="report.closedDepartment.departmentCount"
                        :description="'stats.reports.monthly.closed_department.departments_hint'|trans({total: report.closedDepartment.totalDepartmentCount|format_number}, 'statistics')"
                        :colorizeTrend="true"
                        :invertTrend="true"
                        class="h-100"
                        data-testid="stats-monthly-report-closed-department-departments"
                    />
                </div>
                <div class="col-sm-12 col-lg-4">
                    <div class="border rounded p-3 h-100">
                        <div class="subheader">{{ 'stats.reports.monthly.closed_department.urgency'|trans({}, 'statistics') }}</div>
                        {% if report.closedDepartment.closedCount == 0 %}
                            <p class="text-secondary mb-0 mt-2" data-testid="stats-monthly-report-closed-department-empty">
                                {{ 'stats.reports.monthly.closed_department.empty'|trans({}, 'statistics') }}
                            </p>
                        {% else %}
                            <div class="progress progress-separated my-3">
                                {% for segment in report.closedDepartment.urgencySegments %}
                                    <div class="progress-bar {{ segment.barClass }}"
                                         style="width: {{ segment.percent }}%"
                                         aria-label="{{ segment.label }}"></div>
                                {% endfor %}
                            </div>
                            {{ include('@Statistics/reports/types/_distribution_legend.html.twig', {segments: report.closedDepartment.urgencySegments}) }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3" data-testid="stats-monthly-report-tops">
        {% set topTables = [
            {titleKey: 'stats.reports.monthly.top.diagnoses', rows: report.topDiagnoses, labelKey: 'stats.top_lists.table.diagnosis'},
            {titleKey: 'stats.reports.monthly.top.occasions', rows: report.topOccasions, labelKey: 'stats.top_lists.table.occasion'},
            {titleKey: 'stats.reports.monthly.top.departments', rows: report.topDepartments, labelKey: 'stats.top_lists.table.department'},
        ] %}
        {% for table in topTables %}
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header py-2">
                        <h3 class="card-title mb-0">{{ table.titleKey|trans({}, 'statistics') }}</h3>
                    </div>
                    <div class="card-body{% if table.rows is not empty %} p-0{% endif %}">
                        {% if table.rows is empty %}
                            <p class="text-secondary mb-0">{{ 'stats.reports.monthly.top.empty'|trans({}, 'statistics') }}</p>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>{{ table.labelKey|trans({}, 'statistics') }}</th>
                                            <th class="text-end">{{ 'stats.top_lists.table.count'|trans({}, 'statistics') }}</th>
                                            <th class="text-end">{{ 'stats.top_lists.table.share'|trans({}, 'statistics') }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in table.rows %}
                                            <tr>
                                                <td>{{ row.rank }}</td>
                                                <td>{{ row.label }}</td>
                                                <td class="text-end">{{ row.count|number_format(0, ',', '.') }}</td>
                                                <td class="text-end">{{ row.shareDisplay }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
