{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'stats.reports.page_title'|trans({}, 'statistics') }} – {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include(('@Shared/_includes/subnav_stats.html.twig')) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <div class="d-flex align-items-start justify-content-between gap-3">
            <twig:Breadcrumbs :items="[
                { label: 'link.statistics', path: path('app_stats_dashboard') },
                { label: 'link.stats.reports' }
            ]" />

            <div class="flex-shrink-0 d-print-none mt-2">
                {{ include('@Statistics/_data_quality_indicator.html.twig') }}
            </div>
        </div>

        <div class="page-header d-print-none">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle" data-testid="stats-heading-subtitle">
                        {{ 'stats.reports.index.pretitle'|trans({}, 'statistics') }}
                    </div>
                    <h2 class="page-title" data-testid="stats-heading-title">
                        {{ 'stats.reports.page_title'|trans({}, 'statistics') }}
                    </h2>
                </div>
                {{ include('@Statistics/_header_controls.html.twig', {
                    statsShowFilterDrawer: false,
                    statsHidePeriodControls: true,
                }) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    {{ include('@Statistics/_data_quality_drawer.html.twig') }}

    <p class="text-secondary mb-4" data-testid="stats-reports-index-intro">
        {{ 'stats.reports.index.intro'|trans({}, 'statistics') }}
    </p>

    <div class="row row-cards" data-testid="stats-reports-index">
        {% for card in indexPage.cards %}
            <div class="col-md-6 col-lg-4">
                <a href="{{ card.url }}"
                   class="card card-link"
                   data-testid="stats-reports-card-{{ card.key }}">
                    <div class="card-body">
                        <div class="d-flex align-items-start gap-3">
                            <span class="avatar bg-primary-lt text-primary">
                                <twig:ux:icon name="tabler:file-analytics" class="icon" />
                            </span>
                            <div class="min-w-0">
                                <div class="fw-bold" data-testid="stats-reports-card-title-{{ card.key }}">
                                    {{ card.labelKey|trans({}, 'statistics') }}
                                </div>
                                <div class="text-secondary mt-1">
                                    {{ card.descriptionKey|trans({}, 'statistics') }}
                                </div>
                                <div class="mt-3 text-primary">
                                    {{ 'stats.reports.index.open'|trans({}, 'statistics') }}
                                    <twig:ux:icon name="tabler:arrow-right" class="icon icon-sm" />
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        {% else %}
            <div class="col-12">
                <div class="empty">
                    <p class="empty-title">{{ 'stats.reports.index.empty'|trans({}, 'statistics') }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
