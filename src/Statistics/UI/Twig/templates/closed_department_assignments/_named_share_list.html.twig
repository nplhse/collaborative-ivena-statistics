{# @var rows \App\Statistics\ClosedDepartmentAssignments\Application\DTO\ClosedDepartmentNamedRow[] #}
{% set initialCount = 10 %}
{% set showExpand = rows|length > initialCount %}

<div class="card h-100" data-testid="{{ testId }}">
    <div class="card-header py-2">
        <h3 class="card-title mb-0">
            {% if topListUrl is defined and topListUrl %}
                <a href="{{ topListUrl }}"
                   class="text-reset d-inline-flex align-items-center gap-1"
                   data-testid="{{ testId }}-top-list">
                    <span>{{ titleKey|trans({}, 'statistics') }}</span>
                    <twig:ux:icon name="tabler:external-link" style="height: 0.9em; width: 0.9em;" aria-hidden="true" />
                </a>
            {% else %}
                {{ titleKey|trans({}, 'statistics') }}
            {% endif %}
        </h3>
    </div>
    <div class="card-body">
        {% if rows is empty %}
            <p class="text-muted small mb-0">{{ 'stats.closed_department.empty_section'|trans({}, 'statistics') }}</p>
        {% else %}
            <div {% if showExpand %}
                    data-controller="benchmark-indication-mix-expand"
                    data-benchmark-indication-mix-expand-show-more-label-value="{{ 'stats.closed_department.list.show_more'|trans({}, 'statistics')|e('html_attr') }}"
                    data-benchmark-indication-mix-expand-show-less-label-value="{{ 'stats.closed_department.list.show_less'|trans({}, 'statistics')|e('html_attr') }}"
                 {% endif %}>
                {% for row in rows %}
                    <div class="{% if loop.index > initialCount %}d-none {% endif %}{% if not loop.last %}mb-2{% else %}mb-0{% endif %}"
                         {% if loop.index > initialCount %}data-benchmark-indication-mix-expand-target="hiddenRow"{% endif %}>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span>
                                {% if row.exploreUrl %}
                                    <a href="{{ row.exploreUrl }}">{{ row.name }}</a>
                                {% else %}
                                    {{ row.name }}
                                {% endif %}
                            </span>
                            <span class="text-muted text-nowrap ms-2">
                                {{ row.closedCount|number_format(0, ',', '.') }}
                                {% if row.shareOfClosed is not null %}
                                    &nbsp;·&nbsp;{{ row.shareOfClosed|number_format(1, ',', '.') }}%
                                {% endif %}
                            </span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar"
                                 style="width: {{ row.shareOfClosed ?? 0 }}%"
                                 role="progressbar"
                                 aria-valuenow="{{ row.shareOfClosed ?? 0 }}"
                                 aria-valuemin="0"
                                 aria-valuemax="100"></div>
                        </div>
                    </div>
                {% endfor %}

                {% if showExpand %}
                    <div class="mt-2">
                        <button type="button"
                                class="btn btn-link btn-sm px-0"
                                data-action="benchmark-indication-mix-expand#toggle"
                                data-testid="{{ testId }}-show-more">
                            <span data-benchmark-indication-mix-expand-target="expandLabel">
                                {{ 'stats.closed_department.list.show_more'|trans({}, 'statistics') }}
                            </span>
                        </button>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
