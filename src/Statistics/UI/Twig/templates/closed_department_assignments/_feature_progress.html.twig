{# @var rows \App\Statistics\ClosedDepartmentAssignments\Application\DTO\ClosedDepartmentDistributionRow[] #}
{% set showSwatch = showSwatch|default(false) %}
{% if rows is empty %}
    <p class="text-muted small mb-0">{{ 'stats.closed_department.empty_section'|trans({}, 'statistics') }}</p>
{% else %}
    {% for row in rows %}
        <div class="{% if not loop.last %}mb-3{% else %}mb-0{% endif %}">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="d-flex align-items-center min-w-0">
                    {% if showSwatch %}
                        <span class="legend me-2 {{ row.barClass }}"></span>
                    {% endif %}
                    <span class="text-truncate">
                        {% if row.exploreUrl %}
                            <a href="{{ row.exploreUrl }}">{{ row.labelTranslationKey|trans({}, statistics_label_domain(row.labelTranslationKey)) }}</a>
                        {% else %}
                            {{ row.labelTranslationKey|trans({}, statistics_label_domain(row.labelTranslationKey)) }}
                        {% endif %}
                    </span>
                </span>
                <span class="text-muted text-nowrap ms-2">
                    {{ row.count|number_format(0, ',', '.') }}
                    &nbsp;·&nbsp;{{ (row.percent ?? 0)|number_format(1, ',', '.') }}%
                    {% if row.deltaPp is not null and row.deltaPp != 0 %}
                        {% set regularLabel = row.regularPercent is not null
                            ? ('stats.closed_department.compare.regular'|trans({}, 'statistics') ~ ': ' ~ row.regularPercent|number_format(1, ',', '.') ~ ' %')
                            : null %}
                        <span class="small ms-1 fw-medium {{ row.deltaPp > 0 ? 'text-green' : 'text-red' }}"{% if regularLabel %} title="{{ regularLabel }}"{% endif %}>
                            {% if row.deltaPp > 0 %}+{% endif %}{{ row.deltaPp|number_format(1, ',', '.') }}%
                        </span>
                    {% endif %}
                </span>
            </div>
            {% set showReference = row.regularPercent is not null %}
            <div{% if showReference %} class="overflow-hidden rounded"{% endif %}>
                <div class="progress progress-sm mb-0{% if showReference %} rounded-0{% endif %}">
                    <div class="progress-bar {{ row.barClass }}"
                         style="width: {{ row.percent ?? 0 }}%"
                         role="progressbar"
                         title="{{ 'stats.closed_department.compare.closed'|trans({}, 'statistics') }}"
                         aria-valuenow="{{ row.percent ?? 0 }}"
                         aria-valuemin="0"
                         aria-valuemax="100"></div>
                </div>
                {% if showReference %}
                    <div class="progress progress-sm mb-0 rounded-0">
                        <div class="progress-bar bg-secondary"
                             style="width: {{ row.regularPercent }}%"
                             role="progressbar"
                             title="{{ 'stats.closed_department.compare.regular'|trans({}, 'statistics') }}"
                             aria-valuenow="{{ row.regularPercent }}"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
{% endif %}
