<div class="card" data-testid="stats-closed-department-time-series">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
        <h3 class="card-title mb-0">{{ 'stats.closed_department.section.when'|trans({}, 'statistics') }}</h3>
        <div class="btn-group btn-group-sm" role="group" aria-label="{{ 'stats.closed_department.series.mode.label'|trans({}, 'statistics') }}">
            <button type="button"
                    class="btn active"
                    data-closed-department-assignments-charts-target="seriesModeCount"
                    data-action="closed-department-assignments-charts#setSeriesMode"
                    data-closed-department-assignments-charts-mode-param="count">
                {{ 'stats.closed_department.series.mode.count'|trans({}, 'statistics') }}
            </button>
            <button type="button"
                    class="btn"
                    data-closed-department-assignments-charts-target="seriesModeShare"
                    data-action="closed-department-assignments-charts#setSeriesMode"
                    data-closed-department-assignments-charts-mode-param="share">
                {{ 'stats.closed_department.series.mode.share'|trans({}, 'statistics') }}
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart-lg" data-closed-department-assignments-charts-target="timeSeriesChart"></div>
    </div>
</div>

<div class="card" data-testid="stats-closed-department-heatmap">
    <div class="card-header py-2">
        <h3 class="card-title mb-0">{{ 'stats.closed_department.section.heatmap'|trans({}, 'statistics') }}</h3>
    </div>
    <div class="card-body">
        {% if dashboard.heatmap.maxCount == 0 %}
            <p class="text-muted small mb-0">{{ 'stats.closed_department.empty_section'|trans({}, 'statistics') }}</p>
        {% else %}
            <div class="chart-lg" data-closed-department-assignments-charts-target="heatmapChart"></div>
        {% endif %}
    </div>
</div>
