{% set activePeriodLabel = statisticsHeadingPeriod %}
{% set topListCompareEnabled = statsTopListCompareEnabled|default(false) %}
{% set showTopListCatalog = statsTopListCatalogUrl|default(null) %}
{% set showTopListCompareEnable = statsTopListCompareEnableUrl is defined and not topListCompareEnabled %}
{% set showIndicationCatalog = statsIndicationCatalogUrl|default(null) %}
{% set showIndicationTopList = statsIndicationTopListUrl|default(null) %}
{% set showIndicationCompareLaunch = statsShowCompareLaunchButton|default(false) %}

<div class="col-auto ms-auto d-print-none">
    <div class="btn-list">
        {% if showTopListCatalog or showTopListCompareEnable %}
            <div class="btn-group" role="group" data-testid="stats-top-lists-header-actions">
                {% if showTopListCatalog %}
                    <a class="btn"
                       href="{{ statsTopListCatalogUrl }}"
                       data-testid="stats-top-lists-catalog-link">
                        <twig:ux:icon name="tabler:book-2" class="icon icon-sm" />
                        {{ 'stats.top_lists.nav.catalog_list'|trans({}, 'statistics') }}
                    </a>
                {% endif %}

                {% if showTopListCompareEnable %}
                    <button type="button"
                            class="btn"
                            data-bs-toggle="modal"
                            data-bs-target="#stats-top-lists-comparison-modal-b"
                            data-testid="stats-top-lists-compare-enable">
                        <twig:ux:icon name="tabler:git-compare" class="icon icon-sm" />
                        {{ 'stats.top_lists.comparison.enable'|trans({}, 'statistics') }}
                    </button>
                {% endif %}
            </div>
        {% endif %}

        {% if showIndicationCatalog or showIndicationTopList or showIndicationCompareLaunch %}
            <div class="btn-group" role="group" data-testid="stats-indication-header-actions">
                {% if showIndicationCatalog %}
                    <a class="btn"
                       href="{{ statsIndicationCatalogUrl }}"
                       data-testid="stats-indication-catalog-link">
                        <twig:ux:icon name="tabler:book-2" class="icon icon-sm" />
                        {{ 'stats.indication.nav.catalog'|trans({}, 'statistics') }}
                    </a>
                {% endif %}

                {% if showIndicationTopList %}
                    <a class="btn"
                       href="{{ statsIndicationTopListUrl }}"
                       data-testid="stats-indication-top-list-link">
                        <twig:ux:icon name="tabler:list-numbers" class="icon icon-sm" />
                        {{ 'stats.indication.nav.top_list'|trans({}, 'statistics') }}
                    </a>
                {% endif %}

                {% if showIndicationCompareLaunch %}
                    <button type="button"
                            class="btn"
                            data-bs-toggle="modal"
                            data-bs-target="#{{ statsCompareLaunchModalId|default('stats-indication-compare-launch-modal') }}"
                            data-testid="stats-indication-compare-launch-button">
                        <twig:ux:icon name="tabler:git-compare" class="icon icon-sm" />
                        {{ 'stats.indication.compare.with'|trans({}, 'statistics') }}
                    </button>
                {% endif %}
            </div>
        {% endif %}

        {% if statsShowFilterDrawer|default(false) %}
            {{ include('@Statistics/_filter_drawer_trigger.html.twig') }}
        {% endif %}

        {% if statsTopListCompareEnableUrl is defined and topListCompareEnabled %}
            <a class="btn btn-outline-danger"
               href="{{ statsTopListCompareDisableUrl }}"
               data-testid="stats-top-lists-compare-disable">
                <twig:ux:icon name="tabler:x" class="icon icon-sm" />
                {{ 'stats.top_lists.comparison.disable'|trans({}, 'statistics') }}
            </a>
        {% endif %}

        {% if statsShowCompareEditButton|default(false) %}
            <button type="button"
                    class="btn"
                    data-bs-toggle="modal"
                    data-bs-target="#stats-indication-compare-edit-modal"
                    data-testid="stats-indication-compare-edit-button">
                <twig:ux:icon name="tabler:pencil" class="icon icon-sm" />
                {{ 'stats.indication.compare.edit'|trans({}, 'statistics') }}
            </button>
        {% endif %}

        {% if statsTtpExplorerUrl|default(null) %}
            <a class="btn"
               href="{{ statsTtpExplorerUrl }}"
               data-testid="stats-ttp-explorer-link">
                {{ 'stats.reports.transport_time_profile.explorer_link'|trans({}, 'statistics') }}
            </a>
        {% endif %}

        {% if not statsHideScopeControls|default(false) %}
            {{ include('@Statistics/_scope_controls.html.twig', {
                pageViewModel: {
                    showScopeSecondaryPicker: statsShowScopeSecondaryPicker|default(false),
                    scopePrimaryMenu: statsScopePrimaryMenu|default([]),
                    scopeSecondaryMenu: statsScopeSecondaryMenu|default([]),
                    scopePrimaryDropdownLabel: statsScopePrimaryDropdownLabel|default(statisticsHeadingScope),
                    scopeSecondaryDropdownLabel: statsScopeSecondaryDropdownLabel|default(''),
                },
            }) }}
        {% endif %}

        {% if not statsHidePeriodControls|default(false) %}
            {% if statsUseOverviewPeriodControls|default(false) %}
                {{ include('@Statistics/dashboard/_overview_period_controls.html.twig') }}
            {% else %}
                <div class="btn-group">
                    <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        {{ activePeriodLabel }}
                    </button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item{% if statisticsFilter.period.value == 'all' %} active{% endif %}" href="{{ statsPeriodUrls.all }}">{{ 'stats.filter.period.all'|trans({}, 'statistics') }}</a>
                        <a class="dropdown-item{% if statisticsFilter.period.value == 'all_time' %} active{% endif %}" href="{{ statsPeriodUrls.all_time }}">{{ 'stats.filter.period.all_time'|trans({}, 'statistics') }}</a>
                        <a class="dropdown-item{% if statisticsFilter.period.value == 'year' %} active{% endif %}" href="{{ statsPeriodUrls.year }}">{{ 'stats.filter.period.year'|trans({}, 'statistics') }}</a>
                        <a class="dropdown-item{% if statisticsFilter.period.value == 'quarter' %} active{% endif %}" href="{{ statsPeriodUrls.quarter|default('#') }}">{{ 'stats.filter.period.quarter'|trans({}, 'statistics') }}</a>
                        <a class="dropdown-item{% if statisticsFilter.period.value == 'month' %} active{% endif %}" href="{{ statsPeriodUrls.month }}">{{ 'stats.filter.period.month'|trans({}, 'statistics') }}</a>
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
