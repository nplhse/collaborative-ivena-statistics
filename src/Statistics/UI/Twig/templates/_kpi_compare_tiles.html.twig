{#
    Colour shows how a difference is read, not its sign (#1230, product decision): a higher share with
    physician, resuscitation bay or cath lab is favourable, a longer mean transport time is unfavourable.
    All other metrics (volume, age, night, weekend) describe the case mix and stay neutral grey.
#}
{% set favourableWhenHigher = {with_physician: true, resus: true, cathlab: true, mean_transport: false} %}
<div data-testid="{{ testIdPrefix }}-tiles">
    <div class="row row-deck row-cards g-3">
        {% for metric in metrics %}
            {% set higherIsFavourable = favourableWhenHigher[metric.key.value] ?? null %}
            {# Tone follows the delta as shown: +0,04 pp is displayed as +0,0 and is no change. #}
            {% set shownDelta = metric.absoluteDelta|round(metric.format.value == 'count' ? 0 : 1) %}
            {% set deltaTone = higherIsFavourable is null or shownDelta == 0
                ? 'secondary'
                : ((shownDelta > 0) == higherIsFavourable ? 'success' : 'danger') %}
            {% set deltaTextClass = deltaTone == 'danger' ? 'text-danger' : (deltaTone == 'success' ? 'text-success' : 'text-secondary') %}
            {# The ratio is above 1 exactly when the difference is positive, so it shares the tone. #}
            {% set ratioBadgeClass = deltaTone == 'danger' ? 'bg-red-lt' : (deltaTone == 'success' ? 'bg-green-lt' : 'bg-secondary-lt') %}
            {% set labelKey = metricLabelKeys[metric.key.value]|default('stats.benchmark.metric.' ~ metric.key.value) %}
            {% set tileColumnClass = columnClass|default('col-12 col-md-6 col-lg-4') %}
            {% set withComparison = showComparison ?? true %}

            {% if metric.format.value == 'percent' %}
                {% set primaryLabel = metric.primaryValue|number_format(1, ',', '.') ~ '%' %}
                {% set comparisonLabel = metric.comparisonValue|number_format(1, ',', '.') ~ '%' %}
                {# absoluteDelta of two shares is a difference in percentage points, not a relative change. #}
                {% set deltaLabel = (metric.absoluteDelta >= 0 ? '+' : '') ~ metric.absoluteDelta|number_format(1, ',', '.') %}
            {% elseif metric.format.value == 'count' %}
                {% set primaryLabel = metric.primaryValue|number_format(0, ',', '.') %}
                {% set comparisonLabel = metric.comparisonValue|number_format(0, ',', '.') %}
                {% set deltaLabel = (metric.absoluteDelta >= 0 ? '+' : '') ~ metric.absoluteDelta|number_format(0, ',', '.') %}
            {% elseif metric.format.value == 'minutes' %}
                {% set primaryLabel = metric.primaryValue|number_format(1, ',', '.') ~ ' min' %}
                {% set comparisonLabel = metric.comparisonValue|number_format(1, ',', '.') ~ ' min' %}
                {% set deltaLabel = (metric.absoluteDelta >= 0 ? '+' : '') ~ metric.absoluteDelta|number_format(1, ',', '.') ~ ' min' %}
            {% elseif metric.format.value == 'decimal' %}
                {% set primaryLabel = metric.primaryValue|number_format(1, ',', '.') %}
                {% set comparisonLabel = metric.comparisonValue|number_format(1, ',', '.') %}
                {% set deltaLabel = (metric.absoluteDelta >= 0 ? '+' : '') ~ metric.absoluteDelta|number_format(1, ',', '.') %}
            {% else %}
                {% set primaryLabel = metric.primaryValue|number_format(1, ',', '.') %}
                {% set comparisonLabel = metric.comparisonValue|number_format(1, ',', '.') %}
                {% set deltaLabel = (metric.absoluteDelta >= 0 ? '+' : '') ~ metric.absoluteDelta|number_format(1, ',', '.') %}
            {% endif %}

            <div class="{{ tileColumnClass }}">
                <div class="card h-100" data-testid="{{ testIdPrefix }}-{{ metric.key.value }}">
                    <div class="card-body d-flex flex-column">
                        <div class="subheader mb-2">
                            {{ labelKey|trans({}, 'statistics') }}
                        </div>

                        {% if not withComparison %}
                            <div class="h2 mb-3">{{ primaryLabel }}</div>
                        {% elseif not suppressRatios %}
                            <div class="d-flex align-items-baseline gap-2 mb-3">
                                <div class="h2 mb-0 fw-bold {{ deltaTextClass }}">{{ deltaLabel }}{% if metric.format.value == 'percent' %} {{ include('@Statistics/_percentage_points_unit.html.twig') }}{% endif %}</div>
                                {% if metric.hasRatio %}
                                    <span class="badge {{ ratioBadgeClass }}">{{ metric.ratio|number_format(1, ',', '.') }}×</span>
                                {% else %}
                                    {# Comparison value 0: the ratio is undefined, not 0,0× (#1231). #}
                                    {% set ratioUnavailableLabel = 'stats.benchmark.kpi.ratio_unavailable'|trans({}, 'statistics') %}
                                    <span class="badge bg-secondary-lt" title="{{ ratioUnavailableLabel }}" data-testid="{{ testIdPrefix }}-{{ metric.key.value }}-ratio-unavailable"><span aria-hidden="true">—</span><span class="visually-hidden">{{ ratioUnavailableLabel }}</span></span>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="h3 mb-0">{{ primaryLabel }}</div>
                                </div>
                                <div class="col-6 text-end">
                                    <div class="h3 mb-0 text-secondary">{{ comparisonLabel }}</div>
                                </div>
                            </div>
                        {% endif %}

                        <div class="mt-auto d-flex justify-content-between flex-wrap gap-2 small min-w-0">
                            <span>
                                <span class="badge bg-primary-lt me-1">{{ sideAShortKey|trans({}, 'statistics') }}</span>
                                <span class="text-secondary">{{ primaryLabel }}</span>
                            </span>
                            {% if withComparison %}
                                <span class="text-end">
                                    <span class="badge bg-secondary-lt me-1">{{ sideBShortKey|trans({}, 'statistics') }}</span>
                                    <span class="text-secondary">{{ comparisonLabel }}</span>
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
