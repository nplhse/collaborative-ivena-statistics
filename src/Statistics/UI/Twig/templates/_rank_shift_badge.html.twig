{# Rank shift badge (same pattern as the Transport Time Profile ranked table). #}
{% if entered %}
    <span class="badge bg-blue-lt stats-rank-shift-badge"
          data-testid="{{ testId }}"
          aria-label="{{ ariaNewKey|trans({}, 'statistics') }}">
        <span class="text-blue" aria-hidden="true">
            <twig:ux:icon name="tabler:circle-filled" class="icon icon-xs" />
        </span>
        {{ newLabelKey|trans({}, 'statistics') }}
    </span>
{% elseif rankDelta is not null and rankDelta != 0 %}
    <span class="badge {{ rankDelta > 0 ? 'bg-green-lt' : 'bg-red-lt' }} stats-rank-shift-badge"
          data-testid="{{ testId }}"
          aria-label="{{ (rankDelta > 0 ? ariaUpKey : ariaDownKey)|trans({delta: rankDelta|abs}, 'statistics') }}">
        <span class="{{ rankDelta > 0 ? 'text-success' : 'text-danger' }}" aria-hidden="true">
            {% if rankDelta > 0 %}
                <twig:ux:icon name="tabler:arrow-up" class="icon icon-sm" />
            {% else %}
                <twig:ux:icon name="tabler:arrow-down" class="icon icon-sm" />
            {% endif %}
        </span>
        {{ rankDelta|abs }}
    </span>
{% endif %}
