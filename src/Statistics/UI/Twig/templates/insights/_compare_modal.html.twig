{% set modalId = compareModalId|default('stats-insights-compare-modal') %}
{% set modalTitleKey = compareModalTitleKey|default('stats.insights.compare.edit_modal.title') %}
{% set testIdPrefix = compareModalTestIdPrefix|default('stats-insights-compare-modal') %}

<twig:Modal
    id="{{ modalId }}"
    :title="modalTitleKey|trans({}, 'statistics')"
    size="lg"
    data-testid="{{ testIdPrefix }}-modal"
    data-controller="insight-compare-picker"
>
    {{ component('InsightCompareSelectionForm', {
        initialData: comparePicker.comparisonFormData,
        preservedQuery: comparePicker.preservedQuery,
        locale: app.request.locale,
        searchUrl: comparePicker.searchUrl,
        referenceLabelA: comparePicker.referenceLabelA,
        referenceDetailA: comparePicker.referenceDetailA,
        subjectADimension: comparePicker.subjectA.dimension.value,
        subjectAId: comparePicker.subjectA.id ~ '',
        subjectBDimension: comparePicker.subjectB ? comparePicker.subjectB.dimension.value : '',
        subjectBId: comparePicker.subjectB ? comparePicker.subjectB.id ~ '' : '',
        subjectBLabel: comparePicker.subjectB ? comparePicker.subjectB.label : '',
        key: modalId,
    }) }}
</twig:Modal>
