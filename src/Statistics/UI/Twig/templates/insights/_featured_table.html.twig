{% if rows is empty %}
    <div data-testid="{{ emptyTestId }}">
        <twig:EmptyState
            title="{{ 'stats.insights.empty.title'|trans({}, 'statistics') }}"
            description="{{ 'stats.insights.empty.subtitle'|trans({}, 'statistics') }}"
            icon="tabler:chart-bar-off"
        >
            <twig:block name="actions">
                <button type="button" class="btn btn-primary" onclick="document.getElementById('statistics-analysis-context-trigger')?.click()">{{ 'empty.context.cta'|trans({}, 'shared') }}</button>
            </twig:block>
        </twig:EmptyState>
    </div>
{% else %}
    <twig:Statistics:RankingTable
        rankHeader="{{ 'stats.top_lists.table.rank'|trans({}, 'statistics') }}"
        labelHeader="{{ labelKey|trans({}, 'statistics') }}"
        countHeader="{{ 'stats.top_lists.table.count'|trans({}, 'statistics') }}"
        shareHeader="{{ 'stats.top_lists.table.share'|trans({}, 'statistics') }}"
        :rows="ranking_table_insight_rows(rows, 'stats-insights-featured-row-explore')"
    />
{% endif %}
