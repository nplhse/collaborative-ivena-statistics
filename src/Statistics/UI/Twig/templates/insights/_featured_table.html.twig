{% if rows is empty %}
    <div data-testid="{{ emptyTestId }}">
        <twig:EmptyState
            title="{{ 'stats.insights.empty.title'|trans({}, 'statistics') }}"
            description="{{ 'stats.insights.empty.subtitle'|trans({}, 'statistics') }}"
            icon="tabler:chart-bar-off"
        >
            <twig:block name="actions">
                <button type="button" class="btn btn-primary" onclick="document.getElementById('statistics-analysis-context-trigger')?.click()">{{ 'empty.context.cta'|trans({}, 'shared') }}</button>
            </twig:block>
        </twig:EmptyState>
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped mb-0">
            <thead>
                <tr>
                    <th>{{ 'stats.top_lists.table.rank'|trans({}, 'statistics') }}</th>
                    <th>{{ labelKey|trans({}, 'statistics') }}</th>
                    <th class="text-end">{{ 'stats.top_lists.table.count'|trans({}, 'statistics') }}</th>
                    <th class="text-end">{{ 'stats.top_lists.table.share'|trans({}, 'statistics') }}</th>
                    <th class="w-1" aria-label="{{ 'stats.insights.table.actions'|trans({}, 'statistics') }}"></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.rank }}</td>
                        <td><a href="{{ row.url }}">{{ row.label }}</a></td>
                        <td class="text-end">{{ row.count|number_format(0, ',', '.') }}</td>
                        <td class="text-end">{{ row.shareDisplay }}</td>
                        <td class="w-1">
                            {{ include('@Statistics/insights/_table_icon_action.html.twig', {
                                href: row.exploreUrl,
                                icon: 'tabler:book-2',
                                labelKey: 'stats.indication.nav.catalog',
                                testId: 'stats-insights-featured-row-explore',
                            }) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
