{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ provider.labelTranslationKey|trans({}, 'statistics') }} – {{ 'link.stats.insights'|trans({}, 'shared') }} – {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include('@Shared/_includes/subnav_stats.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <div class="d-flex align-items-start justify-content-between gap-3">
            <twig:Breadcrumbs :items="[
                { label: 'link.statistics', path: path('app_stats_dashboard') },
                { label: 'link.stats.insights', path: path('app_stats_insights') },
                { label: provider.labelTranslationKey }
            ]" />

            <div class="flex-shrink-0 d-print-none mt-2">
                {{ include('@Statistics/_data_quality_indicator.html.twig') }}
            </div>
        </div>

        <div class="page-header d-print-none">
            <div class="row g-2 align-items-center">
                <div class="col min-w-0">
                    <div class="page-pretitle">{{ 'stats.insights.dimension.pretitle'|trans({}, 'statistics') }}</div>
                    <h2 class="page-title mb-0" data-testid="stats-insights-dimension-title">
                        {{ provider.labelTranslationKey|trans({}, 'statistics') }}
                    </h2>
                </div>
                {{ include('@Statistics/_header_controls.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    {{ include('@Statistics/_data_quality_drawer.html.twig') }}
    {{ include('@Statistics/insights/_subnav.html.twig') }}

    <div class="card insights-directory-card" data-testid="stats-insights-directory">
        {% if showGroupsToggle %}
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs align-items-center" role="tablist" data-testid="stats-insights-indication-toggle">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link{% if not groupsView %} active{% endif %}"
                           href="{{ indicationsUrl }}"
                           {% if not groupsView %}aria-current="page"{% endif %}>
                            {{ 'stats.insights.dimension.indications.label'|trans({}, 'statistics') }}
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link{% if groupsView %} active{% endif %}"
                           href="{{ groupsUrl }}"
                           {% if groupsView %}aria-current="page"{% endif %}
                           data-testid="stats-insights-groups-toggle">
                            {{ 'stats.insights.dimension.indication_groups.label'|trans({}, 'statistics') }}
                        </a>
                    </li>
                    <li class="nav-item ms-auto">
                        <div class="insights-directory-header-tools d-flex align-items-center gap-2">
                            {{ include('@Statistics/insights/_directory_toolbar.html.twig') }}
                        </div>
                    </li>
                </ul>
            </div>
        {% else %}
            <div class="card-body py-2 border-bottom" data-testid="stats-insights-directory-toolbar">
                <div class="insights-directory-header-tools d-flex align-items-center justify-content-end">
                    {{ include('@Statistics/insights/_directory_toolbar.html.twig') }}
                </div>
            </div>
        {% endif %}

        {% if directory.rows is empty %}
            <div class="card-body" data-testid="stats-insights-directory-empty">
                <twig:EmptyState
                    title="{{ (searchQuery is not empty ? 'stats.insights.directory.no_results' : 'stats.insights.empty.title')|trans({}, 'statistics') }}"
                    description="{{ (searchQuery is not empty ? 'stats.insights.directory.no_results_help' : 'stats.insights.empty.subtitle')|trans({}, 'statistics') }}"
                    icon="{{ searchQuery is not empty ? 'tabler:filter-off' : 'tabler:chart-bar-off' }}"
                >
                    <twig:block name="actions">
                        {% if searchQuery is not empty %}
                            <a class="btn btn-primary" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all|filter((value, key) => key != 'search'))) }}" target="_top">{{ 'empty.filtered.cta'|trans({}, 'shared') }}</a>
                        {% else %}
                            <button type="button" class="btn btn-primary" onclick="document.getElementById('statistics-analysis-context-trigger')?.click()">{{ 'empty.context.cta'|trans({}, 'shared') }}</button>
                        {% endif %}
                    </twig:block>
                </twig:EmptyState>
            </div>
        {% else %}
            <twig:Statistics:RankingTable
                rankHeader="{{ 'stats.top_lists.table.rank'|trans({}, 'statistics') }}"
                labelHeader="{{ provider.labelTranslationKey|trans({}, 'statistics') }}"
                countHeader="{{ 'stats.top_lists.table.count'|trans({}, 'statistics') }}"
                shareHeader="{{ 'stats.top_lists.table.share'|trans({}, 'statistics') }}"
                :rows="ranking_table_insight_rows(directory.rows, 'stats-insights-row-explore')"
            />
        {% endif %}

        {{ include('@Statistics/insights/_directory_footer.html.twig') }}
    </div>
{% endblock %}
