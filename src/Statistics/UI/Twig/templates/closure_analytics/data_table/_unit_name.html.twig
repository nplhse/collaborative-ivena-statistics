{% set query = context.query|default({})|merge({
    hospitalId: row.hospitalId,
    unit: row.name,
    unitsPage: null,
    unitsLimit: null,
    unitsSort: null,
    unitsOrder: null,
}) %}
{% if row.hospitalId %}
    <a href="{{ path('app_stats_closure_profile_unit', query) }}"
       data-testid="stats-closure-unit-profile-link">
        <span class="text-break" data-testid="stats-closure-unit-name">{{ row.name }}</span>
    </a>
{% else %}
    <span class="text-break" data-testid="stats-closure-unit-name">{{ row.name }}</span>
{% endif %}
