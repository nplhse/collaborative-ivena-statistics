{% set query = context.query|default({})|merge({
    closureUnits: [row.key],
    unitsPage: null,
    unitsLimit: null,
    unitsSort: null,
    unitsOrder: null,
}) %}
{% if context.linkUnits|default(false) %}
    <a href="{{ path('app_stats_closure_analytics_timeline', query) }}"
       data-testid="stats-closure-unit-timeline-link">
        <span class="text-break" data-testid="stats-closure-unit-name">{{ row.name }}</span>
        <twig:ux:icon name="tabler:arrow-right" class="icon ms-1" />
    </a>
{% else %}
    <span class="text-break" data-testid="stats-closure-unit-name">{{ row.name }}</span>
{% endif %}
