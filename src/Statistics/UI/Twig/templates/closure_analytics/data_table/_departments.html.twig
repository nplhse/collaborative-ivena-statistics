<div data-testid="closure-event-facet-departments">
    {% if row.hasChildren is defined and row.hasChildren and row.children is not empty %}
        {{ include('@Statistics/closure_analytics/data_table/_child_preview.html.twig') }}
    {% elseif value is iterable and value|length == 1 %}
        <span class="text-truncate d-inline-block mw-100" title="{{ value[0] }}">{{ value[0] }}</span>
    {% elseif value is iterable and value|length > 1 %}
        {{ include('@Statistics/closure_analytics/data_table/_facet_stack.html.twig', {
            items: value|map(label => {label: label, class: 'bg-secondary-lt text-secondary'}),
            testId: 'closure-event-department-stack',
        }) }}
    {% else %}
        <span class="text-secondary">—</span>
    {% endif %}
</div>
