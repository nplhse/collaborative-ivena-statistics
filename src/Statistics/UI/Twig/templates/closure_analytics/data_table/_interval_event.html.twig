{% set route = row.eventType.value == 'single' ? 'app_stats_closure_analytics_interval' : 'app_stats_closure_analytics_event' %}
{% set routeParameters = row.eventType.value == 'single' ? {id: row.id} : {eventKey: row.eventKey} %}
<a
    href="{{ path(route, app.request.query.all|merge(routeParameters)|merge({page: null})) }}"
    target="_top"
    class="badge text-decoration-none {{ row.grouped ? 'bg-blue-lt text-blue' : (row.clustered ? 'bg-azure-lt text-azure' : 'bg-purple-lt text-purple-lt-fg') }}"
    {% if row.grouped %}title="{{ row.sourceGroupId }}"{% endif %}
>
    {{ ('stats.closure.events.' ~ row.eventType.value)|trans({}, 'statistics') }}
</a>
