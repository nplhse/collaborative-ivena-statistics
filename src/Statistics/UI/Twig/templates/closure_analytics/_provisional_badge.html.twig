{% if reason %}
    <span class="badge bg-yellow-lt text-yellow-lt-fg"
          title="{{ ('stats.closure.result_state.reason.' ~ reason.value)|trans({}, 'statistics') }}"
          data-testid="closure-event-provisional">
        {{ 'stats.closure.result_state.provisional'|trans({}, 'statistics') }}
    </span>
{% endif %}
