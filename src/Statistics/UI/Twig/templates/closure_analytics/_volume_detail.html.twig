<section class="mt-3" data-testid="stats-closure-volume-detail">
    {% if volumeScopeToggle|default(false) and volumeDetail.built and volumeDetail.applicable %}
        {% set scopeParams = app.request.query.all|merge({tab: 'course', population: null}) %}
        {% set departmentScopeParams = scopeParams|merge({volumeSeries: null}) %}
        {% set specialityScopeParams = scopeParams|merge({volumeSeries: 'speciality'}) %}
        <div class="btn-group w-100 w-md-auto mb-3" role="group" aria-label="{{ 'stats.closure.volume.scope.group'|trans({}, 'statistics') }}" data-testid="stats-closure-volume-series-scope">
            <a class="btn {{ volumeSeriesScope.value|default('department') == 'department' ? 'btn-primary' : 'btn-outline-secondary' }}"
               href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(departmentScopeParams)) }}">
                {{ 'stats.closure.volume.scope.departments'|trans({}, 'statistics') }}
            </a>
            <a class="btn {{ volumeSeriesScope.value|default('department') == 'speciality' ? 'btn-primary' : 'btn-outline-secondary' }}"
               href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(specialityScopeParams)) }}">
                {{ 'stats.closure.volume.scope.speciality_field'|trans({}, 'statistics') }}
            </a>
        </div>
    {% endif %}
    <div class="mb-3">
        <h3 class="mb-0">{{ 'stats.closure.volume.detail_title'|trans({}, 'statistics') }}</h3>
        <p class="text-muted small mb-0 mt-2">
            {% if volumeSeriesScope.value|default('department') == 'speciality' %}
                {{ 'stats.closure.volume.detail_series_lead_speciality'|trans({}, 'statistics') }}
            {% else %}
                {{ 'stats.closure.volume.detail_series_lead'|trans({}, 'statistics') }}
            {% endif %}
        </p>
        {% if volumeDetail.comparisonMetrics is not empty %}
            {% set metricLabels = {emergency: 'sk1', inpatient: 'sk2', outpatient: 'sk3', resus: 'resus', cathlab: 'cathlab'} %}
            <p class="text-muted small mb-0 mt-1" data-testid="stats-closure-volume-metric-relevance">
                {{ 'stats.closure.volume.metrics_closed'|trans({metrics: volumeDetail.closedMetrics|map(m => ('stats.closure.volume.stratum.' ~ metricLabels[m.value])|trans({}, 'statistics'))|join(', ')}, 'statistics') }}
                {{ 'stats.closure.volume.metrics_comparison'|trans({metrics: volumeDetail.comparisonMetrics|map(m => ('stats.closure.volume.stratum.' ~ metricLabels[m.value])|trans({}, 'statistics'))|join(', ')}, 'statistics') }}
            </p>
        {% endif %}
    </div>
    {% if not volumeDetail.built %}
        <div class="card"><div class="card-body text-muted">{{ 'stats.closure.volume.not_built'|trans({}, 'statistics') }}</div></div>
    {% elseif not volumeDetail.applicable %}
        <div class="card" data-testid="stats-closure-volume-not-applicable"><div class="card-body text-muted">{{ 'stats.closure.volume.not_applicable'|trans({}, 'statistics') }}</div></div>
    {% else %}
        <div class="row row-deck row-cards g-3 mb-3">
            <div class="col-12 col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="subheader">{{ 'stats.closure.volume.expected'|trans({}, 'statistics') }}</div>
                    <div class="h1 mt-2 mb-0">{{ volumeDetail.during and volumeDetail.during.expectedArea is not null ? volumeDetail.during.expectedArea|number_format(1, ',', '.') : '—' }}</div>
                </div></div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="subheader">{{ 'stats.closure.volume.observed'|trans({}, 'statistics') }}</div>
                    <div class="h1 mt-2 mb-0">{{ volumeDetail.during and volumeDetail.during.observedArea is not null ? volumeDetail.during.observedArea|number_format(1, ',', '.') : '—' }}</div>
                </div></div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card h-100" data-testid="stats-closure-volume-detail-deviation"><div class="card-body">
                    <div class="subheader">{{ 'stats.closure.volume.deviation'|trans({}, 'statistics') }}</div>
                    <div class="h1 mt-2 mb-0">
                        {% if volumeDetail.during is null or volumeDetail.during.absoluteDeviation is null %}—{% else %}{{ volumeDetail.during.absoluteDeviation > 0 ? '+' : '' }}{{ volumeDetail.during.absoluteDeviation|number_format(1, ',', '.') }}{% endif %}
                    </div>
                    <div class="text-muted small">
                        {% if volumeDetail.during is null or volumeDetail.during.relativeDeviation is null %}
                            {{ 'stats.closure.volume.relative_unavailable'|trans({}, 'statistics') }}
                        {% else %}
                            {{ volumeDetail.during.relativeDeviation > 0 ? '+' : '' }}{{ (volumeDetail.during.relativeDeviation * 100)|number_format(1, ',', '.') }} %
                        {% endif %}
                    </div>
                </div></div>
            </div>
        </div>

        {% set volumeChartLabels = {
            observedLabel: 'stats.closure.volume.observed.legend'|trans({}, 'statistics'),
            expectedLabel: 'stats.closure.volume.expected.legend'|trans({}, 'statistics'),
            areaRatioLabel: 'stats.closure.volume.area_ratio'|trans({}, 'statistics'),
            hospitalRatioLabel: 'stats.closure.volume.hospital_ratio'|trans({}, 'statistics'),
            closureBandLabel: 'stats.closure.volume.closure_band'|trans({}, 'statistics'),
            otherClosureHint: 'stats.closure.volume.other_closure'|trans({}, 'statistics'),
            assignmentsAxisLabel: 'stats.closure.volume.assignments_axis'|trans({}, 'statistics'),
            ratioAxisLabel: 'stats.closure.volume.ratio_axis'|trans({}, 'statistics'),
            expectationLineLabel: 'stats.closure.volume.expectation_line'|trans({}, 'statistics'),
            startMarkerLabel: 'stats.closure.volume.marker.start'|trans({}, 'statistics'),
            endMarkerLabel: 'stats.closure.volume.marker.end'|trans({}, 'statistics'),
            ongoingMarkerLabel: 'stats.closure.volume.marker.ongoing'|trans({}, 'statistics'),
            gapLabel: 'stats.closure.volume.gap_label'|trans({hours: volumeDetail.chart.hiddenHours|default(0)}, 'statistics'),
            gapShortLabel: 'stats.closure.volume.gap_short_label'|trans({hours: volumeDetail.chart.hiddenHours|default(0)}, 'statistics'),
            influencedLabel: 'stats.closure.volume.quality.influenced'|trans({}, 'statistics'),
        } %}
        {% if volumeSeriesScope.value|default('department') == 'department' %}
            {% set volumeChartLabels = volumeChartLabels|merge({
                referenceAreaRatioLabel: 'stats.closure.volume.reference_area_ratio'|trans({}, 'statistics'),
            }) %}
        {% endif %}
        {% set volumeChartEmpty = volumeDetail.chart.categories is empty %}
        <div data-controller="closure-analytics-charts"
             data-closure-analytics-charts-payload-value="{{ {
                volume: volumeDetail.chart|merge(volumeChartLabels),
                otherClosures: volumeDetail.otherClosures,
             }|json_encode|e('html_attr') }}">
            {% if not volumeChartEmpty and volumeDetail.chart.gapIndex is not null %}
                <p class="text-muted small mb-2" data-testid="stats-closure-volume-gap-hint">
                    {{ 'stats.closure.volume.gap_hint'|trans({outside: constant('App\\Statistics\\ClosureAnalytics\\Application\\Volume\\ClosureVolumeReferenceConfig::CONTEXT_HOURS'), inside: constant('App\\Statistics\\ClosureAnalytics\\Application\\Volume\\ClosureVolumeReferenceConfig::INNER_FOCUS_HOURS'), hours: volumeDetail.chart.hiddenHours}, 'statistics') }}
                </p>
            {% endif %}
            <div class="card mb-3 closure-volume-chart-card" data-testid="stats-closure-volume-chart-card">
                <div class="card-header flex-column align-items-start">
                    <h3 class="card-title mb-0">{{ 'stats.closure.volume.chart_title'|trans({}, 'statistics') }}</h3>
                    <div class="text-muted small mt-1">{{ 'stats.closure.volume.chart_question'|trans({}, 'statistics') }}</div>
                </div>
                <div class="card-body">
                    {% if volumeChartEmpty %}
                        <p class="text-muted mb-0">{{ 'stats.closure.volume.chart_empty'|trans({}, 'statistics') }}</p>
                    {% else %}
                        <div data-closure-analytics-charts-target="volumeChart" style="min-height: 320px"></div>
                        <p class="text-muted small mb-0 mt-2" data-testid="stats-closure-volume-chart-legend">{{ 'stats.closure.volume.chart_closure_legend'|trans({}, 'statistics') }}</p>
                        <details class="closure-chart-help mt-2" data-testid="stats-closure-volume-chart-help">
                            <summary>{{ 'stats.closure.chart_help.summary'|trans({}, 'statistics') }}</summary>
                            <ul class="text-muted small mb-0 mt-2 ps-3">
                                <li>{{ 'stats.closure.volume.help.point'|trans({}, 'statistics') }}</li>
                                <li>{{ 'stats.closure.volume.help.observed'|trans({}, 'statistics') }}</li>
                                <li>{{ 'stats.closure.volume.help.expected'|trans({before: volumeDetail.referenceWindow.weeksBefore, after: volumeDetail.referenceWindow.weeksAfter, slots: volumeDetail.minimumReferenceSlots}, 'statistics') }}</li>
                                <li>{{ 'stats.closure.volume.help.reading'|trans({}, 'statistics') }}</li>
                            </ul>
                        </details>
                    {% endif %}
                </div>
            </div>
            <div class="card mb-3 closure-volume-chart-card" data-testid="stats-closure-volume-ratio-card">
                <div class="card-header flex-column align-items-start">
                    <h3 class="card-title mb-0">{{ 'stats.closure.volume.ratio_title'|trans({}, 'statistics') }}</h3>
                    <div class="text-muted small mt-1">{{ 'stats.closure.volume.ratio_question'|trans({}, 'statistics') }}</div>
                </div>
                <div class="card-body">
                    {% if volumeChartEmpty %}
                        <p class="text-muted mb-0">{{ 'stats.closure.volume.chart_empty'|trans({}, 'statistics') }}</p>
                    {% else %}
                        <div data-closure-analytics-charts-target="volumeRatioChart" style="min-height: 260px"></div>
                        <details class="closure-chart-help mt-2" data-testid="stats-closure-volume-ratio-help">
                            <summary>{{ 'stats.closure.chart_help.summary'|trans({}, 'statistics') }}</summary>
                            <ul class="text-muted small mb-0 mt-2 ps-3">
                                <li>{{ 'stats.closure.volume.help.ratio'|trans({}, 'statistics') }}</li>
                                <li>{{ 'stats.closure.volume.help.ratio_lines'|trans({}, 'statistics') }}</li>
                                <li>{{ 'stats.closure.volume.ratio_hint'|trans({}, 'statistics') }}</li>
                            </ul>
                        </details>
                    {% endif %}
                </div>
            </div>
        </div>

        {{ include('@Statistics/closure_analytics/_volume_windows_table.html.twig') }}
    {% endif %}
</section>
