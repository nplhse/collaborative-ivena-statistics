<div data-testid="stats-closure-breakdowns">
    <div class="row g-3 align-items-start">
        {% for kind, title in {
            hospital: 'stats.closure.breakdown.hospital',
            speciality: 'stats.closure.breakdown.speciality',
            department: 'stats.closure.breakdown.department',
        } %}
            <div class="col-12 col-lg-4">
                {{ include('@Statistics/closure_analytics/_breakdown_card.html.twig', {
                    kind: kind,
                    title: title,
                    rows: dashboard.breakdowns[kind],
                    totalMinutes: dashboard.metrics.closedMinutes,
                    expandable: true,
                }, false) }}
            </div>
        {% endfor %}
    </div>

    <div class="mt-3" data-testid="stats-closure-units">
        <twig:DataTable
            title="{{ 'stats.closure.breakdown.closure_unit'|trans({}, 'statistics') }}"
            :paginator="closureUnits"
            paginationRoute="app_stats_closure_analytics"
            :sortBy="closureUnitTable.sortBy"
            :orderBy="closureUnitTable.orderBy"
            :columns="closureUnitColumns"
            columnVisibilityEnabled
            columnOrderingEnabled
            persistSort
            :visibleColumnKeys="closureUnitPreferences.visibleColumns"
            :columnOrder="closureUnitPreferences.columnOrder"
            pageParam="unitsPage"
            limitParam="unitsLimit"
            sortByParam="unitsSort"
            orderByParam="unitsOrder"
            columnVisibilityParam="unitsColumns"
            columnOrderParam="unitsColumnOrder"
            :preferenceKey="closureUnitPreferencesPersisted ? closureUnitPreferenceKey : null"
            :preferenceSaveUrl="closureUnitPreferencesPersisted ? path('app_data_table_preferences_save') : null"
            :preferenceCsrfToken="closureUnitPreferencesPersisted ? csrf_token('data_table_preference_' ~ closureUnitPreferenceKey) : null"
            :preferenceReturnUrl="closureUnitPreferencesPersisted ? app.request.requestUri : null"
            :cellContext="{
                linkUnits: statisticsFilter.scope.value in ['hospital', 'my_hospitals'],
                query: app.request.query.all,
            }"
        />
    </div>
</div>
