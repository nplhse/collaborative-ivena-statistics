{% macro row(row, kind, totalMinutes, totalClosures, shareMode, countTranslation) %}
    {% set labelKey = kind == 'event_type'
        ? 'stats.closure.events.' ~ row.key
        : (kind in ['care_level', 'reason'] ? 'stats.closure.' ~ kind ~ '.' ~ row.key : null) %}
    {% set countMode = shareMode|default('duration') == 'count' %}
    {% set percent = countMode
        ? (totalClosures > 0 ? row.closureCount / totalClosures * 100 : 0)
        : (totalMinutes > 0 ? row.actualMinutes / totalMinutes * 100 : 0) %}
    {% set countKey = countTranslation|default('stats.closure.breakdown.closure_count') %}
    {% set profileUrl = null %}
    {% if kind == 'hospital' %}
        {% set profileUrl = path('app_stats_closure_profile_hospital', app.request.query.all|merge({hospitalId: row.key})) %}
    {% elseif kind == 'speciality' and row.hospitalId %}
        {% set profileUrl = path('app_stats_closure_profile_speciality', app.request.query.all|merge({hospitalId: row.hospitalId, specialityId: row.key})) %}
    {% elseif kind == 'speciality' %}
        {% set profileUrl = path('app_stats_closure_profile_speciality_scope', app.request.query.all|merge({specialityId: row.key})) %}
    {% elseif kind == 'department' and row.hospitalId %}
        {% set profileUrl = path('app_stats_closure_profile_department', app.request.query.all|merge({hospitalId: row.hospitalId, departmentId: row.key})) %}
    {% elseif kind == 'department' %}
        {% set profileUrl = path('app_stats_closure_profile_department_scope', app.request.query.all|merge({departmentId: row.key})) %}
    {% endif %}
    <div>
        <div class="d-flex justify-content-between align-items-baseline gap-2">
            <span class="text-truncate">
                {% if kind == 'event_type' %}
                    <span class="badge {{ row.key == 'group' ? 'bg-blue-lt text-blue' : (row.key == 'cluster' ? 'bg-azure-lt text-azure' : 'bg-purple-lt text-purple-lt-fg') }}">
                        {{ labelKey|trans({}, 'statistics') }}
                    </span>
                {% elseif profileUrl %}
                    <a href="{{ profileUrl }}" class="text-reset" data-testid="stats-closure-breakdown-link">{{ row.name }}</a>
                {% else %}
                    {{ labelKey ? labelKey|trans({}, 'statistics') : row.name }}
                {% endif %}
            </span>
            <strong class="text-nowrap">{{ percent|number_format(1, ',', '.') }}%</strong>
        </div>
        <div class="progress progress-sm mt-1 mb-1" aria-hidden="true">
            <div class="progress-bar bg-primary" style="width: {{ min(100, percent) }}%"></div>
        </div>
        <small class="text-secondary">
            {% if countMode %}
                {{ countKey|trans({count: row.closureCount}, 'statistics') }}
                · {{ row.actualMinutes|closure_duration }}
            {% else %}
                {{ row.actualMinutes|closure_duration }}
            {% endif %}
        </small>
    </div>
{% endmacro %}

{% import _self as breakdown %}

<div class="card{{ cardClass is defined ? ' ' ~ cardClass }}" data-testid="stats-closure-breakdown-{{ kind }}">
    <div class="card-header py-2">
        <h3 class="card-title mb-0">{{ title|trans({}, 'statistics') }}</h3>
    </div>
    <div class="card-body">
        <div class="closure-breakdown-rows">
            {% for row in rows|slice(0, 5) %}
                {{ breakdown.row(row, kind, totalMinutes, totalClosures|default(0), shareMode|default('duration'), countTranslation|default('stats.closure.breakdown.closure_count')) }}
            {% else %}
                <div class="text-secondary">—</div>
            {% endfor %}
        </div>
        {% if expandable|default(false) and rows|length > 5 %}
            <details class="closure-breakdown-details">
                <summary class="btn btn-link w-100 text-start px-0 py-1">
                    <span class="closure-breakdown-details__show">
                        {{ 'stats.closure.breakdown.show_all'|trans({count: rows|length}, 'statistics') }}
                    </span>
                    <span class="closure-breakdown-details__hide">
                        {{ 'stats.closure.breakdown.show_less'|trans({}, 'statistics') }}
                    </span>
                </summary>
                <div class="closure-breakdown-rows closure-breakdown-details__rows">
                    {% for row in rows|slice(5) %}
                        {{ breakdown.row(row, kind, totalMinutes, totalClosures|default(0), shareMode|default('duration'), countTranslation|default('stats.closure.breakdown.closure_count')) }}
                    {% endfor %}
                </div>
            </details>
        {% endif %}
    </div>
</div>
