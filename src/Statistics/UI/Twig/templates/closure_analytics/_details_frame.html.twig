<turbo-frame id="stats-closure-details" target="_top">
    <div class="card" data-testid="stats-closure-intervals">
        <div class="card-header">
            <h3 class="card-title">{{ 'stats.closure.events.title'|trans({}, 'statistics') }}</h3>
            <div class="card-actions text-muted">{{ dashboard.eventTotal|number_format(0, ',', '.') }}</div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr>
                    <th>{{ 'stats.closure.intervals.start'|trans({}, 'statistics') }}</th>
                    <th>{{ 'stats.closure.intervals.hospital'|trans({}, 'statistics') }}</th>
                    <th>{{ 'stats.closure.events.event'|trans({}, 'statistics') }}</th>
                    <th>{{ 'stats.closure.events.children'|trans({}, 'statistics') }}</th>
                    <th>{{ 'stats.closure.kpi.sum_duration'|trans({}, 'statistics') }}</th>
                    <th>{{ 'stats.closure.kpi.actual_duration'|trans({}, 'statistics') }}</th>
                </tr></thead>
                <tbody>
                {% for row in dashboard.events %}
                    <tr>
                        <td><a href="{{ path('app_stats_closure_analytics_event', app.request.query.all|merge({eventKey: row.key})) }}">{{ row.startsAt|date('d.m.Y H:i', 'Europe/Berlin') }}</a></td>
                        <td>{{ row.hospitalName }}</td>
                        <td>{{ row.grouped ? row.sourceGroupId : 'stats.closure.events.ungrouped'|trans({}, 'statistics') }}</td>
                        <td>{{ row.closureCount }}</td>
                        <td>{{ row.summedMinutes|closure_duration }}</td>
                        <td>{{ row.actualMinutes|closure_duration }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% if dashboard.pages > 1 %}
            <div class="card-footer d-flex justify-content-between">
                {% if dashboard.page > 1 %}<a data-turbo-frame="stats-closure-details" class="btn btn-outline-secondary" href="{{ path('app_stats_closure_analytics_details', app.request.query.all|merge({page: dashboard.page - 1})) }}">‹</a>{% else %}<span></span>{% endif %}
                <span class="text-muted">{{ dashboard.page }} / {{ dashboard.pages }}</span>
                {% if dashboard.page < dashboard.pages %}<a data-turbo-frame="stats-closure-details" class="btn btn-outline-secondary" href="{{ path('app_stats_closure_analytics_details', app.request.query.all|merge({page: dashboard.page + 1})) }}">›</a>{% endif %}
            </div>
        {% endif %}
    </div>
</turbo-frame>
