<nav class="overflow-x-auto mb-4"
     aria-label="{{ 'stats.closure.tabs.label'|trans({}, 'statistics') }}"
     data-testid="stats-closure-tabs">
    <ul class="nav nav-tabs flex-nowrap" role="tablist">
        {% for tab in closureAnalyticsTabs %}
            <li class="nav-item" role="presentation">
                <a class="nav-link{{ closureAnalyticsActiveTab == tab.key ? ' active' }}"
                   href="{{ tab.url }}"
                   {% if closureAnalyticsActiveTab == tab.key %}aria-current="page"{% endif %}
                   data-testid="stats-closure-tab-{{ tab.key }}">
                    {{ tab.label|trans({}, 'statistics') }}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
