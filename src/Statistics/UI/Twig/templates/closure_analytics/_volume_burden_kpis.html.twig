{# Volume burden KPIs, loaded by the overview in the stats-closure-volume-burden frame. #}
<div class="row row-deck row-cards g-3 h-100">
    <div class="col-12 col-lg-6">
        <div class="card h-100" data-testid="stats-closure-kpi-deviation"><div class="card-body">
            <div class="subheader">{{ 'stats.closure.kpi.volume_deviation'|trans({}, 'statistics') }}</div>
            <div class="d-flex align-items-baseline gap-2 mt-2 mb-0">
                <div class="h1 mb-0">
                    {% if volume is null or not volume.built or volume.absoluteDeviation is null %}
                        —
                    {% else %}
                        {{ volume.absoluteDeviation > 0 ? '+' : '' }}{{ volume.absoluteDeviation|number_format(1, ',', '.') }}
                    {% endif %}
                </div>
                {% if volume and volume.built and volume.relativeDeviation is not null %}
                    <div class="text-muted">{{ volume.relativeDeviation > 0 ? '+' : '' }}{{ (volume.relativeDeviation * 100)|number_format(1, ',', '.') }} %</div>
                {% endif %}
            </div>
            {% if volume and volume.built and volume.relativeDeviation is null %}
                <div class="text-muted small">{{ 'stats.closure.volume.relative_unavailable'|trans({}, 'statistics') }}</div>
            {% elseif volume and not volume.built %}
                <div class="text-muted small">{{ 'stats.closure.volume.not_built'|trans({}, 'statistics') }}</div>
            {% endif %}
            {% if volume and volume.built %}
                <div class="text-muted small">
                    {{ 'stats.closure.kpi.volume_pair'|trans({
                        expected: volume.expectedArea is null ? '—' : volume.expectedArea|number_format(1, ',', '.'),
                        observed: volume.observedArea is null ? '—' : volume.observedArea|number_format(1, ',', '.'),
                    }, 'statistics') }}
                </div>
            {% endif %}
        </div></div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card h-100" data-testid="stats-closure-kpi-share"><div class="card-body">
            <div class="subheader">{{ 'stats.closure.volume.share'|trans({}, 'statistics') }}</div>
            <div class="h1 mt-2 mb-0">
                {% if volume is null or not volume.built or volume.share is null %}
                    —
                {% else %}
                    {{ (volume.share * 100)|number_format(1, ',', '.') }} %
                {% endif %}
            </div>
            <div class="text-muted small">
                {% if volume and volume.built and volume.expectedHospital is not null %}
                    {{ 'stats.closure.volume.share_hint'|trans({hospital: volume.expectedHospital|number_format(1, ',', '.')}, 'statistics') }}
                {% elseif volume and volume.built %}
                    {{ 'stats.closure.volume.share_unavailable'|trans({}, 'statistics') }}
                {% endif %}
            </div>
        </div></div>
    </div>
</div>
