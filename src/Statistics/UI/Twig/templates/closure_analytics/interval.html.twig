{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ interval.departmentName }} – {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}{{ include('@Shared/_includes/subnav_stats.html.twig') }}{% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs :items="[
            { label: 'link.statistics', path: path('app_stats_dashboard') },
            { label: 'stats.closure.title', path: path('app_stats_closure_analytics', app.request.query.all) },
            { label: interval.departmentName }
        ]" />
        <div class="row align-items-center">
            <div class="col-auto">
                <span class="avatar avatar-lg rounded">
                    <twig:ux:icon name="tabler:calendar-off" width="36px" height="36px" />
                </span>
            </div>
            <div class="col">
                <h1 class="fw-bold" data-testid="closure-event-title">{{ interval.departmentName }}</h1>
                <div class="list-inline list-inline-dots text-muted">
                    <div class="list-inline-item">{{ interval.hospitalName }}</div>
                    <div class="list-inline-item">{{ interval.specialityName }}</div>
                    <div class="list-inline-item">
                        {{ interval.startsAt|date('d.m.Y H:i', 'Europe/Berlin') }}
                        –
                        {{ interval.endsAt|date('d.m.Y H:i', 'Europe/Berlin') }}
                    </div>
                </div>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <a class="btn" href="{{ path('app_stats_closure_analytics_events', app.request.query.all) }}">
                        <twig:ux:icon name="tabler:chevron-left" class="me-2" width="1em" height="1em" />
                        {{ 'label.back_to_list'|trans({}, 'messages') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    <div class="row g-3" data-testid="stats-closure-interval-detail">
        <div class="col-lg-8">
            <twig:Card class="mb-3" title="{{ 'stats.closure.event.timeline'|trans({}, 'statistics') }}" :body="false">
                {{ include('@Statistics/closure_analytics/_day_timeline.html.twig', {timelineEventKey: interval.eventKey}) }}
            </twig:Card>

            <twig:Card>
                <div class="card-title">{{ 'stats.closure.interval.title'|trans({}, 'statistics') }}</div>
                <dl class="row mb-0">
                    <dt class="col-sm-4">{{ 'stats.closure.intervals.start'|trans({}, 'statistics') }}</dt>
                    <dd class="col-sm-8">{{ interval.startsAt|date('d.m.Y H:i', 'Europe/Berlin') }}</dd>
                    <dt class="col-sm-4">{{ 'stats.closure.interval.end'|trans({}, 'statistics') }}</dt>
                    <dd class="col-sm-8">{{ interval.endsAt|date('d.m.Y H:i', 'Europe/Berlin') }}</dd>
                    <dt class="col-sm-4">{{ 'stats.closure.intervals.duration'|trans({}, 'statistics') }}</dt>
                    <dd class="col-sm-8">{{ interval.durationMinutes|closure_duration }}</dd>
                    <dt class="col-sm-4">{{ 'stats.closure.breakdown.speciality'|trans({}, 'statistics') }}</dt>
                    <dd class="col-sm-8">{{ interval.specialityName }}</dd>
                    <dt class="col-sm-4">SK</dt>
                    <dd class="col-sm-8">{{ ('stats.closure.care_level.' ~ interval.careLevel)|trans({}, 'statistics') }}</dd>
                    <dt class="col-sm-4">{{ 'stats.closure.intervals.reason'|trans({}, 'statistics') }}</dt>
                    <dd class="col-sm-8">{{ ('stats.closure.reason.' ~ interval.reason)|trans({}, 'statistics') }}</dd>
                    <dt class="col-sm-4">{{ 'stats.closure.breakdown.closure_unit'|trans({}, 'statistics') }}</dt>
                    <dd class="col-sm-8">{{ interval.closureUnit ?: '—' }}</dd>
                    <dt class="col-sm-4">{{ 'stats.closure.interval.group_id'|trans({}, 'statistics') }}</dt>
                    <dd class="col-sm-8">{{ interval.sourceGroupId ?: '—' }}</dd>
                </dl>
            </twig:Card>

            {{ include('@Statistics/closure_analytics/_overlapping_allocations.html.twig') }}
            {{ include('@Statistics/closure_analytics/_volume_detail.html.twig') }}
        </div>
        <div class="col-lg-4">
            {{ include('@Statistics/closure_analytics/_detail_actions.html.twig') }}
            <twig:Card data-testid="catalog-basic-info">
                <div class="card-title">{{ 'label.basic_info'|trans({}, 'messages') }}</div>
                <div class="mb-2">
                    <twig:ux:icon name="tabler:building-hospital" width="1.5em" height="1.5em" />
                    {{ 'label.hospital'|trans({}, 'messages') }} <strong>{{ interval.hospitalName }}</strong>
                </div>
                <div class="mb-2">
                    <twig:ux:icon name="tabler:stethoscope" width="1.5em" height="1.5em" />
                    {{ interval.specialityName }}
                </div>
            </twig:Card>
        </div>
    </div>
{% endblock %}
