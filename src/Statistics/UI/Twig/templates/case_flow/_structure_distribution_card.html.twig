{# @var card \App\Statistics\CaseFlow\Application\DTO\CaseFlowStructureDistributionCard #}
<div class="card" data-testid="{{ testId|default('stats-case-flow-structure-card') }}">
    <div class="card-body">
        <p class="mb-2">{{ card.titleTranslationKey|trans({}, 'statistics') }}</p>
        {% if card.segments is not empty %}
            <div class="progress progress-separated mb-3">
                {% for segment in card.segments %}
                    <div class="progress-bar {{ segment.barClass }}"
                         style="width: {{ segment.percent }}%"
                         aria-label="{{ segment.labelTranslationKey|trans({}, statistics_label_domain(segment.labelTranslationKey)) }}"></div>
                {% endfor %}
            </div>
            <div class="d-flex flex-column gap-2">
                {% for segment in card.segments %}
                    <div class="d-flex align-items-baseline gap-1">
                        <span class="legend flex-shrink-0 {{ segment.barClass }}"></span>
                        <span>{{ segment.labelTranslationKey|trans({}, statistics_label_domain(segment.labelTranslationKey)) }}</span>
                        <span class="text-muted text-nowrap">{{ segment.count|number_format(0, ',', '.') }}</span>
                        <span class="text-muted text-nowrap">{{ segment.percent }}%</span>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-muted small mb-0">{{ 'stats.case_flow.structure.empty'|trans({}, 'statistics') }}</p>
        {% endif %}
    </div>
</div>
