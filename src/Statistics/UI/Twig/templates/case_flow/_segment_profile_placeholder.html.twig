<div class="placeholder-glow" data-testid="stats-case-flow-segment-profile-placeholder" aria-busy="true">
    <div class="placeholder placeholder-xs col-6 mb-2"></div>
    <div class="placeholder placeholder-xs col-4 mb-3"></div>
    <div class="table-responsive">
        <table class="table table-sm table-vcenter mb-0 stats-case-flow-segment-dimension-table">
            <colgroup>
                <col class="stats-case-flow-segment-col-label">
                <col span="3" class="stats-case-flow-segment-col-metric">
            </colgroup>
            {% for row in 1..4 %}
                <tr>
                    <td><span class="placeholder placeholder-xs col-8"></span></td>
                    <td class="text-end"><span class="placeholder placeholder-xs col-4"></span></td>
                    <td class="text-end"><span class="placeholder placeholder-xs col-3"></span></td>
                    <td class="stats-top-lists-share-col">
                        <div class="progress progress-sm">
                            <div class="progress-bar" style="width: 0%"></div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </table>
    </div>
    <span class="visually-hidden">{{ 'stats.case_flow.segment.loading'|trans({}, 'statistics') }}</span>
</div>
