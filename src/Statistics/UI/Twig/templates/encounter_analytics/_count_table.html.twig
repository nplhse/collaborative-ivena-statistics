{# Table of OverviewCount rows: label, count, share of the stated denominator. #}
<div class="table-responsive">
    <table class="table card-table table-vcenter" data-testid="{{ testid }}">
        <thead>
            <tr>
                <th>{{ label_header }}</th>
                <th class="text-end">{{ 'stats.encounter.column.visits'|trans({}, 'statistics') }}</th>
                <th class="text-end">{{ 'stats.encounter.column.share'|trans({}, 'statistics') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr data-testid="{{ testid }}-row" data-key="{{ row.key }}">
                    <td>{{ labels[row.key] ?? row.key }}</td>
                    {{ include('@Statistics/encounter_analytics/_count_cell.html.twig', {row: row}) }}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
