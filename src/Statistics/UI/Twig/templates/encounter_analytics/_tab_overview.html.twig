{# Overview tab: four KPI cards, then 2/3 (visits over time, disposition, care level) and 1/3 (arrival route, MTS categories, top 10 presentations, data coverage). #}
{% set coverage = overview.coverage %}
{% set admitted = overview.dispositions|filter(r => r.key == 'admitted')|first %}
{% set physician = overview.processTimes[1] %}
{% set discharge = overview.processTimes[2] %}
{% set suppressed_label = 'encounter.mts.counts.suppressed'|trans({threshold: threshold}, d) %}
{% import _self as fmt %}
{% macro minutes(value) %}{{ value is null ? '–' : 'encounter.unit.minutes_decimal'|trans({minutes: value|round(1)}, 'encounter') }}{% endmacro %}

<div class="row row-deck row-cards mb-3" data-testid="encounter-overview-kpis">
    <div class="col-12 col-md-6 col-lg-3">
        {{ include('@Statistics/encounter_analytics/_kpi.html.twig', {
            key: 'visits',
            title: 'stats.encounter.kpi.visits'|trans({}, 'statistics'),
            value: coverage.visits|format_number,
        }) }}
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        {{ include('@Statistics/encounter_analytics/_kpi.html.twig', {
            key: 'admitted',
            title: 'stats.encounter.kpi.admitted'|trans({}, 'statistics'),
            value: admitted.share is not null ? admitted.share|format_number({fraction_digit: 1}) ~ ' %' : (admitted.count.suppressed ? suppressed_label : '–'),
            detail: admitted.count.value is not null ? 'stats.encounter.kpi.admitted_detail'|trans({admitted: admitted.count.value, visits: coverage.visits}, 'statistics') : null,
        }) }}
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        {{ include('@Statistics/encounter_analytics/_kpi.html.twig', {
            key: 'physician',
            title: 'stats.encounter.kpi.physician'|trans({}, 'statistics'),
            value: fmt.minutes(physician.median),
            detail: physician.suppressed ? 'stats.encounter.process.suppressed'|trans({threshold: threshold}, 'statistics') : 'stats.encounter.kpi.iqr'|trans({q1: physician.q1|round(1), q3: physician.q3|round(1)}, 'statistics'),
        }) }}
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        {{ include('@Statistics/encounter_analytics/_kpi.html.twig', {
            key: 'length_of_stay',
            title: 'stats.encounter.kpi.length_of_stay'|trans({}, 'statistics'),
            value: fmt.minutes(discharge.median),
            detail: discharge.suppressed ? 'stats.encounter.process.suppressed'|trans({threshold: threshold}, 'statistics') : 'stats.encounter.kpi.iqr'|trans({q1: discharge.q1|round(1), q3: discharge.q3|round(1)}, 'statistics'),
        }) }}
    </div>
</div>

<div class="row g-3 align-items-start">
    <div class="col-12 col-lg-8">
        <div class="d-grid gap-3">
            <div class="card" data-testid="encounter-time-series">
                {{ include('@Statistics/encounter_analytics/_card_header.html.twig', {
                    title: ('stats.encounter.time_series.title_' ~ overview.grain.value)|trans({}, 'statistics'),
                }) }}
                <div class="card-body">
                    {% if overview.timeSeries is empty %}
                        <p class="text-secondary mb-0" data-testid="encounter-time-series-empty">{{ 'stats.encounter.time_series.empty'|trans({}, 'statistics') }}</p>
                    {% else %}
                        {% set bucket_pattern = overview.grain.value == 'day' ? 'dd.MM.' : 'MMM yyyy' %}
                        <div data-controller="encounter-overview-chart" data-encounter-overview-chart-chart-value="{{ {
                            categories: overview.timeSeries|map(b => b.start|format_date(pattern: bucket_pattern)),
                            stacked: true,
                            height: 320,
                            series: ['ems', 'self', 'unknown']|map(route => {
                                name: route_labels[route],
                                color: {ems: '#206bc4', self: '#0ca678', unknown: '#adb5bd'}[route],
                                data: overview.timeSeries|map(b => b.routes[route].shownValue),
                            }),
                        }|json_encode|e('html_attr') }}"></div>
                    {% endif %}
                </div>
            </div>
            {{ include('@Statistics/encounter_analytics/_bar_list_card.html.twig', {
                testid: 'encounter-dispositions-card',
                title: 'stats.encounter.disposition.title'|trans({}, 'statistics'),
                rows: overview.dispositions,
                labels: disposition_labels,
                colors: {},
            }) }}
            {{ include('@Statistics/encounter_analytics/_bar_list_card.html.twig', {
                testid: 'encounter-care-levels-card',
                title: 'stats.encounter.care_level.title'|trans({}, 'statistics'),
                rows: overview.careLevels,
                labels: care_level_labels,
                colors: {},
            }) }}
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="d-grid gap-3">
            {{ include('@Statistics/encounter_analytics/_compact_distribution_card.html.twig', {
                testid: 'encounter-routes',
                title: 'stats.encounter.column.arrival_route'|trans({}, 'statistics'),
                segments: overview.routes,
                labels: route_labels,
                colors: route_colors,
            }) }}
            {{ include('@Statistics/encounter_analytics/_compact_distribution_card.html.twig', {
                testid: 'encounter-categories-bar',
                title: 'stats.encounter.mts.categories'|trans({}, 'statistics'),
                segments: overview.categories,
                labels: category_labels,
                colors: category_colors,
            }) }}
            {{ include('@Statistics/encounter_analytics/_bar_list_card.html.twig', {
                testid: 'encounter-top-diagrams',
                title: 'stats.encounter.mts.diagrams'|trans({top: overview.diagramsShown}, 'statistics'),
                rows: overview.diagrams|filter(r => r.key != 'other' and r.key != ''),
                labels: diagram_labels,
                colors: {},
                link: {url: path('app_stats_encounter_analytics', tabQuery|merge({tab: 'distributions'})), label: 'stats.encounter.show_all'|trans({}, 'statistics')},
            }) }}
            {{ include('@Statistics/encounter_analytics/_coverage_card.html.twig') }}
        </div>
    </div>
</div>
