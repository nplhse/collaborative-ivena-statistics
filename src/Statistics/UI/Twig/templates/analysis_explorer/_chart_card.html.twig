<div class="card mb-4"
     data-testid="stats-analysis-explorer-chart-card"
     {% if hasChart %}
     data-controller="generic-analysis-chart"
     data-generic-analysis-chart-specs-value="{{ chartSpecs|json_encode|e('html_attr') }}"
     data-generic-analysis-chart-default-type-value="{{ defaultChartType }}"
     data-generic-analysis-chart-export-filename-value="{{ result ? result.title : 'analysis-chart' }}"
     data-generic-analysis-chart-chart-height-profile-value="explorer"
     {% endif %}>
    <div class="card-header d-flex flex-nowrap justify-content-between align-items-center gap-2 py-2">
        <div class="stats-aex-chart-summary min-w-0">
            {% if analysisSummary is not null and analysisSummary.hasParts %}
                <p class="text-secondary small mb-0"
                   data-testid="stats-analysis-explorer-summary">{%- for part in analysisSummary.parts -%}
                        {%- if part.emphasize -%}
                            <span class="fw-semibold text-body">{{ part.text }}</span>
                        {%- else -%}
                            {{- part.text -}}
                        {%- endif -%}
                    {%- endfor -%}</p>
            {% endif %}
        </div>
        <div class="stats-aex-chart-toolbar d-flex flex-nowrap gap-2 align-items-center flex-shrink-0">
            <div class="d-none d-lg-block">
                {{ include('@Statistics/analysis_explorer/_chart_type_controls.html.twig') }}
            </div>
            <div class="dropdown d-lg-none">
                <button type="button"
                        class="btn btn-sm dropdown-toggle"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false"
                        data-testid="stats-analysis-explorer-chart-presentation-menu">
                    {{ 'stats.analysis_explorer.edit.section.presentation'|trans({}, 'statistics') }}
                </button>
                <div class="dropdown-menu dropdown-menu-end p-2">
                    {{ include('@Statistics/analysis_explorer/_chart_type_controls.html.twig', {
                        groupClass: 'btn-group btn-group-sm d-flex flex-wrap',
                        withTestIds: false,
                    }) }}
                </div>
            </div>
            <button type="button"
                    class="btn btn-sm d-lg-none"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#analysisExplorerShelf"
                    data-testid="stats-analysis-explorer-shelf-open">
                {{ 'stats.analysis_explorer.edit.section.analysis'|trans({}, 'statistics') }}
            </button>
            {% if hasChart %}
                {% if showChartRowLimitControl %}
                    <div class="btn-group btn-group-sm"
                         role="group"
                         aria-label="{{ 'stats.generic_analysis.table.row_limit_label'|trans({}, 'statistics') }}"
                         data-testid="stats-analysis-explorer-chart-row-limit">
                        <button type="button"
                                class="btn{% if chartRowLimit == 'all' %} active{% endif %}"
                                data-action="live#action"
                                data-live-action-param="setChartRowLimit"
                                data-live-limit-param="all"
                                data-testid="stats-analysis-explorer-row-limit-all">
                            {{ 'stats.generic_analysis.table.row_limit_all'|trans({}, 'statistics') }}
                        </button>
                        <button type="button"
                                class="btn{% if chartRowLimit == '5' %} active{% endif %}"
                                data-action="live#action"
                                data-live-action-param="setChartRowLimit"
                                data-live-limit-param="5"
                                data-testid="stats-analysis-explorer-row-limit-5">
                            {{ 'stats.generic_analysis.table.row_limit_top_5'|trans({}, 'statistics') }}
                        </button>
                        <button type="button"
                                class="btn{% if chartRowLimit == '10' %} active{% endif %}"
                                data-action="live#action"
                                data-live-action-param="setChartRowLimit"
                                data-live-limit-param="10"
                                data-testid="stats-analysis-explorer-row-limit-10">
                            {{ 'stats.generic_analysis.table.row_limit_top_10'|trans({}, 'statistics') }}
                        </button>
                    </div>
                {% endif %}
                <button type="button"
                        class="btn btn-sm d-print-none"
                        data-action="generic-analysis-chart#exportPng"
                        title="{{ 'stats.analysis_explorer.export.png_chart'|trans({}, 'statistics') }}"
                        aria-label="{{ 'stats.analysis_explorer.export.png_chart'|trans({}, 'statistics') }}"
                        data-testid="stats-analysis-explorer-export-png">
                    <twig:ux:icon name="tabler:photo-down" class="icon" />
                </button>
            {% endif %}
        </div>
    </div>
    {{ include('@Statistics/analysis_explorer/_analysis_shelf.html.twig') }}
    <div class="d-none" data-testid="stats-analysis-explorer-edit-chart-row-limit-field">
        {{ form_widget(form.chartType) }}
        {{ form_widget(form.chartRowLimit) }}
    </div>
    <div class="card-body" data-live-id="analysis-explorer-chart-{{ analysisRevision }}">
        {% if hasChart %}
            <div class="chart-lg"
                 data-generic-analysis-chart-target="chart"
                 data-testid="stats-analysis-explorer-chart"></div>
        {% else %}
            <div data-testid="stats-analysis-explorer-chart-empty">
                {{ include('@Statistics/analysis_explorer/_empty_state.html.twig', {
                    emptyReason: emptyReason,
                    canImport: canImport|default(false),
                }) }}
            </div>
        {% endif %}
    </div>
</div>
