{% set filterRow = {row_attr: {class: 'mb-0'}, label_attr: {class: 'form-label small mb-1'}} %}
{% set compactRow = {label: false, row_attr: {class: 'mb-0'}} %}
{% import '@Statistics/analysis_explorer/_edit_accordion_macros.html.twig' as editAccordion %}
{% set demographicsActive = form.filterGender.vars.data is not empty or form.filterAgeGroup.vars.data is not empty %}
{% set allocationActive = form.filterDepartmentId.vars.data is not empty
    or form.filterSpecialityId.vars.data is not empty
    or form.filterIndicationId.vars.data is not empty
    or form.filterSecondaryIndicationId.vars.data is not empty
    or form.filterIndicationGroupId.vars.data is not empty
    or form.filterUrgency.vars.data is not empty
    or form.filterTransportType.vars.data is not empty
    or form.filterAssignmentId.vars.data is not empty %}
{% set clinicalActive = form.filterResus.vars.data is not null
    or form.filterCpr.vars.data is not null
    or form.filterVentilation.vars.data is not null %}

<div class="offcanvas offcanvas-end analysis-explorer-edit-drawer{% if isEditOpen %} show{% endif %}"
     tabindex="-1"
     id="analysisExplorerEditDrawer"
     aria-labelledby="analysisExplorerEditDrawerLabel"
     data-testid="stats-analysis-explorer-edit-drawer">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="analysisExplorerEditDrawerLabel">
            {{ 'label.filters'|trans({}, 'messages') }}
        </h2>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                data-action="live#action"
                data-live-action-param="cancelEdit"
                aria-label="{{ 'action.close'|trans({}, 'messages') }}"
                data-testid="stats-analysis-explorer-edit-close"></button>
    </div>
    <div class="offcanvas-body">
        {{ include('@Statistics/analysis_explorer/_config_alert.html.twig') }}
        <p class="text-secondary small mb-3">{{ 'stats.analysis_explorer.edit.section.filters_help'|trans({}, 'statistics') }}</p>

        {% if not form.hospitalPopulation.vars.disabled %}
            <fieldset class="border-0 p-0 mb-4" data-testid="stats-analysis-explorer-hospital-population-field">
                <legend class="fs-6 fw-semibold mb-1">{{ 'stats.analysis_explorer.edit.section.hospital_population'|trans({}, 'statistics') }}</legend>
                <p class="form-text mt-0 mb-2">{{ 'stats.analysis_explorer.edit.section.hospital_population_help'|trans({}, 'statistics') }}</p>
                {{ form_row(form.hospitalPopulation, compactRow) }}
            </fieldset>
        {% endif %}

        <div class="accordion accordion-flush" id="analysisExplorerFilterAccordion" data-testid="stats-analysis-explorer-edit-section-filters">
            <div class="accordion-item">
                {{ editAccordion.header(
                    'analysisExplorerFilterDemographicsHeading',
                    'analysisExplorerFilterDemographicsPanel',
                    'stats.indication.section.demographics'|trans({}, 'statistics'),
                    'stats-analysis-explorer-filter-section-demographics',
                    demographicsActive,
                ) }}
                {{ editAccordion.panel_start('analysisExplorerFilterDemographicsPanel', 'analysisExplorerFilterDemographicsHeading', demographicsActive) }}
                    <div class="accordion-body">
                        <div class="row g-3">
                            <div class="col-12">{{ form_row(form.filterGender, filterRow) }}</div>
                            <div class="col-12">{{ form_row(form.filterAgeGroup, filterRow) }}</div>
                        </div>
                    </div>
                {{ editAccordion.panel_end() }}
            </div>
            <div class="accordion-item">
                {{ editAccordion.header(
                    'analysisExplorerFilterAllocationHeading',
                    'analysisExplorerFilterAllocationPanel',
                    'label.allocation'|trans({}, 'messages'),
                    'stats-analysis-explorer-filter-section-allocation',
                    allocationActive,
                ) }}
                {{ editAccordion.panel_start('analysisExplorerFilterAllocationPanel', 'analysisExplorerFilterAllocationHeading', allocationActive) }}
                    <div class="accordion-body">
                        <div class="row g-3">
                            <div class="col-12">{{ form_row(form.filterDepartmentId, filterRow) }}</div>
                            <div class="col-12">{{ form_row(form.filterSpecialityId, filterRow) }}</div>
                            <div class="col-12">{{ form_row(form.filterIndicationId, filterRow) }}</div>
                            <div class="col-12">{{ form_row(form.filterSecondaryIndicationId, filterRow) }}</div>
                            <div class="col-12">{{ form_row(form.filterIndicationGroupId, filterRow) }}</div>
                            <div class="col-md-6">{{ form_row(form.filterUrgency, filterRow) }}</div>
                            <div class="col-md-6">{{ form_row(form.filterTransportType, filterRow) }}</div>
                            <div class="col-12">{{ form_row(form.filterAssignmentId, filterRow) }}</div>
                        </div>
                    </div>
                {{ editAccordion.panel_end() }}
            </div>
            <div class="accordion-item">
                {{ editAccordion.header(
                    'analysisExplorerFilterClinicalHeading',
                    'analysisExplorerFilterClinicalPanel',
                    'stats.analysis_explorer.dimension_group.clinical_care'|trans({}, 'statistics'),
                    'stats-analysis-explorer-filter-section-clinical',
                    clinicalActive,
                ) }}
                {{ editAccordion.panel_start('analysisExplorerFilterClinicalPanel', 'analysisExplorerFilterClinicalHeading', clinicalActive) }}
                    <div class="accordion-body">
                        <div class="row g-3">
                            <div class="col-md-4">{{ form_row(form.filterResus, filterRow) }}</div>
                            <div class="col-md-4">{{ form_row(form.filterCpr, filterRow) }}</div>
                            <div class="col-md-4">{{ form_row(form.filterVentilation, filterRow) }}</div>
                        </div>
                    </div>
                {{ editAccordion.panel_end() }}
            </div>
        </div>
    </div>
    <div class="offcanvas-footer border-top p-3 d-flex justify-content-between gap-2">
        <button type="button"
                class="btn"
                data-action="live#action"
                data-live-action-param="clearAnalysisFilters"
                data-testid="stats-analysis-explorer-filter-reset">
            {{ 'label.filters.reset'|trans({}, 'messages') }}
        </button>
        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-link link-secondary"
                    data-bs-dismiss="offcanvas"
                    data-action="live#action"
                    data-live-action-param="cancelEdit"
                    data-testid="stats-analysis-explorer-edit-cancel">
                {{ 'action.cancel'|trans({}, 'messages') }}
            </button>
            <button type="button"
                    class="btn btn-primary"
                    data-bs-dismiss="offcanvas"
                    data-action="live#action"
                    data-live-action-param="applyEdit"
                    data-testid="stats-analysis-explorer-edit-apply">
                {{ 'stats.analysis_explorer.edit.apply'|trans({}, 'statistics') }}
            </button>
        </div>
    </div>
</div>
