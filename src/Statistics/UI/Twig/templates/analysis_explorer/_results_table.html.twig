<div class="card stats-aex-table-card"
     data-testid="stats-analysis-explorer-table"
     data-live-id="analysis-explorer-table-{{ analysisRevision }}">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
        <div>
            <h3 class="card-title mb-0">{{ 'stats.analysis_explorer.table.title'|trans({}, 'statistics') }}</h3>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            {% if not form.showPercentOfTotal.vars.disabled %}
                <div class="mb-0" data-testid="stats-analysis-explorer-show-percent-field">
                    {{ form_widget(form.showPercentOfTotal, {
                        label_attr: {class: 'checkbox-switch'},
                        attr: {
                            class: 'form-check-input',
                            'data-action': 'change->live#action',
                            'data-live-action-param': 'applyEdit',
                        },
                    }) }}
                </div>
            {% endif %}
            {% if not form.tableLayout.vars.disabled %}
                <div data-testid="stats-analysis-explorer-table-layout-field">
                    <label class="visually-hidden" for="{{ form.tableLayout.vars.id }}">
                        {{ 'stats.analysis_explorer.edit.table_layout'|trans({}, 'statistics') }}
                    </label>
                    {{ form_widget(form.tableLayout, {attr: {
                        class: 'form-select form-select-sm',
                        'data-action': 'change->live#action',
                        'data-live-action-param': 'applyEdit',
                    }}) }}
                </div>
            {% endif %}
            {% if not form.additionalTableMetrics.vars.disabled %}
                <div class="dropdown" data-testid="stats-analysis-explorer-additional-table-metrics-field">
                    <button type="button"
                            class="btn btn-sm dropdown-toggle"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        {{ 'stats.analysis_explorer.edit.section.columns'|trans({}, 'statistics') }}
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 18rem;">
                        {% if form.additionalTableMetrics.vars.help is not empty %}
                            <p class="form-text mt-0 mb-2">{{ form.additionalTableMetrics.vars.help|trans({}, 'statistics') }}</p>
                        {% endif %}
                        {% for groupLabel, groupChoices in form.additionalTableMetrics.vars.explorer_metric_groups %}
                            <fieldset class="border-0 p-0 mb-2">
                                <legend class="fs-6 fw-semibold mb-1">{{ groupLabel }}</legend>
                                {% for label, value in groupChoices %}
                                    {% for child in form.additionalTableMetrics %}
                                        {% if child.vars.value == value %}
                                            {{ form_row(child, {row_attr: {class: 'mb-0'}, attr: {
                                                'data-action': 'change->live#action',
                                                'data-live-action-param': 'applyEdit',
                                            }}) }}
                                        {% endif %}
                                    {% endfor %}
                                {% endfor %}
                            </fieldset>
                        {% endfor %}
                        {{ form_errors(form.additionalTableMetrics) }}
                    </div>
                </div>
            {% endif %}
            {% if exportCsvUrl %}
                <button type="submit"
                        form="analysis-explorer-export-csv-form"
                        class="btn btn-sm d-inline-flex align-items-center gap-1 d-print-none"
                        {% if not table or not table.hasData %}disabled{% endif %}
                        data-testid="stats-analysis-explorer-export-csv">
                    <twig:ux:icon name="tabler:download" class="icon" />
                    {{ 'stats.analysis_explorer.export.csv_table'|trans({}, 'statistics') }}
                </button>
            {% endif %}
        </div>
    </div>
    <div class="card-body p-0 stats-aex-table-card-body">
        <div class="stats-aex-table-scroll"
             data-testid="stats-analysis-explorer-table-scroll"
             {% if table and table.isClientSortable %}data-controller="analysis-explorer-table-sort"{% endif %}>
            <table class="table table-vcenter card-table table-striped table-hover mb-0 stats-aex-table"
                   data-testid="stats-analysis-explorer-table-body">
                <thead>
                    <tr>
                        {% if table and table.isClientSortable %}
                            <th>
                                <button type="button"
                                        class="table-sort btn btn-link p-0 text-reset text-decoration-none fw-medium border-0"
                                        data-sort-index="0"
                                        data-sort-type="text"
                                        data-action="analysis-explorer-table-sort#sort">
                                    {{ table.rowAxisLabel|default(table.primaryDimensionLabel) }}
                                </button>
                            </th>
                            {% if table.hasSeries %}
                                {% for seriesLabel in table.seriesLabels %}
                                    {% set columnIndex = loop.index %}
                                    <th class="text-end text-nowrap">
                                        <button type="button"
                                                class="table-sort btn btn-link p-0 text-reset text-decoration-none fw-medium border-0 text-end w-100"
                                                data-sort-index="{{ columnIndex }}"
                                                data-sort-type="number"
                                                data-action="analysis-explorer-table-sort#sort">
                                            {{ seriesLabel }}
                                        </button>
                                    </th>
                                {% endfor %}
                                <th class="text-end text-nowrap border-start">
                                    <button type="button"
                                            class="table-sort btn btn-link p-0 text-reset text-decoration-none fw-medium border-0 text-end w-100"
                                            data-sort-index="{{ table.seriesLabels|length + 1 }}"
                                            data-sort-type="number"
                                            data-action="analysis-explorer-table-sort#sort">
                                        {{ 'stats.analysis_explorer.table.footer_total'|trans({}, 'statistics') }}
                                    </button>
                                </th>
                            {% else %}
                                {% for column in table.metricColumns %}
                                    {% set columnIndex = loop.index %}
                                    {% set sortType = column.key == 'series' ? 'text' : 'number' %}
                                    <th class="text-end text-nowrap">
                                        <button type="button"
                                                class="table-sort btn btn-link p-0 text-reset text-decoration-none fw-medium border-0 text-end w-100"
                                                data-sort-index="{{ columnIndex }}"
                                                data-sort-type="{{ sortType }}"
                                                data-action="analysis-explorer-table-sort#sort">
                                            {{ column.label }}
                                        </button>
                                    </th>
                                {% endfor %}
                            {% endif %}
                        {% else %}
                            <th>{{ table ? table.rowAxisLabel|default(table.primaryDimensionLabel) : '' }}</th>
                            {% if table and table.hasMetricSubRows %}
                                <th class="text-nowrap">{{ 'stats.analysis_explorer.table.metric'|trans({}, 'statistics') }}</th>
                                {% for seriesLabel in table.seriesLabels %}
                                    <th class="text-end text-nowrap">{{ seriesLabel }}</th>
                                {% endfor %}
                            {% elseif table and table.hasSeries %}
                                {% for seriesLabel in table.seriesLabels %}
                                    <th class="text-end text-nowrap">{{ seriesLabel }}</th>
                                {% endfor %}
                                <th class="text-end text-nowrap border-start">{{ 'stats.analysis_explorer.table.footer_total'|trans({}, 'statistics') }}</th>
                            {% elseif table %}
                                {% for column in table.metricColumns %}
                                    <th class="text-end text-nowrap">{{ column.label }}</th>
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    </tr>
                </thead>
                <tbody {% if table and table.isClientSortable %}data-analysis-explorer-table-sort-target="body"{% endif %}>
                    {% if table %}
                        {% for row in table.rows %}
                            <tr>
                                <th scope="row"
                                    class="fw-normal"
                                    {% if table.isClientSortable %}data-sort-value="{{ row.bucketLabel }}"{% endif %}>
                                    {{ row.bucketLabel }}
                                </th>
                                {% if table.hasMetricSubRows %}
                                    <td class="text-nowrap">{{ row.metricSubRowLabel }}</td>
                                    {% for seriesLabel in table.seriesLabels %}
                                        <td class="text-end text-nowrap">
                                            <div class="fw-medium">{{ row.formattedSeriesValues[seriesLabel] ?? '—' }}</div>
                                            {% if table.showPercentOfTotal and row.formattedSeriesPercentValues[seriesLabel] is defined and row.formattedSeriesPercentValues[seriesLabel] %}
                                                <div class="small text-secondary">{{ row.formattedSeriesPercentValues[seriesLabel] }}</div>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                {% elseif table.hasSeries %}
                                    {% for seriesLabel in table.seriesLabels %}
                                        <td class="text-end text-nowrap"
                                            {% if table.isClientSortable %}data-sort-value="{{ row.seriesValues[seriesLabel] ?? '' }}"{% endif %}>
                                            <div class="fw-medium">{{ row.formattedSeriesValues[seriesLabel] ?? '—' }}</div>
                                            {% if table.showPercentOfTotal and row.formattedSeriesPercentValues[seriesLabel] is defined and row.formattedSeriesPercentValues[seriesLabel] %}
                                                <div class="small text-secondary">{{ row.formattedSeriesPercentValues[seriesLabel] }}</div>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                    <td class="text-end text-nowrap fw-semibold border-start"
                                        {% if table.isClientSortable %}data-sort-value="{{ row.rowTotal }}"{% endif %}>
                                        <div>{{ row.formattedRowTotal }}</div>
                                        {% if table.showPercentOfTotal and row.formattedRowTotalPercent %}
                                            <div class="small text-secondary fw-normal">{{ row.formattedRowTotalPercent }}</div>
                                        {% endif %}
                                    </td>
                                {% else %}
                                    {% for column in table.metricColumns %}
                                        <td class="text-end text-nowrap"
                                            {% if table.isClientSortable %}data-sort-value="{{ row.metricValues[column.key] ?? '' }}"{% endif %}>
                                            <div class="fw-medium">{{ row.formattedMetricValues[column.key] ?? '—' }}</div>
                                            {% if table.showPercentOfTotal and row.formattedMetricPercentValues[column.key] is defined and row.formattedMetricPercentValues[column.key] %}
                                                <div class="small text-secondary">{{ row.formattedMetricPercentValues[column.key] }}</div>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ table.columnCount() }}" class="p-3" data-testid="stats-analysis-explorer-table-empty">
                                    {{ include('@Statistics/analysis_explorer/_empty_state.html.twig', {
                                        emptyReason: emptyReason,
                                        canImport: canImport|default(false),
                                    }) }}
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="2" class="p-3" data-testid="stats-analysis-explorer-table-empty">
                                {{ include('@Statistics/analysis_explorer/_empty_state.html.twig', {
                                    emptyReason: emptyReason,
                                    canImport: canImport|default(false),
                                }) }}
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
                {% if table and table.hasData and table.hasSeries and not table.hasMetricSubRows %}
                    <tfoot class="table-light">
                        <tr data-testid="stats-analysis-explorer-table-footer">
                            <th scope="row">{{ 'stats.analysis_explorer.table.footer_total'|trans({}, 'statistics') }}</th>
                            {% for seriesLabel in table.seriesLabels %}
                                <td class="text-end text-nowrap fw-semibold">
                                    <div>{{ table.formattedSeriesTotals[seriesLabel] ?? '—' }}</div>
                                    {% if table.showPercentOfTotal and table.formattedSeriesFooterPercentValues[seriesLabel] is defined and table.formattedSeriesFooterPercentValues[seriesLabel] %}
                                        <div class="small text-secondary fw-normal">{{ table.formattedSeriesFooterPercentValues[seriesLabel] }}</div>
                                    {% endif %}
                                </td>
                            {% endfor %}
                            <td class="text-end text-nowrap fw-bold border-start">
                                <div>{{ table.formattedGrandTotal }}</div>
                                {% if table.showPercentOfTotal and table.formattedGrandTotalPercent %}
                                    <div class="small text-secondary fw-normal">{{ table.formattedGrandTotalPercent }}</div>
                                {% endif %}
                            </td>
                        </tr>
                    </tfoot>
                {% elseif table and table.hasData and not table.hasSeries %}
                    <tfoot class="table-light">
                        <tr data-testid="stats-analysis-explorer-table-footer">
                            <th scope="row">
                                {% if table.metricColumns|length == 1 %}
                                    {{ table.metricColumns[0].footerLabel }}
                                {% endif %}
                            </th>
                            {% for column in table.metricColumns %}
                                <td class="text-end text-nowrap fw-semibold">
                                    {% if table.metricColumns|length > 1 %}
                                        <span class="text-secondary fw-normal me-1">{{ column.footerLabel }}</span>
                                    {% endif %}
                                    <div>{{ table.formattedTotals[column.key] ?? '—' }}</div>
                                    {% if table.showPercentOfTotal and table.formattedTotalsPercentValues[column.key] is defined and table.formattedTotalsPercentValues[column.key] %}
                                        <div class="small text-secondary fw-normal">{{ table.formattedTotalsPercentValues[column.key] }}</div>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    </tfoot>
                {% endif %}
            </table>
        </div>
    </div>
</div>
