{% set chartTypes = [
    {value: 'bar', icon: 'tabler:chart-bar'},
    {value: 'line', icon: 'tabler:chart-line'},
    {value: 'grouped_bar', icon: 'tabler:chart-bar'},
    {value: 'stacked_bar', icon: 'tabler:chart-histogram'},
    {value: 'heatmap', icon: 'tabler:layout-grid'},
    {value: 'box_plot', icon: 'tabler:chart-dots'},
] %}
{% set allowedChartTypes = [] %}
{% for choice in form.chartType.vars.choices %}
    {% set allowedChartTypes = allowedChartTypes|merge([choice.value]) %}
{% endfor %}

<div class="{{ groupClass|default('btn-group btn-group-sm') }}"
     role="group"
     aria-label="{{ 'stats.analysis_explorer.edit.chart_type'|trans({}, 'statistics') }}"
     {% if withTestIds|default(true) %}data-testid="stats-analysis-explorer-chart-type"{% endif %}>
    {% for chartType in chartTypes %}
        {% if chartType.value in allowedChartTypes %}
            {% set selected = form.chartType.vars.value == chartType.value %}
            <button type="button"
                    class="btn{% if selected %} active{% endif %}"
                    data-action="live#action"
                    data-live-action-param="setChartType"
                    data-live-chart-type-param="{{ chartType.value }}"
                    aria-pressed="{{ selected ? 'true' : 'false' }}"
                    title="{{ ('stats.analysis_explorer.chart.' ~ chartType.value)|trans({}, 'statistics') }}"
                    {% if withTestIds|default(true) %}data-testid="stats-analysis-explorer-chart-type-{{ chartType.value }}"{% endif %}>
                <twig:ux:icon name="{{ chartType.icon }}" class="icon" />
                <span class="visually-hidden">{{ ('stats.analysis_explorer.chart.' ~ chartType.value)|trans({}, 'statistics') }}</span>
            </button>
        {% endif %}
    {% endfor %}
</div>
