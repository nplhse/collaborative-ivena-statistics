<div {{ attributes }}>
    {% set contextLocationLabel = this.contextLocationLabel %}
    {% set contextPeriodLabel = this.contextPeriodLabel %}
    {% set activeFilters = this.activeFilterBadges %}
    {% set breadcrumbItems = [
        {label: 'link.statistics', path: path('app_stats_dashboard')},
        {label: 'link.stats.analysis_explorer_library', path: libraryUrl},
    ] %}
    {% if savedViewTitle %}
        {% set breadcrumbItems = breadcrumbItems|merge([{label: savedViewTitle, translatable: false}]) %}
    {% else %}
        {% set breadcrumbItems = breadcrumbItems|merge([{label: 'stats.analysis_explorer.title'}]) %}
    {% endif %}
    <twig:PageHeader
        :title="savedViewTitle ?? ('stats.analysis_explorer.title'|trans({}, 'statistics'))"
        actionsClass="d-flex flex-wrap align-items-center justify-content-end gap-2"
        actionsTestId="stats-analysis-explorer-actions"
    >
        <twig:block name="title">
            <h2 class="page-title mb-0" data-testid="stats-analysis-explorer-title">
                <span class="d-inline-flex align-items-center gap-1">
                    {{ savedViewTitle ?? ('stats.analysis_explorer.title'|trans({}, 'statistics')) }}
                    {% if canChangeVisibility and viewVisibility != 'public' %}
                        <span class="d-inline-flex text-secondary"
                              role="img"
                              title="{{ 'stats.analysis_explorer.visibility.private_hint'|trans({}, 'statistics') }}"
                              aria-label="{{ 'stats.analysis_explorer.visibility.private_hint'|trans({}, 'statistics') }}"
                              data-testid="stats-analysis-explorer-private-lock">
                            <twig:ux:icon name="tabler:lock" class="icon" style="width: 0.9em; height: 0.9em;" />
                        </span>
                    {% endif %}
                </span>
            </h2>
        </twig:block>
        <twig:block name="breadcrumbs">
            <twig:Breadcrumbs :items="breadcrumbItems" />
        </twig:block>
        <twig:block name="meta">
            {{ include('@Statistics/_data_quality_indicator.html.twig') }}
        </twig:block>
        <twig:block name="context">
            {% if savedViewDescription %}
                <p class="text-secondary mt-1 mb-0" data-testid="stats-analysis-explorer-description">
                    {{ savedViewDescription }}
                </p>
            {% endif %}
            {% if savedViewId %}
                <p class="text-secondary small mt-1 mb-0" data-testid="stats-analysis-explorer-meta">
                    {% if isSystemView %}
                        <twig:ux:icon name="tabler:server" class="icon icon-sm" />
                        {{ 'stats.analysis_explorer.library.card.system_source'|trans({}, 'statistics') }}
                    {% else %}
                        <twig:ux:icon name="tabler:user" class="icon icon-sm" />
                        {% if savedViewAuthorUrl and savedViewAuthorName %}
                            <a href="{{ savedViewAuthorUrl }}">{{ savedViewAuthorName }}</a>
                        {% else %}
                            {{ savedViewAuthorName ?: ('stats.analysis_explorer.library.card.unknown_author'|trans({}, 'statistics')) }}
                        {% endif %}
                    {% endif %}
                    {% if savedViewActivityIso %}
                        <span class="mx-1" aria-hidden="true">·</span>
                        <time datetime="{{ savedViewActivityIso }}" title="{{ savedViewActivityAbsolute }}">{{ savedViewActivityRelative }}</time>
                        <span class="visually-hidden">{{ savedViewActivityAbsolute }}</span>
                    {% endif %}
                </p>
            {% endif %}
        </twig:block>
        <twig:block name="actions">
            <div class="btn-group analysis-context-triggers"
                 role="group"
                 aria-label="{{ 'stats.analysis_context.title'|trans({}, 'statistics') }}"
                 data-testid="stats-analysis-explorer-context">
                <button type="button"
                        class="btn analysis-context-location d-inline-flex align-items-center"
                        data-action="live#action"
                        data-live-action-param="openContext"
                        data-testid="stats-analysis-explorer-context-location"
                        title="{{ contextLocationLabel }}">
                    <twig:ux:icon name="tabler:map-pin" class="icon icon-sm flex-shrink-0" />
                    <span class="ms-2 text-truncate analysis-context-location-label">{{ contextLocationLabel }}</span>
                </button>
                <button type="button"
                        class="btn analysis-context-period d-inline-flex align-items-center"
                        data-action="live#action"
                        data-live-action-param="openContext"
                        data-testid="stats-analysis-explorer-context-period"
                        title="{{ contextPeriodLabel }}">
                    <twig:ux:icon name="tabler:calendar" class="icon icon-sm flex-shrink-0" />
                    <span class="ms-2">{{ contextPeriodLabel }}</span>
                </button>
            </div>

            <div class="btn-group" role="group">
                <button type="button"
                        class="btn"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#analysisExplorerEditDrawer"
                        data-action="live#action"
                        data-live-action-param="openEdit"
                        data-testid="stats-analysis-explorer-edit-open">
                    <twig:ux:icon name="tabler:filter" class="icon icon-sm" />
                    <span class="ms-2">{{ 'label.filters'|trans({}, 'messages') }}</span>
                    {% if activeFilters is not empty %}
                        <span class="badge text-primary ms-2" data-testid="stats-analysis-explorer-filter-count">{{ activeFilters|length }}</span>
                    {% endif %}
                </button>
                {% if activeFilters is not empty %}
                    <button type="button"
                            class="btn btn-icon"
                            data-action="live#action"
                            data-live-action-param="clearAnalysisFilters"
                            title="{{ 'label.filters.reset'|trans({}, 'messages') }}"
                            aria-label="{{ 'label.filters.reset'|trans({}, 'messages') }}"
                            data-testid="stats-analysis-explorer-filter-clear">
                        <twig:ux:icon name="tabler:x" class="icon" />
                    </button>
                {% endif %}
            </div>

            {% if (canFavorite and favoriteUrl) or canSave or showSaveAs or canChangeVisibility %}
                <div class="btn-group" role="group" aria-label="{{ 'stats.analysis_explorer.actions.save'|trans({}, 'statistics') }}">
                    {% if canFavorite and favoriteUrl %}
                        <button type="submit"
                                form="analysis-explorer-favorite-form"
                                class="btn btn-icon{% if isFavorite %} text-yellow{% endif %}"
                                title="{{ isFavorite ? 'stats.analysis_explorer.favorite.remove'|trans({}, 'statistics') : 'stats.analysis_explorer.favorite.add'|trans({}, 'statistics') }}"
                                aria-label="{{ isFavorite ? 'stats.analysis_explorer.favorite.remove'|trans({}, 'statistics') : 'stats.analysis_explorer.favorite.add'|trans({}, 'statistics') }}"
                                {% if hasUnsavedChanges %}disabled{% endif %}
                                data-testid="stats-analysis-explorer-favorite-toggle">
                            <twig:ux:icon name="{{ isFavorite ? 'tabler:star-filled' : 'tabler:star' }}" class="icon" />
                        </button>
                    {% endif %}

                    {% if canChangeVisibility %}
                        <button type="button"
                                class="btn d-inline-flex align-items-center gap-1"
                                data-bs-toggle="modal"
                                data-bs-target="#analysisExplorerEditMetadataModal"
                                data-testid="stats-analysis-explorer-edit-metadata-open">
                            <twig:ux:icon name="tabler:pencil" class="icon" />
                            {{ 'stats.analysis_explorer.edit_view.open'|trans({}, 'statistics') }}
                        </button>
                    {% endif %}

                    {% if canSave %}
                        <button type="button"
                                class="btn btn-icon"
                                data-action="live#action"
                                data-live-action-param="save"
                                title="{{ 'stats.analysis_explorer.save'|trans({}, 'statistics') }}"
                                aria-label="{{ 'stats.analysis_explorer.save'|trans({}, 'statistics') }}"
                                {% if not hasUnsavedChanges %}disabled{% endif %}
                                data-testid="stats-analysis-explorer-save">
                            <twig:ux:icon name="tabler:device-floppy" class="icon" />
                        </button>
                    {% endif %}

                    {% if showSaveAs %}
                        <button type="button"
                                class="btn btn-icon"
                                data-bs-toggle="modal"
                                data-bs-target="#analysisExplorerSaveAsModal"
                                data-action="live#action"
                                data-live-action-param="openSaveAs"
                                title="{{ 'stats.analysis_explorer.save_as'|trans({}, 'statistics') }}"
                                aria-label="{{ 'stats.analysis_explorer.save_as'|trans({}, 'statistics') }}"
                                data-testid="stats-analysis-explorer-save-as-open">
                            <twig:ux:icon name="tabler:device-floppy" class="icon" />
                        </button>
                    {% endif %}
                </div>
            {% endif %}

            {% if canFavorite and favoriteUrl %}
                <form id="analysis-explorer-favorite-form"
                      method="post"
                      action="{{ favoriteUrl }}"
                      class="d-none">
                    <input type="hidden" name="_token" value="{{ csrf_token(favoriteToken) }}">
                </form>
            {% endif %}
        </twig:block>
    </twig:PageHeader>

    <div class="page-body">
        <div class="container-xl">
            <section class="content">
                {{ include('@Statistics/_data_quality_drawer.html.twig') }}
                {% if activeFilters is not empty %}
                    {% set activeFilterBadges = [] %}
                    {% for badge in activeFilters %}
                        {% set activeFilterBadges = activeFilterBadges|merge([{
                            label: badge.label,
                            value: badge.value,
                        }]) %}
                    {% endfor %}
                    <twig:ActiveFilters
                        :badges="activeFilterBadges"
                        class="mb-3"
                        data-testid="stats-analysis-explorer-filter-badges"
                    />
                {% endif %}
                {{ form_start(form, {attr: {
                    'data-testid': 'stats-analysis-explorer-edit-form',
                    'data-model': 'norender|on(change)|*',
                }}) }}
                {% if saveNotice %}
                    <twig:Alert type="success" class="py-2 mb-3" data-testid="stats-analysis-explorer-save-notice">
                        {{ saveNotice }}
                    </twig:Alert>
                {% endif %}
                {{ include('@Statistics/analysis_explorer/_config_alert.html.twig') }}
                {{ include('@Statistics/analysis_explorer/_chart_card.html.twig') }}
                {{ include('@Statistics/analysis_explorer/_results_table.html.twig') }}
                {{ include('@Statistics/analysis_explorer/_context_modal.html.twig') }}
                {{ include('@Statistics/analysis_explorer/_edit_drawer.html.twig') }}
                {{ form_end(form, {render_rest: false}) }}
                {% if exportCsvUrl %}
                    <form id="analysis-explorer-export-csv-form"
                          method="post"
                          action="{{ exportCsvUrl }}"
                          class="d-none"
                          data-testid="stats-analysis-explorer-export-csv-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('explorer_export_csv') }}">
                        <input type="hidden" name="appliedConfigState" value="{{ appliedConfigState|json_encode|e('html_attr') }}">
                    </form>
                {% endif %}
            </section>
        </div>
    </div>

    {{ include('@Statistics/analysis_explorer/_save_as_modal.html.twig') }}
    {% if canChangeVisibility %}
        {{ include('@Statistics/analysis_explorer/_edit_metadata_modal.html.twig') }}
        {% if savedViewId %}
            <twig:ConfirmModal
                id="analysisExplorerDeleteModal"
                :title="'stats.analysis_explorer.delete.modal.title'|trans({}, 'statistics')"
                :message="'stats.analysis_explorer.delete.modal.body'|trans({name: savedViewTitle ?? ''}, 'statistics')"
                :action="path('app_stats_analysis_explorer_view_delete', {id: savedViewId})"
                :csrfToken="csrf_token('explorer_view_delete_' ~ savedViewId)"
                :confirmLabel="'stats.analysis_explorer.delete.modal.confirm'|trans({}, 'statistics')"
                :cancelLabel="'action.cancel'|trans({}, 'messages')"
            />
        {% endif %}
    {% endif %}
</div>
