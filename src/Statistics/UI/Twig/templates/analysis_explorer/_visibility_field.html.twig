<fieldset class="border-0 p-0 mt-3 mb-0" data-testid="{{ testId }}">
    <legend class="form-label mb-2">{{ 'stats.analysis_explorer.save_as.visibility_label'|trans({}, 'statistics') }}</legend>
    <label class="form-check">
        <input type="radio"
               class="form-check-input"
               name="{{ inputName }}"
               value="private"
               data-model="norender|{{ inputName }}"
               {% if selected != 'public' %}checked{% endif %}
               data-testid="{{ testId }}-private">
        <span class="form-check-label{% if showPrivateIcon|default(false) %} d-inline-flex align-items-center gap-1{% endif %}">
            {{ 'stats.analysis_explorer.visibility.private'|trans({}, 'statistics') }}
            {% if showPrivateIcon|default(false) %}
                <span class="d-inline-flex text-secondary"
                      aria-hidden="true"
                      title="{{ 'stats.analysis_explorer.visibility.private_hint'|trans({}, 'statistics') }}">
                    <twig:ux:icon name="tabler:lock" class="icon" style="width: 0.9em; height: 0.9em;" />
                </span>
            {% endif %}
        </span>
        <span class="form-check-description">{{ 'stats.analysis_explorer.save_as.visibility_private_help'|trans({}, 'statistics') }}</span>
    </label>
    <label class="form-check mb-0">
        <input type="radio"
               class="form-check-input"
               name="{{ inputName }}"
               value="public"
               data-model="norender|{{ inputName }}"
               {% if selected == 'public' %}checked{% endif %}
               data-testid="{{ testId }}-public">
        <span class="form-check-label">{{ 'stats.analysis_explorer.visibility.public'|trans({}, 'statistics') }}</span>
        <span class="form-check-description">{{ 'stats.analysis_explorer.save_as.visibility_public_help'|trans({}, 'statistics') }}</span>
    </label>
</fieldset>
