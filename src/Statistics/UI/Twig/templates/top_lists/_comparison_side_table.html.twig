{% set showDiff = showDiff|default(false) %}

<div class="h-100" data-testid="{{ testId }}">
    <div class="d-flex align-items-center px-3 py-2 stats-top-lists-comparison-side-header {{ showDiff ? 'bg-secondary-lt' : 'bg-primary-lt' }}">
        <h3 class="card-title mb-0">{{ titleKey|trans({}, 'statistics') }}</h3>
    </div>
    <twig:Statistics:RankingTable
        rankHeader="{{ 'stats.top_lists.table.rank'|trans({}, 'statistics') }}"
        labelHeader="{{ comparison.labelColumnTranslationKey|trans({}, 'statistics') }}"
        countHeader="{{ 'stats.top_lists.table.count'|trans({}, 'statistics') }}"
        shareHeader="{{ 'stats.top_lists.table.share'|trans({}, 'statistics') }}"
        :rows="ranking_table_comparison_rows(rows, showDiff, testId)"
        :compact="true"
        :valuePairs="true"
        emptyMessage="{{ 'stats.top_lists.table.empty'|trans({}, 'statistics') }}"
    />
</div>
