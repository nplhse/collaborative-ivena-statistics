{% set shareWidth = share|default(0) %}
{% if shareWidth < 0 %}
    {% set shareWidth = 0 %}
{% elseif shareWidth > 100 %}
    {% set shareWidth = 100 %}
{% endif %}
<div class="progress progress-sm stats-top-lists-share-bar"
     aria-hidden="true"
     data-testid="{{ testId|default('stats-top-lists-share-bar') }}">
    <div class="progress-bar{% if barClass|default('') %} {{ barClass }}{% endif %}" style="width: {{ shareWidth }}%"></div>
</div>
