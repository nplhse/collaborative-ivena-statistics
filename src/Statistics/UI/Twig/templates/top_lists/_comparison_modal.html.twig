{% set comparisonModalId = comparisonModalId|default('stats-top-lists-comparison-modal-b') %}
{% set comparisonModalTitleKey = comparisonModalTitleKey|default('stats.top_lists.comparison.modal_title_b') %}
{% set comparisonModalTestId = comparisonModalTestId|default(comparisonModalId) %}
{% set comparisonSide = comparisonSide|default('comparison') %}

<twig:Modal
    id="{{ comparisonModalId }}"
    :title="comparisonModalTitleKey|trans({}, 'statistics')"
    size="lg"
    data-testid="{{ comparisonModalTestId }}"
>
    {{ component('TopListComparisonSelectionForm', {
        initialData: comparisonFormData,
        preservedQuery: topListsPage.comparisonPreservedQuery,
        locale: app.request.locale,
        side: comparisonSide,
        key: comparisonSide,
    }) }}
</twig:Modal>
