{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'stats.top_lists.page_title'|trans({}, 'statistics') }}: {{ topListsPage.headerTitleKey|trans({}, 'statistics') }} – {{ parent() }}{% endblock %}

{% block header %}
    {% embed '@Shared/_embeds/header.html.twig' %}
        {% block header_after %}
            {{ include(('@Shared/_includes/subnav_stats.html.twig')) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <div class="d-flex align-items-start justify-content-between gap-3">
            <twig:Breadcrumbs :items="[
                { label: 'link.statistics', path: path('app_stats_dashboard') },
                { label: 'link.stats.top_lists', path: topListsPage.indexUrl },
                { label: topListsPage.headerTitleKey }
            ]" />

            <div class="flex-shrink-0 d-print-none mt-2">
                {{ include('@Statistics/_data_quality_indicator.html.twig') }}
            </div>
        </div>

        <div class="page-header d-print-none">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle" data-testid="stats-heading-subtitle">
                        {{ topListsPage.headerSubtitleKey|trans({}, 'statistics') }}
                    </div>
                    <h2 class="page-title" data-testid="stats-heading-title">
                        {{ topListsPage.headerTitleKey|trans({}, 'statistics') }}
                    </h2>
                </div>
                {{ include('@Statistics/_header_controls.html.twig', {statsShowFilterDrawer: true}) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    {{ include('@Statistics/_data_quality_drawer.html.twig') }}
    {{ include('@Statistics/_filter_drawer.html.twig') }}
    {% if topListsPage.comparisonFormData %}
        {{ include('@Statistics/top_lists/_comparison_modal.html.twig', {
            comparisonModalId: 'stats-top-lists-comparison-modal-b',
            comparisonModalTitleKey: 'stats.top_lists.comparison.modal_title_b',
            comparisonModalTestId: 'stats-top-lists-comparison-modal-b',
            comparisonFormData: topListsPage.comparisonFormData,
            comparisonSide: 'comparison',
        }) }}
    {% endif %}
    {% if topListsPage.compareEnabled and topListsPage.primaryFormData %}
        {{ include('@Statistics/top_lists/_comparison_modal.html.twig', {
            comparisonModalId: 'stats-top-lists-comparison-modal-a',
            comparisonModalTitleKey: 'stats.top_lists.comparison.modal_title_a',
            comparisonModalTestId: 'stats-top-lists-comparison-modal-a',
            comparisonFormData: topListsPage.primaryFormData,
            comparisonSide: 'primary',
        }) }}
    {% endif %}

    {% set compareLayout = topListsPage.compareEnabled %}
    <div class="row g-4 align-items-start">
        {% if not compareLayout %}
            <aside class="col-12 col-lg-4 col-xl-3">
                <div class="position-lg-sticky" style="top: 1rem;">
                    {{ include('@Statistics/_explorer_sidebar.html.twig') }}
                </div>
            </aside>
        {% endif %}
        <div class="{{ compareLayout ? 'col-12' : 'col-12 col-lg-8 col-xl-9' }} min-w-0">
            {{ include('@Statistics/_filter_active_badges.html.twig') }}

            {% if topListsPage.comparison %}
                {{ include('@Statistics/_compare_selection_card.html.twig', {
                    testId: 'stats-top-lists-compare-selection',
                    sideATitleKey: 'stats.top_lists.comparison.side_a',
                    sideAHeading: topListsPage.comparison.sideAHeading,
                    sideASubheading: topListsPage.comparison.sideASubheading,
                    sideACount: topListsPage.comparison.totalAllocationsA,
                    sideATestId: 'stats-top-lists-compare-a',
                    sideAEditModalTarget: '#stats-top-lists-comparison-modal-a',
                    sideAEditTestId: 'stats-top-lists-compare-a-edit',
                    sideBTitleKey: 'stats.top_lists.comparison.side_b',
                    sideBHeading: topListsPage.comparison.sideBHeading,
                    sideBSubheading: topListsPage.comparison.sideBSubheading,
                    sideBCount: topListsPage.comparison.totalAllocationsB,
                    sideBTestId: 'stats-top-lists-compare-b',
                    sideBEditModalTarget: '#stats-top-lists-comparison-modal-b',
                    sideBEditTestId: 'stats-top-lists-compare-b-edit',
                }) }}

                <div data-testid="stats-top-lists-widget">
                    {{ include('@Statistics/top_lists/_comparison_tables.html.twig', {comparison: topListsPage.comparison}) }}
                    <div class="card mt-4" data-testid="stats-analysis-table-card">
                        {{ include('@Statistics/top_lists/_limit_footer.html.twig', {
                            wrapperClass: 'card-footer border-top-0',
                            rankingDepthUrls: topListsPage.limitUrls,
                            currentLimit: topListsPage.currentLimit,
                            pageSizeUrls: topListsPage.pageSizeUrls,
                            currentPageSize: topListsPage.currentPageSize,
                            paginator: topListsPage.paginator,
                            truncated: topListsPage.truncated,
                        }) }}
                    </div>
                </div>
            {% else %}
                <div data-testid="stats-top-lists-widget">
                    {{ include('@Statistics/dashboard/_widget_renderer.html.twig', {widget: topListsPage.topListWidget}) }}
                </div>
            {% endif %}

            {% if not topListsPage.compareEnabled and overviewPeriodViewModel is defined %}
                {{ include('@Statistics/dashboard/_overview_period_navigation.html.twig') }}
            {% endif %}
        </div>
    </div>
{% endblock %}
