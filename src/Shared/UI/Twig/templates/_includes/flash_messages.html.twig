{% if app.request.hasPreviousSession %}
    <div class="container-xl mt-2">
        <div class="row">
            <div class="col-sm-12">
                <div class="messages">
                    {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <twig:Alert type="{{ type }}" :dismissible="true" :important="true">
                                {{ message|trans }}
                            </twig:Alert>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endif %}
