{% if app.request.hasPreviousSession %}
    <div class="container-xl mt-2">
        <div class="row">
            <div class="col-sm-12">
                <div class="messages">
                    {% for type, flashMessages in app.flashes %}
                        {% for flashMessage in flashMessages %}
                            <twig:Alert type="{{ type }}" :message="flashMessage|trans" :dismissible="true" :important="true" />
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endif %}
