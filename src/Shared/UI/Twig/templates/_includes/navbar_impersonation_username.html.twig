{#
  The avatar identifies the signed-in user (#462); while impersonating it gets a warning ring
  (.avatar-impersonating). The name stays available to assistive technology.
#}
<span class="visually-hidden">
    {%- if is_granted('IS_IMPERSONATOR') %}{{ 'label.impersonation_active'|trans({}, 'messages') }} {% endif -%}
    <span id="user_name">{{ app.user.userIdentifier }}</span>
</span>
