{% block header %}
    <header class="navbar navbar-expand-md d-print-none">
        <div class="container-xl">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            {% block navbar_logo %}
                <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3 min-w-0 flex-shrink-1 overflow-hidden">
                    <a class="text-truncate d-block" href="{{ path('app_default') }}">
                        {{ app_title }}
                    </a>
                </h1>
            {% endblock %}
            {% block navbar_user %}
                {{ include('@Shared/_includes/navbar_user.html.twig') }}
            {% endblock %}
            <div class="collapse navbar-collapse" id="navbar-menu">
                <div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
                    <ul class="navbar-nav">
                        {% block navbar_links %}
                            <twig:Navigation:Primary />
                            {% if not is_granted('ROLE_USER') %}
                                <li class="nav-item d-md-none">
                                    <a class="nav-link" href="{{ path('app_register') }}">
                                        <span class="nav-link-title">
                                            <twig:ux:icon name="tabler:user-plus" style="height: 1.5em;" />
                                            {{ 'label.register'|trans({}, 'messages') }}
                                        </span>
                                    </a>
                                </li>
                                <li class="nav-item d-md-none">
                                    <a class="nav-link" href="{{ path('app_login') }}">
                                        <span class="nav-link-title">
                                            <twig:ux:icon name="tabler:login" style="height: 1.5em;" />
                                            {{ 'label.login'|trans({}, 'messages') }}
                                        </span>
                                    </a>
                                </li>
                            {% endif %}
                        {% endblock %}
                        <twig:LocaleSwitcher variant="menu" class="d-md-none" />
                    </ul>
                </div>
            </div>
        </div>
    </header>
{% endblock %}

{% block header_after %}
{% endblock %}
