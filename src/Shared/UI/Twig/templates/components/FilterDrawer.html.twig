<div{{ attributes.defaults(this.rootAttributes) }}>
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="{{ this.labelId }}">
            {% if title %}
                {{ title }}
            {% else %}
                {{ 'label.filter.results'|trans({}, 'messages') }}
            {% endif %}
        </h2>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="{{ 'action.close'|trans({}, 'messages') }}"></button>
    </div>

    <div class="offcanvas-body">
        {% set keptQueryKeys = this.keptQueryKeys %}
        <form
            method="get"
            action="{{ formAction }}"
            id="{{ formId }}"
            data-controller="filter-drawer{% if preserveQuery or keptQueryKeys is not empty %} query-state{% endif %}"
            data-action="submit->filter-drawer#omitEmptyDates"
            {% if preserveQuery %}data-query-state-omit-value="{{ omitQueryKeys|json_encode }}"{% elseif keptQueryKeys is not empty %}data-query-state-keys-value="{{ keptQueryKeys|json_encode }}"{% endif %}
            {% if formTestId %}data-testid="{{ formTestId }}"{% endif %}
        >
            {% for key, value in this.preservedQueryFields %}
                <input type="hidden" name="{{ key }}" value="{{ value }}" data-query-state-field>
            {% endfor %}
            {% block content %}{% endblock %}
        </form>
    </div>

    <div class="offcanvas-footer border-top p-3 d-flex justify-content-between align-items-center gap-2">
        <div>
            {% if this.resetVisible %}
                <a
                    href="{{ resetUrl }}"
                    class="btn{{ resetBtnClass }}"
                    data-testid="{{ resetTestId }}"
                    {% if keepViewState %}data-controller="query-state" data-query-state-keys-value="{{ this.viewQueryKeys|json_encode }}"{% endif %}
                >
                    {{ 'action.reset'|trans({}, 'messages') }}
                </a>
            {% endif %}
        </div>
        <div class="d-flex justify-content-end gap-2 ms-auto">
            <button type="button"
                    class="btn btn-link link-secondary"
                    data-bs-dismiss="offcanvas"
                    data-testid="{{ cancelTestId }}">
                {{ 'action.cancel'|trans({}, 'messages') }}
            </button>
            <button type="submit"
                    class="btn btn-primary"
                    form="{{ formId }}"
                    data-testid="{{ applyTestId }}">
                {{ 'action.apply'|trans({}, 'messages') }}
            </button>
        </div>
    </div>
</div>
