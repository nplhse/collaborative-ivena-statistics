<div{{ attributes }}>
    <div class="card data-table-card">
        {% if title or this.shouldShowHeaderActions %}
            <div class="card-header">
                {% if title %}<h3 class="card-title">{{ title }}</h3>{% endif %}
                {% if this.shouldShowHeaderActions %}
                    <div class="card-actions">
                        <div class="data-table-toolbar" data-testid="data-table-toolbar">
                            {% block toolbar %}{% endblock %}
                            {% if this.shouldShowSortMenu or this.shouldShowColumnVisibility %}
                                <div
                                    class="btn-group btn-group-sm"
                                    role="group"
                                    aria-label="{{ 'label.data_table.configure'|trans({}, 'shared') }}"
                                    data-testid="data-table-configure"
                                >
                                    {% if this.shouldShowSortMenu %}
                                        {{ include('@Shared/components/data_table/_sort_menu.html.twig') }}
                                    {% endif %}
                                    {% if this.shouldShowColumnVisibility %}
                                        {{ include('@Shared/components/data_table/_column_picker.html.twig') }}
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}
        {% if tabs %}
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    {% for tab in tabs %}
                    <li class="nav-item">
                        <a href="{{ tab.path }}" class="nav-link {% if tab.active %}active{% endif %}" target="_top">{{ tab.name }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="card-body p-0{% if loading %} position-relative{% endif %}">
            {% if loading %}
                <div class="data-table-loading" aria-busy="true">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">{{ 'label.loading'|trans({}, 'messages') }}</span>
                    </div>
                </div>
            {% endif %}

            {% if this.declarative %}
                {% set emptyActions %}{% block empty_actions %}{% endblock %}{% endset %}
                {{ include('@Shared/components/data_table/_table.html.twig', {emptyActions: emptyActions}) }}
            {% else %}
                {% block content %}{% endblock %}
            {% endif %}
        </div>

        {% if this.shouldShowFooter %}
            {{ include('@Shared/components/data_table/_footer.html.twig') }}
        {% elseif paginator is not null %}
            <div id="result-count" class="visually-hidden" aria-hidden="true">
                {{ include('@Shared/components/data_table/_result_count.html.twig') }}
            </div>
        {% endif %}
    </div>
</div>
