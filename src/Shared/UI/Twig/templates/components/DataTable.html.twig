<div{{ attributes }}>
    <div class="card">
        {% if title %}
            <div class="card-header">
                <h3 class="card-title">{{ title }}</h3>
            </div>
        {% endif %}
        {% if tabs %}
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    {% for tab in tabs %}
                    <li class="nav-item">
                        <a href="{{ tab.path }}" class="nav-link {% if tab.active %}active{% endif %}" target="_top">{{ tab.name }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="card-body p-0{% if loading %} position-relative{% endif %}">
            {% if loading %}
                <div class="data-table-loading" aria-busy="true">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">{{ 'label.loading'|trans({}, 'messages') }}</span>
                    </div>
                </div>
            {% endif %}

            {% if this.declarative %}
                {{ include('@Shared/components/data_table/_table.html.twig') }}
            {% else %}
                {% block content %}{% endblock %}
            {% endif %}
        </div>

        {% if this.shouldShowFooter %}
            {{ include('@Shared/components/data_table/_footer.html.twig') }}
        {% elseif paginator is not null %}
            <div id="result-count" class="visually-hidden" aria-hidden="true">
                {{ include('@Shared/components/data_table/_result_count.html.twig') }}
            </div>
        {% endif %}
    </div>
</div>
