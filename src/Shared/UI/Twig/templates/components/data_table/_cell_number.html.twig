{% if value is not null and value is not same as('') %}
    {% if column.options.format is defined %}
        {{ value|number_format(
            column.options.format.decimals|default(0),
            column.options.format.decimalSeparator|default(','),
            column.options.format.thousandsSeparator|default('.'),
        ) }}
    {% else %}
        {{ value }}
    {% endif %}
{% else %}
    {{ column.options.emptyValue|default('') }}
{% endif %}
