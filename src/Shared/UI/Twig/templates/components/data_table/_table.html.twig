{% import '@Shared/_macros/pagination.html.twig' as pagination %}
{#
    Cards layout (mobileLayout="cards"): one markup for every screen width, CSS turns rows into cards
    below md. Explicit roles keep the table semantics when CSS changes the display of table elements
    (Safari/VoiceOver drops them otherwise). Card labels are aria-hidden: screen readers already get the
    column header.
#}
{% set cards = this.mobileCards %}

<div class="table-responsive{% if cards %} data-table-cards data-table-cards--{{ this.mobileBreakpointMode.value }}{% endif %}"{% if cards %} data-testid="data-table-cards"{% endif %}>
    <table class="table card-table"{% if cards %} role="table"{% endif %}>
        <thead{% if cards %} role="rowgroup"{% endif %}>
            <tr{% if cards %} role="row"{% endif %}>
                {% if this.bulkEnabled %}
                    <th scope="col" class="w-1{% if cards %} data-table-cell--select{% endif %}"{% if cards %} role="columnheader"{% endif %}>
                        {% if cards %}<label class="data-table-select-page">{% endif %}
                        <input
                            type="checkbox"
                            class="form-check-input m-0 align-middle"
                            data-bulk-selection-target="toggle"
                            data-action="change->bulk-selection#toggleAll"
                            aria-label="{{ 'label.data_table.bulk.select_page'|trans({}, 'shared') }}"
                            data-testid="data-table-bulk-select-all"
                        >
                        {% if cards %}
                            <span class="data-table-cell__label" aria-hidden="true">{{ 'label.data_table.bulk.select_page'|trans({}, 'shared') }}</span>
                        </label>
                        {% endif %}
                    </th>
                {% endif %}
                {% for column in this.visibleColumns %}
                    {% set headerClasses = [
                        column.width,
                        column.align ? 'text-' ~ column.align : null,
                        column.options.nowrap|default(false) ? 'text-nowrap' : null,
                    ]|filter(value => value) %}
                    <th
                        scope="col"
                        {% if headerClasses %}class="{{ headerClasses|join(' ') }}"{% endif %}
                        {% if cards %}role="columnheader"{% endif %}
                        {% if column.sortable %}aria-sort="{{ this.sortDirection(column) ?? 'none' }}"{% endif %}
                    >
                        {% if column.sortable %}
                            <a class="text-reset text-decoration-none d-inline-flex align-items-center gap-1" href="{{ this.sortUrl(column) }}">
                                {{ column.label|trans({}, column.labelDomain) }}
                                {{ pagination.sortArrow(column.resolvedSortKey(), sortBy, orderBy) }}
                            </a>
                        {% elseif column.label %}
                            {{ column.label|trans({}, column.labelDomain) }}
                        {% endif %}
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody{% if cards %} role="rowgroup"{% endif %}>
            {% for row in this.rowItems %}
                <tr{% if this.rowCssClass(row) %} class="{{ this.rowCssClass(row) }}"{% endif %}{% if cards %} role="row"{% endif %}{% if rowTestId %} data-testid="{{ rowTestId }}"{% endif %}>
                    {% if this.bulkEnabled %}
                        <td class="w-1{% if cards %} data-table-cell--select{% endif %}"{% if cards %} role="cell"{% endif %}>
                            {% if this.bulkSelectable(row) %}
                                <input
                                    type="checkbox"
                                    class="form-check-input m-0 align-middle"
                                    name="ids[]"
                                    value="{{ this.bulkRowId(row) }}"
                                    form="{{ bulkId }}-form"
                                    data-bulk-selection-target="item"
                                    data-action="change->bulk-selection#update"
                                    aria-label="{{ 'label.data_table.bulk.select_row'|trans({id: this.bulkRowId(row)}, 'shared') }}"
                                    data-testid="data-table-bulk-select-row"
                                >
                            {% endif %}
                        </td>
                    {% endif %}
                    {% for column in this.visibleColumns %}
                        {% set cellClasses = [
                            column.align ? 'text-' ~ column.align : null,
                            column.options.nowrap|default(false) ? 'text-nowrap' : null,
                            cards and this.mobilePrimary(column) ? 'data-table-cell--primary' : null,
                            cards and this.mobileAction(column) ? (this.mobileActionMenu(column) ? 'data-table-cell--actions' : 'data-table-cell--actions-extra') : null,
                        ]|filter(value => value) %}
                        {% set cellContent %}
                            {{- include('@Shared/components/data_table/_cell.html.twig', {
                                row: row,
                                column: column,
                                value: this.cellValue(row, column),
                            }) -}}
                        {% endset %}
                        <td{% if cellClasses %} class="{{ cellClasses|join(' ') }}"{% endif %}{% if cards %} role="cell"{% endif %}>
                            {% if cards %}
                                {% if this.mobileLabel(column) %}
                                    <span class="data-table-cell__label" aria-hidden="true">{{ this.mobileLabelText(column)|trans({}, column.labelDomain) }}</span>
                                {% endif %}
                                <div class="data-table-cell__value">{{ cellContent }}</div>
                                {% if this.mobileActionMenu(column) %}
                                    {{ include('@Shared/components/data_table/_card_menu.html.twig', {row: row}) }}
                                {% endif %}
                            {% else %}
                                {{ cellContent }}
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% else %}
                <tr{% if cards %} class="data-table-row--empty" role="row"{% endif %}>
                    <td colspan="{{ this.columnCount }}"{% if cards %} role="cell"{% endif %}>
                        <twig:EmptyState
                            title="{{ emptyTitle ?? 'label.search_no_results'|trans({}, 'messages') }}"
                            description="{{ emptyDescription ?? 'help.search_no_results'|trans({}, 'shared') }}"
                            icon="{{ emptyIcon ?? 'tabler:mood-sad' }}"
                        >
                            <twig:block name="actions">{{ emptyActions|default('')|raw }}</twig:block>
                        </twig:EmptyState>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
