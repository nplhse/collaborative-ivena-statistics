{% import '@Shared/_macros/pagination.html.twig' as pagination %}

<div class="table-responsive">
    <table class="table card-table">
        <thead>
            <tr>
                {% for column in this.visibleColumns %}
                    {% set headerClasses = [
                        column.width,
                        column.align ? 'text-' ~ column.align : null,
                        column.options.nowrap|default(false) ? 'text-nowrap' : null,
                    ]|filter(value => value) %}
                    <th
                        scope="col"
                        {% if headerClasses %}class="{{ headerClasses|join(' ') }}"{% endif %}
                        {% if column.sortable %}aria-sort="{{ this.sortDirection(column) ?? 'none' }}"{% endif %}
                    >
                        {% if column.sortable %}
                            <a class="text-reset text-decoration-none d-inline-flex align-items-center gap-1" href="{{ this.sortUrl(column) }}">
                                {{ column.label|trans({}, column.labelDomain) }}
                                {{ pagination.sortArrow(column.resolvedSortKey(), sortBy, orderBy) }}
                            </a>
                        {% elseif column.label %}
                            {{ column.label|trans({}, column.labelDomain) }}
                        {% endif %}
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in this.rowItems %}
                <tr{% if this.rowCssClass(row) %} class="{{ this.rowCssClass(row) }}"{% endif %}{% if rowTestId %} data-testid="{{ rowTestId }}"{% endif %}>
                    {% for column in this.visibleColumns %}
                        {% set cellClasses = [
                            column.align ? 'text-' ~ column.align : null,
                            column.options.nowrap|default(false) ? 'text-nowrap' : null,
                        ]|filter(value => value) %}
                        <td{% if cellClasses %} class="{{ cellClasses|join(' ') }}"{% endif %}>
                            {{ include('@Shared/components/data_table/_cell.html.twig', {
                                row: row,
                                column: column,
                                value: this.cellValue(row, column),
                            }) }}
                        </td>
                    {% endfor %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ this.visibleColumns|length }}">
                        <twig:EmptyState
                            title="{{ emptyTitle ?? 'label.search_no_results'|trans({}, 'messages') }}"
                            description="{{ emptyDescription ?? 'help.search_no_results'|trans({}, 'shared') }}"
                            icon="{{ emptyIcon ?? 'tabler:mood-sad' }}"
                        >
                            <twig:block name="actions">{{ emptyActions|default('')|raw }}</twig:block>
                        </twig:EmptyState>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
