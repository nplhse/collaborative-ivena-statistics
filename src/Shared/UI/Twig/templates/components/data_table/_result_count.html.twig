{# Cursor paginations (CursorPaginationInterface) have no total of their own; some add a ResultCount. #}
{% if paginator.nextCursor is defined %}
    {% set resultCount = paginator.resultCount is defined ? paginator.resultCount : null %}
    {% if resultCount and resultCount.isLowerBound %}
        {{ 'label.pagination_numbers_more_than'|trans({
            total: resultCount.count|number_format(0, ',', '.'),
        }, 'messages') }}
    {% elseif resultCount and resultCount.count > 0 %}
        {{ 'label.pagination_numbers_counted'|trans({
            count: resultCount.count,
            total: resultCount.count|number_format(0, ',', '.'),
            pageCount: paginator.lastPage,
            pages: paginator.lastPage|number_format(0, ',', '.'),
        }, 'messages') }}
    {% else %}
        {{ 'label.pagination_showing_results'|trans({}, 'messages') }}
    {% endif %}
{% else %}
    {{ 'label.pagination_numbers'|trans({
        first: paginator.firstItemNumber|default(0),
        last: paginator.lastItemNumber|default(0),
        total: paginator.totalItems|default(0),
    }, 'messages') }}
{% endif %}
