{# Cursor paginations (CursorPaginationInterface) have no exact total; some offer an estimate. #}
{% if paginator.nextCursor is defined %}
    {% set estimatedTotal = paginator.estimatedNumResults is defined ? paginator.estimatedNumResults : null %}
    {% if estimatedTotal %}
        {{ 'label.pagination_numbers_estimated'|trans({
            total: estimatedTotal|number_format(0, ',', '.'),
            pages: paginator.estimatedLastPage|number_format(0, ',', '.'),
        }, 'messages') }}
    {% else %}
        {{ 'label.pagination_showing_results'|trans({}, 'messages') }}
    {% endif %}
{% else %}
    {{ 'label.pagination_numbers'|trans({
        first: paginator.firstItemNumber|default(0),
        last: paginator.lastItemNumber|default(0),
        total: paginator.totalItems|default(0),
    }, 'messages') }}
{% endif %}
