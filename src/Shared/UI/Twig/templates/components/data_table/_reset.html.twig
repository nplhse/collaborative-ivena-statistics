{% if this.preferenceEnabled %}
    <form class="btn-group btn-group-sm" method="post" action="{{ preferenceSaveUrl }}">
        <input type="hidden" name="_token" value="{{ preferenceCsrfToken }}">
        <input type="hidden" name="tableKey" value="{{ preferenceKey }}">
        <input type="hidden" name="returnUrl" value="{{ this.resetUrl }}">
        <button
            type="submit"
            class="btn btn-sm btn-outline-secondary"
            name="action" value="reset"
            aria-label="{{ 'label.data_table.reset'|trans({}, 'shared') }}"
            title="{{ 'label.data_table.reset'|trans({}, 'shared') }}"
            data-testid="data-table-reset"
        >
            <twig:ux:icon name="tabler:restore" class="icon" />
            {{ 'label.data_table.reset'|trans({}, 'shared') }}
        </button>
    </form>
{% else %}
    <div class="btn-group btn-group-sm">
        <a
            class="btn btn-sm btn-outline-secondary"
            href="{{ this.resetUrl }}"
            aria-label="{{ 'label.data_table.reset'|trans({}, 'shared') }}"
            title="{{ 'label.data_table.reset'|trans({}, 'shared') }}"
            data-testid="data-table-reset"
        >
            <twig:ux:icon name="tabler:restore" class="icon" />
            {{ 'label.data_table.reset'|trans({}, 'shared') }}
        </a>
    </div>
{% endif %}
