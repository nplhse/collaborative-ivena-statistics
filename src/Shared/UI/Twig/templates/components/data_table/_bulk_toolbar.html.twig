{# Shown while rows are selected: count, actions and "clear selection". The row checkboxes belong to this form. #}
<div
    class="card-body border-bottom py-2 d-flex d-none flex-wrap align-items-center gap-2"
    data-bulk-selection-target="toolbar"
    data-testid="data-table-bulk-toolbar"
>
    <span class="me-auto fw-medium" data-bulk-selection-target="label" aria-live="polite" data-testid="data-table-bulk-count"></span>
    <form id="{{ bulkId }}-form" method="post" action="{{ bulkFormAction }}" class="d-flex flex-wrap gap-2" data-turbo-frame="_top">
        <input type="hidden" name="_token" value="{{ bulkCsrfToken }}">
        <button type="button" class="btn btn-sm btn-link" data-action="bulk-selection#clear" data-testid="data-table-bulk-clear">
            {{ 'label.data_table.bulk.clear'|trans({}, 'shared') }}
        </button>
        {% for action in bulkActions %}
            {% if action.requiresConfirmation %}
                <button
                    type="button"
                    class="btn btn-sm btn-{{ action.variant }}"
                    data-bs-toggle="modal"
                    data-bs-target="#{{ bulkId }}-confirm-{{ action.name }}"
                    data-testid="data-table-bulk-action-{{ action.name }}"
                >
            {% else %}
                <button
                    type="submit"
                    name="bulk_action"
                    value="{{ action.name }}"
                    class="btn btn-sm btn-{{ action.variant }}"
                    data-testid="data-table-bulk-action-{{ action.name }}"
                >
            {% endif %}
                {% if action.icon %}<twig:ux:icon :name="action.icon" class="icon" />&nbsp;{% endif %}{{ action.label }}
            </button>
        {% endfor %}
    </form>
</div>
