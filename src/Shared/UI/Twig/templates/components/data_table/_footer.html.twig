<div class="card-footer d-flex align-items-center flex-wrap gap-2">
    <div class="d-flex align-items-center flex-wrap gap-3">
        <div class="dropdown">
            <a class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="me-1">
                    {{ 'label.pagination_results'|trans({pageSize: this.pageSize}, 'messages') }}
                </span>
            </a>
            <div class="dropdown-menu">
                {% for link in this.pageSizeLinks %}
                    {% if this.preferenceEnabled %}
                        <form method="post" action="{{ preferenceSaveUrl }}">
                            <input type="hidden" name="_token" value="{{ preferenceCsrfToken }}">
                            <input type="hidden" name="tableKey" value="{{ preferenceKey }}">
                            <input type="hidden" name="returnUrl" value="{{ preferenceReturnUrl }}">
                            <input type="hidden" name="pageSize" value="{{ link.size }}">
                            {% for column in this.visibleColumns %}<input type="hidden" name="visibleColumns[]" value="{{ column.key }}">{% endfor %}
                            {% for key in this.resolvedColumnOrder %}<input type="hidden" name="columnOrder[]" value="{{ key }}">{% endfor %}
                            <button type="submit" class="dropdown-item{% if link.active %} active{% endif %}" name="action" value="save">
                                {{ 'label.pagination_results'|trans({pageSize: link.size}, 'messages') }}
                            </button>
                        </form>
                    {% else %}
                        <a class="dropdown-item{% if link.active %} active{% endif %}" href="{{ link.url }}"{% for name, value in this.turboPaginationLinkAttributes %} {{ name }}="{{ value }}"{% endfor %}>
                            {{ 'label.pagination_results'|trans({pageSize: link.size}, 'messages') }}
                        </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="text-secondary" id="result-count">
            {{ include('@Shared/components/data_table/_result_count.html.twig') }}
        </div>
    </div>

    {% if this.cursorPaginator %}
        {{ include('@Shared/components/data_table/_cursor_nav.html.twig') }}
    {% elseif this.uxPaginator %}
        {{ ux_pagination(paginator, showInfo: false, attributes: {class: 'ms-auto'}, navigationAttributes: {class: 'm-0'}, linkAttributes: this.turboPaginationLinkAttributes) }}
    {% endif %}
</div>
