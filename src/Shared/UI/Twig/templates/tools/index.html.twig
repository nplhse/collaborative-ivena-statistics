{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'tools.title'|trans({}, 'shared') }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs :items="[
            { label: 'link.tools', label_domain: 'shared' }
        ]" />

        <div class="page-header d-print-none">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ 'tools.title'|trans({}, 'shared') }}</h2>
                    <div class="text-secondary mt-1">{{ 'tools.intro'|trans({}, 'shared') }}</div>
                </div>
                {% if topics|length > 1 %}
                    <div class="col-12 col-md-auto mt-3 mt-md-0">
                        <div class="dropdown" data-testid="tools-topic-filter">
                            <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" data-testid="tools-topic-toggle">
                                <twig:ux:icon name="tabler:tag" class="icon" />
                                {{ 'tools.topic.filter_label'|trans({}, 'shared') }}:
                                {{ topic ? topic.labelKey|trans({}, 'shared') : 'tools.topic.all'|trans({}, 'shared') }}
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item{{ topic is null ? ' active' : '' }}" href="{{ path('app_tools_index') }}" {% if topic is null %}aria-current="true"{% endif %} data-testid="tools-topic-option" data-tools-topic="">
                                    {{ 'tools.topic.all'|trans({}, 'shared') }}
                                </a>
                                {% for option in topics %}
                                    <a class="dropdown-item{{ option == topic ? ' active' : '' }}" href="{{ path('app_tools_index', {topic: option.value}) }}" {% if option == topic %}aria-current="true"{% endif %} data-testid="tools-topic-option" data-tools-topic="{{ option.value }}">
                                        {{ option.labelKey|trans({}, 'shared') }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content %}
    <div data-testid="tools-index">
        {% for group in groups %}
            <section class="mb-4" data-testid="tools-group" data-tools-category="{{ group.category.value }}">
                <h3 class="mb-3">{{ group.category.labelKey|trans({}, 'shared') }}</h3>
                <div class="row row-cards">
                    {% for tool in group.tools %}
                        <div class="col-12 col-md-6 col-lg-4">
                            {#- The title is a stretched link, so the topic badges can be links of their own (no nested anchors). -#}
                            <div class="card card-link h-100 position-relative" data-testid="tools-card" data-tool-key="{{ tool.key }}" data-tool-topics="{{ tool.topics|map(t => t.value)|join(' ') }}">
                                <div class="card-body d-flex align-items-start gap-3">
                                    <span class="avatar bg-primary-lt text-primary flex-shrink-0">
                                        <twig:ux:icon name="{{ tool.icon }}" class="icon" />
                                    </span>
                                    <div class="min-w-0">
                                        <div class="fw-bold">
                                            <a href="{{ path(tool.route, tool.routeParameters) }}" class="text-reset stretched-link" data-testid="tools-card-link">{{ tool.titleKey|trans({}, tool.translationDomain) }}</a>
                                            {% if tool.beta %}
                                                <span class="badge bg-azure-lt ms-1" data-testid="tools-card-beta">{{ 'tools.beta'|trans({}, 'shared') }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="text-secondary mt-1">{{ tool.descriptionKey|trans({}, tool.translationDomain) }}</div>
                                        {% if tool.topics is not empty %}
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                {% for tool_topic in tool.topics %}
                                                    {% set topic_label = tool_topic.labelKey|trans({}, 'shared') %}
                                                    <a href="{{ path('app_tools_index', {topic: tool_topic.value}) }}" class="badge bg-secondary-lt position-relative z-2" title="{{ 'tools.topic.show_only'|trans({topic: topic_label}, 'shared') }}" data-testid="tools-card-topic" data-tools-topic="{{ tool_topic.value }}">{{ topic_label }}</a>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% else %}
            <twig:EmptyState
                title="{{ 'tools.empty'|trans({}, 'shared') }}"
                icon="tabler:tool"
            />
        {% endfor %}
    </div>
{% endblock %}
