{% macro render(type, value, number = null) %}
    {% set badge = data_table_badge(type, value) %}
    {% if badge.presentation.value == 'status' %}
        <span class="{{ badge.cssClass }}">
            {% if badge.animatedDot %}
                <span class="status-dot status-dot-animated"></span>
            {% elseif badge.icon %}
                {{ ux_icon(badge.icon, {width: 12, height: 12}) }}
            {% endif %}
            {{ badge.label }}{% if number is not null %} ({{ number }}){% endif %}
        </span>
    {% else %}
        <span class="badge {{ badge.cssClass }}">{{ badge.label }} {% if number is not null %}({{ number }}){% endif %}</span>
    {% endif %}
{% endmacro %}
