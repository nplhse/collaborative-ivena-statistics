{% macro import_status(status) %}
    {% set view = data_table_badge('import_status', status) %}

    <span class="{{ view.cssClass }}">
        {% if view.animatedDot %}
            <span class="status-dot status-dot-animated"></span>
        {% else %}
            {{ ux_icon(view.icon ?? 'tabler:circle', {width: 12, height: 12}) }}
        {% endif %}
        {{ view.label }}
    </span>
{% endmacro %}

{% macro import_rate(percent, kind) %}
    {% set badge = import_rate_badge(percent, kind) %}
    <span class="status status-{{ badge.color }}">
        {{ ux_icon(badge.icon, {width: 12, height: 12}) }}
        {{ percent|number_format(2, ',', '.') }}%
    </span>
{% endmacro %}
