{# Vote information and the actions of the viewer (ADR 045). Single votes only for Board members; counts and results
   for everyone who can see the request. #}
{% set openRound = dataRequest.getOpenRound() %}
{% set canVote = is_granted('DATA_REQUEST_VOTE', dataRequest) %}
{% set canSeeVotes = is_granted('DATA_REQUEST_VIEW_VOTES', dataRequest) %}
{% set canResolve = is_granted('DATA_REQUEST_RESOLVE', dataRequest) %}
{% set canCheck = dataRequest.status.value == 'submitted' and is_granted('DATA_REQUEST_CHECK', dataRequest) %}
{% set canExcludeSelf = is_granted('DATA_REQUEST_EXCLUDE_SELF', dataRequest) %}
{% set canExcludeOthers = is_granted('DATA_REQUEST_RECORD_EXCLUSION', dataRequest) and boardMembers|filter(member => member.id != app.user.id) is not empty %}
{% set ownActions = own and (is_granted('DATA_REQUEST_EDIT', dataRequest) or is_granted('DATA_REQUEST_SUBMIT', dataRequest) or is_granted('DATA_REQUEST_WITHDRAW', dataRequest)) %}
{% set token = 'data_request_review_' %}
{% set canManageQueries = is_granted('DATA_REQUEST_MANAGE_QUERIES', dataRequest) %}
{% set revocable = releases|filter(entry => entry.canRevoke) %}
{% import '@Shared/_macros/users.html.twig' as users %}

{% if dataRequest.wasSubmitted %}
    <div class="card mb-3" data-testid="data-request-review">
        <div class="card-header"><h3 class="card-title">{{ 'data_request.review.title'|trans({}, 'research') }}</h3></div>
        <div class="card-body">
            {% if dataRequest.handbackMessage and (own or canResolve or canSeeVotes) %}
                <div class="alert alert-warning" role="note" data-testid="data-request-handback">
                    <div class="fw-bold">{{ ('data_request.review.handback.' ~ dataRequest.status.value)|trans({}, 'research') }}</div>
                    <div class="text-break">{{ dataRequest.handbackMessage|nl2br }}</div>
                </div>
            {% endif %}
            {% if dataRequest.revisionDeadline and dataRequest.status.value == 'revision_requested' %}
                <p data-testid="data-request-revision-deadline">{{ 'data_request.review.revision_until'|trans({date: dataRequest.revisionDeadline|format_datetime('medium', 'short')}, 'research') }}</p>
            {% endif %}

            {% if dataRequest.status.value == 'submitted' %}
                <p class="text-body-secondary">{{ 'data_request.review.awaiting_check'|trans({}, 'research') }}</p>
            {% endif %}

            {% for round in dataRequest.rounds|reverse %}
                {% set outcome = round.outcome ? round.outcome.value : 'open' %}
                {% set look = {
                    open: ['blue', 'tabler:clock'],
                    approved: ['green', 'tabler:circle-check'],
                    revision_requested: ['yellow', 'tabler:alert-circle'],
                    rejected: ['red', 'tabler:circle-x'],
                    quorum_missed: ['secondary', 'tabler:circle-x'],
                    vetoed: ['red', 'tabler:ban'],
                    cancelled: ['secondary', 'tabler:x'],
                }[outcome] %}
                <div class="{{ not loop.first ? 'border-top pt-3 mt-3' }}" data-testid="data-request-round">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <twig:Badge :variant="look[0]" data-testid="data-request-round-outcome" data-outcome="{{ outcome }}">
                            <twig:ux:icon name="{{ look[1] }}" class="icon me-1" />{{ round.outcome ? round.outcome.labelKey|trans({}, 'research') : 'data_request.round.open'|trans({}, 'research') }}
                        </twig:Badge>
                        <span class="text-secondary small">{{ 'data_request.round.title'|trans({number: round.number, version: round.version.number}, 'research') }}</span>
                    </div>
                    <div class="small text-body-secondary mt-2">
                        {{ 'data_request.round.summary'|trans({
                            cast: round.choices|length,
                            eligible: round.eligibleCount,
                            quorum: round.quorum,
                        }, 'research') }}
                        <br>
                        {% if round.open %}
                            {{ 'data_request.round.deadline'|trans({date: round.deadline|format_datetime('medium', 'short')}, 'research') }}
                            {% if round.kind.value == 'after_revision' %}<br>{{ 'data_request.round.after_revision'|trans({}, 'research') }}{% endif %}
                        {% else %}
                            {{ 'data_request.round.closed_at'|trans({date: round.closedAt|format_datetime('medium', 'short')}, 'research') }}
                        {% endif %}
                    </div>
                    {% if round.votes is not empty %}
                        <ul class="list-unstyled small mt-2 mb-0" data-testid="data-request-votes">
                            {% for vote in round.votes %}
                                {% set choiceLook = {
                                    approve: ['text-success', 'tabler:circle-check'],
                                    revision: ['text-warning', 'tabler:alert-circle'],
                                    reject: ['text-danger', 'tabler:circle-x'],
                                    veto: ['text-danger', 'tabler:ban'],
                                }[vote.choice.value] %}
                                <li class="d-flex align-items-center gap-1 mb-1" data-testid="data-request-voter"{% if canSeeVotes %} data-choice="{{ vote.choice.value }}"{% endif %}>
                                    {% if canSeeVotes %}
                                        <twig:ux:icon name="{{ choiceLook[1] }}" class="icon {{ choiceLook[0] }}" title="{{ vote.choice.labelKey|trans({}, 'research') }}" aria-label="{{ vote.choice.labelKey|trans({}, 'research') }}" />
                                    {% endif %}
                                    {{ users.link(vote.voter, {avatar: 'inline'}) }}
                                    {% if canSeeVotes and vote.carriedOver %}<span class="text-body-secondary">({{ 'data_request.vote.carried_over'|trans({}, 'research') }})</span>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endfor %}

            {% if dataRequest.exclusions is not empty and (canSeeVotes or canResolve or is_granted('ROLE_ADMIN')) %}
                <div class="mt-3" data-testid="data-request-exclusions">
                    <div class="form-label">{{ 'data_request.exclusion.list'|trans({}, 'research') }}</div>
                    <ul class="list-unstyled small mb-0">
                        {% for exclusion in dataRequest.exclusions %}
                            <li class="mb-1"><strong>{{ exclusion.member.username }}</strong>: <span class="text-break">{{ exclusion.reason }}</span></li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}

{% if canVote or canCheck or canResolve or ownActions or canExcludeSelf or canExcludeOthers or canManageQueries or canRelease or revocable is not empty %}
    {% set fixedActions = canVote or canCheck or canResolve or ownActions or canExcludeSelf or canExcludeOthers %}
    {# Actions that belong to one tab show only with it; without any other action the card shows only then too. #}
    <div class="card mb-3{{ fixedActions ? '' : ' d-none' }}" data-testid="data-request-actions" data-data-request-tabs-target="actionsCard" data-fixed-actions="{{ fixedActions ? 1 : 0 }}">
        <div class="card-header"><h3 class="card-title">{{ 'data_request.actions.title'|trans({}, 'research') }}</h3></div>
        <div class="card-body">
            {% if canVote %}
                {% set ownVote = openRound.voteOf(app.user) %}
                <form method="post" action="{{ path('app_data_requests_review', {publicId: dataRequest.publicIdString, action: 'vote'}) }}" class="mb-3" data-testid="data-request-vote-form">
                    <input type="hidden" name="_token" value="{{ csrf_token(token ~ 'vote_' ~ dataRequest.publicIdString) }}">
                    <div class="form-label">{{ 'data_request.vote.title'|trans({}, 'research') }}</div>
                    {% for choice in enum_cases('App\\Research\\Domain\\Enum\\VoteChoice') %}
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="choice" value="{{ choice.value }}" {{ ownVote and ownVote.choice == choice ? 'checked' }} required>
                            <span class="form-check-label">{{ choice.labelKey|trans({}, 'research') }}</span>
                        </label>
                    {% endfor %}
                    <label class="form-label mt-2" for="data-request-vote-reason">{{ 'data_request.vote.reason'|trans({}, 'research') }}</label>
                    <textarea class="form-control mb-1" id="data-request-vote-reason" name="message" rows="3"></textarea>
                    <div class="form-hint mb-2">{{ 'data_request.vote.reason_help'|trans({}, 'research') }}</div>
                    <button type="submit" class="btn btn-primary w-100" data-testid="data-request-vote">{{ (ownVote ? 'data_request.vote.change' : 'data_request.vote.cast')|trans({}, 'research') }}</button>
                </form>
            {% endif %}

            {% if canCheck %}
                <div class="mb-3" data-testid="data-request-check">
                    <form method="post" action="{{ path('app_data_requests_review', {publicId: dataRequest.publicIdString, action: 'open'}) }}" class="mb-3">
                        <input type="hidden" name="_token" value="{{ csrf_token(token ~ 'open_' ~ dataRequest.publicIdString) }}">
                        <button type="submit" class="btn btn-primary w-100" data-testid="data-request-open-round">{{ 'data_request.review.action.open'|trans({}, 'research') }}</button>
                    </form>
                    <form method="post" action="{{ path('app_data_requests_review', {publicId: dataRequest.publicIdString, action: 'return'}) }}" data-testid="data-request-return-form">
                        <input type="hidden" name="_token" value="{{ csrf_token(token ~ 'return_' ~ dataRequest.publicIdString) }}">
                        <label class="form-label" for="data-request-return-message">{{ 'data_request.review.return_message'|trans({}, 'research') }}</label>
                        <textarea class="form-control mb-2" id="data-request-return-message" name="message" rows="3" required></textarea>
                        <button type="submit" class="btn btn-outline-secondary w-100" data-testid="data-request-return">{{ 'data_request.review.action.return'|trans({}, 'research') }}</button>
                    </form>
                </div>
            {% endif %}
            {% if canResolve %}
                <form method="post" action="{{ path('app_data_requests_review', {publicId: dataRequest.publicIdString, action: 'resolve'}) }}" class="mb-3" data-testid="data-request-resolve-form">
                    <input type="hidden" name="_token" value="{{ csrf_token(token ~ 'resolve_' ~ dataRequest.publicIdString) }}">
                    <div class="form-label">{{ 'data_request.resolve.title'|trans({}, 'research') }}</div>
                    {% for resolution in ['restart', 'revision', 'close'] %}
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="resolution" value="{{ resolution }}" required>
                            <span class="form-check-label">{{ ('data_request.resolve.' ~ resolution)|trans({}, 'research') }}</span>
                        </label>
                    {% endfor %}
                    <label class="form-label mt-2" for="data-request-resolve-message">{{ 'data_request.resolve.message'|trans({}, 'research') }}</label>
                    <textarea class="form-control mb-2" id="data-request-resolve-message" name="message" rows="3"></textarea>
                    <button type="submit" class="btn btn-primary w-100" data-testid="data-request-resolve">{{ 'data_request.resolve.submit'|trans({}, 'research') }}</button>
                </form>
            {% endif %}

            {% if own %}
                {% if is_granted('DATA_REQUEST_EDIT', dataRequest) %}
                    <a class="btn btn-outline-secondary w-100 mb-2" href="{{ path('app_data_requests_edit', {publicId: dataRequest.publicIdString}) }}" data-testid="data-request-edit">
                        <twig:ux:icon name="tabler:pencil" width="1em" height="1em" />&nbsp;{{ 'data_request.action.edit'|trans({}, 'research') }}
                    </a>
                {% endif %}
                {% for transition in ['submit', 'withdraw'] %}
                    {% if is_granted('DATA_REQUEST_' ~ transition|upper, dataRequest) %}
                        <button type="button" class="btn {{ transition == 'submit' ? 'btn-primary' : 'btn-outline-danger' }} w-100 mb-2" data-bs-toggle="modal" data-bs-target="#data-request-{{ transition }}-modal" data-testid="data-request-{{ transition }}">
                            {{ ('data_request.action.' ~ transition)|trans({}, 'research') }}
                        </button>
                    {% endif %}
                {% endfor %}
            {% endif %}
            {% if canManageQueries %}
                <div class="d-none" data-data-request-tabs-target="action" data-tab="tab-queries" data-testid="data-request-query-actions">
                    <button type="button" class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#data-request-query-add-modal" data-testid="data-request-query-add-open">
                        <twig:ux:icon name="tabler:plus" class="icon" /> {{ 'data_request.query.action.add'|trans({}, 'research') }}
                    </button>
                </div>
            {% endif %}
            {% if canRelease or revocable is not empty %}
                <div class="d-none" data-data-request-tabs-target="action" data-tab="tab-release" data-testid="data-request-release-actions">
                    {% if canRelease %}
                        <button type="button" class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#data-request-release-modal" data-testid="data-request-release-open">
                            <twig:ux:icon name="tabler:key" class="icon" /> {{ 'data_request.release.action'|trans({}, 'research') }}
                        </button>
                    {% endif %}
                    {% for entry in revocable %}
                        <button type="button" class="btn btn-outline-danger w-100 mb-2" data-bs-toggle="modal" data-bs-target="#data-request-release-{{ entry.release.number }}-revoke-modal" data-testid="data-request-release-revoke-open">
                            <twig:ux:icon name="tabler:key-off" class="icon" /> {{ 'data_request.release.revoke_number'|trans({number: entry.release.number}, 'research') }}
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
            {% if canExcludeSelf %}
                <button type="button" class="btn btn-outline-danger w-100 mb-2" data-bs-toggle="modal" data-bs-target="#data-request-exclude-self-modal" data-testid="data-request-exclude-self-open">
                    {{ 'data_request.exclusion.self.open'|trans({}, 'research') }}
                </button>
            {% endif %}
            {% if canExcludeOthers %}
                <button type="button" class="btn btn-outline-danger w-100 mb-2" data-bs-toggle="modal" data-bs-target="#data-request-exclude-member-modal" data-testid="data-request-exclude-member-open">
                    {{ 'data_request.exclusion.member.open'|trans({}, 'research') }}
                </button>
            {% endif %}
        </div>
    </div>
{% endif %}

{% if canExcludeSelf %}
    <twig:Modal id="data-request-exclude-self-modal" :title="'data_request.exclusion.self.title'|trans({}, 'research')" :scrollable="false">
        <form method="post" action="{{ path('app_data_requests_review', {publicId: dataRequest.publicIdString, action: 'exclude'}) }}" data-testid="data-request-exclude-self-form">
            <input type="hidden" name="_token" value="{{ csrf_token(token ~ 'exclude_' ~ dataRequest.publicIdString) }}">
            <input type="hidden" name="member" value="{{ app.user.id }}">
            <div class="modal-body">
                <label class="form-label" for="data-request-exclude-self-reason">{{ 'data_request.exclusion.self.reason'|trans({}, 'research') }}</label>
                <textarea class="form-control mb-1" id="data-request-exclude-self-reason" name="message" rows="3" required></textarea>
                <div class="form-hint">{{ 'data_request.exclusion.self.help'|trans({}, 'research') }}</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">{{ 'action.cancel'|trans({}, 'messages') }}</button>
                <button type="submit" class="btn btn-danger" data-testid="data-request-exclude-self">{{ 'data_request.exclusion.self.submit'|trans({}, 'research') }}</button>
            </div>
        </form>
    </twig:Modal>
{% endif %}

{% if canExcludeOthers %}
    <twig:Modal id="data-request-exclude-member-modal" :title="'data_request.exclusion.member.title'|trans({}, 'research')" :scrollable="false">
        <form method="post" action="{{ path('app_data_requests_review', {publicId: dataRequest.publicIdString, action: 'exclude'}) }}" data-testid="data-request-exclude-member-form">
            <input type="hidden" name="_token" value="{{ csrf_token(token ~ 'exclude_' ~ dataRequest.publicIdString) }}">
            <div class="modal-body">
                <label class="form-label" for="data-request-exclude-member">{{ 'data_request.exclusion.member.member'|trans({}, 'research') }}</label>
                <select class="form-select mb-3" id="data-request-exclude-member" name="member" required>
                    {% for member in boardMembers|filter(member => member.id != app.user.id) %}
                        <option value="{{ member.id }}">{{ member.username }}</option>
                    {% endfor %}
                </select>
                <label class="form-label" for="data-request-exclude-member-reason">{{ 'data_request.exclusion.member.reason'|trans({}, 'research') }}</label>
                <textarea class="form-control mb-1" id="data-request-exclude-member-reason" name="message" rows="3" required></textarea>
                <div class="form-hint">{{ 'data_request.exclusion.member.help'|trans({}, 'research') }}</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">{{ 'action.cancel'|trans({}, 'messages') }}</button>
                <button type="submit" class="btn btn-danger" data-testid="data-request-exclude-member">{{ 'data_request.exclusion.member.submit'|trans({}, 'research') }}</button>
            </div>
        </form>
    </twig:Modal>
{% endif %}
