{# Basic information about the request, like on other detail pages: icon, label, value. #}
<div class="mb-3" data-testid="data-request-basics">
    <twig:Card title="{{ 'label.basic_info'|trans({}, 'messages') }}">
        {% import '@Shared/_macros/users.html.twig' as users %}
        <div class="mb-2" id="data-request-created-at">
            <twig:ux:icon name="tabler:clock-play" class="w-3 h-3" />
            {{ 'label.created_at'|trans({}, 'messages') }} <strong>{{ dataRequest.createdAt|format_datetime('medium', 'short') }}</strong>
        </div>
        {% if dataRequest.submittedAt %}
            <div class="mb-2" id="data-request-submitted-at">
                <twig:ux:icon name="tabler:send" class="w-3 h-3" />
                {{ 'data_request.basics.submitted_at'|trans({}, 'research') }} <strong>{{ dataRequest.submittedAt|format_datetime('medium', 'short') }}</strong>
            </div>
        {% endif %}
        <div class="mb-2" data-testid="data-request-version">
            <twig:ux:icon name="tabler:git-compare" class="w-3 h-3" />
            {{ 'data_request.basics.version'|trans({}, 'research') }} <strong>{{ 'data_request.basics.version_of'|trans({number: version.number, count: dataRequest.versions|length}, 'research') }}</strong>
            {% if dataRequest.versions|length > 1 %}
                · <a href="#tab-versions" data-testid="data-request-compare-link">{{ 'data_request.compare.link'|trans({}, 'research') }}</a>
            {% endif %}
        </div>
        <div class="mb-2">
            <twig:ux:icon name="tabler:clock-edit" class="w-3 h-3" />
            {{ 'label.updated_at'|trans({}, 'messages') }} <strong>{{ version.updatedAt|format_datetime('medium', 'short') }}</strong>
        </div>
        <div class="mb-2">
            <twig:ux:icon name="tabler:user-edit" class="w-3 h-3" />
            {{ 'label.updated_by'|trans({}, 'messages') }} <strong>{{ users.link(version.createdBy, {avatar: 'inline'}) }}</strong>
        </div>
        {% if dataRequest.approvedVersion %}
            <div class="mb-2">
                <twig:ux:icon name="tabler:circle-check" class="w-3 h-3" />
                {{ 'data_request.basics.approved_version'|trans({}, 'research') }} <strong>{{ 'data_request.basics.version_number'|trans({number: dataRequest.approvedVersion.number}, 'research') }}</strong>
            </div>
        {% endif %}
        {% if dataRequest.closedAt %}
            <div>
                <twig:ux:icon name="tabler:flag" class="w-3 h-3" />
                {{ 'data_request.basics.closed_at'|trans({}, 'research') }} <strong>{{ dataRequest.closedAt|format_datetime('medium', 'short') }}</strong>
            </div>
        {% endif %}
    </twig:Card>
</div>
