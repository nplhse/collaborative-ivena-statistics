{# Timeline of a data extract request (ADR 045): events and comments in the order they happened, like a GitHub issue.
   Each reader sees only the levels they may read; the form offers only the levels they may write. #}
{% set newLevels = writableLevels|sort((a, b) => b.reach <=> a.reach) %}

<div class="mt-3" id="comments" data-testid="data-request-timeline">
    <h3 class="mb-3">{{ 'data_request.timeline.title'|trans({}, 'research') }}</h3>
    <ul class="timeline" data-testid="data-request-timeline-entries">
        {% for entry in timeline %}
            {% if entry.event %}
                {% set first = entry.event %}
                {% set single = entry.events|length == 1 %}
                <li class="timeline-event" data-testid="data-request-event-group">
                    <div class="timeline-event-icon bg-secondary-lt"><twig:ux:icon name="{{ first.type.icon }}" class="icon" /></div>
                    <div class="timeline-event-card card card-sm">
                        <div class="card-body py-2">
                            {% for event in entry.events %}
                                {% set params = {} %}
                                {% for key, value in event.details %}
                                    {% set params = params|merge({(key): (value ~ '')|e}) %}
                                {% endfor %}
                                {% set params = params|merge({
                                    outcome: event.details.outcome is defined ? ('data_request.round.outcome.' ~ event.details.outcome)|trans({}, 'research')|e : '',
                                    choice: event.details.choice is defined ? ('data_request.vote.choice.' ~ event.details.choice)|trans({}, 'research')|e : '',
                                    resolution: event.details.resolution is defined ? ('data_request.resolve.' ~ event.details.resolution)|trans({}, 'research')|e : '',
                                    until: event.details.until is defined and event.details.until ? event.details.until|format_datetime('medium', 'short')|e : '',
                                    excluded: event.details.excluded is defined and event.details.excluded ? event.details.excluded|split(', ')|map(name => '<kbd>' ~ name|e ~ '</kbd>')|join(', ') : 'none',
                                    accepted: event.details.accepted ?? 0,
                                })|merge(event.details.query is defined ? {query: '<kbd>' ~ event.details.query|e ~ '</kbd>'} : {}) %}
                                {% set text %}
                                    <span>{{ event.type.labelKey|trans(params, 'research')|raw }}</span>
                                    {% if event.type.value == 'submitted' and event.details.version is defined and event.details.version > 1 %}
                                        <a class="small ms-1" href="{{ path('app_data_requests_show', {publicId: dataRequest.publicIdString, from: event.details.version - 1, to: event.details.version}) }}#tab-versions" data-testid="data-request-event-compare">{{ 'data_request.compare.changes'|trans({}, 'research') }}</a>
                                    {% endif %}
                                {% endset %}
                                {% if loop.first %}
                                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                        <div class="d-flex align-items-center gap-2 flex-wrap min-w-0"{% if single %} data-testid="data-request-event" data-event="{{ event.type.value }}"{% endif %}>
                                            {% if first.actor %}{{ include('@Research/data_request/_user.html.twig', {person: first.actor}) }}{% endif %}
                                            {% if single %}{{ text }}{% endif %}
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            {% if first.visibility.value != 'public' %}{{ include('@Research/data_request/_visibility_badge.html.twig', {visibility: first.visibility}) }}{% endif %}
                                            <twig:RelativeTimestamp :datetime="first.occurredAt" />
                                        </div>
                                    </div>
                                {% endif %}
                                {% if not single %}
                                    <div class="mt-1" data-testid="data-request-event" data-event="{{ event.type.value }}">
                                        <twig:ux:icon name="{{ event.type.icon }}" class="icon text-secondary me-1" />{{ text }}
                                    </div>
                                {% endif %}
                                {% if event.details.message is defined or event.details.reason is defined %}
                                    <div class="text-body-secondary text-break mt-1">{{ (event.details.message ?? event.details.reason)|nl2br }}</div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </li>
            {% else %}
                <li class="timeline-event" data-testid="data-request-timeline-comment">
                    <div class="timeline-event-icon bg-primary-lt"><twig:ux:icon name="tabler:message-circle" class="icon" /></div>
                    <div class="timeline-event-card">
                        {{ include('@Research/data_request/_comment.html.twig', {comment: entry.comment}) }}
                    </div>
                </li>
            {% endif %}
        {% else %}
            <li class="text-body-secondary" data-testid="data-request-timeline-empty">{{ 'data_request.timeline.empty'|trans({}, 'research') }}</li>
        {% endfor %}
    </ul>

    {% if newLevels is not empty %}
        <div class="card mt-3">
            <div class="card-body">
                <form method="post" action="{{ path('app_data_requests_comment', {publicId: dataRequest.publicIdString}) }}" data-testid="data-request-comment-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('data_request_comment_' ~ dataRequest.publicIdString) }}">
                    <label class="form-label" for="data-request-comment-body">{{ 'data_request.comment.new'|trans({}, 'research') }}</label>
                    <textarea id="data-request-comment-body" name="body" class="form-control mb-2" rows="3" required maxlength="5000"></textarea>
                    {{ include('@Research/data_request/_comment_visibility.html.twig', {levels: newLevels, fieldId: 'comment'}) }}
                    <button type="submit" class="btn btn-primary" data-testid="data-request-comment-submit">{{ 'data_request.comment.submit'|trans({}, 'research') }}</button>
                </form>
            </div>
        </div>
    {% endif %}
</div>
