{# Discussion of a data extract request (ADR 045). Participants read public comments; Board members also see and write
   private ones. #}
{% set canComment = is_granted('DATA_REQUEST_COMMENT', dataRequest) %}
{% set canSeePrivate = is_granted('DATA_REQUEST_VIEW_PRIVATE_COMMENTS', dataRequest) %}
{% set visibleComments = dataRequest.topLevelComments|filter(comment => canSeePrivate or not comment.private) %}

<div class="card mt-3" id="comments" data-testid="data-request-comments">
    <div class="card-header">
        <h3 class="card-title">{{ 'data_request.comment.title'|trans({}, 'research') }}</h3>
    </div>
    <div class="card-body">
        {% if canComment %}
            <form method="post" action="{{ path('app_data_requests_comment', {publicId: dataRequest.publicIdString}) }}" class="mb-4" data-testid="data-request-comment-form">
                <input type="hidden" name="_token" value="{{ csrf_token('data_request_comment_' ~ dataRequest.publicIdString) }}">
                <textarea name="body" class="form-control mb-2" rows="3" required maxlength="5000" aria-label="{{ 'data_request.comment.new'|trans({}, 'research') }}" placeholder="{{ 'data_request.comment.new'|trans({}, 'research') }}"></textarea>
                {{ include('@Research/data_request/_comment_visibility.html.twig', {fieldId: 'comment'}) }}
                <button type="submit" class="btn btn-primary" data-testid="data-request-comment-submit">{{ 'data_request.comment.submit'|trans({}, 'research') }}</button>
            </form>
        {% endif %}

        {% for comment in visibleComments %}
            {{ include('@Research/data_request/_comment.html.twig', {comment: comment, level: 0}) }}
        {% else %}
            <p class="text-body-secondary mb-0" data-testid="data-request-comments-empty">{{ 'data_request.comment.empty'|trans({}, 'research') }}</p>
        {% endfor %}
    </div>
</div>
