{#- Email of the storage alert and the daily storage report (ADR 017): title, message, a table of values and
    the link to the disk usage. Everything is translated in the recipient's locale by StorageEmailCustomizer. -#}
{%- set fg = '#4b5563' -%}
{%- set fgHeading = '#111827' -%}
{%- set link = '#066FD1' -%}
{%- set boxBg = '#ffffff' -%}
{%- set pageBg = '#f9fafb' -%}
{%- set border = '#e8ebee' -%}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="color-scheme" content="light dark"/>
    <meta name="supported-color-schemes" content="light dark"/>
    <title>{{ title }}</title>
</head>
<body style="margin:0;padding:0;background-color:{{ pageBg }};font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:15px;line-height:1.6;color:{{ fg }};-webkit-font-smoothing:antialiased;">
<center role="presentation" style="width:100%;background-color:{{ pageBg }};">
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto;max-width:560px;width:100%;border-collapse:collapse;">
        <tr>
            <td style="padding:40px 16px;">
                <div style="background:{{ boxBg }};border:1px solid {{ border }};border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
                    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;">
                        <tr>
                            <td align="center" style="padding:40px 32px 0;">
                                <h1 style="margin:0;text-align:center;font-size:24px;line-height:1.3;color:{{ fgHeading }};font-weight:600;">{{ title }}</h1>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:32px;">
                                <p style="margin:0 0 24px;">{{ message }}</p>
                                <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14px;line-height:1.5;margin-bottom:24px;">
                                    {%- for row in rows %}
                                        <tr>
                                            <td style="padding:6px 12px 6px 0;border-bottom:1px solid {{ border }};font-weight:600;color:{{ fgHeading }};vertical-align:top;">{{ row.label }}</td>
                                            <td style="padding:6px 0;border-bottom:1px solid {{ border }};text-align:right;vertical-align:top;">{{ row.value }}</td>
                                        </tr>
                                    {%- endfor %}
                                </table>
                                {% if actionUrl %}
                                    <a href="{{ actionUrl }}" style="display:inline-block;background-color:{{ link }};color:#ffffff;text-decoration:none;font-weight:500;font-size:15px;border-radius:4px;padding:12px 24px;">
                                        {{ 'storage.email.action'|trans({}, 'notification') }}
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </div>
                <div style="text-align:center;margin-top:20px;font-size:12px;color:#8491a1;">
                    {% if inboxUrl %}<a href="{{ inboxUrl }}" style="color:#8491a1;">{{ 'notification.email.inbox'|trans({}, 'notification') }}</a><br/>{% endif %}
                    {{ 'email.footer.transactional'|trans(({app: app_title}), 'user') }}
                </div>
            </td>
        </tr>
    </table>
</center>
</body>
</html>
