<turbo-frame id="{{ frameId }}" data-testid="dashboard-activity-next">
    <div class="list-group-item text-center py-3">
        <a href="{{ path('app_dashboard_activity', {cursor: nextCursor}) }}"
           class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1"
           data-testid="dashboard-activity-load-more">
            <twig:ux:icon name="tabler:chevron-down" style="height: 1.1em;" aria-hidden="true" />
            {{ 'dashboard.activity.load_more'|trans({}, 'content') }}
            <twig:ux:icon name="tabler:chevron-down" style="height: 1.1em;" aria-hidden="true" />
        </a>
    </div>
</turbo-frame>
