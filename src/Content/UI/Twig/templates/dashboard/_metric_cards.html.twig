<div class="row row-cards" data-testid="dashboard-metrics">
    {% for metric in metrics.items %}
        {% set canLink = is_granted('ROLE_PARTICIPANT') and metric.routeName %}
        <div class="col-12 col-md-6 col-lg-3">
            <twig:KpiCard
                :label="metric.labelTranslationKey|trans({}, 'content')"
                :value="metric.value"
                :icon="metric.icon"
                :delta="metric.deltaLast30Days > 0 ? metric.deltaLast30Days : null"
                :comparisonLabel="'dashboard.metrics.last_30_days'|trans({}, 'content')"
                :colorizeTrend="true"
                :href="canLink ? path(metric.routeName, metric.routeParams) : null"
                :class="canLink ? 'h-100 text-reset text-decoration-none' : null"
                data-testid="dashboard-metric-{{ metric.key }}"
            />
        </div>
    {% endfor %}
</div>
