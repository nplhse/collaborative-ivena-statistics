{% extends '@Shared/_layout_vertical.html.twig' %}

{% block title %}{{ 'title.dashboard'|trans({}, 'messages') }} - {{ parent() }}{% endblock %}

{% block page_header %}
    <div class="container-xl">
        <twig:Breadcrumbs :items="[
            { label: 'title.dashboard' }
        ]" />
    </div>
{% endblock %}

{% block page_content %}
    {% set canExplore = is_granted('ROLE_PARTICIPANT') %}
    {# Same check as the upload form (#1351). #}
    {% set canImport = is_granted(constant('App\\Import\\Infrastructure\\Security\\Voter\\ImportCreateVoter::CREATE')) %}
    {% set showParticipantAccessNotice = is_granted('ROLE_USER') and not is_granted('ROLE_PARTICIPANT') %}
    {% set analysisTitleKey = is_granted('ROLE_PARTICIPANT')
        ? 'dashboard.next_steps.analysis.title'
        : 'dashboard.next_steps.analysis.public.title' %}
    {% set analysisDescriptionKey = is_granted('ROLE_PARTICIPANT')
        ? 'dashboard.next_steps.analysis.description'
        : 'dashboard.next_steps.analysis.public.description' %}
    {% set nextSteps = [] %}
    {# Clinic access: owner or access grant; without it the tile leads to the assignment request (#1483). #}
    {% set clinicAccessStatus = clinicAccess is defined and clinicAccess is not null ? clinicAccess.status.value : null %}
    {% if clinicAccessStatus == 'granted' %}
        {% set nextSteps = nextSteps|merge([{
            title: 'dashboard.next_steps.hospitals.owned.title',
            description: 'dashboard.next_steps.hospitals.owned.description',
            icon: 'tabler:building-hospital',
            url: path('app_hospitals_index'),
            testId: 'dashboard-tile-hospitals',
        }]) %}
    {% elseif clinicAccessStatus == 'pending' %}
        {% set nextSteps = nextSteps|merge([{
            title: 'dashboard.next_steps.access_request.pending.title',
            description: 'dashboard.next_steps.access_request.pending.description',
            params: {hospital: clinicAccess.hospitalLabel},
            icon: 'tabler:clock',
            iconClass: 'bg-yellow-lt text-yellow',
            url: clinicAccess.requestUrl,
            testId: 'dashboard-tile-access-request-pending',
        }]) %}
    {% elseif clinicAccessStatus == 'rejected' %}
        {% set nextSteps = nextSteps|merge([{
            title: 'dashboard.next_steps.access_request.rejected.title',
            description: 'dashboard.next_steps.access_request.rejected.description',
            params: {hospital: clinicAccess.hospitalLabel},
            icon: 'tabler:alert-circle',
            iconClass: 'bg-red-lt text-red',
            url: clinicAccess.requestUrl,
            testId: 'dashboard-tile-access-request-rejected',
        }]) %}
    {% elseif clinicAccessStatus == 'no_request' %}
        {% set nextSteps = nextSteps|merge([{
            title: 'dashboard.next_steps.access_request.new.title',
            description: 'dashboard.next_steps.access_request.new.description',
            icon: 'tabler:user-plus',
            url: path('app_hospital_assignment_request_new'),
            testId: 'dashboard-tile-access-request',
        }]) %}
    {% endif %}
    {% if canExplore %}
        {% set nextSteps = nextSteps|merge([{
            title: 'dashboard.next_steps.explore.title',
            description: 'dashboard.next_steps.explore.description',
            icon: 'tabler:compass',
            url: path('app_explore_index'),
        }]) %}
    {% endif %}
    {% set nextSteps = nextSteps|merge([{
        title: analysisTitleKey,
        description: analysisDescriptionKey,
        icon: 'tabler:chart-histogram',
        url: path('app_stats_dashboard'),
    }]) %}
    {% set nextSteps = nextSteps|merge([{
        title: canImport ? 'dashboard.next_steps.import.title' : 'dashboard.next_steps.blog.title',
        description: canImport ? 'dashboard.next_steps.import.description' : 'dashboard.next_steps.blog.description',
        icon: canImport ? 'tabler:database-import' : 'tabler:notes',
        url: canImport ? path('app_import_new') : path('app_blog_index'),
    }]) %}

    <div class="d-flex flex-column gap-3">
        {{ include('@Content/dashboard/_metric_cards.html.twig', {metrics: metrics}) }}

        <div class="row g-3 align-items-start">
            <div class="col-12 col-lg-8 d-flex flex-column gap-3">
                <div class="row row-cards">
                    {% for step in nextSteps %}
                        <div class="col-12 col-md-6">
                            <a href="{{ step.url }}" class="card card-link h-100 text-reset text-decoration-none"{% if step.testId is defined %} data-testid="{{ step.testId }}"{% endif %}>
                                <div class="card-body d-flex gap-3">
                                    <span class="avatar avatar-lg {{ step.iconClass ?? 'bg-primary-lt text-primary' }} flex-shrink-0">
                                        {{ ux_icon(step.icon, {style: 'height: 1.75em;'}) }}
                                    </span>
                                    <div>
                                        <h3 class="h4 mb-1">{{ step.title|trans(step.params ?? {}, 'content') }}</h3>
                                        <p class="text-secondary mb-0">{{ step.description|trans(step.params ?? {}, 'content') }}</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                </div>

                <twig:Card
                    title="{{ 'dashboard.activity.title'|trans({}, 'content') }}"
                    headerClass="d-flex flex-wrap align-items-center justify-content-between gap-2"
                    :body="false"
                    data-testid="dashboard-activity-feed"
                >
                    <twig:block name="actions">
                        <a href="{{ path('app_activity_timeline') }}" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2" data-testid="dashboard-activity-view-all">
                            <twig:ux:icon name="tabler:activity" style="height: 1.25em;" />
                            {{ 'dashboard.activity.view_all'|trans({}, 'content') }}
                        </a>
                    </twig:block>
                    <turbo-frame
                        id="dashboard-activity"
                        src="{{ path('app_dashboard_activity') }}"
                        loading="lazy"
                        data-testid="dashboard-activity-frame"
                    >
                        <div class="card-body text-secondary py-3" aria-busy="true" aria-live="polite">
                            <div class="spinner-border spinner-border-sm text-secondary" role="status" aria-hidden="true"></div>
                            <span class="visually-hidden">{{ 'dashboard.activity.loading'|trans({}, 'content') }}</span>
                        </div>
                    </turbo-frame>
                </twig:Card>
            </div>

            <div class="col-12 col-lg-4 d-flex flex-column gap-3">
                {% if showParticipantAccessNotice %}
                    {{ include('@Content/dashboard/_participant_access_notice.html.twig') }}
                {% endif %}
                {% if onboardingCard is defined and onboardingCard is not null %}
                    {{ include('@Content/dashboard/_onboarding_card.html.twig') }}
                {% endif %}
                <twig:Card
                    title="{{ 'dashboard.blog.recent_title'|trans({}, 'content') }}"
                    headerClass="d-flex flex-wrap align-items-center justify-content-between gap-2"
                    :body="false"
                >
                    <twig:block name="actions">
                        <a href="{{ path('app_blog_index') }}" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2">
                            <twig:ux:icon name="tabler:notes" style="height: 1.25em;" />
                            {{ 'dashboard.blog.visit'|trans({}, 'content') }}
                        </a>
                    </twig:block>
                    <div class="list-group list-group-flush">
                        {% for post in recentPosts %}
                            <a href="{{ path('app_blog_show', {slug: post.slug}) }}" class="list-group-item list-group-item-action">
                                <div class="fw-medium">{{ post.title }}</div>
                                <div class="text-secondary small">{{ post.publishedAt|date('d.m.Y') }}</div>
                            </a>
                        {% else %}
                            <div class="list-group-item text-secondary">
                                {{ 'dashboard.blog.recent_empty'|trans({}, 'content') }}
                            </div>
                        {% endfor %}
                    </div>
                </twig:Card>
                <twig:Content:PageNavigation />
            </div>
        </div>
    </div>
{% endblock %}
