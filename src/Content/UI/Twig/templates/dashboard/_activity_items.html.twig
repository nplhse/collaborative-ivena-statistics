{% import '@Shared/_macros/users.html.twig' as users %}
{#
    Activity entries of the dashboard, the timeline, the hospital feed and user profiles: the icon of the activity, one
    sentence (who did what with what), and a row with the time and the reactions.
#}
{% set previews = previews|default({}) %}
{% set activityIcons = {
    joined: 'tabler:user-plus',
    first_import: 'tabler:database-import',
    import_milestone: 'tabler:award',
    post_published: 'tabler:file-text',
    comment_created: 'tabler:message-circle',
    hospital_associated: 'tabler:link',
    hospital_disassociated: 'tabler:link-off',
    hospital_owner_granted: 'tabler:key',
    hospital_owner_revoked: 'tabler:key-off',
} %}
{% set show_reactions = show_reactions|default(false) %}

{% for activity in activities %}
    {% set type = activity.type.value %}
    {% set actor = {userId: activity.actorId, username: activity.actorUsername, displayName: activity.actorDisplayName} %}
    {# Both parts are captured with auto-escaping, so the sentence below can print them as HTML. #}
    {% set actorHtml %}<span class="fw-medium" data-testid="activity-actor" title="{{ activity.actorUsername }}">{{ users.link(actor, {requireParticipant: true, avatar: 'inline'}) }}</span>{% endset %}
    {% set objectHtml = '' %}
    {% if type in ['post_published', 'comment_created'] %}
        {% if activity.postTitle %}
            {% set objectHtml %}<span class="fw-medium">{% if activity.postSlug %}<a href="{{ path('app_blog_show', {slug: activity.postSlug}) }}" target="_top">{{ activity.postTitle }}</a>{% else %}{{ activity.postTitle }}{% endif %}</span>{% endset %}
        {% endif %}
    {% elseif activity.hospitalName and type != 'joined' %}
        {% set objectHtml %}<span class="fw-medium">{% if is_granted('ROLE_PARTICIPANT') and activity.hospitalPublicId %}<a href="{{ path('app_explore_hospital_show', {publicId: activity.hospitalPublicId}) }}" target="_top">{{ activity.hospitalName }}</a>{% else %}{{ activity.hospitalName }}{% endif %}</span>{% endset %}
    {% endif %}
    {% set sentenceKey = 'label.user.activity.sentence.' ~ type ~ (objectHtml != '' ? '.object' : '.plain') %}
    <div
        class="list-group-item"
        data-testid="{{ activity_item_testid|default('dashboard-activity-item') }}"
        data-activity-type="{{ type }}"
        data-activity-stable-id="{{ activity.stableId }}"
    >
        <div class="row align-items-start">
            <div class="col-auto">
                <span class="avatar avatar-sm rounded" data-testid="activity-icon">
                    <twig:ux:icon name="{{ activityIcons[type] }}" width="1.25em" height="1.25em" aria-hidden="true" />
                </span>
            </div>
            <div class="col min-w-0">
                <div class="activity-lead" data-testid="activity-sentence">
                    {{- sentenceKey|trans({actor: actorHtml, object: objectHtml, count: activity.milestone ?? 0}, 'user')|raw -}}
                </div>
                {% if type == 'post_published' and activity.postTitle %}
                    {% set preview = activity.postSlug ? previews[activity.postSlug]|default('') : '' %}
                    {% if preview %}
                        <div class="text-secondary small activity-post-preview mt-1" data-testid="activity-post-preview">
                            {{ preview|raw }}
                        </div>
                    {% endif %}
                {% elseif type == 'comment_created' and activity.excerpt %}
                    <div class="text-secondary small text-truncate mt-1">{{ activity.excerpt }}</div>
                {% endif %}
                <div class="activity-meta" data-testid="activity-meta">
                    <twig:RelativeTimestamp :datetime="activity.occurredAt" />
                    {% if show_reactions and activity.id %}
                        {{ include('@Content/reaction/_placeholder.html.twig', {target_type: 'activity', target_id: activity.id}) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endfor %}
