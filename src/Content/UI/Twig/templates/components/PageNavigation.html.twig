{# Inside the Card blocks `this` is the Card, so read our values first. #}
{% set nodes = this.nodes %}
{% if nodes is not empty %}
    {% set navId = this.navId %}
    {% set headingId = this.headingId %}
    {% set heading = this.heading ?? 'page.navigation.title'|trans({}, 'content') %}
    <twig:Card :body="false" {{ ...attributes.defaults({class: 'page-navigation', 'data-testid': 'page-navigation'}) }}>
        <twig:block name="header">
            <h3 class="card-title d-flex align-items-center gap-2" id="{{ headingId }}">
                <twig:ux:icon name="tabler:sitemap" class="w-4 h-4" aria-hidden="true" />
                {{ heading }}
            </h3>
        </twig:block>
        <nav class="card-body py-2" aria-labelledby="{{ headingId }}" data-controller="page-navigation">
            <ul class="page-nav-list list-unstyled mb-0">
                {{ include('@Content/components/_page_navigation_nodes.html.twig', {nodes: nodes, navId: navId}, with_context: false) }}
            </ul>
        </nav>
    </twig:Card>
{% endif %}
