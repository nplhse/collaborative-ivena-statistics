{% if this.items is not empty %}
    <div{{ attributes.defaults({class: 'col-12', 'data-testid': 'help-reference'}) }}>
        <div class="card">
            <div class="card-header">
                <h3 class="card-title d-flex align-items-center gap-2">
                    <twig:ux:icon name="tabler:book" class="w-4 h-4" />
                    {{ 'help.reference.title'|trans({}, 'content') }}
                </h3>
            </div>
            <div class="list-group list-group-flush">
                {% for item in this.items %}
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="{{ path(item.route, item.routeParameters) }}" data-testid="help-reference-{{ item.id }}">
                        {% if item.icon %}<twig:ux:icon name="{{ item.icon }}" class="w-4 h-4" />{% endif %}
                        {{ item.label|trans }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}
