#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Compiles the containers that some tests boot besides the regular test kernel, so those tests do not build them
 * in-process (#1343): the test kernels without bundles (#1300 step 5) and the demo kernel of
 * DemoEnvironmentConfigTest. Each one takes a minute or more under coverage and blocks a ParaTest worker.
 *
 * `make test-database` (and so CI) runs it first, without coverage (php -d pcov.enabled=0). The prod header check
 * that used to need a prod container here runs in the CI job "Prod kernel smoke" (bin/check-prod-csp).
 */

use App\Kernel;
use App\Tests\Support\Kernel\KernelWithoutEdVisit;
use App\Tests\Support\Kernel\KernelWithoutEncounterSchemas;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArrayInput;
use Symfony\Component\Console\Output\ConsoleOutput;
use Symfony\Component\Dotenv\Dotenv;
use Symfony\Component\HttpKernel\KernelInterface;

require dirname(__DIR__).'/vendor/autoload.php';

// Same environment as the tests (phpunit.dist.xml forces APP_ENV=test, tests/bootstrap.php loads .env).
$_SERVER['APP_ENV'] = $_ENV['APP_ENV'] = 'test';
new Dotenv()->bootEnv(dirname(__DIR__).'/.env');
$debug = (bool) $_SERVER['APP_DEBUG'];

// Kernel => run cache:warmup (true) or only boot it, which compiles the container (false). The demo kernel is only
// booted: its console guard refuses any database that is not a demo database, and the test only boots it as well.
// DemoEnvironmentConfigTest boots it with debug on, so it rebuilds itself when a file changes.
$kernels = [
    [new KernelWithoutEdVisit('test', $debug), true],
    [new KernelWithoutEncounterSchemas('test', $debug), true],
    [new Kernel('demo', true), false],
];

$output = new ConsoleOutput();
$exitCode = 0;

foreach ($kernels as [$kernel, $runWarmupCommand]) {
    $startedAt = hrtime(true);
    $result = warmUp($kernel, $runWarmupCommand);
    $seconds = (hrtime(true) - $startedAt) / 1e9;

    $output->writeln(sprintf(
        '%s %s (%s, debug %s) in %.1f s',
        0 === $result ? 'Warmed' : 'FAILED',
        $kernel::class,
        $kernel->getEnvironment(),
        $kernel->isDebug() ? 'on' : 'off',
        $seconds,
    ));
    $exitCode = max($exitCode, $result);
}

exit($exitCode);

function warmUp(KernelInterface $kernel, bool $runWarmupCommand): int
{
    if (!$runWarmupCommand) {
        $kernel->boot();
        $kernel->shutdown();

        return 0;
    }

    $application = new Application($kernel);
    $application->setAutoExit(false);

    try {
        // --quiet wins over SHELL_VERBOSITY, which a debug kernel sets when it boots; errors still reach the output.
        return $application->run(new ArrayInput(['command' => 'cache:warmup', '--quiet' => true]), new ConsoleOutput());
    } finally {
        $kernel->shutdown();
    }
}
