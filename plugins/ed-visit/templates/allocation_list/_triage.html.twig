{# Initial triage of an ED visit in the column "Encounter" of the Explore allocation list (#1203). The colour dot
   uses the MTS category, like the visit list. #}
{% set d = 'encounter' %}
<span data-testid="allocation-list-encounter-triage">
    {% if triage.category %}
        <span class="badge bg-{{ triage.category }} me-1" title="{{ ('encounter.mts.category.' ~ triage.category ~ '.name')|trans({}, d) }}"></span>
    {% endif %}
    {% if triage.diagram %}
        {{ encounter_mts_diagram_name(triage.diagram) }}
    {% elseif triage.category %}
        {{ ('encounter.mts.category.' ~ triage.category ~ '.name')|trans({}, d) }}
    {% endif %}
    {% if triage.indicator %}
        <span class="text-secondary d-block">{{ encounter_mts_indicator_name(triage.indicator) }}</span>
    {% endif %}
</span>
