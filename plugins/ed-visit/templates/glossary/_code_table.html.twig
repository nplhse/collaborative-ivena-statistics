{# Table of MtsGlossaryRow. Expects `title`, `rows`, `testid`, `link_route` (nullable), `section_key`, `catalog_usages` and `has_counts`. #}
<div class="card" id="{{ section_key }}" data-testid="{{ testid }}s">
    <div class="card-header">
        <h3 class="card-title">{{ title }}</h3>
        <div class="card-actions text-secondary">{{ rows|length }}</div>
    </div>
    {{ include('@Allocation/glossary/_catalog_usages.html.twig', {usages: catalog_usages|filter(usage => usage.section == section_key)}) }}
    <div class="table-responsive">
        <table class="table table-vcenter card-table mb-0">
            <thead>
                <tr>
                    <th>{{ 'catalog.glossary.column.label'|trans({}, 'allocation') }}</th>
                    {% if has_counts %}
                        <th class="w-1 text-end">{{ 'encounter.mts.column.encounters'|trans({}, 'encounter') }}</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr data-testid="{{ testid }}" data-code="{{ row.code }}">
                        <td>
                            {% if link_route %}
                                <a href="{{ path(link_route, {code: row.code}) }}">{{ row.name }}</a>
                            {% else %}
                                {{ row.name }}
                            {% endif %}
                            {% if row.germanName %}
                                <div class="text-secondary small" lang="de">{{ row.germanName }}</div>
                            {% endif %}
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                {{ include('@EdVisit/glossary/_code_badge.html.twig', {code: row.code}) }}
                                {% if not row.inCatalog %}
                                    <span class="badge bg-secondary-lt">{{ 'encounter.mts.not_in_catalog'|trans({}, 'encounter') }}</span>
                                {% endif %}
                            </div>
                        </td>
                        {% if has_counts %}
                            <td class="text-end" data-testid="mts-count">
                                {% if row.count %}{{ include('@EdVisit/glossary/_count.html.twig', {count: row.count}) }}{% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
