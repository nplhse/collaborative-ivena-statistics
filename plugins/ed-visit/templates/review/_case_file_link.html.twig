{# Link to the allocation case file in Explore (#1177). Expects `allocation` with `public_id`; `class` styles it (default: a button).
   As a header button (`compact`) it shows only its icon on small screens, so the page title keeps its room.
   The case file needs ROLE_PARTICIPANT and access to the hospital (AllocationVoter, ADR 044), which the review does not;
   without them the link is hidden. Expects the reviewed `hospital` in the context.
   Opens in a new tab so the review keeps its selection and position. #}
{% if is_granted('ROLE_PARTICIPANT') and is_granted('ACCESS', hospital) %}
    {% set label = 'encounter.review.action.view_allocation'|trans({}, 'encounter') %}
    {% set compact = compact|default(false) %}
    <a href="{{ path('app_explore_allocation_show', {publicId: allocation.public_id}) }}" target="_blank" rel="noopener" class="{{ class|default('btn') }}" title="{{ label }}" aria-label="{{ label }}" data-test="encounter-review-case-file">
        <span{% if compact %} class="d-none d-sm-inline"{% endif %}>{{ label }}</span>
        <twig:ux:icon name="tabler:external-link" class="w-3 h-3 {{ compact ? 'ms-sm-1' : 'ms-1' }}" aria-hidden="true" />
    </a>
{% endif %}
