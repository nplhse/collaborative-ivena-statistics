# Demo environment (ADR 023, docs/05-operations/demo-environment.md). Committed: local defaults only,
# never secrets. Loaded after .env.local, so a .env.local that points at another database does not
# reach the demo. Local overrides go into .env.demo.local (not committed).
APP_DEBUG=0
APP_SECRET=demo-only-not-a-secret

# Own database; DemoEnvironmentGuard refuses any database whose name does not end in "_demo"
# or that is not on this machine.
DATABASE_URL="postgresql://app:password@127.0.0.1:5432/app_demo?serverVersion=18&charset=utf8"

APP_URL=http://127.0.0.1:8001
MAILER_DSN=null://null
MAILER_FROM=no-reply@localhost
MAILER_REPLY_TO=

SENTRY_DSN=
SENTRY_ENVIRONMENT=demo
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENABLE_LOGS=false
SENTRY_CSP_REPORT_URI=

# No outbound geo requests by default. Preparing geodata while online is an explicit opt-in.
OPENROUTESERVICE_API_KEY=
