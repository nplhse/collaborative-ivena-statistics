{
    "name": "collaborative-ivena-statistics",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "lint": "eslint assets/ src/Encounter/UI/DataPrep/js/ tests/Encounter/DataPrep/",
        "lint:fix": "eslint assets/ src/Encounter/UI/DataPrep/js/ tests/Encounter/DataPrep/ --fix",
        "format": "prettier --write \"assets/**/*.js\" \"src/Encounter/UI/DataPrep/**/*.{js,json}\" \"src/Encounter/Application/Catalog/*.json\" \"tests/Encounter/DataPrep/**/*.{js,json}\"",
        "format:check": "prettier --check \"assets/**/*.js\" \"src/Encounter/UI/DataPrep/**/*.{js,json}\" \"src/Encounter/Application/Catalog/*.json\" \"tests/Encounter/DataPrep/**/*.{js,json}\"",
        "test:js": "node --test \"tests/Encounter/DataPrep/*.test.js\"",
        "check:js": "npm run format:check && npm run lint && npm run test:js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.9.10"
    }
}
