# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Differs from APP_SECRET on purpose, so tests show that persistent hashes do not use APP_SECRET (#1706).
APP_HASH_KEY=test-hash-key-not-for-production-0001
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENABLE_LOGS=false
# Fixed key for two-factor tests (#1357); never use it outside tests.
APP_TWO_FACTOR_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Data extract requests run against the test database in tests (#1635); a read-only role follows with the export runs.
RESEARCH_DATABASE_URL="${DATABASE_URL}"
# The tests share the application user (DAMA), which can write; Application Health does not count that as a problem.
RESEARCH_EXPECT_READ_ONLY=0
